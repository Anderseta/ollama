+static void test_bounded_fallback_upload(const char * directory, ggml_backend_t backend, bool gpu) {
+    constexpr size_t page=65536, mib=1024*1024, size=8*mib, prefix=37;
+    struct fixture {
+        std::filesystem::path path;
+        ~fixture() { std::error_code error; std::filesystem::remove(path,error); }
+    } file { std::filesystem::path(directory)/("moe-fallback-upload-"+std::to_string(std::random_device{}())+".bin") };
+    std::vector<uint8_t> raw(size+prefix), expected(size,0x91), actual(size);
+    for (size_t i=0; i<raw.size(); ++i) { raw[i]=uint8_t(i*13+i/127); }
+    auto write = [&] {
+        std::ofstream stream(file.path,std::ios::binary|std::ios::trunc);
+        stream.write(reinterpret_cast<const char *>(raw.data()),raw.size());
+        require(stream.good(),"cannot write fallback-upload fixture");
+    };
+    write();
+    llama_files files;
+    files.emplace_back(new llama_file(file.path.string().c_str(),"rb"));
+    auto * registry=ggml_backend_dev_backend_reg(ggml_backend_get_device(backend));
+    const bool queue_api=registry && ggml_backend_reg_get_proc_address(registry,"ggml_backend_cuda_upload_api") != nullptr;
+    for (size_t budget : {2*page,8*page}) {
+        ggml_context_ptr source(ggml_init({4*ggml_tensor_overhead(),nullptr,true}));
+        ggml_context_ptr target(ggml_init({4*ggml_tensor_overhead(),nullptr,true}));
+        require(source && target,"cannot create fallback-upload contexts");
+        auto * weights=ggml_new_tensor_1d(source.get(),GGML_TYPE_I8,size);
+        auto * view=ggml_view_1d(source.get(),weights,size-page,page);
+        auto * destination=ggml_new_tensor_1d(target.get(),GGML_TYPE_I8,size);
+        ggml_backend_buffer_ptr output(ggml_backend_alloc_ctx_tensors(target.get(),backend));
+        require(output!=nullptr,"cannot allocate fallback-upload output");
+        llama_model_ram_cache cache(budget,files,true);
+        cache.bind(weights,0,prefix);
+        view->data=static_cast<uint8_t *>(weights->data)+page;
+        constexpr size_t source_offset=11, destination_offset=19, amount=6*mib+47;
+        std::fill(expected.begin(),expected.end(),0x91);
+        std::copy_n(raw.data()+prefix+page+source_offset,amount,expected.data()+destination_offset);
+        auto guard=cache.acquire();
+        auto transfer = [&] {
+            std::fill(actual.begin(),actual.end(),0x91);
+            ggml_backend_tensor_set(destination,actual.data(),0,size);
+            // The whole source exceeds the quota. It must select the same
+            // bounded fallback used by expert uploads, not grow the cache.
+            require(!cache.copy_batch(backend,{{view,destination,source_offset,destination_offset,amount}}),
+                    "oversized batch bypassed the bounded fallback");
+            const auto before=cache.stats(guard);
+            require(cache.copy(backend,view,destination,source_offset,destination_offset,amount),
+                    "bounded fallback upload rejected managed weights");
+            // No caller fence: copy() must finish its destination itself.
+            ggml_backend_tensor_get(destination,actual.data(),0,size);
+            require(actual==expected,"bounded fallback changed view bytes or destination gaps");
+            const auto after=cache.stats(guard);
+            const auto delta=llama_model_ram_stats_delta(before,after);
+            require(after.resident<=budget && after.peak<=budget,"bounded fallback exceeded its RAM quota");
+            require(delta.h2d_bytes==(gpu ? amount : 0),"bounded fallback H2D accounting differs from its exact range");
+            if (gpu && queue_api && after.upload_buffer_bytes) {
+                require(after.upload_buffer_bytes==4*mib,"bounded fallback enlarged upload staging");
+                require(delta.h2d_sync_calls==2,"bounded fallback still fences the backend per source chunk");
+                require(delta.h2d_calls<(amount+page-1)/page,
+                        "bounded fallback still uploads individual scattered pool pages");
+            }
+            printf("fallback upload budget=%zu range=%zu H2D_calls=%llu explicit_syncs=%llu staging=%zu\n",
+                budget,amount,(unsigned long long)delta.h2d_calls,(unsigned long long)delta.h2d_sync_calls,
+                after.upload_buffer_bytes);
+        };
+        transfer();
+        transfer(); // Last-batch events/slots must remain reusable.
+        const auto before_empty=cache.stats(guard);
+        require(cache.copy(backend,view,destination,source_offset,destination_offset,0),"zero-sized fallback rejected");
+        const auto after_empty=cache.stats(guard);
+        require(after_empty.h2d_bytes==before_empty.h2d_bytes && after_empty.read_calls==before_empty.read_calls &&
+                after_empty.h2d_sync_calls==before_empty.h2d_sync_calls,"zero-sized copy performed storage or backend work");
+        // Fail after several read/upload chunks were submitted. Drain their
+        // staging borrows and leave the queue usable by the next attempt.
+        cache.read(weights,size-budget,actual.data(),budget);
+        std::filesystem::resize_file(file.path,prefix+2*mib);
+        bool rejected=false;
+        try { cache.copy(backend,view,destination,source_offset,destination_offset,amount); }
+        catch (const std::exception &) { rejected=true; }
+        require(rejected,"truncated oversized fallback transfer accepted");
+        require(cache.stats(guard).resident<=budget && cache.stats(guard).peak<=budget,
+                "failed fallback upload exceeded its quota");
+        write();
+        transfer();
+    }
+    printf("PASS bounded fallback upload: oversized ranges, views, gaps, two RAM quotas, renewed staging, no-op and partial-I/O recovery\n");
 }
 
