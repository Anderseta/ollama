+static void llama_sampler_token_mask_backend_apply(llama_sampler * sampler, ggml_context * ctx,
+        ggml_cgraph * gf, llama_sampler_data * data) {
+    auto & sctx=*static_cast<llama_sampler_token_mask *>(sampler->ctx);
+    GGML_ASSERT(data->logits && !data->sampled && "token masks must precede selection");
+    sctx.inp_words=ggml_new_tensor_1d(ctx,GGML_TYPE_I32,sctx.words.size());
