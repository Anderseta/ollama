+static void grammar_mask_equivalence(llama_model * model) {
+    auto compare=[](llama_sampler * grammar) {
+        std::vector<llama_token_data> candidates(n_vocab);
+        for(int i=0;i<n_vocab;++i) { candidates[i]={i,0.f,0.f}; }
+        llama_token_data_array array{candidates.data(),candidates.size(),-1,false};
+        llama_sampler_apply(grammar,&array);
+        std::vector<uint32_t> words((n_vocab+31)/32);
+        require(llama_sampler_grammar_token_mask(grammar,words.data(),words.size()),"grammar mask export failed");
+        for(int i=0;i<n_vocab;++i) {
+            require(bool(words[i/32]&(UINT32_C(1)<<(i%32)))==(candidates[i].logit!=-INFINITY),"grammar mask changed UTF8/lazy/EOG rule");
+        }
+    };
+    const auto * vocab=llama_model_get_vocab(model);
+    llama_sampler_ptr unicode(llama_sampler_init_grammar(vocab,"root ::= \"\xc3\xa1\xc3\xa7\"\n","root"));
+    compare(unicode.get());compare(unicode.get());
+    require(llama_sampler_grammar_mask_cache_stats(unicode.get()).hits>0,"identical grammar state did not reuse bitset");
+    for(auto byte:{0xc3,0xa1,0xc3,0xa7}) { llama_sampler_accept(unicode.get(),3+byte);compare(unicode.get()); }
+    const llama_token trigger=3+'[';
+    llama_sampler_ptr lazy(llama_sampler_init_grammar_lazy(vocab,"root ::= \"[AB]\"\n","root",nullptr,0,&trigger,1));
+    compare(lazy.get());llama_sampler_accept(lazy.get(),3+'x');compare(lazy.get());
+    for(auto byte:{'[','A','B',']'}) { llama_sampler_accept(lazy.get(),3+byte);compare(lazy.get()); }
+    auto clone=llama_sampler_ptr(llama_sampler_clone(lazy.get()));compare(clone.get());
+    const std::string sequence="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
+    const std::string grammar="root ::= \""+sequence+"\"\n";
+    llama_sampler_ptr many(llama_sampler_init_grammar(vocab,grammar.c_str(),"root"));
+    for(unsigned char c:sequence) {
+        compare(many.get());
+        const auto stats=llama_sampler_grammar_mask_cache_stats(many.get());
+        require(stats.entries<=16 && stats.bytes<=1024*1024,"grammar-state mask cache exceeded its retained quota");
+        llama_sampler_accept(many.get(),3+c);
+    }
+    compare(many.get());llama_sampler_reset(many.get());compare(many.get());
+    require(llama_sampler_grammar_mask_cache_stats(many.get()).entries==1,"grammar reset retained stale stack pointers");
+    std::puts("PASS grammar bitsets: identical legacy rejection across partial UTF8, lazy triggers, EOG and clone");
+}
