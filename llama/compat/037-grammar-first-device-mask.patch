+    graph_binding_budget("64");llama_context_ptr right(llama_init_from_model(model,params));
+    require(left && right,"grammar-first contexts unavailable");
+    auto * backend=compact ? common_sampler_get_backend_selected_only(next.get()) : common_sampler_get_backend(next.get());
+    require(backend && llama_set_sampler(right.get(),0,backend),"grammar-first backend attach failed");
+    require(llama_sampler_backend_can_bind_graph(backend)==(output_limit==1),"multi-output constraint did not retain fallback");
+    llama_pos position=0;size_t arenas=0;int accepted=0;
+    const int shapes[]={1,3,2,3,1,3,2,1,3,2,3,1};
+    for(size_t step=0;step<sizeof(shapes)/sizeof(shapes[0]);++step) {
+        common_batch a(left.get()),b(right.get());
+        for(int i=0;i<shapes[step];++i) {
+            const bool output=output_limit>1 || i==shapes[step]-1;
+            a.add(3+'a'+int(step%19),position,0,output);b.add(3+'a'+int(step%19),position++,0,output);
+        }
