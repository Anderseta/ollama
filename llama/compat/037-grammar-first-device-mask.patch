+static void llama_sampler_token_mask_apply(llama_sampler * sampler, llama_token_data_array * cur) {
+    const auto & ctx = *static_cast<const llama_sampler_token_mask *>(sampler->ctx);
+    for (size_t i=0; i<cur->size; ++i) {
+        const auto id=cur->data[i].id;
+        if (id<0 || id>=ctx.n_vocab || !(ctx.words[id/32] & (UINT32_C(1) << (id%32)))) {
+            cur->data[i].logit=-INFINITY;
+        }
+    }
+    cur->sorted=false;
+}
+static void llama_sampler_token_mask_free(llama_sampler * sampler) {
+    delete static_cast<llama_sampler_token_mask *>(sampler->ctx);
+}
+static llama_sampler * llama_sampler_token_mask_clone(const llama_sampler * sampler) {
+    const auto & ctx=*static_cast<const llama_sampler_token_mask *>(sampler->ctx);
+    llama_sampler_ptr clone(llama_sampler_init_token_mask(ctx.n_vocab));
+    static_cast<llama_sampler_token_mask *>(clone->ctx)->copy_state(ctx);
