+    for(int variant=0;variant<6;++variant) {
+        std::fill(mask.begin(),mask.end(),0);
+        for(int id=0;id<n_vocab;++id) { if((id+variant)%3) { mask[id/32]|=UINT32_C(1)<<(id%32); } }
+        ggml_backend_tensor_set(logits,input.data(),0,input.size()*4);
+        ggml_backend_tensor_set(filtered,small.data(),0,small.size()*4);
+        ggml_backend_tensor_set(candidates,ids.data(),0,ids.size()*4);
+        ggml_backend_tensor_set(words,mask.data(),0,mask.size()*4);
