+static void grammar_first_backend(llama_model * model,bool compact,int output_limit=1) {
+    common_params_sampling aparams;
+    aparams.seed=424242;aparams.temp=.7f;aparams.top_k=20;aparams.top_p=.9f;
+    aparams.penalty_repeat=1.f;aparams.penalty_freq=aparams.penalty_present=0.f;
+    aparams.grammar_first=true;
+    aparams.grammar=common_grammar(COMMON_GRAMMAR_TYPE_USER,
+        compact ? "root ::= [A-Za-z0-9, ]+\n" : "root ::= ([A-Z] [0-9])+\n");
+    aparams.logit_bias={{0,-INFINITY},{1,-INFINITY},{2,-INFINITY}};
