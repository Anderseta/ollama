+    const char * env=std::getenv("WILDLLAMA_GRAPH_VARIANTS_MIB");const std::string old_budget=env?env:"";
+    struct restore_budget {std::string value;~restore_budget(){graph_binding_budget(value.c_str());}} restore{old_budget};
