+    auto default_params=aparams;default_params.grammar_first=false;default_params.backend_sampling=true;
+    common_sampler_ptr default_order(common_sampler_init(model,default_params));
+    require(!common_sampler_get_backend(default_order.get()) && !default_params.backend_sampling,"default grammar-last behavior changed");
+    auto controller_params=aparams;controller_params.backend_sampling=true;
+    controller_params.reasoning_budget_tokens=2;controller_params.reasoning_budget_start={3+'['};
