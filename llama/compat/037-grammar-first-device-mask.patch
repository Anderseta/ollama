+// Owned dynamic allowed-token bitset. Logical words/versions survive arena
+// changes; only inp_words belongs to a particular graph.
+struct llama_sampler_token_mask : llama_sampler_backend {
+    explicit llama_sampler_token_mask(int32_t n_vocab) : llama_sampler_backend("token-mask"),
+        n_vocab(n_vocab), words((size_t(n_vocab)+31)/32, UINT32_MAX), next_words(words.size()) { }
+
+    const int32_t n_vocab;
+    std::vector<uint32_t> words;
+    std::vector<uint32_t> next_words;
+    uint64_t version = 1;
+    ggml_backend_buffer_ptr pinned;
+    uint64_t pinned_version = 0;
+    ggml_tensor * inp_words = nullptr;
+
+    void copy_state(const llama_sampler_token_mask & src) {
+        GGML_ASSERT(n_vocab == src.n_vocab);
+        if (words != src.words) { words = src.words; ++version; }
+    }
+};
+
+static const char * llama_sampler_token_mask_name(const llama_sampler * sampler) {
+    return static_cast<llama_sampler_token_mask *>(sampler->ctx)->get_name();
