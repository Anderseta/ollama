new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/token-mask.cu
@@ -0,0 +1,20 @@
+#include "token-mask.cuh"
+
+static __global__ void token_mask_kernel(const float * logits, const uint32_t * words,
+        const int32_t * ids, float * output, int64_t n, int32_t n_vocab) {
+    const int64_t i = int64_t(blockIdx.x)*blockDim.x + threadIdx.x;
+    if (i >= n) { return; }
+    const int64_t id = ids ? ids[i] : i;
+    const bool allowed = id >= 0 && id < n_vocab && (words[id/32] & (uint32_t(1) << (id%32)));
+    output[i] = allowed ? logits[i] : -INFINITY;
+}
+
+void ggml_cuda_op_token_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
+    const int64_t n = ggml_nelements(dst);
+    const int32_t n_vocab = ggml_get_op_params_i32(dst, 0);
+    constexpr int threads = 256;
+    token_mask_kernel<<<(n+threads-1)/threads,threads,0,ctx.stream()>>>(
+        (const float *)dst->src[0]->data, (const uint32_t *)dst->src[1]->data,
+        dst->src[2] ? (const int32_t *)dst->src[2]->data : nullptr, (float *)dst->data, n, n_vocab);
+}
