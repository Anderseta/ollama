+    auto & ctx=*static_cast<llama_sampler_token_mask *>(sampler->ctx);
+    if (!ctx.inp_words) { return; }
+    const size_t bytes=ctx.words.size()*sizeof(uint32_t);
+    const void * source=ctx.words.data();
