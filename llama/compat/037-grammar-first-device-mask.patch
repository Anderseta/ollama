+static void ggml_compute_forward_token_mask(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    const int64_t n = ggml_nelements(dst);
+    const int64_t chunk = (n + params->nth - 1)/params->nth;
+    const int64_t first = chunk*params->ith, last = MIN(n, first + chunk);
+    const int32_t n_vocab = ggml_get_op_params_i32(dst, 0);
+    const float * logits = (const float *) dst->src[0]->data;
+    const uint32_t * words = (const uint32_t *) dst->src[1]->data;
+    const int32_t * ids = dst->src[2] ? (const int32_t *) dst->src[2]->data : NULL;
+    float * output = (float *) dst->data;
+    for (int64_t i = first; i < last; ++i) {
+        const int64_t id = ids ? ids[i] : i;
+        const bool allowed = id >= 0 && id < n_vocab && (words[id/32] & (UINT32_C(1) << (id%32)));
+        output[i] = allowed ? logits[i] : -INFINITY;
+    }
+}
