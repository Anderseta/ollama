+    const std::vector<int32_t> ids={258,0,31,32,63,64,127,128,255,256,257,-1,259,30,33,65,129};
+    auto * filtered=ggml_new_tensor_1d(context.get(),GGML_TYPE_F32,ids.size());
+    auto * candidates=ggml_new_tensor_1d(context.get(),GGML_TYPE_I32,ids.size());
+    auto * full=ggml_token_mask(context.get(),logits,words,nullptr,n_vocab);
+    auto * partial=ggml_token_mask(context.get(),filtered,words,candidates,n_vocab);
+    auto * graph=ggml_new_graph(context.get());
+    ggml_build_forward_expand(graph,full); ggml_build_forward_expand(graph,partial);
