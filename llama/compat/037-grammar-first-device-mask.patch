+                llama_process(right.get(),LLAMA_PROCESS_TYPE_DECODE,b.get())==0,"grammar-first decode failed");
+        for(int i=output_limit>1 ? 0 : shapes[step]-1;i<shapes[step];++i) {
+            const auto token=common_sampler_sample(reference.get(),left.get(),i,true);
+            const auto actual=common_sampler_sample(next.get(),right.get(),i,true);
+            if(token!=actual) {std::fprintf(stderr,"grammar-first mismatch step%zu row%d compact%d limit%d: CPU%d backend%d\n",step,i,int(compact),output_limit,token,actual);}
+            if(!compact) {
+                const auto * x=common_sampler_get_candidates(reference.get(),true);
+                const auto * y=common_sampler_get_candidates(next.get(),true);
+                std::map<llama_token,float> expected,got;
+                for(size_t j=0;j<x->size;++j) {if(x->data[j].p>0.f){expected[x->data[j].id]=x->data[j].p;}}
+                for(size_t j=0;j<y->size;++j) {if(y->data[j].p>0.f){got[y->data[j].id]=y->data[j].p;}}
+                require(expected.size()==got.size(),"grammar-first distribution support changed");
+                for(const auto & item:expected) {require(got.count(item.first) && std::fabs(item.second-got[item.first])<2e-6f,"grammar-first distribution changed");}
+            }
+            require(token==actual,"grammar-first CPU/backend token or RNG changed");
+            common_sampler_accept(reference.get(),token,true);common_sampler_accept(next.get(),actual,true);
+            ++accepted;
