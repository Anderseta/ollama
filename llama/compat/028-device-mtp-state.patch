diff --git a/tests/test-mtp-device-state.cpp b/tests/test-mtp-device-state.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-mtp-device-state.cpp
@@ -0,0 +1,210 @@
+// Reuse the nonzero in-memory <4 MiB model and checkpoint helpers. The existing
+// CPU regression remains a separate executable with its original entry point.
+#define main mtp_existing_cpu_regression
+#include "test-mtp-state.cpp"
+#undef main
+
+#include "mtp-device-state.h"
+#include <cstdlib>
+
+static void option(bool enabled) {
+#ifdef _WIN32
+    _putenv_s("WILDLLAMA_MTP_DEVICE_STATE", enabled ? "1" : "0");
+#else
+    setenv("WILDLLAMA_MTP_DEVICE_STATE", enabled ? "1" : "0", 1);
+#endif
+}
+
+static void bound_model_buffers(const session & s) {
+    // User-created models have no GGUF file size; inspect allocated weights
+    // rather than accepting llama_model_size()==0 as a resource bound.
+    size_t bytes = 0;
+    for (const auto & entry : llama_get_memory_breakdown(s.target.get())) { bytes += entry.second.model; }
+    require(bytes > 0 && bytes < 4u*1024u*1024u, "device fixture model buffers exceed 4 MiB or are unmeasured");
+    std::printf("MTP fixture allocated model buffers: %zu bytes\n", bytes);
+}
+
+static void process_without_host_hidden(session & s, llama_token token, llama_pos position) {
+    require(common_speculative_can_resume(s.spec.get(), 0, position), "device resume guard rejected valid predecessor");
+    common_batch input(s.target.get()); input.add(token, position, 0, true);
+    const int target_rc=llama_process(s.target.get(), LLAMA_PROCESS_TYPE_DECODE, input.get());
+    const bool catch_up=target_rc==0 && common_speculative_process(s.spec.get(), input);
+    if(target_rc || !catch_up) { std::fprintf(stderr,"process diagnostic token=%d pos=%d rc=%d catchup=%d owner=%d row=%d\n",token,position,target_rc,catch_up,
+            bool(llama_get_nextn_device_owner(s.target.get())),bool(llama_get_nextn_device_row(s.target.get(),0))); }
+    require(target_rc == 0 && catch_up, "device target/catch-up failed");
+}
+
+static llama_tokens proposals(session & s, llama_pos position) {
+    llama_tokens result, history = {3,4,5,6};
+    auto & dp = common_speculative_get_draft_params(s.spec.get(), 0);
+    dp.drafting = true; dp.n_max = 2; dp.pos0 = position; dp.id_last = 7;
+    dp.prompt = &history; dp.result = &result;
+    common_speculative_draft(s.spec.get());
+    require(result.size() == 2, "device fixture did not produce two draft tokens");
+    return result;
+}
+
+static void verify(session & s, const llama_tokens & draft, uint16_t accept) {
+    require(llama_memory_seq_rm(llama_get_memory(s.draft.get()), 0, 4, -1), "device draft trim failed");
+    common_batch input(s.target.get()); input.add(7,4,0,true);
+    input.add(draft[0],5,0,true); input.add(draft[1],6,0,true);
+    require(llama_process(s.target.get(), LLAMA_PROCESS_TYPE_DECODE, input.get()) == 0 &&
+            common_speculative_process(s.spec.get(),input), "device verification failed");
+    common_speculative_accept(s.spec.get(),0,accept);
+}
+
+int main(int argc, char ** argv) {
+    try {
+        const bool cuda = argc > 1 && std::string(argv[1]) == "--cuda";
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH), "CPU backend unavailable");
+#else
+        ggml_backend_load_all();
+#endif
+        if (cuda) {
+#ifdef GGML_TEST_CUDA_BACKEND_PATH
+            require(ggml_backend_load(GGML_TEST_CUDA_BACKEND_PATH), "CUDA backend unavailable");
+#else
+            std::puts("SKIP: CUDA backend not configured"); return 77;
+#endif
+            require(llama_nextn_cuda_device(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)), "CUDA device unavailable");
+        }
+        llama_backend_init();
+        auto model = tiny_model(cuda);
+        {
+            common_mtp_device_state malformed;
+            malformed.pending_pos = 4;
+            common_mtp_state sentinel(32); sentinel.pending[0] = 42.f;
+            require(!malformed.materialize(sentinel,32,64) && sentinel.pending[0] == 42.f,
+                    "malformed empty device state published a host replacement");
+        }
+        option(false); session host(model.get());
+        bound_model_buffers(host);
+        require(!llama_get_nextn_device_owner(host.target.get()) && !llama_get_nextn_device_owner(host.draft.get()),
+                "disabled reference unexpectedly enabled device transport");
+        option(true); session device(model.get());
+        auto owner = llama_get_nextn_device_owner(device.target.get());
+        auto draft_owner = llama_get_nextn_device_owner(device.draft.get());
+        require(bool(owner) == cuda && bool(draft_owner) == cuda, "device eligibility was silently ignored");
+        const llama_tokens a={3,4,5,6}, b={17,18,19,20};
+        for (size_t i=0;i<a.size();++i) { process_without_host_hidden(host,a[i],llama_pos(i)); process_without_host_hidden(device,a[i],llama_pos(i)); }
+        require(host.logits() == device.logits(), "device prefill changed target logits");
+        if (cuda) {
+            std::fprintf(stderr,"device target captured=%llu input=%llu host=%llu bytes=%zu current=%d; draft captured=%llu input=%llu host=%llu bytes=%zu\n",
+                    (unsigned long long)owner->captured_bytes,(unsigned long long)owner->device_input_rows,
+                    (unsigned long long)owner->materialized_bytes,owner->bytes,bool(llama_get_nextn_device_row(device.target.get(),0)),
+                    (unsigned long long)draft_owner->captured_bytes,(unsigned long long)draft_owner->device_input_rows,
+                    (unsigned long long)draft_owner->materialized_bytes,draft_owner->bytes);
+            require(owner->captured_bytes && owner->device_input_rows, "device target transfer path did not execute");
+            require(owner->materialized_bytes == 0 && draft_owner->materialized_bytes == 0 &&
+                    owner->host_input_rows == 0 && draft_owner->host_input_rows == 0,
+                    "steady MTP unexpectedly transferred hidden rows through the host");
+            require(draft_owner->bytes == 0,"catch-up without hidden outputs allocated a draft output bank");
+        }
+        const auto saved_host = host.save(), saved_device = device.save();
+        step("device initial snapshots");
+        equal(saved_host,saved_device,"device checkpoint changed target/draft/aux bytes");
+        if (cuda) { require(owner->materialized_bytes > 0,"explicit snapshot did not materialize device state"); }
+        const auto host_draft = proposals(host,4), device_draft = proposals(device,4);
+        step("device proposals");
+        require(host_draft == device_draft,"device draft proposals changed");
+        if(cuda) {
+            require(draft_owner->captured_bytes && draft_owner->device_input_rows &&
+                    draft_owner->materialized_bytes == 0 && draft_owner->host_input_rows == 0,
+                    "intermediate draft hidden rows used the host");
+        }
+        for (uint16_t accepted=0;accepted<=2;++accepted) {
+            std::fprintf(stderr,"device accepted test %u\n",unsigned(accepted));
+            require(host.restore(saved_host) && device.restore(saved_device),"device restore failed");
+            const auto hd = proposals(host,4), dd=proposals(device,4);
+            verify(host,hd,accepted); verify(device,dd,accepted);
+            equal(host.save(),device.save(),"device accepted/rejected boundary differed");
+            require(common_speculative_can_resume(device.spec.get(),0,5+accepted),"accepted boundary not reusable");
+            require(!common_speculative_can_resume(device.spec.get(),0,6+accepted),"rejected suffix exposed as carry");
+        }
+        require(host.restore(saved_host) && device.restore(saved_device),"A restore failed");
+        step("device A/B/A");
+        for (session * s : {&host,&device}) {
+            s->clear(); for(size_t i=0;i<b.size();++i) { process_without_host_hidden(*s,b[i],llama_pos(i)); }
+        }
+        require(host.restore(saved_host) && device.restore(saved_device),"A/B/A restoration failed");
+        process_without_host_hidden(host,7,4); process_without_host_hidden(device,7,4);
+        equal(host.save(),device.save(),"A/B/A device carry contaminated another conversation");
+        auto broken = saved_device; broken.spec.resize(broken.spec.size()-1);
+        step("device failed restore");
+        require(!device.restore(broken),"truncated device snapshot was accepted");
+        require(device.restore(saved_device),"device state did not recover after failure");
+        // Force the explicit bounded-allocation fallback on the next capture.
+        if (cuda) {
+            const auto real_bytes = owner->bytes;
+            owner->bytes = owner->max_bytes + 1;
+            require(!llama_nextn_device_allocate(owner,32,1),"over-budget owner counter underflowed");
+            owner->bytes = owner->max_bytes;
+            common_batch large(device.target.get());
+            for (int i=0;i<64;++i) { large.add(7+i%5,4+i,0,true); }
+            require(llama_process(device.target.get(),LLAMA_PROCESS_TYPE_DECODE,large.get()) == 0 &&
+                    common_speculative_process(device.spec.get(),large),"bounded allocation fallback failed");
+            // Subtract the artificial reservation, preserving real changes.
+            owner->bytes -= owner->max_bytes - real_bytes;
+            require(!llama_get_nextn_device_row(device.target.get(),0),"forced byte budget did not fall back");
+            require(host.restore(saved_host),"host reference reset failed");
+            common_batch reference(host.target.get());
+            for(int i=0;i<64;++i) { reference.add(7+i%5,4+i,0,true); }
+            require(llama_process(host.target.get(),LLAMA_PROCESS_TYPE_DECODE,reference.get()) == 0 &&
+                    common_speculative_process(host.spec.get(),reference),"host fallback reference failed");
+            equal(host.save(),device.save(),"device allocation fallback changed state");
+        }
+        // Exercise pool reuse without reading any hidden row back to the CPU.
+        option(false); session repeated_host(model.get());
+        option(true); session repeated_device(model.get());
+        for (int i=0;i<40;++i) {
+            process_without_host_hidden(repeated_host,3+i%9,i);
+            process_without_host_hidden(repeated_device,3+i%9,i);
+        }
+        equal(repeated_host.save(),repeated_device.save(),"device source/input reuse raced across streams");
+        // A second embedding width checks transport dispatch without matching a
+        // model name or the installed model's matrix dimensions.
+        auto other_model=tiny_model(cuda,64);
+        option(false); session other_host(other_model.get());
+        bound_model_buffers(other_host);
+        option(true); session other_device(other_model.get());
+        for(size_t i=0;i<a.size();++i) {
+            process_without_host_hidden(other_host,a[i],llama_pos(i));
+            process_without_host_hidden(other_device,a[i],llama_pos(i));
+        }
+        equal(other_host.save(),other_device.save(),"device transport changed another embedding width");
+        if(cuda) {
+            require(!llama_get_nextn_device_row(other_device.target.get(),-1) &&
+                    !llama_get_nextn_device_row(other_device.target.get(),64),"invalid row index accepted");
+            common_batch invalid(other_device.draft.get()); invalid.add(7,4,0,true);
+            std::vector<float> zero(64); invalid.set_embd_state(0,{zero.data(),1,zero.size()});
+            auto row=llama_get_nextn_device_row(other_device.target.get(),0);
+            row.index=SIZE_MAX;
+            require(llama_process_with_nextn_rows(other_device.draft.get(),LLAMA_PROCESS_TYPE_DECODE,invalid.get(),{row}) == -1,
+                    "malformed device row silently became a zero row");
+            row=llama_get_nextn_device_row(other_device.target.get(),0);
+            common_mtp_device_state guarded;
+            require(guarded.record(0,{row}) && !guarded.record(INT64_MAX,{row}) && guarded.pending_pos == 0,
+                    "out-of-range device history position overflowed or mutated old state");
+            option(false); session coalesced_host(model.get());
+            option(true); session coalesced(model.get());
+            process_without_host_hidden(coalesced,3,0);
+            process_without_host_hidden(coalesced_host,3,0);
+            auto coalesced_owner=llama_get_nextn_device_owner(coalesced.target.get());
+            const auto ranges=coalesced_owner->device_input_ranges;
+            common_batch prefix(coalesced.target.get());
+            for(int i=1;i<64;++i) { prefix.add(3+i%9,i,0,true); }
+            require(llama_process(coalesced.target.get(),LLAMA_PROCESS_TYPE_DECODE,prefix.get()) == 0 &&
+                    common_speculative_process(coalesced.spec.get(),prefix),"coalesced device prefill failed");
+            require(coalesced_owner->device_input_ranges-ranges <= 2 && coalesced_owner->device_input_rows == 63 &&
+                    coalesced_owner->materialized_bytes == 0,"contiguous device rows were not coalesced or used host copies");
+            common_batch host_prefix(coalesced_host.target.get());
+            for(int i=1;i<64;++i) { host_prefix.add(3+i%9,i,0,true); }
+            require(llama_process(coalesced_host.target.get(),LLAMA_PROCESS_TYPE_DECODE,host_prefix.get()) == 0 &&
+                    common_speculative_process(coalesced_host.spec.get(),host_prefix),"coalesced host reference failed");
+            equal(coalesced_host.save(),coalesced.save(),"coalesced ranges changed full target/draft/carry state");
+        }
+        std::puts("PASS: bounded model-independent NextN device transport, no steady hidden D2H, exact MTP proposals, snapshots, every rejection boundary, A/B/A and allocation fallback");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr,"FAIL: %s\n",error.what()); return 1; }
+}
