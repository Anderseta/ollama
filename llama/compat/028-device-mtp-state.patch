diff --git a/src/llama-nextn-device.h b/src/llama-nextn-device.h
new file mode 100644
--- /dev/null
+++ b/src/llama-nextn-device.h
@@ -0,0 +1,153 @@
+#pragma once
+
+#include "ggml-cpp.h"
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <vector>
+
+// Own the transport backend as well as its buffers: a saved row cannot borrow
+// a stream or graph allocation that a context reset/unload may destroy.
+struct llama_nextn_device_owner {
+    ggml_backend_ptr backend;
+    size_t bytes = 0;
+    static constexpr size_t max_bytes = 32u*1024u*1024u;
+    uint64_t captured_bytes = 0;
+    uint64_t device_input_rows = 0;
+    uint64_t host_input_rows = 0;
+    uint64_t materialized_bytes = 0;
+    uint64_t device_input_ranges = 0;
+};
+
+struct llama_nextn_device_rows {
+    std::shared_ptr<llama_nextn_device_owner> owner;
+    ggml_context_ptr ctx;
+    ggml_backend_buffer_ptr buffer;
+    ggml_backend_event_ptr reuse_event;
+    ggml_backend_event_ptr input_event;
+    ggml_tensor * tensor = nullptr;
+    size_t bytes = 0;
+
+    ~llama_nextn_device_rows() {
+        if (owner && owner->backend) {
+            // Copies are submitted on the source stream. A last reference can
+            // be released immediately after a draft submission, so drain that
+            // stream before releasing/reusing its source allocation.
+            ggml_backend_synchronize(owner->backend.get());
+        }
+        if (owner) { owner->bytes -= bytes; }
+    }
+};
+
+struct llama_nextn_device_row {
+    std::shared_ptr<llama_nextn_device_rows> rows;
+    size_t index = 0;
+
+    explicit operator bool() const {
+        return rows && rows->tensor && rows->buffer && rows->owner && rows->owner->backend &&
+            rows->tensor->type == GGML_TYPE_F32 && rows->tensor->ne[0] > 0 &&
+            rows->tensor->ne[1] > 0 && index < size_t(rows->tensor->ne[1]);
+    }
+};
+
+inline bool llama_nextn_cuda_device(ggml_backend_dev_t device) {
+    if (!device || ggml_backend_dev_type(device) != GGML_BACKEND_DEVICE_TYPE_GPU) { return false; }
+    const auto reg = ggml_backend_dev_backend_reg(device);
+    return reg && std::strcmp(ggml_backend_reg_name(reg), "CUDA") == 0;
+}
+
+inline std::shared_ptr<llama_nextn_device_rows> llama_nextn_device_allocate(
+        const std::shared_ptr<llama_nextn_device_owner> & owner, size_t width, size_t count) {
+    if (!owner || !owner->backend || !width || !count || owner->bytes > owner->max_bytes ||
+        count > SIZE_MAX/sizeof(float)/width) { return {}; }
+    const size_t bytes = width*count*sizeof(float);
+    if (bytes > owner->max_bytes || bytes > owner->max_bytes - owner->bytes) { return {}; }
+    auto result = std::make_shared<llama_nextn_device_rows>();
+    result->owner = owner;
+    result->ctx.reset(ggml_init({ggml_tensor_overhead(), nullptr, true}));
+    if (!result->ctx) { return {}; }
+    result->tensor = ggml_new_tensor_2d(result->ctx.get(), GGML_TYPE_F32, int64_t(width), int64_t(count));
+    result->buffer.reset(ggml_backend_alloc_ctx_tensors(result->ctx.get(), owner->backend.get()));
+    if (!result->buffer || ggml_backend_buffer_is_host(result->buffer.get())) { return {}; }
+    const auto device = ggml_backend_get_device(owner->backend.get());
+    result->reuse_event.reset(ggml_backend_event_new(device));
+    result->input_event.reset(ggml_backend_event_new(device));
+    if (!result->reuse_event || !result->input_event) { return {}; }
+    const size_t allocation = ggml_backend_buffer_get_size(result->buffer.get());
+    if (allocation > owner->max_bytes - owner->bytes) { return {}; }
+    result->bytes = allocation;
+    owner->bytes += allocation;
+    return result;
+}
+
+// Stack descriptors only; the copy API consumes the descriptors synchronously
+// and queues the data transfer with backend event ordering.
+inline ggml_tensor llama_nextn_device_view(const ggml_tensor * tensor, size_t first, size_t count) {
+    ggml_tensor view = *tensor;
+    view.ne[1] = int64_t(count);
+    view.ne[2] = view.ne[3] = 1;
+    view.nb[2] = view.nb[1]*count;
+    view.nb[3] = view.nb[2];
+    view.data = static_cast<char *>(tensor->data) + first*tensor->nb[1];
+    view.view_src = nullptr;
+    view.view_offs = 0;
+    return view;
+}
+
+inline bool llama_nextn_device_copy(
+        ggml_backend_t source_backend, const ggml_tensor * source, size_t source_first,
+        const std::shared_ptr<llama_nextn_device_rows> & destination, size_t destination_first, size_t count) {
+    if (!source_backend || !source || !destination || !destination->tensor || !count ||
+        source->type != GGML_TYPE_F32 || !ggml_is_contiguous(source) || source->ne[0] != destination->tensor->ne[0] ||
+        source_first > size_t(source->ne[1]) || count > size_t(source->ne[1]) - source_first ||
+        destination_first > size_t(destination->tensor->ne[1]) || count > size_t(destination->tensor->ne[1]) - destination_first ||
+        ggml_backend_get_device(source_backend) != ggml_backend_get_device(destination->owner->backend.get()) ||
+        ggml_backend_buffer_is_host(source->buffer)) { return false; }
+    auto src = llama_nextn_device_view(source, source_first, count);
+    auto dst = llama_nextn_device_view(destination->tensor, destination_first, count);
+    // A released input reference can leave an asynchronous source read in
+    // flight. Protect pool reuse on-device without a host synchronization.
+    ggml_backend_event_record(destination->reuse_event.get(), destination->owner->backend.get());
+    ggml_backend_event_wait(source_backend, destination->reuse_event.get());
+    ggml_backend_tensor_copy_async(source_backend, destination->owner->backend.get(), &src, &dst);
+    destination->owner->captured_bytes += count*source->nb[1];
+    return true;
+}
+
+inline bool llama_nextn_device_read(const llama_nextn_device_row & row, float * destination, size_t count = 1) {
+    if (!row || !destination || !count || count > size_t(row.rows->tensor->ne[1]) - row.index) { return false; }
+    ggml_backend_synchronize(row.rows->owner->backend.get());
+    ggml_backend_tensor_get(row.rows->tensor, destination, row.index*row.rows->tensor->nb[1], count*row.rows->tensor->nb[1]);
+    row.rows->owner->materialized_bytes += count*row.rows->tensor->nb[1];
+    return true;
+}
+
+inline bool llama_nextn_device_input(const llama_nextn_device_row & row, ggml_backend_t destination_backend,
+        ggml_tensor * destination, size_t destination_index, size_t count = 1) {
+    if (!row || !destination_backend || !destination || destination->type != GGML_TYPE_F32 ||
+        destination->ne[0] != row.rows->tensor->ne[0] || destination_index >= size_t(destination->ne[1]) ||
+        !count || count > size_t(row.rows->tensor->ne[1]) - row.index ||
+        count > size_t(destination->ne[1]) - destination_index || !ggml_is_contiguous(destination)) { return false; }
+    auto src = llama_nextn_device_view(row.rows->tensor, row.index, count);
+    auto dst = llama_nextn_device_view(destination, destination_index, count);
+    const auto device = ggml_backend_get_device(destination_backend);
+    if (device == ggml_backend_get_device(row.rows->owner->backend.get()) &&
+        !ggml_backend_buffer_is_host(destination->buffer)) {
+        // The destination graph may still be reading its previous input.
+        ggml_backend_event_record(row.rows->input_event.get(), destination_backend);
+        ggml_backend_event_wait(row.rows->owner->backend.get(), row.rows->input_event.get());
+        ggml_backend_tensor_copy_async(row.rows->owner->backend.get(), destination_backend, &src, &dst);
+        row.rows->owner->device_input_rows += count;
+        ++row.rows->owner->device_input_ranges;
+        return true;
+    }
+    // An unsupported placement keeps the original computation through a real
+    // host transfer. No zero-copy claim is made for this explicit fallback.
+    std::vector<float> host(size_t(src.ne[0])*count);
+    if (!llama_nextn_device_read(row, host.data(), count)) { return false; }
+    ggml_backend_tensor_set(destination, host.data(), destination_index*destination->nb[1], count*destination->nb[1]);
+    row.rows->owner->host_input_rows += count;
+    return true;
+}
