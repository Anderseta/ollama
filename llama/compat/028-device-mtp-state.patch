+ggml_backend_t llama_context::nextn_input_backend() const {
+    ggml_backend_dev_t device = nextn_device_enabled && nextn_device_owner
+        ? ggml_backend_get_device(nextn_device_owner->backend.get()) : nullptr;
+    if (!device) {
+        for (const auto & row : nextn_device_inputs) {
+            if (row) { device = ggml_backend_get_device(row.rows->owner->backend.get()); break; }
+        }
+    }
+    if (device && llama_nextn_cuda_device(device)) {
+        for (const auto & backend : backends) {
+            if (ggml_backend_get_device(backend.get()) == device) { return backend.get(); }
+        }
+    }
+    return nullptr;
+}
+
+void llama_context::place_nextn_input(llm_graph_result * result, ggml_backend_sched_t scheduler, ggml_backend_t backend) const {
+    if (!result || !scheduler || !backend) { return; }
+    // Graph inputs normally start in CPU staging even for a fully offloaded
+    // model. All graph arenas must use the same explicit placement, and include
+    // this backend in their reuse eligibility/identity.
+    for (const auto & input : result->inputs) {
+        auto * hidden = dynamic_cast<llm_graph_input_embd_h *>(input.get());
+        if (hidden && hidden->h) { ggml_backend_sched_set_tensor_backend(scheduler, hidden->h, backend); }
+    }
+}
+
+bool llama_context::set_nextn_device(bool enable) {
+    if (!enable) {
+        synchronize();
+        output_reorder();
+        materialize_nextn_device();
+        nextn_device_enabled = false;
+        nextn_device_active = -1;
+        nextn_device_pool.clear();
+        nextn_device_row_ids.clear();
+        return true;
+    }
+    if (model.devices.size() != 1 || !llama_nextn_cuda_device(model.devices[0].dev) ||
+        !cparams.embeddings_nextn || cparams.pipeline_parallel || cparams.pooling_type != LLAMA_POOLING_TYPE_NONE) { return false; }
+    if (!nextn_device_owner) {
+        try {
+            auto owner = std::make_shared<llama_nextn_device_owner>();
+            owner->backend.reset(ggml_backend_dev_init(model.devices[0].dev, nullptr));
+            if (!owner->backend) { return false; }
+            nextn_device_owner = std::move(owner);
+        } catch (const std::bad_alloc &) { return false; }
+    }
+    nextn_device_enabled = true;
+    return true;
+}
+
+bool llama_context::prepare_nextn_device(size_t rows) {
+    if (!nextn_device_owner || !rows) { return false; }
+    const size_t width = model.hparams.n_embd_out();
+    if (!width || rows > llama_nextn_device_owner::max_bytes/sizeof(float)/width) { return false; }
+    for (size_t i = 0; i < nextn_device_pool.size(); ++i) {
+        auto & bank = nextn_device_pool[i];
+        if (bank.use_count() == 1 && bank->tensor->ne[0] == int64_t(width) && size_t(bank->tensor->ne[1]) >= rows) {
+            nextn_device_active = int(i);
+            return true;
+        }
+    }
+    // Reclaim unused shapes before allocating. Referenced history rows remain
+    // immutable; at most three live generation banks are retained by this pool.
+    nextn_device_pool.erase(std::remove_if(nextn_device_pool.begin(), nextn_device_pool.end(),
+            [](const auto & bank) { return bank.use_count() == 1; }), nextn_device_pool.end());
+    if (nextn_device_pool.size() >= 3) { return false; }
+    try {
+        auto bank = llama_nextn_device_allocate(nextn_device_owner, width, rows);
+        if (!bank) { return false; }
+        nextn_device_pool.push_back(std::move(bank));
+        nextn_device_active = int(nextn_device_pool.size()) - 1;
+        return true;
+    } catch (const std::bad_alloc &) { return false; }
+}
+
+bool llama_context::capture_nextn_device(ggml_backend_t backend, const ggml_tensor * tensor,
+        size_t offset, size_t rows, const llama_ubatch & ubatch) {
+    if (nextn_device_active < 0 || !ubatch.data || ubatch.data->batch_idxs.size() != ubatch.n_tokens) { return false; }
+    auto & bank = nextn_device_pool[size_t(nextn_device_active)];
+    if (!llama_nextn_device_copy(backend, tensor, 0, bank, offset, rows)) { return false; }
+    size_t ordinal = 0;
+    for (size_t i = 0; i < ubatch.n_tokens; ++i) {
+        if (cparams.embeddings_nextn_masked && !ubatch.output[i]) { continue; }
+        const int32_t raw = ubatch.data->batch_idxs[i];
+        if (raw < 0 || size_t(raw) >= nextn_device_row_ids.size() || ordinal >= rows) { return false; }
+        nextn_device_row_ids[size_t(raw)] = int32_t(offset + ordinal++);
+    }
+    return ordinal == rows;
+}
+
+llama_nextn_device_row llama_context::get_nextn_device_row(int32_t raw_index) const {
+    if (!nextn_device_enabled || nextn_device_active < 0 || raw_index < 0 || size_t(raw_index) >= nextn_device_row_ids.size()) { return {}; }
+    const auto index = nextn_device_row_ids[size_t(raw_index)];
+    return index < 0 ? llama_nextn_device_row{} : llama_nextn_device_row{nextn_device_pool[size_t(nextn_device_active)], size_t(index)};
+}
+
+void llama_context::materialize_nextn_device(bool logical_order) {
+    if (!nextn_device_host_stale || nextn_device_active < 0) { return; }
+    const auto & bank = nextn_device_pool[size_t(nextn_device_active)];
+    const size_t width = model.hparams.n_embd_out();
+    std::vector<float> host(size_t(bank->tensor->ne[1])*width);
+    if (!llama_nextn_device_read({bank, 0}, host.data(), size_t(bank->tensor->ne[1]))) {
+        throw std::runtime_error("cannot materialize device NextN output");
+    }
+    if (!logical_order) {
+        size_t captured = 0;
+        for (auto index : nextn_device_row_ids) { if (index >= 0) { captured = std::max(captured, size_t(index) + 1); } }
+        if (captured*width > embd_nextn.size) { throw std::runtime_error("partial device NextN host output overflow"); }
+        std::memcpy(embd_nextn.data, host.data(), captured*width*sizeof(float));
+        nextn_device_host_stale = false;
+        return;
+    }
+    for (size_t raw = 0; raw < nextn_device_row_ids.size(); ++raw) {
+        const int32_t source = nextn_device_row_ids[raw];
+        if (source < 0) { continue; }
+        const size_t destination = cparams.embeddings_nextn_masked ? size_t(output_resolve_row(int32_t(raw))) : raw;
+        if ((destination + 1)*width > embd_nextn.size) { throw std::runtime_error("device NextN host output overflow"); }
+        std::memcpy(embd_nextn.data + destination*width, host.data() + size_t(source)*width, width*sizeof(float));
+    }
+    nextn_device_host_stale = false;
+}
+
+int llama_context::decode_nextn_rows(const llama_batch_ext & batch, const std::vector<llama_nextn_device_row> & rows) {
+    if (!nextn_device_inputs.empty() || rows.size() != batch.tokens.size()) { return -1; }
+    for (const auto & row : rows) {
+        if (row.rows && (!row || size_t(row.rows->tensor->ne[0]) != batch.n_embd_state)) { return -1; }
+    }
+    nextn_device_inputs = rows;
+    struct cleanup { std::vector<llama_nextn_device_row> & rows; ~cleanup() { rows.clear(); } } clear{nextn_device_inputs};
+    return decode(batch);
+}
+
+bool llama_set_nextn_device(llama_context * ctx, bool enable) { return ctx && ctx->set_nextn_device(enable); }
+std::shared_ptr<llama_nextn_device_owner> llama_get_nextn_device_owner(llama_context * ctx) { return ctx ? ctx->get_nextn_device_owner() : nullptr; }
+llama_nextn_device_row llama_get_nextn_device_row(llama_context * ctx, int32_t raw_index) { return ctx ? ctx->get_nextn_device_row(raw_index) : llama_nextn_device_row{}; }
+int32_t llama_process_with_nextn_rows(llama_context * ctx, enum llama_process_type type,
+        const llama_batch_ext * batch, const std::vector<llama_nextn_device_row> & rows) {
+    return ctx && batch && type == LLAMA_PROCESS_TYPE_DECODE ? ctx->decode_nextn_rows(*batch, rows) : -1;
+}
+
 void llama_set_embeddings_nextn(llama_context * ctx, bool value, bool masked) {
     ctx->set_embeddings_nextn(value, masked);
 }
