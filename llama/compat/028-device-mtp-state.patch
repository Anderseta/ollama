diff --git a/common/mtp-device-state.h b/common/mtp-device-state.h
new file mode 100644
--- /dev/null
+++ b/common/mtp-device-state.h
@@ -0,0 +1,102 @@
+#pragma once
+
+#include "mtp-state.h"
+#include "../src/llama-nextn-device.h"
+
+// Positional provenance and rejection boundaries match common_mtp_state. Float
+// rows stay in immutable owned device buffers until an explicit snapshot asks
+// for host bytes. A rejected suffix is never addressable through at().
+struct common_mtp_device_state {
+    int64_t pending_pos = -1;
+    int64_t boundary_pos = -1;
+    llama_nextn_device_row pending;
+    llama_nextn_device_row boundary;
+    std::vector<llama_nextn_device_row> verify;
+    std::vector<int64_t> positions;
+
+    void clear() { pending_pos = boundary_pos = -1; pending = {}; boundary = {}; verify.clear(); positions.clear(); }
+
+    llama_nextn_device_row at(int64_t position) const {
+        if (position < 0 || position > pending_pos) { return {}; }
+        if (position == pending_pos) { return pending; }
+        auto it = std::lower_bound(positions.begin(), positions.end(), position);
+        if (it != positions.end() && *it == position) { return verify[size_t(it - positions.begin())]; }
+        return boundary_pos == position ? boundary : llama_nextn_device_row{};
+    }
+
+    bool can_resume(int64_t next) const { return next == 0 || (next > 0 && bool(at(next - 1))); }
+
+    bool record(int64_t first, const std::vector<llama_nextn_device_row> & rows) {
+        if (first < 0 || first > INT32_MAX || rows.empty() || rows.size() > uint64_t(INT32_MAX) - uint64_t(first) + 1 ||
+            std::any_of(rows.begin(), rows.end(), [](const auto & r) { return !r; })) { return false; }
+        auto predecessor = first ? at(first - 1) : llama_nextn_device_row{};
+        if (first && !predecessor) { return false; }
+        // All allocations precede publication, so a failed optional allocation
+        // retains the old state and the original cache-restore contract.
+        verify.reserve(rows.size());
+        positions.reserve(rows.size());
+        verify.assign(rows.begin(), rows.end());
+        positions.resize(rows.size());
+        for (size_t i = 0; i < rows.size(); ++i) { positions[i] = first + int64_t(i); }
+        boundary = std::move(predecessor);
+        boundary_pos = first - 1;
+        pending = verify.back();
+        pending_pos = positions.back();
+        return true;
+    }
+
+    bool accept(size_t row) {
+        if (row >= verify.size()) { return false; }
+        pending = verify[row]; pending_pos = positions[row];
+        verify.resize(row + 1); positions.resize(row + 1);
+        return true;
+    }
+
+    bool materialize(common_mtp_state & host, uint32_t width, size_t max_rows) const {
+        if (!width || positions.size() > max_rows || positions.size() != verify.size() || positions.size() > SIZE_MAX/width) { return false; }
+        common_mtp_state next(width);
+        if (positions.empty()) {
+            if (pending_pos != -1 || boundary_pos != -1 || pending.rows || boundary.rows) { return false; }
+            host = std::move(next);
+            return true;
+        }
+        const auto valid_width = [width](const auto & row) { return row && row.rows->tensor->ne[0] == int64_t(width); };
+        if (!valid_width(pending) || (boundary_pos >= 0 && !valid_width(boundary)) ||
+            std::any_of(verify.begin(), verify.end(), [&](const auto & row) { return !valid_width(row); })) { return false; }
+        next.pending_pos = pending_pos; next.boundary_pos = boundary_pos;
+        next.positions = positions;
+        next.verify.resize(verify.size()*size_t(width));
+        if (boundary && !llama_nextn_device_read(boundary, next.boundary.data())) { return false; }
+        for (size_t i = 0; i < verify.size();) {
+            size_t count = 1;
+            while (i + count < verify.size() && verify[i + count].rows == verify[i].rows &&
+                   verify[i + count].index == verify[i].index + count) { ++count; }
+            if (!llama_nextn_device_read(verify[i], next.verify.data() + i*width, count)) { return false; }
+            i += count;
+        }
+        std::copy_n(next.verify.data() + (verify.size() - 1)*width, width, next.pending.begin());
+        if (!next.valid(width, max_rows)) { return false; }
+        host = std::move(next);
+        return true;
+    }
+
+    bool upload(const common_mtp_state & host, const std::shared_ptr<llama_nextn_device_owner> & owner, size_t max_rows) {
+        if (!host.valid(host.width, max_rows)) { return false; }
+        if (host.positions.empty()) { clear(); return true; }
+        auto storage = llama_nextn_device_allocate(owner, host.width, host.positions.size() + 2);
+        if (!storage) { return false; }
+        const size_t stride = host.width*sizeof(float);
+        ggml_backend_tensor_set(storage->tensor, host.pending.data(), 0, stride);
+        ggml_backend_tensor_set(storage->tensor, host.boundary.data(), stride, stride);
+        ggml_backend_tensor_set(storage->tensor, host.verify.data(), 2*stride, host.verify.size()*sizeof(float));
+        common_mtp_device_state next;
+        next.pending_pos = host.pending_pos; next.boundary_pos = host.boundary_pos;
+        next.pending = {storage, 0};
+        next.boundary = {storage, 1};
+        next.positions = host.positions;
+        next.verify.reserve(host.positions.size());
+        for (size_t i = 0; i < host.positions.size(); ++i) { next.verify.push_back({storage, i + 2}); }
+        *this = std::move(next);
+        return true;
+    }
+};
