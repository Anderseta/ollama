@@ -0,0 +1,103 @@
+#include "../src/llama-model-ram.h"
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <future>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        if (argc < 2 || argc > 3 || (argc == 3 && std::string(argv[2]) != "--gpu")) {
+            throw std::runtime_error("usage: test-moe-ram-metrics DIRECTORY [--gpu]");
+        }
+        const bool gpu = argc == 3;
+        ggml_backend_load_all();
+        ggml_backend_ptr backend(ggml_backend_init_by_type(gpu ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+        if (gpu && !backend) { fprintf(stderr, "SKIP: no available GPU device\n"); return 77; }
+        require(backend != nullptr, "test backend unavailable");
+        constexpr size_t size = 8*1024*1024;
+        struct fixture {
+            std::filesystem::path path;
+            ~fixture() { std::error_code error; std::filesystem::remove(path, error); }
+        } file { std::filesystem::path(argv[1]) / ("moe-ram-metrics-" + std::to_string(std::random_device{}()) + ".bin") };
+        std::vector<uint8_t> raw(size + 31);
+        for (size_t i = 0; i < raw.size(); ++i) { raw[i] = uint8_t(i*37 + i/251); }
+        {
+            std::ofstream stream(file.path, std::ios::binary);
+            stream.write((const char *) raw.data(), raw.size());
+            require(stream.good(), "cannot write metrics fixture");
+        }
+        llama_files files;
+        files.emplace_back(new llama_file(file.path.string().c_str(), "rb"));
+        ggml_context_ptr ctx_src(ggml_init({ 4*ggml_tensor_overhead(), nullptr, true }));
+        ggml_context_ptr ctx_dst(ggml_init({ 4*ggml_tensor_overhead(), nullptr, true }));
+        require(ctx_src && ctx_dst, "cannot create test contexts");
+        auto * src = ggml_new_tensor_1d(ctx_src.get(), GGML_TYPE_I8, size);
+        auto * dst = ggml_new_tensor_1d(ctx_dst.get(), GGML_TYPE_I8, size);
+        ggml_backend_buffer_ptr destination(ggml_backend_alloc_ctx_tensors(ctx_dst.get(), backend.get()));
+        require(destination != nullptr, "cannot allocate test destination");
+        llama_model_ram_cache cache(size, files);
+        cache.bind(src, 0, 31);
+        std::vector<uint8_t> result(size);
+        {
+            auto guard = cache.acquire();
+            require(cache.copy_batch(backend.get(), { { src, dst, 0, 0, size } }), "initial batch failed");
+            auto off = cache.stats(guard);
+            require(off.peak <= off.limit && off.resident == size && off.bytes_read > 0, "cache accounting failed");
+            require(!off.timings_enabled && off.io_submit_us == 0 && off.io_wait_us == 0 &&
+                    off.commit_us == 0 && off.host_copy_us == 0 && off.h2d_us == 0, "disabled diagnostics recorded timings");
+            require(off.h2d_bytes == (gpu ? size : 0), "H2D counters include CPU copies or miss GPU bytes");
+            ggml_backend_dev_props props = {};
+            ggml_backend_dev_get_props(ggml_backend_get_device(backend.get()), &props);
+            if (gpu && off.upload_buffer_bytes > 0 && props.caps.events) {
+                require(off.upload_buffer_bytes == 4*1024*1024 && off.h2d_slot_waits >= 2,
+                        "double staging did not reuse bounded event slots");
+            }
+        }
+        ggml_backend_tensor_get(dst, result.data(), 0, size);
+        require(!memcmp(result.data(), raw.data() + 31, size), "staging slots corrupted initial transfer");
+        cache.set_diagnostics(true);
+        const auto before = cache.stats();
+        {
+            auto guard = cache.acquire();
+            for (int i = 0; i < 3; ++i) {
+                require(cache.copy_batch(backend.get(), { { src, dst, 0, 0, size } }), "warm batch failed");
+            }
+            cache.read(src, 0, result.data(), size);
+            const auto after = cache.stats(guard);
+            const auto delta = llama_model_ram_stats_delta(before, after);
+            require(delta.bytes_read == 0 && delta.read_calls == 0 && delta.hits > 0, "warm transfer reread SSD data");
+            require(delta.timings_enabled && delta.host_copy_us > 0 && delta.peak == after.peak && delta.resident == after.resident,
+                    "delta lost timing or gauge semantics");
+            require(delta.h2d_bytes == (gpu ? 3*size : 0), "H2D delta bytes are wrong");
+            if (gpu) { require(delta.h2d_us > 0 && delta.h2d_sync_calls > 0, "H2D diagnostics missing"); }
+        }
+        require(!memcmp(result.data(), raw.data() + 31, size), "host read after staging differs");
+        ggml_backend_tensor_get(dst, result.data(), 0, size);
+        require(!memcmp(result.data(), raw.data() + 31, size), "reused staging slots corrupted GPU bytes");
+        const auto after = cache.stats();
+        const auto backwards = llama_model_ram_stats_delta(after, before);
+        require(backwards.h2d_bytes == 0 && backwards.hits == 0, "counter delta underflowed");
+        // A competing snapshot waits for acquire(), then sees a complete state.
+        auto guard = cache.acquire();
+        auto concurrent = std::async(std::launch::async, [&] { return cache.stats(); });
+        guard.unlock();
+        require(concurrent.get().resident == size, "concurrent snapshot saw partial cache state");
+        printf("PASS RAM diagnostics, deltas, bounded staging, exact bytes and concurrent snapshots (%s)\n", gpu ? "GPU" : "CPU");
+        return 0;
+    } catch (const std::exception & error) {
+        fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+}
