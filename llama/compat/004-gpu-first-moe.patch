+    auto * context = static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(context->device);
+    if (enabled && !context->execution_timing) {
+        try {
+            auto timing = std::make_unique<ggml_cuda_execution_timing>();
+            if (!timing->initialize()) { return false; }
