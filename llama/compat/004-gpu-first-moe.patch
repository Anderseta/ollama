+            auto & policy = state.devices[physical_device];
+            policy.pending -= size;
+            policy.used += size;
+            policy.peak = std::max(policy.peak, policy.used);
+        }
+        committed = true;
+        return true;
+    }
+
+    void cancel() {
+        if (!valid || committed) { return; }
+        auto & policy = state.devices[physical_device];
+        if (tracked) {
+            std::lock_guard<std::mutex> lock(state.mutex);
+            policy.pending -= size;
+        } else {
+            policy.untracked_allocations.fetch_sub(1, std::memory_order_relaxed);
+        }
+        valid = false;
+    }
+
+    ~ggml_cuda_memory_reservation() { cancel(); }
+};
