+#include "ggml-cpp.h"
+#include "ggml-cuda.h"
+
+#include <cstdio>
+#include <future>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+int main() {
+    try {
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || ggml_backend_reg_dev_count(registry) == 0) {
+            fprintf(stderr, "SKIP: no available CUDA device\n");
+            return 77;
+        }
+        auto * device = ggml_backend_reg_dev_get(registry, 0);
+        auto set_limit = reinterpret_cast<decltype(&ggml_backend_cuda_set_memory_limit)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_set_memory_limit"));
+        auto get_stats = reinterpret_cast<decltype(&ggml_backend_cuda_get_memory_stats)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_memory_stats"));
+        auto set_timing = reinterpret_cast<decltype(&ggml_backend_cuda_set_execution_diagnostics)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_set_execution_diagnostics"));
+        auto get_timing = reinterpret_cast<decltype(&ggml_backend_cuda_get_execution_stats)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_execution_stats"));
+        require(set_limit && get_stats, "CUDA memory policy API unavailable");
+        require(set_timing && get_timing, "CUDA execution timing API unavailable");
+        auto stats = [&] {
+            ggml_backend_cuda_memory_stats result = {};
+            require(get_stats(device, &result), "cannot read CUDA memory stats");
+            return result;
+        };
+        auto * buft = ggml_backend_dev_buffer_type(device);
+        constexpr size_t mib = 1024*1024;
+        require(set_limit(device, 2*mib, true), "cannot enable test allocation quota");
+        struct owner {
+            decltype(set_limit) release;
+            ggml_backend_dev_t device;
+            ~owner() { release(device, 0, false); }
+        } policy { set_limit, device };
+        require(stats().enabled && stats().limit_bytes == 2*mib && stats().driver_headroom_bytes > 0,
+                "allocation policy stats differ from requested limit");
+        require(set_limit(device, 2*mib, true), "second compatible policy owner failed");
+        require(!set_limit(device, 3*mib, true), "incompatible policy owners were accepted");
+        require(set_limit(device, 0, false) && stats().enabled, "one owner disabled another owner's policy");
+        ggml_backend_buffer_ptr first(ggml_backend_buft_alloc_buffer(buft, mib));
+        ggml_backend_buffer_ptr second(ggml_backend_buft_alloc_buffer(buft, mib));
+        require(first && second, "cannot allocate buffers within quota");
+        const auto full = stats();
+        require(full.managed_used_bytes == 2*mib && full.managed_peak_bytes >= full.managed_used_bytes,
+                "successful allocations are not charged exactly");
+        ggml_backend_buffer_ptr denied(ggml_backend_buft_alloc_buffer(buft, 1));
+        require(!denied && stats().managed_used_bytes == 2*mib && stats().denied_allocations > full.denied_allocations,
+                "quota failed to reject allocation before exceeding limit");
+        require(set_limit(device, 0, false) && !stats().enabled, "final owner release kept enforcement enabled");
+        first.reset();
+        require(stats().managed_used_bytes == mib, "free after policy release lost accounting");
+        ggml_backend_buffer_ptr legacy(ggml_backend_buft_alloc_buffer(buft, mib));
+        require(legacy != nullptr, "legacy allocation failed after disabling policy");
+        require(!set_limit(device, 2*mib, true), "enabling omitted a live untracked allocation");
+        legacy.reset();
+        require(set_limit(device, 2*mib, true), "cannot re-enable after untracked allocation is freed");
+        second.reset();
+        require(stats().managed_used_bytes == 0, "free did not return live managed bytes to zero");
+
+        // Buffers survive in futures until every concurrent attempt has finished.
+        // At most two 1 MiB allocations can be live under the shared 2 MiB quota.
+        std::vector<std::future<ggml_backend_buffer_t>> futures;
+        for (int i = 0; i < 8; ++i) {
+            futures.emplace_back(std::async(std::launch::async, [&] { return ggml_backend_buft_alloc_buffer(buft, mib); }));
+        }
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        for (auto & future : futures) { buffers.emplace_back(future.get()); }
+        size_t allocated = 0;
+        for (const auto & buffer : buffers) { allocated += buffer != nullptr; }
+        require(allocated == 2 && stats().managed_used_bytes == allocated*mib,
+                "concurrent reservations oversubscribed or lost quota");
+        buffers.clear();
+        require(stats().managed_used_bytes == 0, "concurrent buffer cleanup leaked accounting");
+        require(set_limit(device, 0, false), "cannot release limited policy");
+        require(set_limit(device, 0, true), "strict policy without explicit cap was rejected");
+        ggml_backend_buffer_ptr no_cap(ggml_backend_buft_alloc_buffer(buft, 65536));
+        require(no_cap && stats().enabled && stats().limit_bytes == 0 && stats().managed_used_bytes == 65536,
+                "zero quota did not retain strict allocation tracking");
+        no_cap.reset();
+        require(stats().managed_used_bytes == 0, "strict allocation cleanup leaked accounting");
+        {
+            // A real matrix multiply also creates backend-owned compute-pool /
+            // cuBLAS allocations. They remain charged after graph tensors free,
+            // and must disappear only when the backend actually releases them.
+            ggml_backend_ptr backend(ggml_backend_dev_init(device, nullptr));
+            require(backend != nullptr, "cannot initialize CUDA compute test backend");
+            ggml_backend_cuda_execution_stats timing = {};
+            require(get_timing(backend.get(), &timing) && !timing.enabled && timing.samples == 0 && timing.pending == 0 &&
+                    timing.cuda_execution_stream_ms == 0, "disabled CUDA diagnostics created timing samples");
+            require(set_timing(backend.get(), true), "cannot enable optional CUDA execution timing");
+            ggml_context_ptr context(ggml_init({ 16*ggml_tensor_overhead() + ggml_graph_overhead_custom(16, false), nullptr, true }));
+            require(context != nullptr, "cannot create CUDA compute test context");
+            auto * a = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 256, 256);
+            auto * b = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 256, 256);
+            auto * out = ggml_mul_mat(context.get(), a, b);
+            ggml_backend_buffer_ptr tensors(ggml_backend_alloc_ctx_tensors(context.get(), backend.get()));
+            require(tensors != nullptr, "cannot allocate CUDA compute tensors");
+            const size_t tensor_bytes = stats().managed_used_bytes;
+            std::vector<float> values(256*256, 1.0f);
+            ggml_backend_tensor_set(a, values.data(), 0, values.size()*sizeof(float));
+            ggml_backend_tensor_set(b, values.data(), 0, values.size()*sizeof(float));
+            auto * graph = ggml_new_graph_custom(context.get(), 16, false);
+            ggml_build_forward_expand(graph, out);
+            // Direct execution, CUDA graph capture and graph replay all pass
+            // through the timing boundary, with event handles outside capture.
+            for (int i = 0; i < 3; ++i) {
+                require(ggml_backend_graph_compute(backend.get(), graph) == GGML_STATUS_SUCCESS, "CUDA compute failed under tracked policy");
+            }
+            require(get_timing(backend.get(), &timing) && timing.enabled && timing.samples == 3 && timing.pending == 0 &&
+                    timing.dropped == 0 && timing.cuda_execution_stream_ms > 0, "CUDA stream timing samples are missing or incomplete");
+            const auto measured = timing;
+            require(set_timing(backend.get(), false), "cannot disable CUDA timing");
+            require(ggml_backend_graph_compute(backend.get(), graph) == GGML_STATUS_SUCCESS, "CUDA compute failed after disabling timing");
+            require(get_timing(backend.get(), &timing) && !timing.enabled && timing.samples == measured.samples &&
+                    timing.cuda_execution_stream_ms == measured.cuda_execution_stream_ms, "disabled timing continued to record measurements");
+            ggml_backend_tensor_get(out, values.data(), 0, values.size()*sizeof(float));
+            for (float value : values) { require(value == 256.0f, "CUDA compute output differs under allocation policy"); }
+            require(stats().managed_used_bytes > tensor_bytes, "CUDA pool/workspace allocation escaped accounting");
+            tensors.reset();
+            require(stats().managed_used_bytes > 0, "retained CUDA pool/workspace bytes were released too early");
+            backend.reset();
+            require(stats().managed_used_bytes == 0, "CUDA VMM pool/workspace cleanup leaked accounting");
+        }
+        {
+            // A F16 second operand forces the cuBLAS path. Because the operands
+            // have different types, at least one conversion uses ctx.pool() for
+            // any selected compute type. On a VMM-capable CUDA device this
+            // exercises physical VMM allocation/unmap, rather than workspace only.
+            ggml_backend_ptr backend(ggml_backend_dev_init(device, nullptr));
+            require(backend != nullptr, "cannot initialize forced-pool backend");
+            ggml_context_ptr context(ggml_init({ 16*ggml_tensor_overhead() + ggml_graph_overhead_custom(16, false), nullptr, true }));
+            require(context != nullptr, "cannot create forced-pool context");
+            auto * a = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, 256, 256);
+            auto * b = ggml_new_tensor_2d(context.get(), GGML_TYPE_F16, 256, 256);
+            auto * out = ggml_mul_mat(context.get(), a, b);
+            ggml_backend_buffer_ptr tensors(ggml_backend_alloc_ctx_tensors(context.get(), backend.get()));
+            require(tensors != nullptr, "cannot allocate forced-pool tensors");
+            const size_t tensor_bytes = stats().managed_used_bytes;
+            std::vector<float> values(256*256, 1.0f);
+            std::vector<ggml_fp16_t> halves(256*256, ggml_fp32_to_fp16(1.0f));
+            ggml_backend_tensor_set(a, values.data(), 0, values.size()*sizeof(float));
+            ggml_backend_tensor_set(b, halves.data(), 0, halves.size()*sizeof(ggml_fp16_t));
+            auto * graph = ggml_new_graph_custom(context.get(), 16, false);
+            ggml_build_forward_expand(graph, out);
+            require(ggml_backend_graph_compute(backend.get(), graph) == GGML_STATUS_SUCCESS, "forced-pool mixed-type matmul failed");
+            ggml_backend_tensor_get(out, values.data(), 0, values.size()*sizeof(float));
+            for (float value : values) { require(value == 256.0f, "forced-pool conversion changed exact matmul output"); }
+            const size_t retained = stats().managed_used_bytes - tensor_bytes;
+            tensors.reset();
+            require(retained > 0 && stats().managed_used_bytes == retained,
+                    "conversion pool/workspace bytes were not retained and charged");
+            backend.reset();
+            require(stats().managed_used_bytes == 0, "forced-pool physical allocation cleanup leaked accounting");
+            printf("PASS forced-pool mixed-type conversion: tensor %zu bytes, retained pool/workspace %zu bytes, final managed 0 bytes\n",
+                   tensor_bytes, retained);
+        }
+        printf("PASS CUDA quota, owners, denial, concurrency, released-policy frees, strict zero cap, compute pool/workspace lifecycle, forced-pool conversion and optional stream timing\n");
+        return 0;
+    } catch (const std::exception & error) {
+        fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+}
