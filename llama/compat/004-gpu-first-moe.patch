+cudaError_t ggml_cuda_device_free(void * ptr, int device) {
+    if (!ptr) { return cudaSuccess; }
+    ggml_cuda_set_device(device);
+    auto & state = ggml_cuda_memory();
+    if (!state.activated.load(std::memory_order_acquire)) {
+        const cudaError_t error = cudaFree(ptr);
+        if (error == cudaSuccess) {
+            state.devices[ggml_cuda_get_physical_device(device)].untracked_allocations.fetch_sub(1, std::memory_order_relaxed);
+        }
+        return error;
+    }
+    std::lock_guard<std::mutex> lock(state.mutex);
+    const cudaError_t error = cudaFree(ptr);
+    if (error != cudaSuccess) { return error; }
+    auto found = state.allocations.find(ptr);
+    if (found != state.allocations.end()) {
+        auto & policy = state.devices[found->second.physical_device];
+        GGML_ASSERT(policy.used >= found->second.size);
+        policy.used -= found->second.size;
+        state.allocations.erase(found);
+    } else {
+        state.devices[ggml_cuda_get_physical_device(device)].untracked_allocations.fetch_sub(1, std::memory_order_relaxed);
+    }
+    return cudaSuccess;
+}
