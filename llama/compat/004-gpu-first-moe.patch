+// Physical-device shared allocation policy. Configure only while allocation is quiescent,
+// before loading model buffers. Each enabled call registers an owner; disabled releases
+// one owner. Concurrent owners must request the same limit. Release every registration,
+// including failed model loads. Existing untracked allocations prevent enabling it.
+// A zero limit enables physical-free-memory checks without an explicit byte quota.
+// The final release disables enforcement but preserves accounting until live buffers free.
+// Driver/context/library allocations outside this backend are not included in managed bytes.
+struct ggml_backend_cuda_memory_stats {
+    size_t limit_bytes;
+    size_t managed_used_bytes;
+    size_t managed_peak_bytes;
+    size_t driver_headroom_bytes;
+    uint64_t denied_allocations;
+    bool enabled;
+};
