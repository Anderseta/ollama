new file mode 100644
index 0000000..b93a4e2
--- /dev/null
+++ b/tests/test-gpu-exclusive-op.cpp
@@ -0,0 +1,291 @@
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <fstream>
+#include <map>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+struct weights {
+    std::string file, name;
+    ggml_type type;
+    int64_t k, n, experts;
+    size_t row_bytes;
+    std::vector<uint8_t> raw;
+};
+
+static void load_weights(const char * file, std::map<ggml_type, weights> & result) {
+    ggml_context * metadata = nullptr;
+    gguf_context_ptr gguf(gguf_init_from_file(file, { true, &metadata }));
+    ggml_context_ptr tensors(metadata);
+    require(gguf && tensors, "cannot read GGUF tensor metadata");
+    std::ifstream input(file, std::ios::binary);
+    require(input.good(), "cannot open GGUF data");
+    for (int64_t i = 0; i < gguf_get_n_tensors(gguf.get()); ++i) {
+        const char * name = gguf_get_tensor_name(gguf.get(), i);
+        auto * tensor = ggml_get_tensor(tensors.get(), name);
+        if (!tensor || tensor->ne[2] < 7 || tensor->ne[3] != 1 || tensor->ne[1] < 128 ||
+            std::string(name).find("_exps") == std::string::npos || result.count(tensor->type)) { continue; }
+        if (tensor->type != GGML_TYPE_F32 && tensor->type != GGML_TYPE_Q4_K && tensor->type != GGML_TYPE_Q6_K &&
+            tensor->type != GGML_TYPE_MXFP4) { continue; }
+        weights value { file, name, tensor->type, tensor->ne[0], tensor->ne[1], tensor->ne[2], tensor->nb[1], {} };
+        value.raw.resize(ggml_nbytes(tensor));
+        input.seekg(std::streamoff(gguf_get_data_offset(gguf.get()) + gguf_get_tensor_offset(gguf.get(), i)));
+        input.read(reinterpret_cast<char *>(value.raw.data()), value.raw.size());
+        require(size_t(input.gcount()) == value.raw.size(), "truncated raw expert tensor");
+        std::printf("SOURCE type=%s tensor=%s K=%lld N=%lld E=%lld row_bytes=%zu raw_bytes=%zu file=%s\n",
+                ggml_type_name(value.type), name, (long long) value.k, (long long) value.n,
+                (long long) value.experts, value.row_bytes, value.raw.size(), file);
+        result.emplace(value.type, std::move(value));
+    }
+}
+
+static std::vector<float> make_input(int64_t k, int lanes, int tokens) {
+    std::vector<float> input(k*lanes*tokens);
+    for (size_t i = 0; i < input.size(); ++i) {
+        uint32_t x = uint32_t(i + 97)*747796405u + 2891336453u;
+        x = ((x >> ((x >> 28) + 4)) ^ x)*277803737u;
+        x = (x >> 22) ^ x;
+        input[i] = float(int32_t(x % 8191) - 4095)/2048.0f;
+        if (i % 53 == 0) { input[i] *= 3.75f; }
+    }
+    return input;
+}
+
+static std::vector<int32_t> make_ids(int tokens, bool remapped) {
+    std::vector<int32_t> ids(2*tokens);
+    for (int t = 0; t < tokens; ++t) {
+        for (int j = 0; j < 2; ++j) {
+            const int logical = (t + j) % 2 ? 1 : 6;
+            ids[2*t + j] = remapped ? (logical == 1 ? 1 : 0) : logical;
+        }
+    }
+    return ids;
+}
+
+static std::vector<float> execute(ggml_backend_t backend, const weights & w, const std::vector<float> & input,
+        int tokens, int lanes, int64_t row, int64_t rows, bool packed) {
+    ggml_context_ptr storage(ggml_init({ 8*ggml_tensor_overhead(), nullptr, true }));
+    ggml_context_ptr context(ggml_init({ 16*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true }));
+    require(storage && context, "cannot allocate isolated graph metadata");
+    const int64_t visible = packed ? 2 : w.experts;
+    auto * bank = ggml_new_tensor_3d(storage.get(), w.type, w.k, rows, visible + 1);
+    auto * view = ggml_view_3d(storage.get(), bank, w.k, rows, visible, bank->nb[1], bank->nb[2], 0);
+    auto * values = ggml_new_tensor_3d(context.get(), GGML_TYPE_F32, w.k, lanes, tokens);
+    auto * indices = ggml_new_tensor_2d(context.get(), GGML_TYPE_I32, 2, tokens);
+    auto * out = ggml_mul_mat_id(context.get(), view, values, indices);
+    require(ggml_backend_supports_op(backend, out), "backend does not support requested isolated MUL_MAT_ID");
+    auto * graph = ggml_new_graph_custom(context.get(), 32, false);
+    ggml_build_forward_expand(graph, out);
+    ggml_backend_buffer_ptr weight_buffer(ggml_backend_alloc_ctx_tensors(storage.get(), backend));
+    ggml_backend_buffer_ptr compute_buffer(ggml_backend_alloc_ctx_tensors(context.get(), backend));
+    require(weight_buffer && compute_buffer, "cannot allocate isolated GPU tensors");
+    ggml_backend_buffer_set_usage(weight_buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+    ggml_backend_buffer_set_usage(compute_buffer.get(), GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+    ggml_backend_buffer_clear(weight_buffer.get(), 0);
+    std::vector<uint8_t> raw(ggml_nbytes(bank), 0);
+    const size_t tile_bytes = rows*w.row_bytes;
+    for (int64_t e = 0; e < visible; ++e) {
+        const int64_t logical = packed ? (e == 0 ? 6 : 1) : e;
+        const size_t source = (logical*w.n + row)*w.row_bytes;
+        require(source + tile_bytes <= w.raw.size(), "raw tile exceeds GGUF tensor");
+        std::memcpy(raw.data() + e*tile_bytes, w.raw.data() + source, tile_bytes);
+    }
+    ggml_backend_tensor_set(bank, raw.data(), 0, raw.size());
+    // Detect packing/upload corruption independently of arithmetic differences.
+    std::vector<uint8_t> readback(raw.size());
+    ggml_backend_tensor_get(bank, readback.data(), 0, readback.size());
+    require(raw == readback, "raw quantized GPU bank bytes differ");
+    const auto ids = make_ids(tokens, packed);
+    ggml_backend_tensor_set(values, input.data(), 0, input.size()*sizeof(float));
+    ggml_backend_tensor_set(indices, ids.data(), 0, ids.size()*sizeof(int32_t));
+    require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "isolated CUDA compute failed");
+    std::vector<float> result(ggml_nelements(out));
+    ggml_backend_tensor_get(out, result.data(), 0, result.size()*sizeof(float));
+    for (float value : result) { require(std::isfinite(value), "non-finite isolated output"); }
+    return result;
+}
+
+static std::vector<float> tiled(ggml_backend_t backend, const weights & w, const std::vector<float> & input,
+        int tokens, int lanes, int64_t tile) {
+    std::vector<float> result(w.n*2*tokens);
+    for (int64_t row = 0; row < w.n; row += tile) {
+        const int64_t rows = std::min(tile, w.n - row);
+        const auto part = execute(backend, w, input, tokens, lanes, row, rows, true);
+        for (int t = 0; t < tokens; ++t) {
+            for (int j = 0; j < 2; ++j) {
+                std::memcpy(result.data() + (2*t + j)*w.n + row,
+                        part.data() + (2*t + j)*rows, rows*sizeof(float));
+            }
+        }
+    }
+    return result;
+}
+
+static void compare(const char * kind, const weights & w, int tokens, int lanes, int64_t tile,
+        const std::vector<float> & reference, const std::vector<float> & actual) {
+    require(reference.size() == actual.size() && !reference.empty(), "isolated output sizes differ");
+    double max_abs = 0, max_scaled = 0, sum_sq = 0;
+    size_t changed = 0, worst = 0;
+    for (size_t i = 0; i < reference.size(); ++i) {
+        const double error = std::abs(double(reference[i]) - actual[i]);
+        sum_sq += error*error;
+        max_scaled = std::max(max_scaled, error/std::max(1.0, std::abs(double(reference[i]))));
+        if (error > max_abs) { max_abs = error; worst = i; }
+        changed += std::memcmp(&reference[i], &actual[i], sizeof(float)) != 0;
+    }
+    std::printf("METRIC kind=%s type=%s K=%lld N=%lld T=%d lanes=%d tile=%lld max_abs=%.9g rmse=%.9g scaled_max=%.9g changed=%zu/%zu worst=%zu ref=%.9g actual=%.9g\n",
+            kind, ggml_type_name(w.type), (long long) w.k, (long long) w.n, tokens, lanes, (long long) tile,
+            max_abs, std::sqrt(sum_sq/reference.size()), max_scaled, changed, reference.size(), worst,
+            reference[worst], actual[worst]);
+}
+
+struct scalar_reference {
+    std::vector<float> values;
+    std::vector<double> f32_bounds;
+};
+
+static scalar_reference oracle(const weights & w, const std::vector<float> & input, int tokens, int lanes) {
+    scalar_reference result;
+    result.values.resize(w.n*2*tokens);
+    result.f32_bounds.resize(result.values.size());
+    std::vector<float> row(w.k);
+    const auto ids = make_ids(tokens, false);
+    const auto * traits = ggml_get_type_traits(w.type);
+    // The existing F32 MMF path uses TF32 MMA (mma.cuh). Permit the worst
+    // truncation error for its 10 fraction bits, plus FP32 multiply/add rounding.
+    // gamma(2K) covers separate products and additions; no measured error is
+    // used to choose this bound. A direct FP32 path is more accurate and fits it.
+    const double u_tf32 = std::ldexp(1.0, -10);
+    const double u_f32 = std::ldexp(1.0, -23);
+    const double steps = 2.0*w.k;
+    require(steps*u_f32 < 1.0, "reduction too large for FP32 error bound");
+    const double gamma = steps*u_f32/(1.0 - steps*u_f32);
+    const double operand_error = 2*u_tf32 + u_tf32*u_tf32;
+    const double u_double = std::numeric_limits<double>::epsilon();
+    const double gamma_double = steps*u_double/(1.0 - steps*u_double);
+    for (int t = 0; t < tokens; ++t) {
+        for (int j = 0; j < 2; ++j) {
+            for (int64_t n = 0; n < w.n; ++n) {
+                const void * raw = w.raw.data() + (ids[2*t + j]*w.n + n)*w.row_bytes;
+                if (w.type == GGML_TYPE_F32) { std::memcpy(row.data(), raw, row.size()*sizeof(float)); }
+                else { require(traits->to_float != nullptr, "missing public row dequantizer"); traits->to_float(raw, row.data(), w.k); }
+                double sum = 0, abs_sum = 0;
+                const float * in = input.data() + (t*lanes + j%lanes)*w.k;
+                for (int64_t k = 0; k < w.k; ++k) {
+                    require(std::isfinite(row[k]) && std::isfinite(in[k]), "non-finite scalar operands");
+                    if (w.type == GGML_TYPE_F32) {
+                        require((row[k] == 0 || std::abs(row[k]) >= std::numeric_limits<float>::min()) &&
+                                (in[k] == 0 || std::abs(in[k]) >= std::numeric_limits<float>::min()),
+                                "F32 format bound requires normal or zero operands");
+                    }
+                    const double product = double(row[k])*in[k];
+                    sum += product;
+                    abs_sum += std::abs(product);
+                }
+                const size_t at = (2*t + j)*w.n + n;
+                result.values[at] = float(sum);
+                result.f32_bounds[at] = (operand_error + gamma*(1 + operand_error) + gamma_double)*abs_sum +
+                    std::abs(sum - result.values[at]) + steps*std::numeric_limits<float>::min();
+            }
+        }
+    }
+    return result;
+}
+
+static size_t check_f32_bound(const char * kind, const weights & w, int tokens, int lanes, int64_t tile,
+        const scalar_reference & reference, const std::vector<float> & actual) {
+    size_t violations = 0;
+    double max_ratio = 0;
+    for (size_t i = 0; i < actual.size(); ++i) {
+        const double error = std::abs(double(reference.values[i]) - actual[i]);
+        const double bound = reference.f32_bounds[i];
+        violations += error > bound;
+        if (bound > 0) { max_ratio = std::max(max_ratio, error/bound); }
+    }
+    std::printf("CHECK kind=%s type=f32 K=%lld N=%lld T=%d lanes=%d tile=%lld criterion=tf32_operand_plus_fp32_accum_bound violations=%zu max_bound_ratio=%.9g\n",
+            kind, (long long) w.k, (long long) w.n, tokens, lanes, (long long) tile, violations, max_ratio);
+    return violations;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        std::setvbuf(stdout, nullptr, _IONBF, 0);
+        bool cpu_oracle = false;
+        std::string only_type;
+        std::map<ggml_type, weights> tensors;
+        for (int i = 1; i < argc; ++i) {
+            if (std::string(argv[i]) == "--cpu-oracle") { cpu_oracle = true; }
+            else if (std::string(argv[i]).rfind("--type=", 0) == 0) { only_type = std::string(argv[i]).substr(7); }
+            else { load_weights(argv[i], tensors); }
+        }
+        require(!tensors.empty(), "usage: test-gpu-exclusive-op fixture.gguf [fixture.gguf ...] [--cpu-oracle]");
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || ggml_backend_reg_dev_count(registry) == 0) { std::fprintf(stderr, "SKIP: CUDA unavailable\n"); return 77; }
+        ggml_backend_ptr backend(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        require(backend != nullptr, "cannot initialize CUDA backend");
+        size_t quantized_failures = 0, f32_violations = 0, cases = 0;
+        for (const auto & entry : tensors) {
+            const auto & w = entry.second;
+            if (!only_type.empty() && only_type != ggml_type_name(w.type)) { continue; }
+            for (int lanes : { 1, 2 }) {
+                std::vector<float> first;
+                std::map<int64_t, std::vector<float>> first_tiles;
+                for (int tokens : { 1, 32 }) {
+                    const auto input = make_input(w.k, lanes, tokens);
+                    std::printf("CASE type=%s T=%d lanes=%d full_N=%lld original_experts=%lld\n",
+                            ggml_type_name(w.type), tokens, lanes, (long long) w.n, (long long) w.experts);
+                    const auto full = execute(backend.get(), w, input, tokens, lanes, 0, w.n, false);
+                    scalar_reference scalar;
+                    if (cpu_oracle || w.type == GGML_TYPE_F32) { scalar = oracle(w, input, tokens, lanes); }
+                    if (w.type == GGML_TYPE_F32) { f32_violations += check_f32_bound("scalar-vs-full", w, tokens, lanes, w.n, scalar, full); }
+                    if (tokens == 1) { first = full; }
+                    else {
+                        std::vector<float> token(full.begin(), full.begin() + 2*w.n);
+                        compare("full-T32-vs-T1", w, tokens, lanes, w.n, first, token);
+                    }
+                    for (int64_t tile : { w.n, int64_t(17), int64_t(31), int64_t(64), int64_t(128) }) {
+                        std::printf("CASE type=%s T=%d lanes=%d tile=%lld compact_experts=2 logical1_to_slot1 logical6_to_slot0\n",
+                                ggml_type_name(w.type), tokens, lanes, (long long) tile);
+                        const auto compact = tiled(backend.get(), w, input, tokens, lanes, tile);
+                        compare("full-vs-remap-tile", w, tokens, lanes, tile, full, compact);
+                        ++cases;
+                        if (w.type == GGML_TYPE_F32) {
+                            compare("scalar-oracle-vs-tile", w, tokens, lanes, tile, scalar.values, compact);
+                            f32_violations += check_f32_bound("scalar-vs-tile", w, tokens, lanes, tile, scalar, compact);
+                        } else if (std::memcmp(full.data(), compact.data(), full.size()*sizeof(float))) {
+                            ++quantized_failures;
+                            std::printf("REGRESSION FAIL type=%s T=%d lanes=%d tile=%lld criterion=bitwise_same_T\n",
+                                    ggml_type_name(w.type), tokens, lanes, (long long) tile);
+                        }
+                        if (tokens == 1) { first_tiles[tile] = compact; }
+                        else {
+                            std::vector<float> token(compact.begin(), compact.begin() + 2*w.n);
+                            compare("tile-T32-vs-T1", w, tokens, lanes, tile, first_tiles.at(tile), token);
+                        }
+                    }
+                    if (cpu_oracle || w.type == GGML_TYPE_F32) {
+                        compare("scalar-oracle-vs-full", w, tokens, lanes, w.n, scalar.values, full);
+                    }
+                }
+            }
+        }
+        require(cases > 0, "type filter selected no operator cases");
+        std::printf("REGRESSION COMPLETE: raw bytes verified; cases=%zu quantized_bitwise_failures=%zu f32_bound_violations=%zu\n",
+                cases, quantized_failures, f32_violations);
+        return quantized_failures || f32_violations ? 1 : 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-gpu-exclusive-scheduler.cpp b/tests/test-gpu-exclusive-scheduler.cpp
new file mode 100644
index 0000000..1ad2f6f
--- /dev/null
+++ b/tests/test-gpu-exclusive-scheduler.cpp
@@ -0,0 +1,145 @@
+#include "ggml.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+
+#include <cstdio>
+#include <cstring>
+
+static bool test_host_cast_view(ggml_backend_t cpu) {
+    auto * registry = ggml_backend_reg_by_name("CUDA");
+    if (!registry || ggml_backend_reg_dev_count(registry) == 0) {
+        std::fprintf(stderr, "SKIP optional CUDA destination-view regression: no CUDA device\n");
+        return true;
+    }
+    ggml_backend_ptr cuda(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+    ggml_context_ptr source(ggml_init({ 4*ggml_tensor_overhead(), nullptr, true }));
+    ggml_context_ptr target(ggml_init({ 4*ggml_tensor_overhead(), nullptr, true }));
+    ggml_context_ptr context(ggml_init({ 16*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true }));
+    if (!cuda || !source || !target || !context) { return false; }
+    auto * src = ggml_new_tensor_1d(source.get(), GGML_TYPE_F16, 8);
+    auto * dst = ggml_new_tensor_1d(target.get(), GGML_TYPE_F32, 8);
+    ggml_backend_buffer_ptr source_buffer(ggml_backend_alloc_ctx_tensors(source.get(), cuda.get()));
+    ggml_backend_buffer_ptr target_buffer(ggml_backend_alloc_ctx_tensors(target.get(), cpu));
+    if (!source_buffer || !target_buffer) { return false; }
+    const float sentinel[8] = { -17, -16, -15, -14, -13, -12, -11, -10 };
+    ggml_backend_tensor_set(dst, sentinel, 0, sizeof(sentinel));
+    auto * cast = ggml_cpy(context.get(), src, dst);
+    ggml_set_name(cast, "strict_host_cast_view");
+    auto * graph = ggml_new_graph(context.get());
+    ggml_build_forward_expand(graph, cast);
+    if (cast->buffer != nullptr || cast->view_src != dst || !ggml_backend_buffer_is_host(dst->buffer)) { return false; }
+    ggml_backend_t backends[] = { cuda.get(), cpu };
+    for (int pinned = 0; pinned < 2; ++pinned) {
+        ggml_backend_sched_ptr sched(ggml_backend_sched_new(backends, nullptr, 2, 128, false, true));
+        if (!sched) { return false; }
+        ggml_backend_sched_set_gpu_exclusive(sched.get(), true);
+        if (pinned) { ggml_backend_sched_set_tensor_backend(sched.get(), cast, cuda.get()); }
+        // An unexpected successful reservation is already a regression. Do not
+        // launch a kernel which could write through the invalid host destination.
+        if (ggml_backend_sched_reserve(sched.get(), graph) ||
+            !std::strstr(ggml_backend_sched_get_error(sched.get()), "strict_host_cast_view")) {
+            return false;
+        }
+        if (ggml_backend_sched_graph_compute(sched.get(), graph) == GGML_STATUS_SUCCESS ||
+            !std::strstr(ggml_backend_sched_get_error(sched.get()), "strict_host_cast_view")) {
+            return false;
+        }
+        const auto stats = ggml_backend_sched_get_gpu_stats(sched.get());
+        float actual[8] {};
+        ggml_backend_tensor_get(dst, actual, 0, sizeof(actual));
+        if (stats.cpu_heavy_ops_submitted || stats.gpu_heavy_ops_submitted ||
+            std::memcmp(actual, sentinel, sizeof(actual))) { return false; }
+    }
+    std::fprintf(stderr, "gpu-exclusive CPU destination view (automatic and pinned CUDA): PASS\n");
+    return true;
+}
+
+static bool test_unsupported_flash_attention(ggml_backend_t cpu) {
+    auto * registry = ggml_backend_reg_by_name("CUDA");
+    if (!registry || ggml_backend_reg_dev_count(registry) == 0) {
+        std::fprintf(stderr, "SKIP optional explicit Flash Attention regression: no CUDA device\n");
+        return true;
+    }
+    ggml_backend_ptr cuda(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+    ggml_context_ptr source(ggml_init({ 8*ggml_tensor_overhead(), nullptr, true }));
+    ggml_context_ptr context(ggml_init({ 8*ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true }));
+    if (!cuda || !source || !context) { return false; }
+    auto * q = ggml_new_tensor_4d(source.get(), GGML_TYPE_F32, 32, 1, 1, 1);
+    auto * k = ggml_new_tensor_4d(source.get(), GGML_TYPE_F16, 32, 32, 1, 1);
+    auto * v = ggml_new_tensor_4d(source.get(), GGML_TYPE_F16, 32, 32, 1, 1);
+    ggml_backend_buffer_ptr inputs(ggml_backend_alloc_ctx_tensors(source.get(), cuda.get()));
+    if (!inputs) { return false; }
+    ggml_backend_buffer_clear(inputs.get(), 0);
+    // Head dimension 32 is absent from CUDA fattn.cu's supported-head switch.
+    // This explicit operator must fail closed, rather than taking FA-auto's
+    // separate unfused-graph selection path or executing it on the CPU.
+    auto * attention = ggml_flash_attn_ext(context.get(), q, k, v, nullptr, 1.0f, 0.0f, 0.0f);
+    ggml_set_name(attention, "strict_unsupported_fa_head32");
+    if (ggml_backend_supports_op(cuda.get(), attention) || !ggml_backend_supports_op(cpu, attention)) {
+        std::fprintf(stderr, "explicit Flash Attention regression requires CUDA-unsupported/CPU-supported shape\n");
+        return false;
+    }
+    auto * graph = ggml_new_graph(context.get());
+    ggml_build_forward_expand(graph, attention);
+    ggml_backend_t backends[] = { cuda.get(), cpu };
+    ggml_backend_sched_ptr sched(ggml_backend_sched_new(backends, nullptr, 2, 128, false, true));
+    if (!sched) { return false; }
+    ggml_backend_sched_set_gpu_exclusive(sched.get(), true);
+    if (ggml_backend_sched_reserve(sched.get(), graph) ||
+        !std::strstr(ggml_backend_sched_get_error(sched.get()), "strict_unsupported_fa_head32")) {
+        return false;
+    }
+    if (ggml_backend_sched_graph_compute(sched.get(), graph) == GGML_STATUS_SUCCESS ||
+        !std::strstr(ggml_backend_sched_get_error(sched.get()), "strict_unsupported_fa_head32")) {
+        return false;
+    }
+    const auto stats = ggml_backend_sched_get_gpu_stats(sched.get());
+    if (stats.cpu_heavy_ops_submitted || stats.gpu_heavy_ops_submitted) { return false; }
+    std::fprintf(stderr, "gpu-exclusive explicit unsupported Flash Attention (head32): PASS\n");
+    return true;
+}
+
+// The core case runs without CUDA; an available CUDA backend also exercises the
+// output-view placement guard. Strict scheduling rejects before submitting work.
+int main() {
+    ggml_backend_load_all();
+    ggml_backend_t cpu = ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr);
+    if (!cpu) { return 1; }
+    ggml_backend_t backends[] = { cpu };
+    ggml_backend_sched_t sched = ggml_backend_sched_new(backends, nullptr, 1, 128, false, true);
+    ggml_init_params params = { 128 * ggml_tensor_overhead() + ggml_graph_overhead(), nullptr, true };
+    ggml_context * ctx = ggml_init(params);
+    ggml_tensor * a = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 8);
+    ggml_tensor * b = ggml_new_tensor_1d(ctx, GGML_TYPE_F32, 8);
+    ggml_tensor * sum = ggml_add(ctx, a, b);
+    ggml_set_name(sum, "strict_test_sum");
+    ggml_cgraph * graph = ggml_new_graph(ctx);
+    ggml_build_forward_expand(graph, sum);
+    ggml_backend_sched_set_gpu_exclusive(sched, true);
+    bool ok = !ggml_backend_sched_reserve(sched, graph);
+    ok = ok && std::strstr(ggml_backend_sched_get_error(sched), "strict_test_sum");
+    ok = ok && ggml_backend_sched_graph_compute(sched, graph) != GGML_STATUS_SUCCESS;
+    auto stats = ggml_backend_sched_get_gpu_stats(sched);
+    ok = ok && stats.cpu_heavy_ops_submitted == 0 && stats.gpu_heavy_ops_submitted == 0;
+    ggml_backend_sched_reset(sched);
+    ggml_backend_sched_set_gpu_exclusive(sched, false);
+    ok = ok && ggml_backend_sched_alloc_graph(sched, graph);
+    if (ok) {
+        const float values[8] = {1,2,3,4,5,6,7,8};
+        ggml_backend_tensor_set(a, values, 0, sizeof(values));
+        ggml_backend_tensor_set(b, values, 0, sizeof(values));
+        ok = ggml_backend_sched_graph_compute(sched, graph) == GGML_STATUS_SUCCESS;
+        float actual[8];
+        ggml_backend_tensor_get(sum, actual, 0, sizeof(actual));
+        for (int i = 0; i < 8; ++i) { ok = ok && actual[i] == 2 * values[i]; }
+        stats = ggml_backend_sched_get_gpu_stats(sched);
+        ok = ok && stats.cpu_heavy_ops_submitted == 0;
+    }
+    if (ok) { ok = test_host_cast_view(cpu); }
+    if (ok) { ok = test_unsupported_flash_attention(cpu); }
+    ggml_backend_sched_free(sched);
+    ggml_free(ctx);
+    ggml_backend_free(cpu);
+    std::fprintf(stderr, "gpu-exclusive scheduler fail-closed: %s\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
diff --git a/tests/test-gpu-exclusive-ssm.cpp b/tests/test-gpu-exclusive-ssm.cpp
new file mode 100644
index 0000000..199a144
--- /dev/null
+++ b/tests/test-gpu-exclusive-ssm.cpp
@@ -0,0 +1,176 @@
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static float sample(size_t index, uint32_t salt, float scale) {
+    uint32_t x = uint32_t(index)*747796405u + salt;
+    x = ((x >> ((x >> 28) + 4)) ^ x)*277803737u;
+    x = (x >> 22) ^ x;
+    return float(int(x % 8191) - 4095)*scale;
+}
+
+static double gamma_n(int n, double u) { return n*u/(1 - n*u); }
+
+// gamma(2K+1) permits either separate FP32 operations or FMA contraction.
+// Inputs/products are normal dyadic values, so FTZ does not add input error.
+// SiLU propagates that bound through z/(1+exp(-z)). CUDA 12.8 documents
+// __expf <= (2+floor(abs(1.173*z))) ULP and __fdividef <= 2 ULP:
+// https://docs.nvidia.com/cuda/archive/12.8.1/cuda-c-programming-guide/index.html#intrinsic-functions
+// One normal float ULP is at most epsilon*abs(value). Bounds use epsilon,
+// rather than epsilon/2, and remain valid with or without --use_fast_math.
+static double silu_bound(double z, double z_error) {
+    const double u = std::numeric_limits<float>::epsilon();
+    const double magnitude = std::abs(z) + z_error;
+    require(magnitude < 8.0, "SiLU fixture exceeded its bounded normal range");
+    const double exp_max = std::exp(magnitude);
+    const double exp_error = (2 + std::floor(1.173*magnitude))*u*exp_max;
+    const double denominator_error = exp_error + u*(1 + exp_max + exp_error);
+    const double denominator_min = 1 + std::exp(-magnitude);
+    require(denominator_error < denominator_min, "invalid SiLU denominator bound");
+    const double quotient_error = magnitude*denominator_error /
+        (denominator_min*(denominator_min - denominator_error));
+    const double division_error = 2*u*magnitude/(denominator_min - denominator_error);
+    const double input_error = (1 + magnitude/4)*z_error;
+    const double reference_error = gamma_n(8, std::numeric_limits<double>::epsilon())*(1 + magnitude)*exp_max;
+    return input_error + quotient_error + division_error + reference_error;
+}
+
+struct case_result { size_t violations = 0, outputs = 0; double max_error = 0, max_ratio = 0; };
+
+static case_result run_case(ggml_backend_t backend, int channels, int tokens, int sequences, int kernel,
+        int mode, bool padded) {
+    ggml_context_ptr context(ggml_init({ 32*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true }));
+    require(context != nullptr, "cannot allocate SSM test metadata");
+    const int length = kernel - 1 + tokens;
+    auto * x_root = ggml_new_tensor_3d(context.get(), GGML_TYPE_F32, length,
+            channels + (padded ? 3 : 0), sequences + (padded ? 1 : 0));
+    auto * w_root = ggml_new_tensor_2d(context.get(), GGML_TYPE_F32, kernel + (padded ? 2 : 0),
+            channels + (padded ? 1 : 0));
+    auto * x = padded ? ggml_view_3d(context.get(), x_root, length, channels, sequences,
+            x_root->nb[1], x_root->nb[2], x_root->nb[1]) : x_root;
+    auto * w = padded ? ggml_view_2d(context.get(), w_root, kernel, channels,
+            w_root->nb[1], sizeof(float)) : w_root;
+    auto * bias = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, channels);
+    auto * conv = ggml_ssm_conv(context.get(), x, w);
+    ggml_set_name(conv, "ssm_conv_scalar_regression");
+    auto * out = conv;
+    if (mode == 2) { out = ggml_add(context.get(), out, bias); }
+    if (mode != 0) { out = ggml_silu(context.get(), out); }
+    require(ggml_backend_supports_op(backend, conv), "CUDA rejects a supported SSM_CONV fixture");
+    auto * graph = ggml_new_graph_custom(context.get(), 32, false);
+    ggml_build_forward_expand(graph, out);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(context.get(), backend));
+    require(buffer != nullptr, "cannot allocate SSM CUDA tensors");
+    ggml_backend_buffer_clear(buffer.get(), 0);
+    // All unused/padding cells are NaN, so an accidental read cannot mimic zero.
+    const float sentinel = std::numeric_limits<float>::quiet_NaN();
+    std::vector<float> x_raw(ggml_nbytes(x_root)/sizeof(float), sentinel);
+    std::vector<float> w_raw(ggml_nbytes(w_root)/sizeof(float), sentinel);
+    std::vector<float> b_raw(channels);
+    const size_t x_offset = padded ? x_root->nb[1]/sizeof(float) : 0;
+    const size_t w_offset = padded ? 1 : 0;
+    for (int s = 0; s < sequences; ++s) {
+        for (int c = 0; c < channels; ++c) {
+            for (int t = 0; t < length; ++t) {
+                x_raw[x_offset + s*(x->nb[2]/sizeof(float)) + c*length + t] =
+                    sample((s*channels + c)*length + t, 2891336453u, 1.0f/8192);
+            }
+        }
+    }
+    for (int c = 0; c < channels; ++c) {
+        for (int j = 0; j < kernel; ++j) {
+            w_raw[w_offset + c*(w->nb[1]/sizeof(float)) + j] =
+                sample(c*kernel + j, 123456789u, 1.0f/16384);
+        }
+        b_raw[c] = sample(c, 987654321u, 1.0f/16384);
+    }
+    ggml_backend_tensor_set(x_root, x_raw.data(), 0, x_raw.size()*sizeof(float));
+    ggml_backend_tensor_set(w_root, w_raw.data(), 0, w_raw.size()*sizeof(float));
+    ggml_backend_tensor_set(bias, b_raw.data(), 0, b_raw.size()*sizeof(float));
+    require(ggml_backend_graph_compute(backend, graph) == GGML_STATUS_SUCCESS, "SSM CUDA compute failed");
+    std::vector<float> actual(ggml_nelements(out));
+    ggml_backend_tensor_get(out, actual.data(), 0, actual.size()*sizeof(float));
+    case_result result;
+    result.outputs = actual.size();
+    for (int s = 0; s < sequences; ++s) {
+        for (int t = 0; t < tokens; ++t) {
+            for (int c = 0; c < channels; ++c) {
+                double sum = 0, absolute_sum = 0;
+                for (int j = 0; j < kernel; ++j) {
+                    const double a = x_raw[x_offset + s*(x->nb[2]/sizeof(float)) + c*length + t + j];
+                    const double b = w_raw[w_offset + c*(w->nb[1]/sizeof(float)) + j];
+                    sum += a*b;
+                    absolute_sum += std::abs(a*b);
+                }
+                if (mode == 2) { sum += b_raw[c]; absolute_sum += std::abs(double(b_raw[c])); }
+                double bound = (gamma_n(2*kernel + 1, std::numeric_limits<float>::epsilon()) +
+                    gamma_n(2*kernel + 1, std::numeric_limits<double>::epsilon()))*absolute_sum;
+                double reference = sum;
+                if (mode != 0) { bound = silu_bound(sum, bound); reference = sum/(1 + std::exp(-sum)); }
+                const size_t index = (s*tokens + t)*channels + c;
+                const double error = std::abs(double(actual[index]) - reference);
+                if (!std::isfinite(actual[index]) || error > bound) {
+                    if (result.violations == 0) {
+                        std::printf("FIRST_FAILURE channel=%d token=%d sequence=%d expected=%.17g actual=%.9g bound=%.9g\n",
+                                c, t, s, reference, actual[index], bound);
+                    }
+                    ++result.violations;
+                }
+                result.max_error = std::max(result.max_error, error);
+                if (bound > 0) { result.max_ratio = std::max(result.max_ratio, error/bound); }
+            }
+        }
+    }
+    // GPU readback of all input bytes also detects unintended writes into views.
+    std::vector<float> readback(std::max(x_raw.size(), w_raw.size()));
+    ggml_backend_tensor_get(x_root, readback.data(), 0, x_raw.size()*sizeof(float));
+    require(std::memcmp(readback.data(), x_raw.data(), x_raw.size()*sizeof(float)) == 0, "SSM modified input/padding bytes");
+    ggml_backend_tensor_get(w_root, readback.data(), 0, w_raw.size()*sizeof(float));
+    require(std::memcmp(readback.data(), w_raw.data(), w_raw.size()*sizeof(float)) == 0, "SSM modified weights/padding bytes");
+    std::printf("SSM channels=%d T=%d sequences=%d K=%d mode=%s layout=%s outputs=%zu violations=%zu max_abs=%.9g max_bound_ratio=%.9g\n",
+            channels, tokens, sequences, kernel, mode == 0 ? "conv" : mode == 1 ? "silu" : "bias+silu",
+            padded ? "offset+padded-sequence+weights" : "contiguous", result.outputs, result.violations,
+            result.max_error, result.max_ratio);
+    return result;
+}
+
+int main() {
+    try {
+        std::setvbuf(stdout, nullptr, _IONBF, 0);
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || ggml_backend_reg_dev_count(registry) == 0) { std::fprintf(stderr, "SKIP: CUDA unavailable\n"); return 77; }
+        ggml_backend_ptr backend(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        require(backend != nullptr, "cannot initialize CUDA backend");
+        size_t cases = 0, outputs = 0, violations = 0;
+        double max_ratio = 0;
+        for (int channels : { 127, 128, 129, 192 }) {
+            for (int tokens : { 1, 7, 32 }) {
+                for (int sequences : { 1, 2 }) {
+                    for (int kernel : { 3, 4, 5, 7, 9, 15 }) {
+                        for (bool padded : { false, true }) {
+                            for (int mode : { 0, 1, 2 }) {
+                                const auto result = run_case(backend.get(), channels, tokens, sequences, kernel, mode, padded);
+                                ++cases; outputs += result.outputs; violations += result.violations;
+                                max_ratio = std::max(max_ratio, result.max_ratio);
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        std::printf("SSM_REGRESSION COMPLETE cases=%zu outputs=%zu violations=%zu max_bound_ratio=%.9g\n",
+                cases, outputs, violations, max_ratio);
+        return violations ? 1 : 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
diff --git a/tests/test-gpu-exclusive.cpp b/tests/test-gpu-exclusive.cpp
new file mode 100644
index 0000000..c191ff1
--- /dev/null
+++ b/tests/test-gpu-exclusive.cpp
@@ -0,0 +1,250 @@
+#include "llama.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct diagnostic_result {
+    std::vector<float> logits;
+    uint64_t user_asks = 0, user_reads = 0, selections = 0;
+};
+
+static diagnostic_result evaluate_diagnostics(const char * path, bool enabled, size_t cache_bytes,
+                                             uint32_t context, uint32_t prefill) {
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = 999;
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false;
+    mp.no_host = true;
+    mp.gpu_exclusive = true;
+    mp.gpu_diagnostics = enabled;
+    mp.moe_ram_limit = 1024 * 1024;
+    const llama_model_tensor_buft_override overrides[] = {
+        { ".*ffn_(up|down|gate|gate_up)_exps.*", ggml_backend_dev_buffer_type(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)) }, { nullptr, nullptr }
+    };
+    mp.tensor_buft_overrides = overrides;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(llama_model_load_from_file(path, mp), llama_model_free);
+    if (!model) { throw std::runtime_error("failed to load diagnostic fixture"); }
+    char architecture[128] {}, text[128] {};
+    llama_model_meta_val_str(model.get(), "general.architecture", architecture, sizeof(architecture));
+    if (std::string(architecture) != "qwen3moe") { throw std::runtime_error("diagnostics test requires the all-MoE qwen3moe fixture"); }
+    auto metadata = [&](const char * key) {
+        if (llama_model_meta_val_str(model.get(), (std::string(architecture) + "." + key).c_str(), text, sizeof(text)) <= 0) {
+            throw std::runtime_error("missing diagnostic fixture metadata");
+        }
+        return uint32_t(std::stoul(text));
+    };
+    const uint32_t layers = metadata("block_count"), experts = metadata("expert_count"), top_k = metadata("expert_used_count");
+    diagnostic_result result;
+    auto cp = llama_context_default_params();
+    cp.n_ctx = context; cp.n_batch = prefill; cp.n_ubatch = prefill; cp.n_seq_max = 1;
+    cp.n_threads = 2; cp.n_threads_batch = 2; cp.moe_cache_size = cache_bytes;
+    // Observe every node externally in both modes. This tests callback chaining
+    // without introducing a different graph-segmentation policy into the logit comparison.
+    cp.cb_eval = [](ggml_tensor *, bool ask, void * data) {
+        auto & result = *static_cast<diagnostic_result *>(data);
+        if (ask) { ++result.user_asks; } else { ++result.user_reads; }
+        return true;
+    };
+    cp.cb_eval_user_data = &result;
+    std::unique_ptr<llama_context, decltype(&llama_free)> ctx(llama_init_from_model(model.get(), cp), llama_free);
+    if (!ctx) { throw std::runtime_error("failed to create diagnostic fixture context"); }
+    auto batch = llama_batch_init(int32_t(prefill), 0, 1);
+    batch.n_tokens = int32_t(prefill);
+    for (uint32_t i = 0; i < prefill; ++i) {
+        batch.token[i] = 40 + (i * 13) % 180;
+        batch.pos[i] = int32_t(i);
+        batch.n_seq_id[i] = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i] = 1; // no output pruning: K * T * L is the exact expected selection count
+    }
+    const int status = llama_decode(ctx.get(), batch);
+    llama_batch_free(batch);
+    if (status) { throw std::runtime_error("diagnostic prefill failed"); }
+    const size_t vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+    const float * logits = llama_get_logits(ctx.get());
+    if (!logits || llama_n_ctx(ctx.get()) != context) { throw std::runtime_error("missing diagnostic logits or changed context"); }
+    result.logits.assign(logits, logits + prefill * vocab);
+    std::vector<llama_gpu_layer_stats> layer_stats(llama_gpu_layer_stats_get(ctx.get(), nullptr, 0));
+    std::vector<llama_gpu_expert_stats> expert_stats(llama_gpu_expert_stats_get(ctx.get(), nullptr, 0));
+    llama_gpu_layer_stats_get(ctx.get(), layer_stats.data(), layer_stats.size());
+    llama_gpu_expert_stats_get(ctx.get(), expert_stats.data(), expert_stats.size());
+    llama_gpu_execution_stats execution {};
+    if (!llama_gpu_execution_stats_get(ctx.get(), &execution) || execution.cpu_heavy_ops_submitted || !execution.gpu_heavy_ops_submitted) {
+        throw std::runtime_error("diagnostic GPU execution not demonstrated");
+    }
+    std::vector<uint64_t> per_layer(layers, 0);
+    for (const auto & entry : expert_stats) {
+        if (entry.layer < 0 || uint32_t(entry.layer) >= layers || entry.expert < 0 || uint32_t(entry.expert) >= experts) {
+            throw std::runtime_error("invalid diagnostic histogram key");
+        }
+        result.selections += entry.selections;
+        per_layer[size_t(entry.layer)] += entry.selections;
+    }
+    if (enabled) {
+        if (execution.expert_selections_dropped || result.selections != uint64_t(layers) * top_k * prefill) {
+            throw std::runtime_error("diagnostic histogram is not exactly one canonical top-k per layer/token");
+        }
+        for (uint32_t layer = 0; layer < layers; ++layer) {
+            if (per_layer[layer] != uint64_t(top_k) * prefill ||
+                std::none_of(layer_stats.begin(), layer_stats.end(), [layer](const llama_gpu_layer_stats & entry) {
+                    return entry.layer == int32_t(layer) && entry.segments > 0 && entry.wall_us > 0;
+                })) { throw std::runtime_error("missing diagnostic layer profile or histogram"); }
+        }
+        if (!execution.cuda_execution_timing_enabled) { throw std::runtime_error("diagnostic CUDA timer not enabled"); }
+    } else if (!layer_stats.empty() || !expert_stats.empty() || execution.cuda_execution_timing_enabled) {
+        throw std::runtime_error("diagnostics-off unexpectedly collected detailed state");
+    }
+    if (!result.user_asks || result.user_asks != result.user_reads) { throw std::runtime_error("external callback was not preserved"); }
+    std::fprintf(stderr, "diagnostics=%s selections=%llu expected=%llu external_asks=%llu external_reads=%llu layer_records=%zu\n",
+            enabled ? "on" : "off", (unsigned long long) result.selections,
+            (unsigned long long) (uint64_t(layers) * top_k * prefill), (unsigned long long) result.user_asks,
+            (unsigned long long) result.user_reads, layer_stats.size());
+    return result;
+}
+
+static std::vector<float> evaluate(const char * path, bool strict, size_t cache_bytes, uint32_t context, uint32_t prefill, uint32_t ubatch = 0) {
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = 999;
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false;
+    mp.no_host = true;
+    mp.gpu_exclusive = strict;
+    mp.moe_ram_limit = strict ? 1024 * 1024 : 0;
+    const llama_model_tensor_buft_override overrides[] = {
+        { ".*ffn_(up|down|gate|gate_up)_exps.*", ggml_backend_dev_buffer_type(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU)) }, { nullptr, nullptr }
+    };
+    if (strict) { mp.tensor_buft_overrides = overrides; }
+    llama_model * model = llama_model_load_from_file(path, mp);
+    if (!model) { throw std::runtime_error("failed to load fixture"); }
+    char architecture[128] {}, count[128] {};
+    llama_model_meta_val_str(model, "general.architecture", architecture, sizeof(architecture));
+    const auto count_key = std::string(architecture) + ".expert_count";
+    const bool moe = llama_model_meta_val_str(model, count_key.c_str(), count, sizeof(count)) > 0 && std::strtoul(count, nullptr, 10) > 0;
+    auto cp = llama_context_default_params();
+    cp.n_ctx = context; cp.n_batch = prefill; cp.n_ubatch = prefill; cp.n_seq_max = 1;
+    if (ubatch) { cp.n_ubatch = ubatch; }
+    cp.n_threads = 2; cp.n_threads_batch = 2;
+    cp.moe_cache_size = strict ? cache_bytes : 0;
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { llama_model_free(model); throw std::runtime_error("failed to create GPU fixture context"); }
+    std::vector<float> result;
+    const int vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    std::vector<llama_token> tokens;
+    // Explicit output-free prefill exercises last-layer MoE with zero tokens.
+    // batch_get_one requests a logit and would never cover this path.
+    llama_token prefix[] = { 23, 24 };
+    int32_t prefix_positions[] = { 0, 1 };
+    int32_t prefix_n_seq[] = { 1, 1 };
+    llama_seq_id prefix_sequence = 0;
+    llama_seq_id * prefix_sequences[] = { &prefix_sequence, &prefix_sequence };
+    int8_t prefix_logits[] = { 0, 0 };
+    llama_batch prefix_batch {};
+    prefix_batch.n_tokens = 2;
+    prefix_batch.token = prefix;
+    prefix_batch.pos = prefix_positions;
+    prefix_batch.n_seq_id = prefix_n_seq;
+    prefix_batch.seq_id = prefix_sequences;
+    prefix_batch.logits = prefix_logits;
+    if (llama_decode(ctx, prefix_batch)) {
+        llama_free(ctx); llama_model_free(model);
+        throw std::runtime_error("output-free prefix decode failed");
+    }
+    for (uint32_t i = 0; i < prefill; ++i) { tokens.push_back(40 + (i * 13) % 180); }
+    for (int step = 0; step < 9; ++step) {
+        auto batch = llama_batch_get_one(tokens.data(), int32_t(tokens.size()));
+        const int status = llama_decode(ctx, batch);
+        if (status) { llama_free(ctx); llama_model_free(model); throw std::runtime_error("GPU fixture decode failed"); }
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        if (!logits) { throw std::runtime_error("missing fixture logits"); }
+        result.insert(result.end(), logits, logits + vocab);
+        tokens = { llama_token(80 + step * 11) };
+    }
+    llama_gpu_execution_stats stats {};
+    if (!llama_gpu_execution_stats_get(ctx, &stats)) { throw std::runtime_error("missing execution stats"); }
+    if (strict && (stats.cpu_heavy_ops_submitted || !stats.gpu_heavy_ops_submitted || (moe && (!stats.tiles || !stats.h2d_bytes)))) {
+        throw std::runtime_error("strict GPU execution was not demonstrated by operation/cache counters");
+    }
+    std::fprintf(stderr, "mode=%s CPU submitted=%llu GPU submitted=%llu cache hits=%llu misses=%llu evictions=%llu tiles=%llu H2D=%llu\n",
+            strict ? "strict" : "resident", (unsigned long long) stats.cpu_heavy_ops_submitted,
+            (unsigned long long) stats.gpu_heavy_ops_submitted, (unsigned long long) stats.vram_cache_hits,
+            (unsigned long long) stats.vram_cache_misses, (unsigned long long) stats.vram_cache_evictions,
+            (unsigned long long) stats.tiles, (unsigned long long) stats.h2d_bytes);
+    if (llama_n_ctx(ctx) != context) { throw std::runtime_error("context changed under streaming"); }
+    llama_free(ctx);
+    llama_model_free(model);
+    return result;
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) { std::fprintf(stderr, "usage: test-gpu-exclusive fixture.gguf [cache bytes] [context] [prefill tokens] [resident-chunks|diagnostics]\n"); return 2; }
+    ggml_backend_load_all();
+    llama_backend_init();
+    bool cuda = false;
+    for (size_t i = 0; i < ggml_backend_dev_count(); ++i) {
+        cuda |= std::string(ggml_backend_reg_name(ggml_backend_dev_backend_reg(ggml_backend_dev_get(i)))) == "CUDA";
+    }
+    if (!cuda) { std::fprintf(stderr, "SKIP: CUDA backend required\n"); llama_backend_free(); return 77; }
+    try {
+        const size_t cache_bytes = argc > 2 ? std::stoull(argv[2]) : 1024 * 1024;
+        const uint32_t context = argc > 3 ? uint32_t(std::stoul(argv[3])) : 256;
+        const uint32_t prefill = argc > 4 ? uint32_t(std::stoul(argv[4])) : 32;
+        if (!prefill || context < prefill + 10) { throw std::runtime_error("context must fit the prefix, prefill and decode tokens"); }
+        if (argc > 5 && std::string(argv[5]) == "diagnostics") {
+            const auto off = evaluate_diagnostics(argv[1], false, cache_bytes, context, prefill);
+            const auto on = evaluate_diagnostics(argv[1], true, cache_bytes, context, prefill);
+            if (off.logits.size() != on.logits.size() ||
+                std::memcmp(off.logits.data(), on.logits.data(), off.logits.size() * sizeof(float)) ||
+                std::any_of(on.logits.begin(), on.logits.end(), [](float value) { return !std::isfinite(value); }) ||
+                off.user_asks != on.user_asks || off.user_reads != on.user_reads) {
+                throw std::runtime_error("diagnostic toggle changed logits or external callback delivery");
+            }
+            std::fprintf(stderr, "PASS diagnostics off/on: %zu logits bitwise equal, canonical top-k totals and external callback preserved\n", on.logits.size());
+            llama_backend_free(); return 0;
+        }
+        const auto reference = evaluate(argv[1], false, cache_bytes, context, prefill);
+        const bool resident_chunks = argc > 5 && std::string(argv[5]) == "resident-chunks";
+        const auto actual = evaluate(argv[1], !resident_chunks, cache_bytes, context, prefill, resident_chunks ? 1 : 0);
+        if (reference.size() != actual.size()) { throw std::runtime_error("logit count differs"); }
+        float max_error = 0, max_relative = 0;
+        double squared_error = 0, reference_energy = 0;
+        bool finite = true;
+        size_t different = 0, same_top1 = 0;
+        for (size_t i = 0; i < reference.size(); ++i) {
+            const float error = std::abs(reference[i] - actual[i]);
+            const float relative = error / std::max(1.0f, std::abs(reference[i]));
+            max_error = std::max(max_error, error);
+            max_relative = std::max(max_relative, relative);
+            squared_error += double(error) * error;
+            reference_energy += double(reference[i]) * reference[i];
+            finite = finite && std::isfinite(reference[i]) && std::isfinite(actual[i]);
+            if (!std::isfinite(reference[i]) || !std::isfinite(actual[i]) || relative > 2e-4f) {
+                if (different++ == 0) { std::fprintf(stderr, "logit %zu differs: %.9g vs %.9g\n", i, reference[i], actual[i]); }
+            }
+        }
+        const size_t vocab = reference.size() / 9;
+        for (size_t step = 0; step < 9; ++step) {
+            const auto r = reference.begin() + step * vocab;
+            const auto a = actual.begin() + step * vocab;
+            same_top1 += (std::max_element(r, r + vocab) - r) == (std::max_element(a, a + vocab) - a);
+        }
+        std::fprintf(stderr, "comparison=%s max_abs=%g max_scaled=%g rmse=%g nmse=%g finite=%d outside_tolerance=%zu top1_same=%zu/9\n",
+                resident_chunks ? "resident-batch-variation" : "streaming", max_error, max_relative,
+                std::sqrt(squared_error / reference.size()),
+                reference_energy ? squared_error / reference_energy : squared_error, finite ? 1 : 0, different, same_top1);
+        if (!finite) { throw std::runtime_error("nonfinite fixture logits"); }
+        if (different) { throw std::runtime_error("GPU streaming logits exceed numerical tolerance"); }
+        std::fprintf(stderr, "PASS %zu logits, max absolute error=%g scaled error=%g; original GGUF and context preserved\n", actual.size(), max_error, max_relative);
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "FAIL: %s\n", e.what()); llama_backend_free(); return 1;
+    }
+    llama_backend_free();
+    return 0;
+}
diff --git a/tests/test-gpu-layer-diagnostics.cpp b/tests/test-gpu-layer-diagnostics.cpp
new file mode 100644
index 0000000..6e3eb90
--- /dev/null
+++ b/tests/test-gpu-layer-diagnostics.cpp
@@ -0,0 +1,130 @@
+#include "../src/llama-gpu-layer-diagnostics.h"
+#include "ggml-cpp.h"
+
+#include <cstdio>
+#include <limits>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+struct forwarding {
+    ggml_tensor * requested = nullptr;
+    ggml_tensor * abort_at = nullptr;
+    size_t asks = 0, afters = 0;
+    static bool callback(ggml_tensor * node, bool ask, void * data) {
+        auto & self = *static_cast<forwarding *>(data);
+        if (ask) { ++self.asks; return node == self.requested || node == self.abort_at; }
+        require(node == self.requested || node == self.abort_at, "diagnostics forwarded an unrequested after callback");
+        ++self.afters;
+        return node != self.abort_at;
+    }
+};
+
+static void exercise(ggml_backend_t backend, bool strided_elements) {
+    ggml_context_ptr ctx(ggml_init({ 32*ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true }));
+    require(ctx != nullptr, "cannot allocate diagnostic fixture metadata");
+    auto * storage = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I32, 256);
+    auto * router = ggml_view_3d(ctx.get(), storage, 2, 2, 2, 64, 160, sizeof(int32_t));
+    router->nb[0] = strided_elements ? 8 : 4;
+    ggml_set_name(router, "ffn_moe_topk-0");
+    auto tensor = [&](const char * name) {
+        auto * value = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 1);
+        ggml_set_name(value, name);
+        return value;
+    };
+    auto * shared = tensor("shared_input");
+    auto * layer0 = tensor("attn-0");
+    auto * untagged = tensor("intermediate");
+    auto * end0 = tensor("ffn_out-0");
+    auto * layer1 = tensor("attn-1");
+    auto * end1 = tensor("ffn_out-1");
+    auto * result = tensor("result_output");
+    auto * graph = ggml_new_graph_custom(ctx.get(), 32, false);
+    for (auto * node : {shared, layer0, untagged, router, end0, layer1, end1, result}) {
+        ggml_graph_add_node(graph, node);
+    }
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(), backend));
+    require(buffer != nullptr, "cannot allocate diagnostic CPU fixture");
+    std::vector<int32_t> raw(256, 999); // Unselected argsort suffix must be ignored.
+    for (size_t i2 = 0; i2 < 2; ++i2) {
+        for (size_t i1 = 0; i1 < 2; ++i1) {
+            for (size_t i0 = 0; i0 < 2; ++i0) {
+                raw[1 + (i0*router->nb[0] + i1*router->nb[1] + i2*router->nb[2])/sizeof(int32_t)] =
+                    (i0 + i1 + i2) % 2 ? 1 : 6;
+            }
+        }
+    }
+    ggml_backend_tensor_set(storage, raw.data(), 0, raw.size()*sizeof(int32_t));
+    llama_gpu_layer_diagnostics totals;
+    forwarding external { untagged, result };
+    using frame = llama_gpu_layer_diagnostics::frame;
+    frame run(totals, graph, 2, 8, forwarding::callback, &external);
+    require(run.routers.size() == 1 && run.routers.at(router) == 0, "canonical router marker missing");
+    require(run.ends.size() == 4 && run.ends.at(shared) == -1 && run.ends.at(end0) == 0 &&
+        run.ends.at(end1) == 1 && run.ends.at(result) == -1, "layer/shared endpoints incorrect");
+    run.begin();
+    for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+        auto * node = ggml_graph_node(graph, i);
+        const bool need = frame::callback(node, true, &run);
+        const bool expected = node == shared || node == untagged || node == router ||
+            node == end0 || node == end1 || node == result;
+        require(need == expected, "diagnostic ask forwarding changed callback requirement");
+        if (need) {
+            require(frame::callback(node, false, &run) == (node != result), "external callback abort result lost");
+        }
+    }
+    require(external.asks == 8 && external.afters == 2, "external callback invocation count changed");
+    require(totals.layers.size() == 3 && totals.layers.at(-1).segments == 2 &&
+        totals.layers.at(0).segments == 1 && totals.layers.at(1).segments == 1, "segment totals incorrect");
+    require(totals.experts.size() == 2 && totals.experts.at({0, 1}) == 4 && totals.experts.at({0, 6}) == 4,
+        "strided canonical selections or suffix exclusion incorrect");
+    std::vector<int32_t> overwritten(256, 0);
+    ggml_backend_tensor_set(storage, overwritten.data(), 0, overwritten.size()*sizeof(int32_t));
+    require(totals.experts.at({0, 1}) == 4 && totals.experts.at({0, 6}) == 4,
+        "router statistics retained a pointer to reusable tensor storage");
+    ggml_backend_tensor_set(storage, raw.data(), 0, raw.size()*sizeof(int32_t));
+    // A full histogram drops only unknown selections, preserving existing keys.
+    llama_gpu_layer_diagnostics bounded;
+    for (size_t i = 0; i < llama_gpu_layer_diagnostics::max_expert_records; ++i) {
+        bounded.experts.emplace(std::make_pair(7, int32_t(i)), 1);
+    }
+    frame full(bounded, graph, 2, 8, nullptr, nullptr);
+    full.capture_router(router, 0);
+    require(bounded.experts.size() == llama_gpu_layer_diagnostics::max_expert_records &&
+        bounded.dropped_expert_selections == 8, "bounded histogram grew or miscounted dropped selections");
+    bounded.experts.erase(bounded.experts.begin());
+    bounded.experts.emplace(std::make_pair(0, 1), 10);
+    full.capture_router(router, 0);
+    require(bounded.experts.size() == llama_gpu_layer_diagnostics::max_expert_records &&
+        bounded.experts.at({0, 1}) == 14 && bounded.dropped_expert_selections == 12,
+        "existing histogram key stopped counting at capacity");
+    router->type = GGML_TYPE_I64;
+    bool rejected = false;
+    try { full.capture_router(router, 0); } catch (const std::runtime_error &) { rejected = true; }
+    require(rejected, "unsupported router dtype accepted");
+    router->type = GGML_TYPE_I32;
+    raw[1] = 8;
+    ggml_backend_tensor_set(storage, raw.data(), 0, raw.size()*sizeof(int32_t));
+    rejected = false;
+    try { full.capture_router(router, 0); } catch (const std::runtime_error &) { rejected = true; }
+    require(rejected, "out-of-range canonical expert accepted");
+    std::printf("PASS layer diagnostics CPU: nb0=%zu, strided rows/sequences, selected suffix exclusion, immediate lifetime, endpoints, user forwarding/abort, bounded histogram\n",
+            router->nb[0]);
+}
+
+int main() {
+    try {
+        using frame = llama_gpu_layer_diagnostics::frame;
+        require(frame::named_layer("attn-0", 2) == 0 && frame::named_layer("ffn_out-1", 2) == 1 &&
+            frame::named_layer("result_output", 2) == -1 && frame::named_layer("attn-2", 2) == -1 &&
+            frame::named_layer("attn-1tail", 2) == -1, "graph layer-name validation failed");
+        ggml_backend_load_all();
+        ggml_backend_ptr cpu(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+        require(cpu != nullptr, "CPU backend unavailable");
+        exercise(cpu.get(), false);
+        exercise(cpu.get(), true);
+        std::printf("PASS GPU layer diagnostic helper invariants (CPU-only arithmetic)\n");
+        return 0;
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
diff --git a/tests/test-moe-ram-metrics.cpp b/tests/test-moe-ram-metrics.cpp
