diff --git a/tools/server/server-gpu-diagnostics.h b/tools/server/server-gpu-diagnostics.h
new file mode 100644
index 0000000..7578be2
--- /dev/null
+++ b/tools/server/server-gpu-diagnostics.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include "llama.h"
+#include "json.h"
+#include <algorithm>
+#include <map>
+#include <vector>
+
+// Snapshots are shared model/context counters. Concurrent requests can contribute
+// to a slot's delta; these are deliberately not described as exclusive costs.
+struct server_gpu_diagnostics_snapshot {
+    llama_moe_io_stats io = {};
+    llama_gpu_execution_stats execution = {};
+    std::vector<llama_gpu_layer_stats> layers;
+    std::vector<llama_gpu_expert_stats> experts;
+
+    void capture(const llama_model * model, const llama_context * ctx) {
+        llama_model_get_moe_io_stats(model, &io);
+        llama_gpu_execution_stats_get(ctx, &execution);
+        layers.resize(llama_gpu_layer_stats_get(ctx, nullptr, 0));
+        llama_gpu_layer_stats_get(ctx, layers.data(), layers.size());
+        experts.resize(llama_gpu_expert_stats_get(ctx, nullptr, 0));
+        llama_gpu_expert_stats_get(ctx, experts.data(), experts.size());
+    }
+};
+
+inline json server_gpu_diagnostics_summary(
+        const server_gpu_diagnostics_snapshot & before,
+        const llama_model * model, const llama_context * ctx, bool exclusive) {
+    server_gpu_diagnostics_snapshot after;
+    after.capture(model, ctx);
+    llama_gpu_memory_stats memory = {};
+    llama_model_get_gpu_memory_stats(model, &memory);
+    const auto & a = after.io;
+    const auto & b = before.io;
+    const auto & x = after.execution;
+    const auto & y = before.execution;
+    auto delta = [](uint64_t end, uint64_t start) { return end >= start ? end - start : 0; };
+    auto elapsed = [](int64_t end, int64_t start) { return end >= start ? (end - start) / 1000.0 : 0.0; };
+    std::map<int32_t, llama_gpu_layer_stats> previous_layers;
+    for (const auto & entry : before.layers) { previous_layers[entry.layer] = entry; }
+    json layer_times = json::array();
+    for (const auto & entry : after.layers) {
+        const auto & previous = previous_layers[entry.layer];
+        const uint64_t segments = delta(entry.segments, previous.segments);
+        if (segments) {
+            layer_times.push_back({{"layer", entry.layer}, {"wall_ms", delta(entry.wall_us, previous.wall_us) / 1000.0}, {"segments", segments}});
+        }
+    }
+    std::map<std::pair<int32_t, int32_t>, uint64_t> previous_experts;
+    for (const auto & entry : before.experts) { previous_experts[{entry.layer, entry.expert}] = entry.selections; }
+    std::vector<llama_gpu_expert_stats> popular;
+    uint64_t expert_selections = 0;
+    for (auto entry : after.experts) {
+        entry.selections = delta(entry.selections, previous_experts[{entry.layer, entry.expert}]);
+        expert_selections += entry.selections;
+        if (entry.selections) { popular.push_back(entry); }
+    }
+    std::sort(popular.begin(), popular.end(), [](const llama_gpu_expert_stats & a, const llama_gpu_expert_stats & b) {
+        if (a.selections != b.selections) { return a.selections > b.selections; }
+        return std::make_pair(a.layer, a.expert) < std::make_pair(b.layer, b.expert);
+    });
+    json top_experts = json::array();
+    for (size_t i = 0; i < std::min<size_t>(32, popular.size()); ++i) {
+        const auto & entry = popular[i];
+        top_experts.push_back({{"layer", entry.layer}, {"expert", entry.expert}, {"selections", entry.selections}});
+    }
+    return {
+        {"counter_scope", "shared_model_context_delta"},
+        {"gpu_exclusive", exclusive},
+        {"operator_counters_enabled", exclusive},
+        {"ram_peak_scope", "model_lifetime"},
+        {"cpu_heavy_ops_submitted", delta(x.cpu_heavy_ops_submitted, y.cpu_heavy_ops_submitted)},
+        {"gpu_heavy_ops_submitted", delta(x.gpu_heavy_ops_submitted, y.gpu_heavy_ops_submitted)},
+        {"vram_cache_hits", delta(x.vram_cache_hits, y.vram_cache_hits)},
+        {"vram_cache_misses", delta(x.vram_cache_misses, y.vram_cache_misses)},
+        {"vram_cache_evictions", delta(x.vram_cache_evictions, y.vram_cache_evictions)},
+        {"gpu_cache_h2d_bytes", delta(x.h2d_bytes, y.h2d_bytes)},
+        {"tiles", delta(x.tiles, y.tiles)},
+        {"layer_profile", {
+            {"scope", "serialized_tagged_graph_segments_host_wall_including_io_and_diagnostic_barriers"},
+            {"shared_layer_index", -1}, {"layers", std::move(layer_times)},
+        }},
+        {"expert_usage", {
+            {"scope", "canonical_ffn_router_selections_per_layer_not_weight_tile_accesses"},
+            {"selections", expert_selections}, {"distinct_layer_experts", popular.size()},
+            {"dropped_selections", delta(x.expert_selections_dropped, y.expert_selections_dropped)},
+            {"top_limit", 32}, {"top", std::move(top_experts)},
+        }},
+        {"cuda_execution", {
+            {"enabled", x.cuda_execution_timing_enabled},
+            {"scope", "execution_stream_intervals_not_kernel_only"},
+            {"stream_ms", std::max(0.0, x.cuda_execution_stream_ms - y.cuda_execution_stream_ms)},
+            {"samples", delta(x.cuda_execution_samples, y.cuda_execution_samples)},
+            {"pending", x.cuda_execution_pending},
+            {"dropped", delta(x.cuda_execution_dropped, y.cuda_execution_dropped)},
+        }},
+        {"ram", {
+            {"limit_bytes", a.ram_limit_bytes}, {"resident_bytes", a.ram_resident_bytes},
+            {"peak_bytes", a.ram_peak_bytes}, {"hits", delta(a.ram_hits, b.ram_hits)},
+            {"misses", delta(a.ram_misses, b.ram_misses)}, {"evicted_pages", delta(a.evicted_pages, b.evicted_pages)},
+            {"io_buffer_bytes", a.io_buffer_bytes}, {"upload_buffer_bytes", a.upload_buffer_bytes},
+        }},
+        {"ssd", {{"bytes", delta(a.ssd_bytes, b.ssd_bytes)}, {"reads", delta(a.ssd_reads, b.ssd_reads)}}},
+        {"h2d", {{"bytes", delta(a.h2d_bytes, b.h2d_bytes)}, {"calls", delta(a.h2d_calls, b.h2d_calls)},
+                 {"syncs", delta(a.h2d_sync_calls, b.h2d_sync_calls)}, {"slot_waits", delta(a.h2d_slot_waits, b.h2d_slot_waits)}}},
+        {"timings", {
+            {"enabled", a.timings_enabled && b.timings_enabled}, {"scope", "overlapping_host_intervals"},
+            {"io_submit_ms", elapsed(a.io_submit_us, b.io_submit_us)}, {"io_wait_ms", elapsed(a.io_wait_us, b.io_wait_us)},
+            {"host_copy_ms", elapsed(a.host_copy_us, b.host_copy_us)}, {"commit_ms", elapsed(a.commit_us, b.commit_us)},
+            {"release_ms", elapsed(a.release_us, b.release_us)}, {"h2d_ms", elapsed(a.h2d_us, b.h2d_us)},
+            {"h2d_wait_ms", elapsed(a.h2d_wait_us, b.h2d_wait_us)},
+        }},
+        {"cuda_managed", {
+            {"peak_scope", "physical_device_allocator_lifetime"},
+            {"enabled", memory.enabled}, {"limit_bytes", memory.limit_bytes},
+            {"used_bytes", memory.managed_used_bytes}, {"peak_bytes", memory.managed_peak_bytes},
+            {"driver_headroom_bytes", memory.driver_headroom_bytes}, {"denied_allocations_total", memory.denied_allocations},
+        }},
+    };
+}
