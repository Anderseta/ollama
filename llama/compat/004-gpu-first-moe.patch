+static constexpr size_t GGML_CUDA_DRIVER_HEADROOM = 64*1024*1024;
+
+// Reserve quota before touching the driver. Pending reservations count against
+// concurrent allocations but are not reported as successful live allocations.
+struct ggml_cuda_memory_reservation {
+    ggml_cuda_memory_state & state = ggml_cuda_memory();
+    int physical_device;
+    size_t size;
+    bool tracked = false;
+    bool valid = false;
+    bool committed = false;
+
+    ggml_cuda_memory_reservation(int device, size_t size) :
+        physical_device(ggml_cuda_get_physical_device(device)), size(size) {
+        auto & policy = state.devices[physical_device];
+        if (!state.activated.load(std::memory_order_acquire)) {
+            policy.untracked_allocations.fetch_add(1, std::memory_order_seq_cst);
+            // Pair with activation before its outstanding-allocation check. A
+            // racing first policy must either see this legacy allocation, or
+            // make this allocation retry through the locked policy path.
+            if (!state.activated.load(std::memory_order_seq_cst)) {
+                valid = true;
+                return;
+            }
+            policy.untracked_allocations.fetch_sub(1, std::memory_order_relaxed);
+        }
+        std::lock_guard<std::mutex> lock(state.mutex);
+        tracked = policy.enabled;
+        if (!tracked) {
+            policy.untracked_allocations.fetch_add(1, std::memory_order_relaxed);
+            valid = true;
+            return;
+        }
+        const bool overflow = size > SIZE_MAX - policy.used || policy.pending > SIZE_MAX - policy.used - size;
+        const size_t requested = overflow ? SIZE_MAX : policy.used + policy.pending + size;
+        size_t free_bytes = 0, total_bytes = 0;
+        const cudaError_t info = cudaMemGetInfo(&free_bytes, &total_bytes);
+        const bool no_headroom = info != cudaSuccess || policy.pending > free_bytes || size > free_bytes - policy.pending ||
+                                 free_bytes - policy.pending - size < GGML_CUDA_DRIVER_HEADROOM;
+        if (overflow || (policy.limit && requested > policy.limit) || no_headroom) {
+            ++policy.denied;
+            GGML_LOG_ERROR("%s: GPU %d allocation denied: request %.2f MiB, managed %.2f MiB, pending %.2f MiB, "
+                           "limit %.2f MiB, driver free %.2f MiB, headroom %.2f MiB\n", __func__, physical_device,
+                           size/1048576.0, policy.used/1048576.0, policy.pending/1048576.0,
+                           policy.limit/1048576.0, free_bytes/1048576.0, GGML_CUDA_DRIVER_HEADROOM/1048576.0);
+            return;
+        }
+        policy.pending += size;
+        valid = true;
+    }
+
+    // A map insertion can fail on host OOM; leave the reservation pending so the
+    // caller can free the actual CUDA allocation before the destructor rolls it back.
+    bool commit(void * pointer = nullptr) {
+        if (tracked) {
+            std::lock_guard<std::mutex> lock(state.mutex);
+            if (pointer) {
+                try {
+                    if (!state.allocations.emplace(pointer, ggml_cuda_memory_state::allocation { physical_device, size }).second) {
+                        return false;
+                    }
+                } catch (const std::bad_alloc &) {
