+bool ggml_cuda_execution_timing::initialize() {
+    for (auto & item : slots) {
+        for (auto * event : { &item.start, &item.end }) {
+            const cudaError_t error = cudaEventCreate(event);
+            if (error != cudaSuccess) {
+                GGML_LOG_ERROR("%s: cannot create optional CUDA timing events: %s\n", __func__, cudaGetErrorString(error));
+                return false;
+            }
+        }
+    }
+    return true;
+}
+
+ggml_cuda_execution_timing::~ggml_cuda_execution_timing() {
+    for (auto & item : slots) {
+        // CUDA defers resource destruction for recorded events still in flight.
+        if (item.start) { (void) cudaEventDestroy(item.start); }
+        if (item.end) { (void) cudaEventDestroy(item.end); }
+    }
+}
+
+void ggml_cuda_execution_timing::collect() {
+    for (auto & item : slots) {
+        if (item.state != slot::pending) { continue; }
+        const cudaError_t ready = cudaEventQuery(item.end);
+        if (ready == cudaErrorNotReady) { continue; }
+        CUDA_CHECK(ready);
+        float ms = 0;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, item.start, item.end));
+        elapsed_ms += ms;
+        ++samples;
+        item.state = slot::free;
+    }
+}
+
+int ggml_cuda_execution_timing::begin(cudaStream_t stream) {
+    std::lock_guard<std::mutex> lock(mutex);
+    if (!enabled) { return -1; }
+    collect();
+    for (size_t i = 0; i < capacity; ++i) {
+        const size_t index = (cursor + i) % capacity;
+        auto & item = slots[index];
+        if (item.state != slot::free) { continue; }
+        CUDA_CHECK(cudaEventRecord(item.start, stream));
+        item.state = slot::recording;
+        cursor = (index + 1) % capacity;
+        return (int) index;
+    }
+    ++dropped;
+    return -1;
+}
+
+void ggml_cuda_execution_timing::end(int index, cudaStream_t stream) {
+    if (index < 0) { return; }
+    std::lock_guard<std::mutex> lock(mutex);
+    auto & item = slots[index];
+    GGML_ASSERT(item.state == slot::recording);
+    CUDA_CHECK(cudaEventRecord(item.end, stream));
+    item.state = slot::pending;
+}
+
+ggml_backend_cuda_execution_stats ggml_cuda_execution_timing::stats() {
+    std::lock_guard<std::mutex> lock(mutex);
+    collect();
+    uint64_t pending = 0;
+    for (const auto & item : slots) { pending += item.state != slot::free; }
+    return { elapsed_ms, samples, pending, dropped, enabled };
+}
