new file mode 100644
index 0000000..187cff9
--- /dev/null
+++ b/src/llama-gpu-layer-diagnostics.h
@@ -0,0 +1,125 @@
+#pragma once
+
+#include "llama.h"
+#include "ggml.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cstdlib>
+#include <cstring>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+// Optional, deliberately serialized diagnostic. These are host wall intervals
+// between tagged graph boundaries, including storage/transfers and diagnostic
+// barriers, NOT CUDA kernel durations. No instance exists with diagnostics off.
+struct llama_gpu_layer_diagnostics {
+    std::map<int32_t, llama_gpu_layer_stats> layers;
+    std::map<std::pair<int32_t, int32_t>, uint64_t> experts;
+    uint64_t dropped_expert_selections = 0;
+    static constexpr size_t max_expert_records = 262144;
+
+    struct frame {
+        llama_gpu_layer_diagnostics & totals;
+        ggml_backend_sched_eval_callback user_callback;
+        void * user_data;
+        int32_t n_expert;
+        std::unordered_map<const ggml_tensor *, int32_t> ends;
+        std::unordered_map<const ggml_tensor *, int32_t> routers;
+        std::unordered_map<const ggml_tensor *, bool> user_needs;
+        int64_t previous_us = 0;
+
+        static int32_t named_layer(const char * name, int32_t n_layers) {
+            const char * dash = std::strrchr(name, '-');
+            if (!dash || !dash[1]) { return -1; }
+            for (const char * p = dash + 1; *p; ++p) {
+                if (*p < '0' || *p > '9') { return -1; }
+            }
+            char * end = nullptr;
+            const long layer = std::strtol(dash + 1, &end, 10);
+            return end && !*end && layer >= 0 && layer < n_layers ? int32_t(layer) : -1;
+        }
+
+        frame(llama_gpu_layer_diagnostics & totals, ggml_cgraph * graph,
+              int32_t n_layers, int32_t n_expert,
+              ggml_backend_sched_eval_callback callback, void * data) :
+            totals(totals), user_callback(callback), user_data(data), n_expert(n_expert) {
+            int32_t current = -1;
+            const ggml_tensor * previous = nullptr;
+            for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+                const auto * node = ggml_graph_node(graph, i);
+                const int32_t layer = named_layer(node->name, n_layers);
+                // Unnamed intermediates inherit the preceding graph tag. A
+                // shared result_* node ends attribution to transformer layers.
+                const int32_t next = layer >= 0 ? layer :
+                    (std::strncmp(node->name, "result_", 7) == 0 ? -1 : current);
+                if (previous && next != current) { ends[previous] = current; }
+                current = next;
+                previous = node;
+                // The canonical router view is observed once, before any of
+                // its consumers can reuse its storage: never once per tile.
+                if (layer >= 0 && std::strncmp(node->name, "ffn_moe_topk-", 13) == 0) {
+                    routers[node] = layer;
+                }
+            }
+            if (previous) { ends[previous] = current; }
+        }
+
+        void begin() { previous_us = ggml_time_us(); }
+
+        void capture_router(ggml_tensor * node, int32_t layer) {
+            if (node->type != GGML_TYPE_I32 || node->ne[3] != 1) {
+                throw std::runtime_error("gpu diagnostics: unsupported router index layout");
+            }
+            // Read only selected entries. In particular a strided top-k view
+            // must not copy/sum the unselected suffix of its argsort storage.
+            std::vector<int32_t> row(size_t(node->ne[0]));
+            for (int64_t i2 = 0; i2 < node->ne[2]; ++i2) {
+                for (int64_t i1 = 0; i1 < node->ne[1]; ++i1) {
+                    if (node->nb[0] == sizeof(int32_t)) {
+                        ggml_backend_tensor_get(node, row.data(), i1*node->nb[1] + i2*node->nb[2], row.size()*sizeof(int32_t));
+                    } else {
+                        for (int64_t i0 = 0; i0 < node->ne[0]; ++i0) {
+                            ggml_backend_tensor_get(node, &row[size_t(i0)], i0*node->nb[0] + i1*node->nb[1] + i2*node->nb[2], sizeof(int32_t));
+                        }
+                    }
+                    for (const int32_t expert : row) {
+                        if (expert < 0 || expert >= n_expert) {
+                            throw std::runtime_error("gpu diagnostics: invalid router expert index");
+                        }
+                        const auto key = std::make_pair(layer, expert);
+                        auto it = totals.experts.find(key);
+                        if (it != totals.experts.end()) { ++it->second; }
+                        else if (totals.experts.size() < max_expert_records) { totals.experts.emplace(key, 1); }
+                        else { ++totals.dropped_expert_selections; }
+                    }
+                }
+            }
+        }
+
+        static bool callback(ggml_tensor * node, bool ask, void * data) {
+            auto & self = *static_cast<frame *>(data);
+            if (ask) {
+                const bool user_need = self.user_callback && self.user_callback(node, true, self.user_data);
+                self.user_needs[node] = user_need;
+                return user_need || self.ends.count(node) || self.routers.count(node);
+            }
+            if (const auto it = self.ends.find(node); it != self.ends.end()) {
+                const int64_t now = ggml_time_us();
+                auto & layer = self.totals.layers[it->second];
+                layer.layer = it->second;
+                layer.wall_us += uint64_t(std::max<int64_t>(0, now - self.previous_us));
+                ++layer.segments;
+                self.previous_us = now;
+            }
+            if (const auto it = self.routers.find(node); it != self.routers.end()) {
+                self.capture_router(node, it->second);
+            }
+            const auto user = self.user_needs.find(node);
+            return user == self.user_needs.end() || !user->second || self.user_callback(node, false, self.user_data);
+        }
+    };
+};
