diff --git a/src/llama-runtime-activity.h b/src/llama-runtime-activity.h
new file mode 100644
index 0000000..11548c4
--- /dev/null
+++ b/src/llama-runtime-activity.h
@@ -0,0 +1,100 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <mutex>
+#include <string>
+
+// Lightweight progress is separate from gpu_diagnostics: no graph barriers,
+// CUDA events, tensor readbacks or cache locks are added for the UI.
+namespace llama_runtime_activity {
+inline bool enabled() {
+    static const bool value = [] { const char * env = std::getenv("WILDLLAMA_ACTIVITY"); return env && std::string(env) == "1"; }();
+    return value;
+}
+
+inline void phase(const char * name, double progress = -1, int64_t processed = -1,
+                  int64_t total = -1, int64_t generated = -1, double rate = -1,
+                  const char * stage = "") {
+    if (!enabled()) { return; }
+    static std::mutex mutex;
+    static std::string previous;
+    static int64_t last = 0;
+    std::lock_guard<std::mutex> guard(mutex);
+    const int64_t now = ggml_time_us();
+    const std::string key = std::string(name) + stage;
+    if (key == previous && now - last < 250000 && progress != 1) { return; }
+    previous = key; last = now;
+    char data[768];
+    size_t at = std::snprintf(data, sizeof(data), "wildllama_activity {\"kind\":\"phase\",\"phase\":\"%s\",\"stage\":\"%s\"", name, stage);
+    auto append = [&](const char * format, auto... args) {
+        if (at >= sizeof(data)) { return; }
+        const int n = std::snprintf(data+at,sizeof(data)-at,format,args...);
+        at = n < 0 ? sizeof(data) : at + size_t(n);
+    };
+    if (progress >= 0 && std::isfinite(progress)) { append(",\"progress\":%.6f",std::min(1.0,progress)); }
+    if (processed >= 0) { append(",\"prompt_processed\":%lld",(long long) processed); }
+    if (total >= 0) { append(",\"prompt_total\":%lld",(long long) total); }
+    if (generated >= 0) { append(",\"generated_tokens\":%lld",(long long) generated); }
+    if (rate >= 0 && std::isfinite(rate)) { append(",\"tokens_per_second\":%.6g",rate); }
+    if (at >= sizeof(data)) { return; }
+    std::fprintf(stderr,"%s}\n",data);
+}
+
+struct scope;
+struct operation_state { const scope * visible = nullptr; scope * current = nullptr; int64_t last = 0; };
+inline operation_state & operations() { static thread_local operation_state state; return state; }
+struct scope {
+    scope * parent = nullptr;
+    const char * name;
+    int layer;
+    explicit scope(const char * name, int layer = -1) : name(name), layer(layer) {
+        if (!enabled()) { return; }
+        auto & state = operations(); parent = state.current; state.current = this;
+        if (this->layer < 0 && parent) { this->layer = parent->layer; }
+        const int64_t now = ggml_time_us();
+        if (now - state.last >= 250000) { publish(this, now); }
+    }
+    static void publish(const scope * current, int64_t now) {
+        auto & state = operations(); state.visible = current; state.last = now;
+        std::fprintf(stderr,"wildllama_activity {\"kind\":\"operation\",\"name\":\"%s\",\"layer\":%d}\n",
+                     current ? current->name : "compute", current ? current->layer : -1);
+    }
+    ~scope() {
+        if (!enabled()) { return; }
+        auto & state = operations(); state.current = parent;
+        // A published sub-operation must never remain displayed after it ends.
+        if (state.visible == this) { publish(parent, ggml_time_us()); }
+    }
+    scope(const scope &) = delete;
+    scope & operator=(const scope &) = delete;
+};
+
+inline int layer(const char * tensor_name) {
+    int result = -1;
+    return std::sscanf(tensor_name,"blk.%d.",&result) == 1 ? result : -1;
+}
+
+inline void ram(uint64_t used, uint64_t limit, uint64_t ssd, uint64_t h2d) {
+    if (!enabled()) { return; }
+    static thread_local int64_t last = 0;
+    const int64_t now = ggml_time_us(); if (now - last < 250000) { return; } last = now;
+    std::fprintf(stderr,"wildllama_activity {\"kind\":\"memory\",\"stage\":\"ram\",\"memory\":{\"ram_bytes\":%llu,\"ram_limit_bytes\":%llu,\"ssd_bytes\":%llu,\"h2d_bytes\":%llu}}\n",
+                 (unsigned long long) used,(unsigned long long) limit,(unsigned long long) ssd,(unsigned long long) h2d);
+}
+inline bool cuda_snapshot_due() {
+    if (!enabled()) { return false; }
+    static thread_local int64_t last = 0;
+    const int64_t now = ggml_time_us(); if (now - last < 250000) { return false; } last = now;
+    return true;
+}
+inline void cuda(uint64_t used, uint64_t limit) {
+    if (!enabled()) { return; }
+    std::fprintf(stderr,"wildllama_activity {\"kind\":\"memory\",\"stage\":\"cuda\",\"memory\":{\"vram_bytes\":%llu,\"vram_limit_bytes\":%llu}}\n",
+                 (unsigned long long) used,(unsigned long long) limit);
+}
+}
