+    auto mp = llama_model_default_params();
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false; mp.no_host = true; mp.moe_ram_limit = 1024*1024;
+    const llama_model_tensor_buft_override cpu_experts[] = { llm_ffn_exps_cpu_override(), { nullptr, nullptr } };
+    mp.tensor_buft_overrides = cpu_experts;
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 131072; cp.n_batch = 32; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.moe_cache_size = 8*1024*1024;
+    std::vector<ggml_backend_dev_t> devices;
+    uint32_t layers, trained_context, experts;
+    const auto full = common_get_device_memory_data(path, &mp, &cp, devices, layers, trained_context, experts, GGML_LOG_LEVEL_ERROR);
+    if (devices.size() != 1) { throw std::runtime_error("fit test needs exactly one GPU"); }
+    const size_t full_bytes = full[0].model + full[0].context + full[0].compute;
+    std::vector<size_t> margins(llama_max_devices(), (size_t) full[0].free - full_bytes/2);
+    std::vector<float> splits(llama_max_devices());
+    std::vector<llama_model_tensor_buft_override> overrides(llama_max_tensor_buft_overrides());
+    const auto status = common_fit_params(path, &mp, &cp, splits.data(), overrides.data(), margins.data(),
+        UINT32_MAX, nullptr, GGML_LOG_LEVEL_ERROR);
+    if (status != COMMON_PARAMS_FIT_STATUS_SUCCESS || cp.n_ctx != 131072 ||
+        mp.n_gpu_layers < 0 || mp.n_gpu_layers >= (int) layers + 1 || mp.tensor_buft_overrides != cpu_experts) {
+        throw std::runtime_error("constrained fit changed context or CPU overrides, or did not reduce GPU layers");
+    }
+    const auto fitted = common_get_device_memory_data(path, &mp, &cp, devices, layers, trained_context, experts, GGML_LOG_LEVEL_ERROR);
+    if ((int64_t) fitted[0].free - (int64_t) (fitted[0].model + fitted[0].context + fitted[0].compute) < (int64_t) margins[0]) {
+        throw std::runtime_error("fit did not meet the requested GPU margin");
+    }
+    printf("PASS fit: context 131072 preserved, %d GPU layers, CPU expert override preserved\n", mp.n_gpu_layers);
+}
+
+static std::vector<float> evaluate(const char * path, size_t budget, int gpu_layers, size_t gpu_cache) {
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = gpu_layers;
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false;
+    mp.no_host = true;
+    mp.moe_ram_limit = budget;
+    const llama_model_tensor_buft_override overrides[] = {
+        llm_ffn_exps_cpu_override(), { nullptr, nullptr },
+    };
+    mp.tensor_buft_overrides = overrides;
+    llama_model * model = llama_model_load_from_file(path, mp);
+    if (!model) { throw std::runtime_error("cannot load fixture"); }
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 256; cp.n_batch = 32; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.n_threads = 2; cp.n_threads_batch = 2;
+    cp.moe_cache_size = gpu_cache;
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { llama_model_free(model); throw std::runtime_error("cannot create fixture context"); }
+    std::vector<float> result;
+    std::vector<llama_token> prompt = { 50, 51, 52, 90, 91, 92, 66, 67, 68, 70, 71, 72, 100, 101, 102, 103 };
+    const int vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    for (int step = 0; step < 25; ++step) {
+        llama_batch batch = llama_batch_get_one(prompt.data(), (int32_t) prompt.size());
+        if (llama_decode(ctx, batch) != 0) {
+            llama_free(ctx); llama_model_free(model);
+            throw std::runtime_error("decode failed under weight budget");
+        }
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        if (!logits) { throw std::runtime_error("missing fixture logits"); }
+        result.insert(result.end(), logits, logits + vocab);
+        const auto next = (llama_token) (std::max_element(logits, logits + vocab) - logits);
+        prompt = { next };
+    }
+    llama_free(ctx); llama_model_free(model);
+    return result;
+}
+int main(int argc, char ** argv) {
+    if (argc < 2) { fprintf(stderr, "usage: test-moe-ram fixture.gguf [budget MiB] [GPU layers] [GPU expert cache MiB]\n"); return 2; }
+    ggml_backend_load_all();
+    llama_backend_init();
+    try {
+        const size_t budget = (argc > 2 ? std::stoul(argv[2]) : 1) * 1024*1024;
+        const int gpu_layers = argc > 3 ? std::stoi(argv[3]) : 0;
+        const size_t gpu_cache = (argc > 4 ? std::stoul(argv[4]) : 0) * 1024*1024;
+        if (gpu_layers > 0 && !ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)) {
+            throw std::runtime_error("GPU test requested but no GPU backend loaded");
+        }
+        const auto reference = evaluate(argv[1], 0, gpu_layers, gpu_cache);
+        const auto streamed = evaluate(argv[1], budget, gpu_layers, gpu_cache);
+        if (reference.size() != streamed.size()) { throw std::runtime_error("logit count differs"); }
+        float max_error = 0;
+        for (size_t i = 0; i < reference.size(); ++i) {
+            const float error = std::abs(reference[i] - streamed[i]);
+            max_error = std::max(max_error, error);
+            if (!std::isfinite(reference[i]) || !std::isfinite(streamed[i]) || error > 1e-6f * std::max(1.0f, std::abs(reference[i]))) {
+                fprintf(stderr, "logit %zu differs: %.9g vs %.9g\n", i, reference[i], streamed[i]);
+                throw std::runtime_error("streamed logits differ from resident logits");
+            }
+        }
+        // A budget smaller than one matrix must fail cleanly, never exceed its limit.
+        bool rejected = false;
+        try { evaluate(argv[1], 64*1024, 0, 0); }
+        catch (const std::exception &) { rejected = true; }
+        if (!rejected) { throw std::runtime_error("insufficient weight budget was not rejected"); }
+        if (gpu_layers > 0 && gpu_cache == 0) { test_fixed_context_fit(argv[1]); }
+        printf("PASS: %zu logits, maximum error %.9g, weight budget %zu MiB, GPU layers %d, GPU expert cache %zu MiB; insufficient budget rejected\n", reference.size(), max_error, budget/(1024*1024), gpu_layers, gpu_cache/(1024*1024));
+    } catch (const std::exception & e) {
+        fprintf(stderr, "FAIL: %s\n", e.what()); llama_backend_free(); return 1;
+    }
+    llama_backend_free();
+    return 0;
+}
