+    bool prefetch(const std::vector<llama_model_ram_range> & ranges);
+    void load_device_tensor(ggml_tensor * tensor, uint16_t file, size_t offset);
+    // Caller holds acquire(), as for prepare() and copy().
+    void read(const ggml_tensor * tensor, size_t offset, void * dst, size_t size);
+    std::unique_lock<std::mutex> acquire();
+    const char * error() const;
+    void report() const;
+    llama_model_ram_stats stats() const;
+private:
