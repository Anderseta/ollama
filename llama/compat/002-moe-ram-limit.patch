+    auto * ids = ggml_view_2d(ctx.get(), ids_storage, 3, 1, 24, 0);
+    ids->nb[0] = 8;
+    auto * indices4 = ggml_view_3d(ctx.get(), ids_storage, 2, 2, 2, 16, 32, 0);
+    auto * dst = ggml_dup_tensor(ctx.get(), weights);
+    auto * tail = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_I8, 127);
+    ggml_backend_ptr backend(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+    require(backend != nullptr, "CPU backend missing");
+    ggml_backend_buffer_ptr buf(ggml_backend_alloc_ctx_tensors(ctx.get(), backend.get()));
+    require(buf != nullptr, "cannot allocate test tensors");
+    llama_model_ram_cache cache(4*page, files);
+    cache.bind(weights, 0, 31); cache.bind(alias, 0, 31);
+    cache.bind(table, 0, 31 + 8*page); cache.bind(bias, 0, 31 + 16*page);
+    require(weights->data == alias->data, "tied weights were duplicated");
+    require(cache.prefetch({ { weights, 6*page, page }, { weights, page, page }, { alias, 6*page, page } }),
+        "queued prefetch of duplicate ranges failed");
+    const auto after_prefetch = cache.stats();
+    require(after_prefetch.resident == 2*page, "prefetch charged duplicate pages");
+    int32_t indices[16] = { 6, 999, 1, 999, 6, 999 };
+    ggml_backend_tensor_set(ids_storage, indices, 0, sizeof(indices));
+    ggml_tensor node = {};
+    node.flags = GGML_TENSOR_FLAG_COMPUTE;
+    node.op = GGML_OP_MUL_MAT_ID; node.src[0] = weights; node.src[2] = ids;
+    require(cache.needs_prepare(&node) && cache.prepare(&node), "strided routing failed");
+    require(cache.stats().bytes_read == after_prefetch.bytes_read, "prefetched weights reread from disk");
+    require(!memcmp((uint8_t *) weights->data + 6*page, raw.data() + 31 + 6*page, page), "wrong expert bytes");
+    require(cache.stats().resident == 2*page, "duplicate routing consumed extra pages");
+    const auto before_hit = cache.stats();
+    require(cache.prepare(&node) && cache.stats().bytes_read == before_hit.bytes_read && cache.stats().hits >= 2,
+        "cache hit unexpectedly reread the file");
+    indices[0] = 100;
+    ggml_backend_tensor_set(ids_storage, indices, 0, sizeof(indices));
+    require(!cache.prepare(&node), "invalid expert id accepted");
+    node.flags = 0;
+    require(!cache.needs_prepare(&node), "inactive branch prepared");
+    node.flags = GGML_TENSOR_FLAG_COMPUTE;
+    indices[0] = 0; indices[2] = 300; indices[4] = 0;
+    ggml_backend_tensor_set(ids_storage, indices, 0, sizeof(indices));
+    node.op = GGML_OP_ADD_ID; node.src[0] = nullptr; node.src[1] = bias;
+    require(cache.prepare(&node), "expert bias should read only selected rows");
+    require(!memcmp((uint8_t *) bias->data + 300*1024, raw.data() + 31 + 16*page + 300*1024, 1024), "wrong bias bytes");
+    require(std::strlen(cache.error()) == 0, "stale error after recovery");
+    for (size_t i = 0; i < 16; ++i) { indices[i] = int32_t((i*11)%128); }
+    ggml_backend_tensor_set(ids_storage, indices, 0, sizeof(indices));
+    node.op = GGML_OP_GET_ROWS; node.src[0] = table; node.src[1] = indices4; node.src[2] = nullptr;
+    require(cache.prepare(&node), "4D embedding lookup failed");
+    for (size_t i2 = 0; i2 < 2; ++i2) {
+        for (size_t i1 = 0; i1 < 2; ++i1) {
+            for (size_t i0 = 0; i0 < 2; ++i0) {
+                const auto id = indices[i0 + 4*i1 + 8*i2];
+                const auto at = id*table->nb[1] + i1*table->nb[2] + i2*table->nb[3];
+                require(!memcmp((uint8_t *) table->data + at, raw.data() + 31 + 8*page + at, 1024), "wrong 4D row");
+            }
+        }
+    }
+    node.op = GGML_OP_MUL_MAT; node.src[0] = weights; node.src[1] = nullptr;
+    require(!cache.prepare(&node), "operation larger than budget accepted");
+    const auto before_oversized = cache.stats();
+    require(!cache.prefetch({ { weights, 0, 8*page } }) && cache.stats().bytes_read == before_oversized.bytes_read,
+        "oversized prefetch must defer to streaming without I/O");
+    std::vector<uint8_t> result(8*page);
+    for (size_t pass = 0; pass < 8; ++pass) {
+        cache.read(weights, 0, result.data(), result.size());
+        require(!memcmp(result.data(), raw.data() + 31, result.size()), "evicted weights reloaded incorrectly");
+    }
+    require(cache.copy(backend.get(), weights, dst, 0, 0, 8*page), "chunked copy failed");
+    ggml_backend_tensor_get(dst, result.data(), 0, result.size());
+    require(!memcmp(result.data(), raw.data() + 31, result.size()), "chunked copy mismatch");
+    auto stats = cache.stats();
+    require(stats.peak <= 4*page && stats.evicted_pages > stats.eviction_calls && stats.eviction_calls > 0,
+        "budget or batched eviction invariant failed");
+    bool rejected = false;
+    try { cache.bind(alias, 1, 0); } catch (const std::exception &) { rejected = true; }
+    require(rejected, "invalid shard accepted");
+    rejected = false;
+    try { cache.read(weights, 8*page - 1, result.data(), 2); } catch (const std::exception &) { rejected = true; }
+    require(rejected, "out of bounds read accepted");
+    rejected = false;
+    try { cache.prefetch({ { weights, 8*page - 1, 2 } }); } catch (const std::exception &) { rejected = true; }
+    require(rejected, "out of bounds prefetch accepted");
+    cache.bind(tail, 0, raw.size() - 127);
+    cache.read(tail, 0, result.data(), 127);
+    require(!memcmp(result.data(), raw.data() + raw.size() - 127, 127), "unaligned EOF read failed");
+    node.data = weights->data;
+    require(cache.needs_prepare(&node) && !cache.prepare(&node), "write to immutable weights accepted");
+    node.data = nullptr;
+    std::filesystem::resize_file(file.path, 31);
+    rejected = false;
+    try { cache.prefetch({ { weights, 0, 4*page } }); } catch (const std::exception &) { rejected = true; }
+    require(rejected && cache.stats().peak <= 4*page, "truncated read did not fail within budget");
+    printf("PASS cache: strided routing, tied weights, bias, 4D rows, eviction, recovery, bounds, exact bytes, peak %zu bytes\n", stats.peak);
+}
+
+static void test_fixed_context_fit(const char * path) {
+    auto mp = llama_model_default_params();
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false; mp.no_host = true; mp.moe_ram_limit = 1024*1024;
+    const llama_model_tensor_buft_override cpu_experts[] = { llm_ffn_exps_cpu_override(), { nullptr, nullptr } };
+    mp.tensor_buft_overrides = cpu_experts;
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 131072; cp.n_batch = 32; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.moe_cache_size = 8*1024*1024;
+    std::vector<ggml_backend_dev_t> devices;
+    uint32_t layers, trained_context, experts;
+    const auto full = common_get_device_memory_data(path, &mp, &cp, devices, layers, trained_context, experts, GGML_LOG_LEVEL_ERROR);
+    if (devices.size() != 1) { throw std::runtime_error("fit test needs exactly one GPU"); }
+    const size_t full_bytes = full[0].model + full[0].context + full[0].compute;
+    std::vector<size_t> margins(llama_max_devices(), (size_t) full[0].free - full_bytes/2);
+    std::vector<float> splits(llama_max_devices());
+    std::vector<llama_model_tensor_buft_override> overrides(llama_max_tensor_buft_overrides());
+    const auto status = common_fit_params(path, &mp, &cp, splits.data(), overrides.data(), margins.data(),
+        UINT32_MAX, nullptr, GGML_LOG_LEVEL_ERROR);
+    if (status != COMMON_PARAMS_FIT_STATUS_SUCCESS || cp.n_ctx != 131072 ||
+        mp.n_gpu_layers < 0 || mp.n_gpu_layers >= (int) layers + 1 || mp.tensor_buft_overrides != cpu_experts) {
+        throw std::runtime_error("constrained fit changed context or CPU overrides, or did not reduce GPU layers");
+    }
+    const auto fitted = common_get_device_memory_data(path, &mp, &cp, devices, layers, trained_context, experts, GGML_LOG_LEVEL_ERROR);
+    if ((int64_t) fitted[0].free - (int64_t) (fitted[0].model + fitted[0].context + fitted[0].compute) < (int64_t) margins[0]) {
+        throw std::runtime_error("fit did not meet the requested GPU margin");
+    }
+    printf("PASS fit: context 131072 preserved, %d GPU layers, CPU expert override preserved\n", mp.n_gpu_layers);
+}
+
+static std::vector<float> evaluate(const char * path, size_t budget, int gpu_layers, size_t gpu_cache, bool extended = false) {
+    auto mp = llama_model_default_params();
+    mp.n_gpu_layers = gpu_layers;
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false;
+    mp.no_host = true;
+    mp.moe_ram_limit = budget;
+    const llama_model_tensor_buft_override overrides[] = {
+        llm_ffn_exps_cpu_override(), { nullptr, nullptr },
+    };
+    mp.tensor_buft_overrides = overrides;
+    llama_model * model = llama_model_load_from_file(path, mp);
+    if (!model) { throw std::runtime_error("cannot load fixture"); }
+    std::vector<float> result;
+    if (extended) {
+        const auto count = llama_model_get_tok_embd(model, nullptr);
+        std::vector<float> full(count);
+        if (!count || llama_model_get_tok_embd(model, full.data()) != count) { throw std::runtime_error("cannot read token embeddings"); }
+        const llama_token tokens[] = { 258, 0, 61, 258 };
+        const auto width = count / llama_vocab_n_tokens(llama_model_get_vocab(model));
+        std::vector<float> rows(4*width);
+        if (llama_model_get_tok_embd_rows(model, tokens, 4, rows.data()) != rows.size()) { throw std::runtime_error("cannot read embedding rows"); }
+        for (size_t i = 0; i < 4; ++i) {
+            if (!std::equal(rows.begin() + i*width, rows.begin() + (i+1)*width, full.begin() + tokens[i]*width)) {
+                throw std::runtime_error("embedding row mismatch");
+            }
+        }
+        result.insert(result.end(), rows.begin(), rows.end());
+    }
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 256; cp.n_batch = 32; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.n_threads = 2; cp.n_threads_batch = 2;
+    cp.moe_cache_size = gpu_cache;
+    if (extended) {
+        cp.n_batch = 64; cp.n_ubatch = 64;
+        cp.type_k = GGML_TYPE_Q8_0; cp.type_v = GGML_TYPE_Q8_0;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    }
+    llama_context * ctx = llama_init_from_model(model, cp);
+    if (!ctx) { llama_model_free(model); throw std::runtime_error("cannot create fixture context"); }
+    std::vector<llama_token> prompt = { 50, 51, 52, 90, 91, 92, 66, 67, 68, 70, 71, 72, 100, 101, 102, 103 };
+    const int vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+    if (extended) { for (int i = 0; i < 16; ++i) { prompt.push_back(120 + i*7); } }
+    std::vector<uint8_t> saved;
+    for (int step = 0; step < (extended ? 97 : 25); ++step) {
+        if (extended && step == 48) {
+            prompt.clear();
+            for (int i = 0; i < 48; ++i) { prompt.push_back(40 + (i*17)%200); }
+        }
+        if (extended && step == 16) {
+            saved.resize(llama_state_get_size(ctx));
+            if (llama_state_get_data(ctx, saved.data(), saved.size()) != saved.size()) { throw std::runtime_error("state save failed"); }
+            if (llama_state_set_data(ctx, saved.data(), saved.size()) != saved.size()) { throw std::runtime_error("state restore failed"); }
+        }
+        llama_batch batch = llama_batch_get_one(prompt.data(), (int32_t) prompt.size());
+        if (llama_decode(ctx, batch) != 0) {
+            llama_free(ctx); llama_model_free(model);
+            throw std::runtime_error("decode failed under weight budget");
+        }
+        const float * logits = llama_get_logits_ith(ctx, -1);
+        if (!logits) { throw std::runtime_error("missing fixture logits"); }
+        result.insert(result.end(), logits, logits + vocab);
+        const auto next = (llama_token) (std::max_element(logits, logits + vocab) - logits);
+        prompt = { next };
+    }
+    llama_free(ctx); llama_model_free(model);
+    return result;
+}
+int main(int argc, char ** argv) {
+    if (argc < 2) { fprintf(stderr, "usage: test-moe-ram fixture.gguf [budget MiB] [GPU layers] [GPU expert cache MiB]\n"); return 2; }
+    ggml_backend_load_all();
+    llama_backend_init();
+    try {
+        if (std::string(argv[1]) == "--cache") {
+            require(argc > 2, "cache test needs an explicit temporary directory");
+            test_cache(argv[2]); llama_backend_free(); return 0;
+        }
+        const size_t budget = (argc > 2 ? std::stoul(argv[2]) : 1) * 1024*1024;
+        const int gpu_layers = argc > 3 ? std::stoi(argv[3]) : 0;
+        const size_t gpu_cache = (argc > 4 ? std::stoul(argv[4]) : 0) * 1024*1024;
+        if (argc > 5 && std::string(argv[5]) == "parallel") {
+            test_parallel_contexts(argv[1], budget, gpu_layers, gpu_cache);
+            llama_backend_free(); return 0;
+        }
+        if (gpu_layers > 0 && !ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)) {
+            throw std::runtime_error("GPU test requested but no GPU backend loaded");
+        }
+        const bool extended = argc > 5 && std::string(argv[5]) == "extended";
+        const auto reference = evaluate(argv[1], 0, gpu_layers, gpu_cache, extended);
+        const auto streamed = evaluate(argv[1], budget, gpu_layers, gpu_cache, extended);
+        if (reference.size() != streamed.size()) { throw std::runtime_error("logit count differs"); }
+        float max_error = 0;
+        for (size_t i = 0; i < reference.size(); ++i) {
+            const float error = std::abs(reference[i] - streamed[i]);
+            max_error = std::max(max_error, error);
+            if (!std::isfinite(reference[i]) || !std::isfinite(streamed[i]) || error > 1e-6f * std::max(1.0f, std::abs(reference[i]))) {
+                fprintf(stderr, "logit %zu differs: %.9g vs %.9g\n", i, reference[i], streamed[i]);
+                throw std::runtime_error("streamed logits differ from resident logits");
+            }
+        }
+        // A budget smaller than one matrix must fail cleanly, never exceed its limit.
+        bool rejected = false;
+        try { evaluate(argv[1], 64*1024, 0, 0); }
+        catch (const std::exception &) { rejected = true; }
+        if (!rejected) { throw std::runtime_error("insufficient weight budget was not rejected"); }
+        if (gpu_layers > 0 && gpu_cache == 0) { test_fixed_context_fit(argv[1]); }
+        printf("PASS: %zu logits, maximum error %.9g, weight budget %zu MiB, GPU layers %d, GPU expert cache %zu MiB; insufficient budget rejected\n", reference.size(), max_error, budget/(1024*1024), gpu_layers, gpu_cache/(1024*1024));
+    } catch (const std::exception & e) {
+        fprintf(stderr, "FAIL: %s\n", e.what()); llama_backend_free(); return 1;
+    }
+    llama_backend_free();
+    return 0;
+}
