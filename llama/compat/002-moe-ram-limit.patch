@@ -0,0 +1,616 @@
+#include "llama-model-ram.h"
+#include "llama-impl.h"
+#include "ggml.h"
+
+#include <algorithm>
+#include <array>
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <list>
+#include <map>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+#ifdef _WIN32
+#define NOMINMAX
+#include <windows.h>
+#include <io.h>
+#else
+#include <fcntl.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <sys/resource.h>
+#include <unistd.h>
+#endif
+
+namespace {
+constexpr size_t page_size = 64 * 1024;
+constexpr size_t io_size = 4 * 1024 * 1024;
+constexpr size_t alignment = 4096;
+#ifdef _WIN32
+constexpr size_t io_depth = 4;
+#else
+constexpr size_t io_depth = 1;
+#endif
+constexpr size_t io_chunk = io_size / io_depth;
+constexpr size_t staging_size = io_size + io_depth * alignment;
+size_t checked_add(size_t a, size_t b) {
+    if (b > SIZE_MAX - a) { throw std::runtime_error("MoE RAM cache: byte range overflow"); }
+    return a + b;
+}
+size_t round_up(size_t n, size_t a) { return checked_add(n, a - 1) / a * a; }
+
+struct reader {
+    const size_t size;
+#ifdef _WIN32
+    HANDLE handle = INVALID_HANDLE_VALUE;
+    HANDLE async_handle = INVALID_HANDLE_VALUE;
+    explicit reader(const llama_file & file) : size(file.size()) {
+        HANDLE old = (HANDLE) _get_osfhandle(file.file_id());
+        std::vector<wchar_t> path(32768);
+        DWORD n = GetFinalPathNameByHandleW(old, path.data(), (DWORD) path.size(), FILE_NAME_NORMALIZED);
+        if (!n || n >= path.size()) { throw std::runtime_error("MoE RAM cache: cannot resolve GGUF file"); }
+        handle = CreateFileW(path.data(), GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             nullptr, OPEN_EXISTING, FILE_FLAG_NO_BUFFERING, nullptr);
+        if (handle == INVALID_HANDLE_VALUE) { throw std::runtime_error("MoE RAM cache: cannot open unbuffered GGUF reader"); }
+    }
+    ~reader() {
+        if (async_handle != INVALID_HANDLE_VALUE) { CloseHandle(async_handle); }
+        if (handle != INVALID_HANDLE_VALUE) { CloseHandle(handle); }
+    }
+    HANDLE overlapped_handle() {
+        if (async_handle == INVALID_HANDLE_VALUE) {
+            async_handle = ReOpenFile(handle, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                                      FILE_FLAG_NO_BUFFERING | FILE_FLAG_OVERLAPPED);
+            if (async_handle == INVALID_HANDLE_VALUE) { throw std::runtime_error("MoE RAM cache: cannot open queued GGUF reader"); }
+        }
+        return async_handle;
+    }
+    size_t read_at(void * dst, size_t size, uint64_t offset) {
+        OVERLAPPED ov = {};
+        ov.Offset = (DWORD) offset;
+        ov.OffsetHigh = (DWORD) (offset >> 32);
+        DWORD got = 0;
+        if (!ReadFile(handle, dst, (DWORD) size, &got, &ov) && GetLastError() != ERROR_HANDLE_EOF) {
+            throw std::runtime_error("MoE RAM cache: unbuffered GGUF read failed");
+        }
+        return got;
+    }
+#else
+    int fd = -1;
+    explicit reader(const llama_file & file) : size(file.size()) {
+#if defined(__linux__)
+        std::string path = "/proc/self/fd/" + std::to_string(file.file_id());
+        fd = open(path.c_str(), O_RDONLY | O_DIRECT | O_CLOEXEC);
+#elif defined(F_NOCACHE)
+        fd = dup(file.file_id());
+        if (fd >= 0 && fcntl(fd, F_NOCACHE, 1) != 0) { close(fd); fd = -1; }
+#else
+        (void) file; // No buffered fallback on platforms without a cache-bypass API.
+#endif
+        if (fd < 0) { throw std::runtime_error("MoE RAM cache: direct GGUF reads are unavailable"); }
+    }
+    ~reader() { if (fd >= 0) { close(fd); } }
+    size_t read_at(void * dst, size_t size, uint64_t offset) {
+        ssize_t n;
+        do { n = pread(fd, dst, size, (off_t) offset); } while (n < 0 && errno == EINTR);
+        if (n < 0) { throw std::runtime_error("MoE RAM cache: direct GGUF read failed"); }
+        return (size_t) n;
+    }
+#endif
+};
+
+struct read_request {
+    size_t bytes = 0;
+#ifdef _WIN32
+    OVERLAPPED ov = {};
+    HANDLE file = INVALID_HANDLE_VALUE;
+    bool pending = false;
+    read_request() {
+        ov.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+        if (!ov.hEvent) { throw std::runtime_error("MoE RAM cache: cannot create I/O event"); }
+    }
+    ~read_request() { drain(); CloseHandle(ov.hEvent); }
+    void start(reader & source, void * dst, size_t size, uint64_t offset) {
+        GGML_ASSERT(!pending);
+        file = source.overlapped_handle();
+        const HANDLE event = ov.hEvent;
+        ov = {};
+        ov.hEvent = event;
+        if (!ResetEvent(event)) { throw std::runtime_error("MoE RAM cache: cannot reset I/O event"); }
+        ov.Offset = (DWORD) offset;
+        ov.OffsetHigh = (DWORD) (offset >> 32);
+        DWORD got = 0;
+        if (ReadFile(file, dst, (DWORD) size, &got, &ov)) { bytes = got; return; }
+        const DWORD error = GetLastError();
+        if (error == ERROR_IO_PENDING) { pending = true; return; }
+        if (error == ERROR_HANDLE_EOF) { bytes = 0; return; }
+        throw std::runtime_error("MoE RAM cache: queued GGUF read failed");
+    }
+    size_t finish() {
+        if (pending) {
+            DWORD got = 0;
+            const BOOL ok = GetOverlappedResult(file, &ov, &got, TRUE);
+            pending = false;
+            if (!ok && GetLastError() != ERROR_HANDLE_EOF) {
+                throw std::runtime_error("MoE RAM cache: queued GGUF completion failed");
+            }
+            bytes = got;
+        }
+        return bytes;
+    }
+    void drain() noexcept {
+        if (pending) {
+            CancelIoEx(file, &ov);
+            DWORD ignored = 0;
+            GetOverlappedResult(file, &ov, &ignored, TRUE);
+            pending = false;
+        }
+    }
+#else
+    void start(reader & source, void * dst, size_t size, uint64_t offset) { bytes = source.read_at(dst, size, offset); }
+    size_t finish() { return bytes; }
+    void drain() noexcept {}
+#endif
+};
+
+void * reserve(size_t size) {
+#ifdef _WIN32
+    void * p = VirtualAlloc(nullptr, size, MEM_RESERVE, PAGE_READWRITE);
+#else
+    void * p = mmap(nullptr, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+    if (p == MAP_FAILED) { p = nullptr; }
+#endif
+    if (!p) { throw std::runtime_error("MoE RAM cache: virtual address reservation failed"); }
+    return p;
+}
+void release(void * ptr, size_t size) {
+#ifdef _WIN32
+    (void) size;
+    VirtualFree(ptr, 0, MEM_RELEASE);
+#else
+    munmap(ptr, size);
+#endif
+}
+void commit_lock(void * ptr, size_t size) {
+#ifdef _WIN32
+    if (!VirtualAlloc(ptr, size, MEM_COMMIT, PAGE_READWRITE)) { throw std::runtime_error("MoE RAM cache: commit failed"); }
+    if (!VirtualLock(ptr, size)) {
+        VirtualFree(ptr, size, MEM_DECOMMIT);
+        throw std::runtime_error("MoE RAM cache: cannot lock weights; refusing pagefile fallback");
+    }
+#else
+    if (mprotect(ptr, size, PROT_READ | PROT_WRITE) != 0) { throw std::runtime_error("MoE RAM cache: commit failed"); }
+    if (mlock(ptr, size) != 0) {
+        mprotect(ptr, size, PROT_NONE);
+        madvise(ptr, size, MADV_DONTNEED);
+        throw std::runtime_error("MoE RAM cache: cannot lock weights; increase the memlock allowance");
+    }
+#endif
+}
+void decommit(void * ptr, size_t size) {
+#ifdef _WIN32
+    if (!VirtualFree(ptr, size, MEM_DECOMMIT)) {
+        throw std::runtime_error("MoE RAM cache: cannot release weight pages");
+    }
+#else
+    // Replace the range atomically instead of unlocking pages before discarding them.
+    if (mmap(ptr, size, PROT_NONE, MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED, -1, 0) == MAP_FAILED) {
+        throw std::runtime_error("MoE RAM cache: cannot release weight pages");
+    }
+#endif
+}
+}
+
+struct llama_model_ram_cache::impl {
+    struct region;
+    struct page {
+        region * owner;
+        size_t index;
+        bool resident = false;
+        bool hot = false;
+        bool prefetched = false;
+        uint64_t epoch = 0;
+        std::list<page *>::iterator position;
+    };
+    struct region {
+        uint16_t file;
+        size_t offset, size, reserved;
+        uint8_t * data = nullptr;
+        std::vector<page> pages;
+        ~region() { if (data) { release(data, reserved); } }
+    };
+    size_t limit, resident = 0, peak = 0;
+    uint64_t epoch = 0, hits = 0, misses = 0, bytes_read = 0;
+    uint64_t read_calls = 0, evicted_pages = 0, eviction_calls = 0;
+    int64_t read_us = 0, release_us = 0, commit_us = 0, upload_us = 0;
+    std::vector<std::unique_ptr<reader>> readers;
+    std::vector<std::unique_ptr<region>> regions;
+    std::map<uintptr_t, region *> addresses;
+    std::list<page *> probation, protected_pages;
+    std::mutex compute_mutex;
+    std::string last_error;
+    uint8_t * staging = nullptr;
+    std::array<read_request, io_depth> requests;
+    bool poisoned = false;
+#ifdef _WIN32
+    SIZE_T old_min = 0, old_max = 0, current_min = 0;
+#endif
+
+    impl(size_t bytes, const llama_files & files) : limit(bytes / page_size * page_size) {
+        if (!limit) { throw std::runtime_error("MoE RAM cache: limit is smaller than a cache page"); }
+#ifdef _WIN32
+        if (!GetProcessWorkingSetSize(GetCurrentProcess(), &old_min, &old_max)) { throw std::runtime_error("MoE RAM cache: cannot query lock allowance"); }
+        current_min = old_min;
+#else
+        struct rlimit locked = {};
+        if (getrlimit(RLIMIT_MEMLOCK, &locked) == 0 && locked.rlim_cur != RLIM_INFINITY &&
+            locked.rlim_cur < checked_add(limit, staging_size)) {
+            LLAMA_LOG_WARN("MoE RAM cache: memlock allowance is %llu bytes; weights plus I/O need %zu bytes. Increase ulimit -l or the service LimitMEMLOCK if locking fails.\n",
+                (unsigned long long) locked.rlim_cur, checked_add(limit, staging_size));
+        }
+#endif
+        // Complete all potentially throwing reader construction before allocating the raw staging buffer.
+        for (const auto & file : files) { readers.emplace_back(new reader(*file)); }
+        allowance(0);
+#ifdef _WIN32
+        staging = (uint8_t *) VirtualAlloc(nullptr, staging_size, MEM_RESERVE | MEM_COMMIT, PAGE_READWRITE);
+        if (staging && !VirtualLock(staging, staging_size)) {
+            VirtualFree(staging, 0, MEM_RELEASE);
+            staging = nullptr;
+        }
+#else
+        if (posix_memalign((void **) &staging, alignment, staging_size) != 0) { staging = nullptr; }
+        if (staging && mlock(staging, staging_size) != 0) { free(staging); staging = nullptr; }
+#endif
+        if (!staging) {
+#ifdef _WIN32
+            SetProcessWorkingSetSize(GetCurrentProcess(), old_min, old_max);
+#endif
+            throw std::runtime_error("MoE RAM cache: cannot allocate and lock the I/O buffer");
+        }
+    }
+    ~impl() {
+        for (auto & request : requests) { request.drain(); }
+        // Releasing each reservation also releases its locked pages.
+        regions.clear();
+#ifdef _WIN32
+        VirtualUnlock(staging, staging_size);
+        VirtualFree(staging, 0, MEM_RELEASE);
+        if (old_min) { SetProcessWorkingSetSize(GetCurrentProcess(), old_min, old_max); }
+#else
+        munlock(staging, staging_size);
+        free(staging);
+#endif
+    }
+    region * find(const ggml_tensor * t) const {
+        if (!t || !t->data) { return nullptr; }
+        uintptr_t ptr = (uintptr_t) t->data;
+        auto it = addresses.upper_bound(ptr);
+        if (it == addresses.begin()) { return nullptr; }
+        region * r = (--it)->second;
+        return ptr - (uintptr_t) r->data < r->size ? r : nullptr;
+    }
+    const uint8_t * staged_read(uint16_t file, size_t offset, size_t size) {
+        if (file >= readers.size()) { throw std::runtime_error("MoE RAM cache: invalid GGUF shard"); }
+        if (size > io_size) { throw std::runtime_error("MoE RAM cache: I/O request exceeds staging capacity"); }
+        size_t base = offset / alignment * alignment;
+        size_t prefix = offset - base;
+        const int64_t start = ggml_time_us();
+        size_t got = readers[file]->read_at(staging, round_up(prefix + size, alignment), base);
+        read_us += ggml_time_us() - start;
+        ++read_calls;
+        bytes_read += got;
+        if (got < prefix + size) { throw std::runtime_error("MoE RAM cache: truncated GGUF read"); }
+        return staging + prefix;
+    }
+    void allowance(size_t wanted) {
+#ifdef _WIN32
+        // Grow the lock allowance in chunks rather than making a system call per cache page.
+        size_t need = checked_add(std::min(limit, round_up(wanted, 64 * 1024 * 1024)), 32 * 1024 * 1024);
+        if (need > current_min) {
+            SIZE_T maximum = std::max<size_t>(old_max, checked_add(need, 256 * 1024 * 1024));
+            if (!SetProcessWorkingSetSize(GetCurrentProcess(), need, maximum)) { throw std::runtime_error("MoE RAM cache: cannot increase weight-lock allowance"); }
+            current_min = need;
+        }
+#else
+        (void) wanted;
+#endif
+    }
+    void touch(page & p) {
+        auto & from = p.hot ? protected_pages : probation;
+        protected_pages.splice(protected_pages.end(), from, p.position);
+        p.hot = true;
+        if (protected_pages.size() > limit / page_size / 2) {
+            page * cold = protected_pages.front();
+            probation.splice(probation.end(), protected_pages, cold->position);
+            cold->hot = false;
+        }
+    }
+    void evict(size_t wanted) {
+        for (auto * queue : { &probation, &protected_pages }) {
+            for (auto it = queue->begin(); it != queue->end(); ++it) {
+                page * p = *it;
+                if (p->epoch == epoch) { continue; }
+                size_t n = 1;
+                auto end = std::next(it);
+                while (end != queue->end() && n * page_size < std::min(wanted, io_size)) {
+                    page * next = *end;
+                    if (next->epoch == epoch || next->owner != p->owner || next->index != p->index + n) { break; }
+                    ++n; ++end;
+                }
+                const int64_t start = ggml_time_us();
+                decommit(p->owner->data + p->index * page_size, n * page_size);
+                release_us += ggml_time_us() - start;
+                evicted_pages += n; ++eviction_calls;
+                for (auto cur = it; cur != end; ++cur) { (*cur)->resident = false; }
+                queue->erase(it, end);
+                resident -= n * page_size;
+                return;
+            }
+        }
+        throw std::runtime_error("MoE RAM cache: required weights exceed the limit");
+    }
+    void range(std::vector<page *> & needed, const ggml_tensor * t, size_t offset, size_t size) {
+        region * r = find(t);
+        if (!r || !size) { return; }
+        size_t start = checked_add((uintptr_t) t->data - (uintptr_t) r->data, offset);
+        size_t end = checked_add(start, size);
+        if (end > r->size) { throw std::runtime_error("MoE RAM cache: weight read exceeds GGUF tensor bounds"); }
+        for (size_t i = start / page_size; i < round_up(end, page_size) / page_size; ++i) {
+            page & p = r->pages[i];
+            if (p.epoch != epoch) { p.epoch = epoch; needed.push_back(&p); }
+        }
+    }
+    void ensure(std::vector<page *> & needed, bool prefetch = false) {
+        if (poisoned) { throw std::runtime_error("MoE RAM cache: unusable after failed page release"); }
+        if (needed.size() > limit / page_size) { throw std::runtime_error("MoE RAM cache: this operation needs more weight pages than the limit"); }
+        size_t missing = 0;
+        for (page * p : needed) {
+            if (p->resident) {
+                ++hits;
+                if (!prefetch) {
+                    if (!p->prefetched) { touch(*p); }
+                    p->prefetched = false;
+                }
+            } else { ++misses; missing += page_size; }
+        }
+        if (!missing) { return; }
+        while (missing > limit - resident) { evict(missing - (limit - resident)); }
+        allowance(resident + missing);
+        std::sort(needed.begin(), needed.end(), [](page * a, page * b) {
+            if (a->owner->file != b->owner->file) { return a->owner->file < b->owner->file; }
+            return a->owner->offset + a->index*page_size < b->owner->offset + b->index*page_size;
+        });
+        struct load_job {
+            std::list<page *> ready;
+            uint8_t * dst = nullptr;
+            size_t bytes = 0, size = 0, prefix = 0;
+            bool committed = false;
+        };
+        std::array<load_job, io_depth> jobs;
+        size_t i = 0, head = 0, active = 0;
+        try {
+            while (i < needed.size() || active) {
+                while (i < needed.size() && active < io_depth) {
+                    page * first = needed[i];
+                    if (first->resident) { ++i; continue; }
+                    size_t n = 1;
+                    while (i + n < needed.size() && n*page_size < io_chunk) {
+                        page * next = needed[i + n];
+                        if (next->resident || next->owner != first->owner || next->index != first->index + n) { break; }
+                        ++n;
+                    }
+                    const size_t slot = (head + active) % io_depth;
+                    auto & job = jobs[slot];
+                    region & r = *first->owner;
+                    const size_t offset = first->index*page_size;
+                    const size_t file_offset = checked_add(r.offset, offset);
+                    job.bytes = n*page_size;
+                    job.size = std::min(job.bytes, r.size - offset);
+                    job.prefix = file_offset % alignment;
+                    job.dst = r.data + offset;
+                    // Allocate queue entries before committing pages or submitting I/O.
+                    for (size_t j = 0; j < n; ++j) { job.ready.push_back(needed[i + j]); }
+                    int64_t start = ggml_time_us();
+                    commit_lock(job.dst, job.bytes);
+                    commit_us += ggml_time_us() - start;
+                    job.committed = true;
+                    resident += job.bytes; peak = std::max(peak, resident);
+                    start = ggml_time_us();
+                    requests[slot].start(*readers[r.file], staging + slot*(io_chunk + alignment),
+                                         round_up(job.prefix + job.size, alignment), file_offset - job.prefix);
+                    read_us += ggml_time_us() - start;
+                    ++read_calls;
+                    i += n; ++active;
+                }
+                if (!active) { break; }
+                auto & job = jobs[head];
+                const int64_t start = ggml_time_us();
+                const size_t got = requests[head].finish();
+                read_us += ggml_time_us() - start;
+                bytes_read += got;
+                if (got < job.prefix + job.size) { throw std::runtime_error("MoE RAM cache: truncated queued GGUF read"); }
+                memcpy(job.dst, staging + head*(io_chunk + alignment) + job.prefix, job.size);
+                for (auto it = job.ready.begin(); it != job.ready.end(); ++it) {
+                    page * p = *it;
+                    p->resident = true; p->hot = false; p->prefetched = prefetch;
+                    p->position = it;
+                }
+                probation.splice(probation.end(), job.ready);
+                job.committed = false;
+                head = (head + 1) % io_depth; --active;
+            }
+        } catch (...) {
+            // I/O must finish before its buffers or destination pages can be released.
+            for (auto & request : requests) { request.drain(); }
+            for (auto & job : jobs) {
+                if (!job.committed) { continue; }
+                try { decommit(job.dst, job.bytes); resident -= job.bytes; }
+                catch (...) { poisoned = true; }
+            }
+            throw;
+        }
+    }
+};
+
+llama_model_ram_cache::llama_model_ram_cache(size_t limit, const llama_files & files) : pimpl(new impl(limit, files)) {
+    LLAMA_LOG_INFO("moe_ram: host weight budget = %zu bytes\n", pimpl->limit);
+}
+llama_model_ram_cache::~llama_model_ram_cache() { report(); }
+void llama_model_ram_cache::report() const {
+    const auto & p = *pimpl;
+    LLAMA_LOG_INFO("moe_ram: limit = %.2f MiB, resident = %.2f MiB, peak = %.2f MiB, hits = %llu, misses = %llu, SSD reads = %.2f MiB\n",
+        p.limit / 1048576.0, p.resident / 1048576.0, p.peak / 1048576.0,
+        (unsigned long long) p.hits, (unsigned long long) p.misses, p.bytes_read / 1048576.0);
+    LLAMA_LOG_DEBUG("moe_ram: I/O = %.1f ms / %llu reads, commit = %.1f ms, release = %.1f ms / %llu calls / %llu pages, upload = %.1f ms\n",
+        p.read_us/1000.0, (unsigned long long) p.read_calls, p.commit_us/1000.0, p.release_us/1000.0,
+        (unsigned long long) p.eviction_calls, (unsigned long long) p.evicted_pages, p.upload_us/1000.0);
+}
+llama_model_ram_stats llama_model_ram_cache::stats() const {
+    const auto & p = *pimpl;
+    return { p.limit, p.resident, p.peak, p.hits, p.misses, p.bytes_read, p.read_calls, p.evicted_pages, p.eviction_calls };
+}
+void llama_model_ram_cache::bind(ggml_tensor * t, uint16_t file, size_t offset) {
+    auto & p = *pimpl;
+    const size_t bytes = ggml_nbytes(t);
+    if (file >= p.readers.size() || offset > p.readers[file]->size || bytes > p.readers[file]->size - offset) {
+        throw std::runtime_error("MoE RAM cache: tensor exceeds GGUF file bounds");
+    }
+    for (auto & r : p.regions) {
+        if (r->file == file && r->offset == offset && r->size == bytes) { t->data = r->data; return; }
+    }
+    auto r = std::unique_ptr<impl::region>(new impl::region);
+    r->file = file; r->offset = offset; r->size = bytes; r->reserved = round_up(bytes, page_size);
+    r->data = (uint8_t *) reserve(r->reserved);
+    r->pages.resize(r->reserved / page_size);
+    for (size_t i = 0; i < r->pages.size(); ++i) { r->pages[i].owner = r.get(); r->pages[i].index = i; }
+    t->data = r->data; p.addresses.emplace((uintptr_t) r->data, r.get()); p.regions.push_back(std::move(r));
+}
+bool llama_model_ram_cache::contains(const ggml_tensor * t) const { return pimpl->find(t) != nullptr; }
+bool llama_model_ram_cache::needs_prepare(const ggml_tensor * node) const {
+    // SELECT branches retain inactive nodes and their inputs may alias live intermediates.
+    if (!(node->flags & GGML_TENSOR_FLAG_COMPUTE)) { return false; }
+    if (node->op == GGML_OP_NONE || node->op == GGML_OP_VIEW || node->op == GGML_OP_RESHAPE || node->op == GGML_OP_PERMUTE || node->op == GGML_OP_TRANSPOSE) { return false; }
+    if (contains(node)) { return true; }
+    for (const auto * src : node->src) { if (contains(src)) { return true; } }
+    return false;
+}
+bool llama_model_ram_cache::prepare(ggml_tensor * node) {
+    auto & p = *pimpl;
+    try {
+        p.last_error.clear();
+        if (contains(node)) { throw std::runtime_error("MoE RAM cache: managed model weights are read-only"); }
+        ++p.epoch;
+        std::vector<impl::page *> needed;
+        for (int source = 0; source < GGML_MAX_SRC; ++source) {
+            const ggml_tensor * t = node->src[source];
+            if (!contains(t)) { continue; }
+            const bool expert_bias = source == 1 && node->op == GGML_OP_ADD_ID;
+            if (expert_bias || (source == 0 && (node->op == GGML_OP_MUL_MAT_ID || node->op == GGML_OP_GET_ROWS))) {
+                const ggml_tensor * ids = node->src[node->op == GGML_OP_GET_ROWS ? 1 : 2];
+                if (!ids || ids->type != GGML_TYPE_I32 || ids->ne[3] != 1) { throw std::runtime_error("MoE RAM cache: unsupported routing index layout"); }
+                if (contains(ids)) {
+                    p.range(needed, ids, 0, ggml_nbytes(ids));
+                    p.ensure(needed);
+                }
+                std::vector<uint8_t> data(ggml_nbytes(ids));
+                ggml_backend_tensor_get(ids, data.data(), 0, data.size());
+                for (int64_t i2 = 0; i2 < ids->ne[2]; ++i2) {
+                    for (int64_t i1 = 0; i1 < ids->ne[1]; ++i1) {
+                        for (int64_t i0 = 0; i0 < ids->ne[0]; ++i0) {
+                            int32_t id;
+                            memcpy(&id, data.data() + i0*ids->nb[0] + i1*ids->nb[1] + i2*ids->nb[2], sizeof(id));
+                            if (node->op == GGML_OP_MUL_MAT_ID) {
+                                if (id < 0 || id >= t->ne[2]) { throw std::runtime_error("MoE RAM cache: invalid expert index"); }
+                                p.range(needed, t, id*t->nb[2], t->nb[2]);
+                            } else if (expert_bias) {
+                                if (id < 0 || id >= t->ne[1]) { throw std::runtime_error("MoE RAM cache: invalid expert bias index"); }
+                                p.range(needed, t, id*t->nb[1], ggml_row_size(t->type, t->ne[0]));
+                            } else {
+                                if (id < 0 || id >= t->ne[1] || i1 >= t->ne[2] || i2 >= t->ne[3]) { throw std::runtime_error(std::string("MoE RAM cache: invalid row index in ") + node->name + " reading " + t->name + " id=" + std::to_string(id) + " rows=" + std::to_string(t->ne[1]) + " i1=" + std::to_string(i1) + "/" + std::to_string(t->ne[2]) + " i2=" + std::to_string(i2) + "/" + std::to_string(t->ne[3])); }
+                                p.range(needed, t, id*t->nb[1] + i1*t->nb[2] + i2*t->nb[3], ggml_row_size(t->type, t->ne[0]));
+                            }
+                        }
+                    }
+                }
+            } else { p.range(needed, t, 0, ggml_nbytes(t)); }
+        }
+        p.ensure(needed);
+        return true;
+    } catch (const std::exception & e) { p.last_error = e.what(); LLAMA_LOG_ERROR("%s\n", e.what()); return false; }
+}
+void llama_model_ram_cache::load_device_tensor(ggml_tensor * tensor, uint16_t file, size_t offset) {
+    const size_t size = ggml_nbytes(tensor);
+    for (size_t done = 0; done < size;) {
+        const size_t n = std::min(size - done, io_size);
+        // tensor_set completes the upload before the locked staging buffer is reused.
+        ggml_backend_tensor_set(tensor, pimpl->staged_read(file, checked_add(offset, done), n), done, n);
+        done += n;
+    }
+}
+void llama_model_ram_cache::read(const ggml_tensor * src, size_t offset, void * dst, size_t size) {
+    auto & p = *pimpl;
+    if (checked_add(offset, size) > ggml_nbytes(src)) { throw std::runtime_error("MoE RAM cache: invalid host-copy range"); }
+    if (!contains(src)) { ggml_backend_tensor_get(src, dst, offset, size); return; }
+    const auto * r = p.find(src);
+    for (size_t done = 0; done < size;) {
+        const size_t at = checked_add((uintptr_t) src->data - (uintptr_t) r->data, checked_add(offset, done));
+        const size_t n = std::min({ size - done, io_size, p.limit - at % page_size });
+        ++p.epoch;
+        std::vector<impl::page *> needed;
+        p.range(needed, src, offset + done, n);
+        p.ensure(needed);
+        memcpy((uint8_t *) dst + done, (const uint8_t *) src->data + offset + done, n);
+        done += n;
+    }
+}
+bool llama_model_ram_cache::prefetch(const std::vector<llama_model_ram_range> & ranges) {
+    auto & p = *pimpl;
+    ++p.epoch;
+    std::vector<impl::page *> needed;
+    for (const auto & range : ranges) {
+        if (!range.tensor || checked_add(range.offset, range.size) > ggml_nbytes(range.tensor)) {
+            throw std::runtime_error("MoE RAM cache: invalid prefetch range");
+        }
+        const auto * r = p.find(range.tensor);
+        if (!r || !range.size) { continue; }
+        const size_t start = checked_add((uintptr_t) range.tensor->data - (uintptr_t) r->data, range.offset);
+        const size_t end = checked_add(start, range.size);
+        if (end > r->size) { throw std::runtime_error("MoE RAM cache: prefetch exceeds GGUF tensor bounds"); }
+        // An oversized batch uses the existing bounded streaming path.
+        if (round_up(end, page_size)/page_size - start/page_size > p.limit/page_size) { return false; }
+        p.range(needed, range.tensor, range.offset, range.size);
+        if (needed.size() > p.limit/page_size) { return false; }
+    }
+    p.ensure(needed, true);
+    return true;
+}
+bool llama_model_ram_cache::copy(ggml_backend_t backend, const ggml_tensor * src, ggml_tensor * dst, size_t src_offset, size_t dst_offset, size_t size) {
+    auto & p = *pimpl;
+    if (!contains(src)) { return false; }
+    if (checked_add(src_offset, size) > ggml_nbytes(src) || checked_add(dst_offset, size) > ggml_nbytes(dst)) {
+        throw std::runtime_error("MoE RAM cache: invalid device-copy range");
+    }
+    const auto * r = p.find(src);
+    size_t done = 0;
+    while (done < size) {
+        const size_t at = checked_add((uintptr_t) src->data - (uintptr_t) r->data, checked_add(src_offset, done));
+        const size_t n = std::min({ size - done, io_size, p.limit - at % page_size });
+        ++p.epoch;
+        std::vector<impl::page *> needed;
+        p.range(needed, src, checked_add(src_offset, done), n);
+        p.ensure(needed);
+        const int64_t start = ggml_time_us();
+        ggml_backend_tensor_set(dst, (const uint8_t *) src->data + src_offset + done, dst_offset + done, n);
+        ggml_backend_synchronize(backend);
+        p.upload_us += ggml_time_us() - start;
+        done += n;
+    }
+    return true;
+}
+std::unique_lock<std::mutex> llama_model_ram_cache::acquire() { return std::unique_lock<std::mutex>(pimpl->compute_mutex); }
+const char * llama_model_ram_cache::error() const { return pimpl->last_error.c_str(); }
