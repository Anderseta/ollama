+static void test_parallel_contexts(const char * path, size_t budget, int gpu_layers, size_t gpu_cache) {
+    if (gpu_layers > 0 && !ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU)) {
+        throw std::runtime_error("GPU test requested but no GPU backend loaded");
+    }
+    auto mp = llama_model_default_params();
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP; mp.use_extra_bufts = false; mp.no_host = true;
+    mp.moe_ram_limit = budget; mp.n_gpu_layers = gpu_layers;
+    const llama_model_tensor_buft_override overrides[] = { llm_ffn_exps_cpu_override(), { nullptr, nullptr } };
+    mp.tensor_buft_overrides = overrides;
+    llama_model_ptr model(llama_model_load_from_file(path, mp));
+    if (!model) { throw std::runtime_error("cannot load concurrent fixture"); }
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 256; cp.n_batch = 8; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.n_threads = 2; cp.n_threads_batch = 2; cp.moe_cache_size = gpu_cache;
+    auto decode = [&](llama_context * ctx, llama_token token) {
+        std::vector<float> result;
+        const auto vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+        for (int step = 0; step < 12; ++step) {
+            auto batch = llama_batch_get_one(&token, 1);
+            if (llama_decode(ctx, batch)) { throw std::runtime_error("concurrent decode failed"); }
+            const float * logits = llama_get_logits_ith(ctx, -1);
+            result.insert(result.end(), logits, logits + vocab);
+            token = (token + 13) % vocab;
+        }
+        return result;
+    };
+    std::vector<float> expected[2];
+    for (int i = 0; i < 2; ++i) {
+        llama_context_ptr ctx(llama_init_from_model(model.get(), cp));
+        if (!ctx) { throw std::runtime_error("cannot create serial context"); }
+        expected[i] = decode(ctx.get(), 50 + i*40);
+    }
+    llama_context_ptr contexts[] = {
+        llama_context_ptr(llama_init_from_model(model.get(), cp)),
+        llama_context_ptr(llama_init_from_model(model.get(), cp))
+    };
+    if (!contexts[0] || !contexts[1]) { throw std::runtime_error("cannot create concurrent contexts"); }
+    auto first = std::async(std::launch::async, [&] { return decode(contexts[0].get(), 50); });
+    auto second = std::async(std::launch::async, [&] { return decode(contexts[1].get(), 90); });
+    if (first.get() != expected[0] || second.get() != expected[1]) { throw std::runtime_error("concurrent context logits differ"); }
