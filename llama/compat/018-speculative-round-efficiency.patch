+void check_prompt_materialization() {
+    for (auto type : {COMMON_SPECULATIVE_TYPE_NONE, COMMON_SPECULATIVE_TYPE_DRAFT_SIMPLE,
+                     COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3, COMMON_SPECULATIVE_TYPE_DRAFT_MTP,
+                     COMMON_SPECULATIVE_TYPE_DRAFT_DFLASH, COMMON_SPECULATIVE_TYPE_DRAFT_DSPARK}) {
+        require(!common_speculative_type_needs_prompt_tokens(type), "known neural drafter unexpectedly needs full history");
+    }
+    for (auto type : {COMMON_SPECULATIVE_TYPE_NGRAM_SIMPLE, COMMON_SPECULATIVE_TYPE_NGRAM_MAP_K,
+                     COMMON_SPECULATIVE_TYPE_NGRAM_MAP_K4V, COMMON_SPECULATIVE_TYPE_NGRAM_MOD,
+                     COMMON_SPECULATIVE_TYPE_NGRAM_CACHE, COMMON_SPECULATIVE_TYPE_COUNT,
+                     static_cast<common_speculative_type>(15)}) {
+        require(common_speculative_type_needs_prompt_tokens(type), "ngram/future type lost conservative history requirement");
+    }
+    llama_tokens scratch = {99};
+    int absent_materializations = 0;
+    require(common_speculative_prepare_prompt(nullptr, scratch, [&] { ++absent_materializations; return llama_tokens{1}; }) == nullptr &&
+            absent_materializations == 0 && scratch.empty(), "absent spec materialized or retained stale history");
+    llama_tokens prompt;
+    for (int i = 0; i < 64; ++i) { prompt.push_back(1 + i%4); }
+    auto draft = [&](bool lazy) {
+        common_params_speculative config;
+        config.types = {COMMON_SPECULATIVE_TYPE_NGRAM_SIMPLE};
+        config.ngram_simple.size_n = 2; config.ngram_simple.size_m = 4;
+        common_speculative_ptr spec(common_speculative_init(config, 1));
+        require(bool(spec) && common_speculative_needs_prompt_tokens(spec.get()), "ngram prompt capability missing");
+        common_speculative_begin(spec.get(), 0, prompt);
+        llama_tokens storage, output;
+        int calls = 0;
+        auto & dp = common_speculative_get_draft_params(spec.get(), 0);
+        dp.drafting = true; dp.n_max = 4; dp.pos0 = llama_pos(prompt.size()); dp.id_last = 1; dp.result = &output;
+        dp.prompt = lazy ? common_speculative_prepare_prompt(spec.get(), storage, [&] { ++calls; return prompt; }) : &prompt;
+        common_speculative_draft(spec.get());
+        require(calls == (lazy ? 1 : 0), "ngram materialization count differs from one");
+        return output;
+    };
+    const auto lazy = draft(true), control = draft(false);
+    require(!lazy.empty() && lazy == control, "lazy ngram history changed actual lookup proposals");
+    std::puts("PASS prompt materialization: absent 0, ngram 1, identical real lookup proposals, conservative mixed/future policy");
+}
