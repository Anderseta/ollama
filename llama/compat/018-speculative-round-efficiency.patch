+// Neural drafters consume their existing native state, not a full token-history
+// copy. N-gram and unknown/future implementations conservatively need history.
+bool common_speculative_type_needs_prompt_tokens(common_speculative_type type);
+bool common_speculative_needs_prompt_tokens(const common_speculative * spec);
+
+// Materialize at most once, only when an installed implementation may use it.
+// Storage remains owned by the slot while the draft call runs asynchronously.
+template <typename Materialize>
+const llama_tokens * common_speculative_prepare_prompt(const common_speculative * spec,
+                                                      llama_tokens & storage, Materialize materialize) {
+    if (!common_speculative_needs_prompt_tokens(spec)) {
+        storage.clear();
+        return nullptr;
+    }
+    storage = materialize();
+    return &storage;
+}
 
