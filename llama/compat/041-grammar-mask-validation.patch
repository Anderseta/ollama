+            dst->src[3] ? (const int32_t *)dst->src[3]->data : nullptr,
+            dst->src[4] ? (const float *)dst->src[4]->data : nullptr,
+            dst->src[5] ? (const float *)dst->src[5]->data : nullptr,(int32_t *)dst->data,
+            ggml_nelements(dst->src[0]),dst->src[5] ? ggml_nelements(dst->src[5]) : 0,ggml_get_op_params_i32(dst,0));
+        return;
+    }
     GGML_ASSERT(dst->type == GGML_TYPE_F32 && ggml_is_contiguous(dst));
     const int64_t n = ggml_nelements(dst);
     const int32_t n_vocab = ggml_get_op_params_i32(dst, 0);
