+static __global__ void token_mask_validate_kernel(const float * logits,const uint32_t * words,
+        const int32_t * selected,const int32_t * ids,const float * probs,const float * pre_filter,
+        int32_t * output,int64_t n,int64_t pre_filter_n,int32_t vocab) {
+    __shared__ int valid,invalid;
+    if(threadIdx.x==0) {valid=0;invalid=0;}
+    __syncthreads();
+    for(int64_t i=threadIdx.x;i<n;i+=blockDim.x) {if(isnan(logits[i]) || logits[i]==INFINITY) {atomicExch(&invalid,1);}}
+    for(int64_t i=threadIdx.x;i<pre_filter_n;i+=blockDim.x) {if(isnan(pre_filter[i]) || pre_filter[i]==INFINITY) {atomicExch(&invalid,1);}}
+    const int32_t id=*selected;
+    if(id>=0 && id<vocab && (words[id/32]&(uint32_t(1)<<(id%32)))) {
+        if(ids) {
+            for(int64_t i=threadIdx.x;i<n;i+=blockDim.x) {
+                if(ids[i]==id && isfinite(logits[i]) && (!probs || (isfinite(probs[i]) && probs[i]>0))) {atomicExch(&valid,1);}
+            }
+        } else if(threadIdx.x==0 && id<n && isfinite(logits[id]) && (!probs || (isfinite(probs[id]) && probs[id]>0))) {valid=1;}
+    }
+    __syncthreads();
+    if(threadIdx.x==0) {*output=valid && !invalid ? id : -1;}
+}
