+void llama_context::graph_variant_save() {
+    auto & dst = graph_variants[graph_variant_active];
+    GGML_ASSERT(!dst.sched);
+    dst.sched = std::move(sched);
+    dst.results = std::move(gf_res_prev);
+    dst.active = gf_res_prev_active;
+    dst.bytes = graph_variant_bytes;
+    dst.last_used = graph_variant_last_used;
+    gf_res_prev_active = nullptr;
+}
+
+void llama_context::graph_variant_restore(size_t index) {
+    auto & src = graph_variants[index];
+    GGML_ASSERT(!sched);
+    sched = std::move(src.sched);
+    gf_res_prev = std::move(src.results);
+    gf_res_prev_active = src.active;
+    graph_variant_bytes = src.bytes;
+    graph_variant_last_used = src.last_used;
+    graph_variant_active = index;
+    src.active = nullptr;
+    src.bytes = 0;
+}
+
+void llama_context::graph_variant_evict(size_t index) {
+    auto & variant = graph_variants[index];
+    GGML_ASSERT(index && index != graph_variant_active);
+    if (variant.sched) {
+        // An inactive runtime was drained before it was parked. Account its
+        // submitted work once before releasing its independent allocator.
+        const auto stats = ggml_backend_sched_get_gpu_stats(variant.sched.get());
+        gpu_stats_previous.cpu_heavy_ops_submitted += stats.cpu_heavy_ops_submitted;
+        gpu_stats_previous.gpu_heavy_ops_submitted += stats.gpu_heavy_ops_submitted;
+        variant.sched.reset();
+    }
+    variant.active = nullptr;
+    variant.bytes = 0;
+    // Keep metadata arenas in fixed slots, rather than allocating new metadata
+    // addresses (and therefore new potential CUDA graph keys) on every eviction.
+    for (auto & result : variant.results) { if (result) { result->reset(); } }
+}
+
+void llama_context::graph_variants_clear() {
+    if (graph_variant_active) {
+        ggml_backend_sched_synchronize(sched.get());
+        graph_variant_save();
+        graph_variant_restore(0);
+    }
+    for (size_t i = 1; i < graph_variants.size(); ++i) {
+        graph_variant_evict(i);
+    }
+    graph_variant_bytes = 0;
+}
+
+size_t llama_context::graph_variant_retained_bytes() const {
+    size_t bytes = graph_variant_active ? graph_variant_bytes : 0;
+    if (graph_variant_active) {
+        for (const auto & result : gf_res_prev) {
+            if (result && !llama_graph_variant_policy::add_size(bytes, result->buf_compute_meta.capacity())) {
+                return std::numeric_limits<size_t>::max();
+            }
+        }
+    }
+    for (size_t i = 1; i < graph_variants.size(); ++i) {
+        if (!llama_graph_variant_policy::add_size(bytes, graph_variants[i].bytes)) {
+            return std::numeric_limits<size_t>::max();
+        }
+        for (const auto & result : graph_variants[i].results) {
+            if (result && !llama_graph_variant_policy::add_size(bytes, result->buf_compute_meta.capacity())) {
+                return std::numeric_limits<size_t>::max();
+            }
+        }
+    }
+    return bytes;
+}
