--- /dev/null
+++ b/src/llama-graph-variant-policy.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstddef>
+#include <limits>
+
+namespace llama_graph_variant_policy {
+constexpr size_t max_variants = 4;
+constexpr unsigned max_tokens = 8;
+
+// An optional cache must never turn malformed input into a large allocation.
+inline size_t parse_budget(const char * text) {
+    if (!text || !*text) { return 0; }
+    size_t mib = 0;
+    for (const char * p = text; *p; ++p) {
+        if (*p < '0' || *p > '9' || mib > 1024) { return 0; }
+        mib = mib*10 + size_t(*p - '0');
+    }
+    return mib <= 1024 ? mib*size_t(1024*1024) : 0;
+}
+
+inline bool add_size(size_t & total, size_t bytes) {
+    if (bytes > std::numeric_limits<size_t>::max() - total) { return false; }
+    total += bytes;
+    return true;
+}
+
+inline bool fits(size_t budget, size_t retained, size_t requested) {
+    return budget && retained <= budget && requested <= budget - retained;
+}
+}
