--- /dev/null
+++ b/tests/test-graph-variants.cpp
@@ -0,0 +1,176 @@
+#include "llama.h"
+#include "llama-context.h"
+#include "llama-graph-variant-policy.h"
+#include "ggml-backend.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+static void budget_environment(const char * value) {
+#ifdef _WIN32
+    require(_putenv_s("WILDLLAMA_GRAPH_VARIANTS_MIB", value) == 0, "cannot set test budget");
+#else
+    require(setenv("WILDLLAMA_GRAPH_VARIANTS_MIB", value, 1) == 0, "cannot set test budget");
+#endif
+}
+
+static void policy() {
+    using namespace llama_graph_variant_policy;
+    require(parse_budget(nullptr) == 0 && parse_budget("") == 0 && parse_budget("0") == 0, "disabled budget");
+    require(parse_budget("1") == 1024*1024 && parse_budget("1024") == size_t(1024)*1024*1024, "valid budget");
+    for (const char * invalid : {"-1", "+1", "1 ", " 1", "1MiB", "1025", "999999999999999999999999"}) {
+        require(parse_budget(invalid) == 0, "malformed budget accepted");
+    }
+    require(fits(100, 70, 30) && !fits(100, 70, 31) && !fits(100, 101, 0), "retention admission");
+    require(!fits(0, 0, 0), "zero budget enabled cache");
+    size_t sum = std::numeric_limits<size_t>::max() - 2;
+    require(add_size(sum, 2) && !add_size(sum, 1), "overflow accepted");
+    std::puts("graph-variant policy: PASS");
+}
+
+struct result {
+    std::vector<float> logits;
+    std::vector<llama_token> sampled;
+    int reused = 0;
+    size_t peak_arenas = 0;
+    size_t peak_compute_bytes = 0;
+};
+
+static result run(llama_model * model, const char * budget, bool invalidate, bool backend = false) {
+    budget_environment(budget);
+    auto params = llama_context_default_params();
+    params.n_ctx = 256;
+    params.n_batch = 64;
+    params.n_ubatch = 64;
+    params.n_threads = 2;
+    params.n_threads_batch = 2;
+    params.no_perf = false;
+    params.n_outputs_max = 64;
+    params.n_outputs_max_per_seq = 64;
+    auto * ctx = llama_init_from_model(model, params);
+    require(ctx != nullptr, "small context allocation failed");
+    llama_sampler * chain = nullptr;
+    auto batch = llama_batch_init(64, 0, 1);
+    result out;
+    try {
+        if (backend) {
+            chain = llama_sampler_chain_init(llama_sampler_chain_default_params());
+            llama_sampler_chain_add(chain, llama_sampler_init_top_k(20));
+            llama_sampler_chain_add(chain, llama_sampler_init_temp(0.7f));
+            llama_sampler_chain_add(chain, llama_sampler_init_dist(1234));
+            require(llama_set_sampler(ctx, 0, chain), "fixture cannot offload stochastic sampler");
+        }
+        const int n_vocab = llama_vocab_n_tokens(llama_model_get_vocab(model));
+        llama_pos position = 0;
+        // A B C B A -> retains B/C with stable independent bindings. Additional
+        // shapes exercise LRU eviction, while 16 uses the primary reservation.
+        const std::vector<int> sizes = {32, 1, 3, 2, 3, 1, 4, 5, 6, 7, 8, 3, 2, 16, 1, 3, 2};
+        for (size_t step = 0; step < sizes.size(); ++step) {
+            if (invalidate && step == 13) {
+                // A real parameter change must return to the primary arena and
+                // invalidate all retained bindings before reservation.
+                require(llama_set_adapter_cvec(ctx, nullptr, 0, 0, -1, -1) == 0, "parameter invalidation failed");
+            }
+            const int n = sizes[step];
+            batch.n_tokens = n;
+            for (int i = 0; i < n; ++i) {
+                batch.token[i] = 1 + (position + i) % std::max(1, n_vocab - 1);
+                batch.pos[i] = position + i;
+                batch.n_seq_id[i] = 1;
+                batch.seq_id[i][0] = 0;
+                batch.logits[i] = true;
+            }
+            require(llama_decode(ctx, batch) == 0, "shape-changing decode failed");
+            for (int i = 0; i < n; ++i) {
+                if (backend) {
+                    const auto token = llama_get_sampled_token_ith(ctx, i);
+                    require(token >= 0 && token < n_vocab, "backend sampling did not run");
+                    require(llama_sampler_sample(chain, ctx, i) == token, "backend token consumption changed");
+                    out.sampled.push_back(token);
+                    continue;
+                }
+                const float * row = llama_get_logits_ith(ctx, i);
+                require(row != nullptr, "logits missing");
+                for (int v = 0; v < n_vocab; ++v) { require(std::isfinite(row[v]), "nonfinite logits"); }
+                out.logits.insert(out.logits.end(), row, row + n_vocab);
+            }
+            const auto stats = ctx->get_graph_variant_stats();
+            require(stats.arenas <= llama_graph_variant_policy::max_variants, "unbounded graph arenas");
+            require(stats.compute_bytes <= llama_graph_variant_policy::parse_budget(budget), "compute cache exceeds budget");
+            require(stats.metadata_bytes <= llama_graph_variant_policy::parse_budget(budget) - stats.compute_bytes, "graph metadata exceeds budget");
+            out.peak_arenas = std::max(out.peak_arenas, stats.arenas);
+            out.peak_compute_bytes = std::max(out.peak_compute_bytes, stats.compute_bytes);
+            position += n;
+        }
+        out.reused = llama_perf_context(ctx).n_reused;
+    } catch (...) {
+        llama_batch_free(batch);
+        llama_free(ctx);
+        llama_sampler_free(chain);
+        throw;
+    }
+    llama_batch_free(batch);
+    llama_free(ctx);
+    llama_sampler_free(chain);
+    return out;
+}
+
+int main(int argc, char ** argv) {
+    try {
+        policy();
+        if (argc == 1) { return 0; }
+        require(argc == 2, "usage: test-graph-variants [small-local.gguf]");
+        // This test never downloads a model. The caller supplies a small local
+        // fixture; refuse larger files even when the wrong path is supplied.
+        FILE * file = std::fopen(argv[1], "rb");
+        require(file != nullptr, "fixture missing");
+        std::fseek(file, 0, SEEK_END);
+        const long length = std::ftell(file);
+        std::fclose(file);
+        require(length > 0 && length <= 64*1024*1024, "fixture exceeds 64 MiB");
+        ggml_backend_load_all();
+        llama_backend_init();
+        auto params = llama_model_default_params();
+        params.n_gpu_layers = 0;
+        auto * model = llama_model_load_from_file(argv[1], params);
+        require(model != nullptr, "fixture load failed");
+        try {
+            const auto baseline = run(model, "0", false);
+            const auto cached = run(model, "64", false);
+            const auto limited = run(model, "1", false);
+            const auto invalidated = run(model, "64", true);
+            const auto malformed = run(model, "9999999999999999999", false);
+            const auto sampler_baseline = run(model, "0", false, true);
+            const auto sampler_cached = run(model, "64", false, true);
+            require(baseline.logits == cached.logits, "retained graph changed CPU logits");
+            require(baseline.logits == limited.logits, "budget fallback changed CPU logits");
+            require(baseline.logits == invalidated.logits, "invalidation changed CPU logits");
+            require(baseline.logits == malformed.logits, "malformed budget changed baseline");
+            require(cached.peak_arenas > 0, "retained graph path was never exercised");
+            require(cached.reused > baseline.reused, "retained shapes were rebuilt rather than reused");
+            require(malformed.peak_arenas == 0, "invalid budget enabled retention");
+            require(limited.peak_arenas < cached.peak_arenas, "small budget admission was not exercised");
+            require(sampler_baseline.sampled == sampler_cached.sampled, "fallback changed stochastic RNG");
+            require(sampler_cached.peak_arenas == 0, "backend sampler graph bindings were retained");
+            std::printf("graph variants: PASS, reused %d -> %d; peak %zu arenas / %zu compute bytes\n",
+                    baseline.reused, cached.reused, cached.peak_arenas, cached.peak_compute_bytes);
+        } catch (...) { llama_model_free(model); throw; }
+        llama_model_free(model);
+        llama_backend_free();
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "graph variants: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
