+llama_context::graph_variant_selection llama_context::graph_variant_select(
+        const llama_ubatch & ubatch, llama_memory_context_i * mctx, llm_graph_type gtype) {
+    // Host-provider graphs have extra model-owned bindings that are not owned
+    // by a scheduler. Keep those, training, encoder and pipeline paths on the
+    // original arena. Fully resident dense and MoE models need no name list.
+    // Backend samplers also own graph-input pointers: switching their RNG and
+    // history alone would leave their input writes bound to the newest graph.
+    const bool eligible = graph_variant_budget && !graph_reuse_disable && !cparams.training &&
+        !cparams.pipeline_parallel && !cparams.warmup && !model.hparams.no_alloc && !moe_cache &&
+        !model.ram_cache && sampling.samplers.empty() && !cparams.cb_eval && model.hparams.causal_attn &&
+        cparams.causal_attn &&
+        ubatch.token && !ubatch.embd &&
+        ubatch.n_tokens && ubatch.n_tokens <= llama_graph_variant_policy::max_tokens &&
+        gtype != LLM_GRAPH_TYPE_ENCODER;
+
+    if (eligible) {
+        for (size_t i = 0; i < graph_variants.size(); ++i) {
+            auto & variant = graph_variants[i];
+            if (!variant.sched || !variant.active) { continue; }
+            auto params = graph_params(variant.active, ubatch, mctx, gtype);
+            params.sched = variant.sched.get();
+            // This rebinds every input's memory-context pointer. No previous
+            // microbatch memory-context object is dereferenced on a cache hit.
+            if (!variant.active->can_reuse(params)) { continue; }
+            ggml_backend_sched_synchronize(sched.get());
+            graph_variant_save();
+            graph_variant_restore(i);
+            graph_variant_last_used = ++graph_variant_clock;
+            return graph_variant_selection::reused;
+        }
+    }
+
+    // Large/unsupported requests, cache misses and allocation failures always
+    // have the original worst-case compute reservation available.
+    if (graph_variant_active) {
+        ggml_backend_sched_synchronize(sched.get());
+        graph_variant_save();
+        graph_variant_restore(0);
+        auto * previous = get_gf_res_prev();
+        const auto params = graph_params(previous, ubatch, mctx, gtype);
+        if (!graph_reuse_disable && gf_res_prev_active == previous && previous->can_reuse(params)) {
+            return graph_variant_selection::reused;
+        }
+    }
+    if (!eligible) { return graph_variant_selection::none; }
+
+    // Keep the first shape in the primary reservation. Secondary arenas are
+    // useful only after a real change of shape, not during the first decode.
+    if (!gf_res_prev_active) { return graph_variant_selection::none; }
+
+    const size_t max_nodes = graph_max_nodes(llama_graph_variant_policy::max_tokens);
+    size_t metadata = ggml_graph_overhead_custom(max_nodes, false);
+    if (max_nodes > std::numeric_limits<size_t>::max()/ggml_tensor_overhead() ||
+        !llama_graph_variant_policy::add_size(metadata, max_nodes*ggml_tensor_overhead())) {
+        return graph_variant_selection::none;
+    }
+    const size_t retained_metadata = get_graph_variant_stats().metadata_bytes;
+    size_t chosen = 0;
+    for (size_t i = 1; i < graph_variants.size(); ++i) {
+        const auto & variant = graph_variants[i];
+        const auto & result = variant.results[n_outputs > 0];
+        if (!variant.sched) {
+            // Under a small budget, reuse an older initialized slot instead of
+            // repeatedly attempting a new metadata arena that cannot fit.
+            const size_t extra = result && result->get_max_nodes() >= int64_t(max_nodes) ? 0 : metadata;
+            if (llama_graph_variant_policy::fits(graph_variant_budget, retained_metadata, extra)) {
+                chosen = i; break;
+            }
+            continue;
+        }
+        if (!chosen || variant.last_used < graph_variants[chosen].last_used) { chosen = i; }
+    }
+    if (!chosen) { return graph_variant_selection::none; }
+
+    ggml_backend_sched_synchronize(sched.get());
+    graph_variant_save();
+    graph_variant_evict(chosen);
+    graph_variant_restore(chosen);
+    auto restore_primary = [&] {
+        // No candidate graph has been submitted. Failed optional allocations
+        // are released before retrying through the conventional scheduler.
+        sched.reset();
+        gf_res_prev_active = nullptr;
+        graph_variant_bytes = 0;
+        for (auto & result : gf_res_prev) { if (result) { result->reset(); } }
+        graph_variant_save();
+        graph_variant_restore(0);
+    };
+
+    try {
+        const auto & previous_result = gf_res_prev[n_outputs > 0];
+        if (!previous_result || previous_result->get_max_nodes() < int64_t(max_nodes)) {
+            if (!llama_graph_variant_policy::fits(graph_variant_budget, graph_variant_retained_bytes(), metadata)) {
+                restore_primary(); return graph_variant_selection::none;
+            }
+        }
+        auto create = [&]() -> ggml_cgraph * {
+            sched.reset(ggml_backend_sched_new(backend_ptrs.data(), backend_buft.data(),
+                    backend_ptrs.size(), max_nodes, false, cparams.op_offload));
+            if (!sched) { return nullptr; }
+            ggml_backend_sched_set_gpu_exclusive(sched.get(), model.gpu_exclusive());
+            ggml_backend_sched_set_copy_callback(sched.get(), sched_copy_experts, this);
+            ggml_backend_sched_set_realloc_callback(sched.get(), sched_graph_realloc, this);
+            auto & result = gf_res_prev[n_outputs > 0];
+            if (!result || result->get_max_nodes() < int64_t(max_nodes)) {
+                result.reset(new llm_graph_result(max_nodes));
+            } else { result->reset(); }
+            auto * graph = model.build_graph(graph_params(result.get(), ubatch, mctx, gtype));
+            // Apply the same input placement during preflight and allocation
+            // as the baseline arena. Its backend is also in can_reuse's key.
+            place_nextn_input(result.get(), sched.get(), nextn_input_backend());
+            return graph;
+        };
+
+        auto * gf = create();
+        if (!gf) { restore_primary(); return graph_variant_selection::none; }
+
+        // Preflight without allocating backend compute buffers. Splitting a
+        // graph can rewrite its sources, so rebuild once after measurement.
+        std::vector<size_t> sizes(backend_ptrs.size(), 0);
+        ggml_backend_sched_reserve_size(sched.get(), gf, sizes.data());
+        size_t requested = 0;
+        bool valid = !ggml_backend_sched_get_error(sched.get())[0];
+        for (size_t bytes : sizes) { valid &= llama_graph_variant_policy::add_size(requested, bytes); }
+        if (!valid || !requested || requested > graph_variant_budget) {
+            restore_primary(); return graph_variant_selection::none;
+        }
+
+        // Admission is LRU within four fixed slots. The live primary arena is
+        // the baseline allocation and is not part of this extra-cache budget.
+        while (!llama_graph_variant_policy::fits(graph_variant_budget, graph_variant_retained_bytes(), requested)) {
+            size_t victim = 0;
+            for (size_t i = 1; i < graph_variants.size(); ++i) {
+                if (!graph_variants[i].sched) { continue; }
+                if (!victim || graph_variants[i].last_used < graph_variants[victim].last_used) { victim = i; }
+            }
+            if (!victim) { restore_primary(); return graph_variant_selection::none; }
+            graph_variant_evict(victim);
+        }
+
+        gf = create();
+        if (!gf || !ggml_backend_sched_alloc_graph(sched.get(), gf)) {
+            restore_primary(); return graph_variant_selection::none;
+        }
+        size_t actual = 0;
+        for (auto * backend : backend_ptrs) {
+            if (!llama_graph_variant_policy::add_size(actual, ggml_backend_sched_get_buffer_size(sched.get(), backend))) {
+                restore_primary(); return graph_variant_selection::none;
+            }
+        }
+        if (!llama_graph_variant_policy::fits(graph_variant_budget, graph_variant_retained_bytes(), actual)) {
+            restore_primary(); return graph_variant_selection::none;
+        }
+        graph_variant_bytes = actual;
+        graph_variant_last_used = ++graph_variant_clock;
+        gf_res_prev_active = get_gf_res_prev();
+        LLAMA_LOG_DEBUG("%s: retained short graph in arena %zu (%zu bytes, total %zu)\n",
+                __func__, chosen, actual, graph_variant_retained_bytes());
+        return graph_variant_selection::built;
+    } catch (const std::exception & error) {
+        LLAMA_LOG_DEBUG("%s: optional graph arena unavailable: %s\n", __func__, error.what());
+        restore_primary();
+        return graph_variant_selection::none;
+    }
+}
