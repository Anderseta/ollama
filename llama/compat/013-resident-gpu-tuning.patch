--- /dev/null
+++ b/ggml/include/ggml-cuda-tuning.h
@@ -0,0 +1,81 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Optional ABI obtained through ggml_backend_reg_get_proc_address with
+// "ggml_backend_cuda_tuning_api". Unsupported backends return null. Configure
+// only on a quiescent backend, before graph execution/capture. Never supplies
+// approximate kernels, changes model weights, or calibrates during inference.
+enum ggml_cuda_tuning_kernel {
+    GGML_CUDA_TUNING_DEFAULT = 0,
+    GGML_CUDA_TUNING_MMVQ = 1,
+    GGML_CUDA_TUNING_MMQ = 2,
+};
+
+enum ggml_cuda_tuning_status {
+    GGML_CUDA_TUNING_APPROVED = 0,
+    GGML_CUDA_TUNING_UNSUPPORTED,
+    GGML_CUDA_TUNING_INVALID,
+    GGML_CUDA_TUNING_CAPTURE,
+    GGML_CUDA_TUNING_BUDGET,
+    GGML_CUDA_TUNING_CANCELLED,
+    GGML_CUDA_TUNING_NONFINITE,
+    GGML_CUDA_TUNING_DIFFERENT,
+    GGML_CUDA_TUNING_NO_GAIN,
+    GGML_CUDA_TUNING_CUDA_ERROR,
+};
+
+struct ggml_cuda_tuning_limits {
+    uint32_t abi_version;       // 1
+    uint32_t pairs;             // 3..16 alternating timed pairs
+    uint32_t max_time_ms;       // 1..10000; no new work after this deadline
+    size_t max_scratch_bytes;   // <=256 MiB: fixed GPU arena + host output copies
+    bool allow_warmup;         // false honors --no-warmup: no kernels launched
+    bool (*abort_callback)(void * user_data);
+    void * abort_user_data;
+};
+
+struct ggml_cuda_tuning_result {
+    enum ggml_cuda_tuning_status status;
+    enum ggml_cuda_tuning_kernel original;
+    enum ggml_cuda_tuning_kernel selected;
+    uint32_t pairs;
+    double mmvq_ms;
+    double mmq_ms;
+    double minimum_speedup;
+    size_t scratch_bytes;
+    size_t workspace_bytes;     // observed fixed-arena peak; dispatch never grows its pool for a policy
+};
+
+struct ggml_cuda_tuning_stats {
+    uint32_t entries;
+    uint64_t hits;              // direct dispatch/capture only, not graph replays
+    uint64_t misses;
+    bool enabled;
+};
+
+struct ggml_backend_cuda_tuning_api {
+    uint32_t abi_version;       // 1
+    // fingerprint: SHA-256 identity from the trusted runtime, including exact
+    // native payload, complete kernel driver, physical UUID/PCI and hardware
+    // capabilities. Never reuse a fingerprint across devices or driver builds.
+    // Absolute cache_path is read only, bounded to 64 KiB and 128 entries.
+    // Null/empty path disables. Failed configuration also clears old policy.
+    bool (*configure)(ggml_backend_t backend, const char * cache_path, const char * fingerprint);
+    bool (*get_stats)(ggml_backend_t backend, struct ggml_cuda_tuning_stats * stats);
+    // Stand-alone calibration only, on an idle backend, with fully resident
+    // 2D contiguous quantized weights and F32 input/output; op is MUL_MAT.
+    // Every pair must be finite and bitwise equal. Gain must exceed 5% in
+    // every pair; otherwise selected stays DEFAULT. Deadline/abort cannot
+    // preempt an already launched CUDA kernel: cleanup drains it safely.
+    enum ggml_cuda_tuning_status (*calibrate)(ggml_backend_t backend, struct ggml_tensor * op,
+        const struct ggml_cuda_tuning_limits * limits, struct ggml_cuda_tuning_result * result);
+};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/src/ggml-cuda/resident-tuning-policy.h b/ggml/src/ggml-cuda/resident-tuning-policy.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/resident-tuning-policy.h
@@ -0,0 +1,159 @@
+#pragma once
+
+// CPU-only policy parsing/validation shared by the CUDA consumer and the
+// explicit calibration tool. No file I/O, CUDA calls, or policy search work
+// happens on the default inference path.
+#include "ggml-cuda-tuning.h"
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iomanip>
+#include <istream>
+#include <limits>
+#include <ostream>
+#include <sstream>
+#include <string>
+#include <tuple>
+
+namespace wildllama_cuda_tuning {
+constexpr size_t max_entries = 128;
+constexpr size_t max_file_bytes = 65536;
+constexpr double required_speedup = 1.05;
+
+struct key {
+    int type = 0;
+    int64_t k = 0, m = 0, n = 0;
+    bool operator<(const key & other) const {
+        return std::tie(type, k, m, n) < std::tie(other.type, other.k, other.m, other.n);
+    }
+    bool operator==(const key & other) const {
+        return type == other.type && k == other.k && m == other.m && n == other.n;
+    }
+};
+
+struct entry {
+    key shape;
+    ggml_cuda_tuning_kernel original = GGML_CUDA_TUNING_DEFAULT;
+    ggml_cuda_tuning_kernel selected = GGML_CUDA_TUNING_DEFAULT;
+    uint32_t pairs = 0;
+    double minimum_speedup = 0;
+    size_t workspace_bytes = 0;
+};
+
+inline bool fingerprint_valid(const std::string & value) {
+    if (value.size() != 64) { return false; }
+    for (char c : value) {
+        if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f'))) { return false; }
+    }
+    return true;
+}
+
+inline bool valid(const entry & e) {
+    return e.shape.type >= 0 && e.shape.type < GGML_TYPE_COUNT &&
+        e.shape.k >= 256 && e.shape.k <= 16384 && e.shape.k % 256 == 0 &&
+        e.shape.m >= 128 && e.shape.m <= 16384 && e.shape.m % 128 == 0 &&
+        e.shape.n >= 1 && e.shape.n <= 8 && e.pairs >= 3 && e.pairs <= 16 &&
+        (e.original == GGML_CUDA_TUNING_MMVQ || e.original == GGML_CUDA_TUNING_MMQ) &&
+        (e.selected == GGML_CUDA_TUNING_MMVQ || e.selected == GGML_CUDA_TUNING_MMQ) &&
+        e.original != e.selected && e.workspace_bytes > 0 && e.workspace_bytes <= size_t(256) * 1024 * 1024 && std::isfinite(e.minimum_speedup) &&
+        e.minimum_speedup >= required_speedup && e.minimum_speedup < 1000.0;
+}
+
+inline bool finite_bitwise_equal(const float * a, const float * b, size_t n) {
+    for (size_t i = 0; i < n; ++i) {
+        if (!std::isfinite(a[i]) || !std::isfinite(b[i])) { return false; }
+    }
+    return std::memcmp(a, b, n * sizeof(float)) == 0;
+}
+
+inline bool has_finite_values(const float * values, size_t n) {
+    return std::all_of(values, values + n, [](float value) { return std::isfinite(value); });
+}
+
+// Every paired result must favor the same alternative by at least 5%. Averages
+// alone cannot approve a noisy winner. Reject nonfinite/zero event durations.
+inline bool repeatable_gain(const double * mmvq, const double * mmq, size_t count,
+                            ggml_cuda_tuning_kernel original, double & minimum_speedup) {
+    if (count < 3 || count > 16 ||
+        (original != GGML_CUDA_TUNING_MMVQ && original != GGML_CUDA_TUNING_MMQ)) { return false; }
+    minimum_speedup = std::numeric_limits<double>::infinity();
+    for (size_t i = 0; i < count; ++i) {
+        if (!std::isfinite(mmvq[i]) || !std::isfinite(mmq[i]) || mmvq[i] <= 0 || mmq[i] <= 0) { return false; }
+        const double speedup = original == GGML_CUDA_TUNING_MMVQ ? mmvq[i] / mmq[i] : mmq[i] / mmvq[i];
+        minimum_speedup = std::min(minimum_speedup, speedup);
+    }
+    return std::isfinite(minimum_speedup) && minimum_speedup >= required_speedup && minimum_speedup < 1000.0;
+}
+
+struct policy {
+    std::array<entry, max_entries> entries{};
+    size_t count = 0;
+    uint64_t hits = 0, misses = 0;
+
+    ggml_cuda_tuning_kernel lookup(const key & shape, ggml_cuda_tuning_kernel original, size_t available_workspace) {
+        const auto end = entries.begin() + count;
+        const auto found = std::lower_bound(entries.begin(), end, shape,
+            [](const entry & e, const key & k) { return e.shape < k; });
+        if (found != end && found->shape == shape && found->original == original && found->workspace_bytes <= available_workspace) {
+            ++hits;
+            return found->selected;
+        }
+        ++misses;
+        return GGML_CUDA_TUNING_DEFAULT;
+    }
+};
+
+// Strict bounded text format, v1. The producer certifies "bitwise finite";
+// loading never broadens that validation or accepts a tolerance field.
+inline bool parse(std::istream & in, const std::string & expected_fingerprint, policy & out) {
+    out = {};
+    if (!fingerprint_valid(expected_fingerprint)) { return false; }
+    std::string bytes;
+    std::array<char, 4096> chunk{};
+    while (in) {
+        in.read(chunk.data(), chunk.size());
+        if (size_t(in.gcount()) > max_file_bytes - bytes.size()) { return false; }
+        bytes.append(chunk.data(), size_t(in.gcount()));
+    }
+    if (in.bad()) { return false; }
+    std::istringstream source(bytes);
+    std::string magic, fingerprint, validation;
+    unsigned version;
+    if (!(source >> magic >> version >> fingerprint >> validation) || magic != "wildllama-cuda-policy" ||
+        version != 1 || fingerprint != expected_fingerprint || validation != "bitwise-finite") { return false; }
+    policy parsed;
+    while (source >> std::ws && !source.eof()) {
+        if (parsed.count == max_entries) { return false; }
+        entry e;
+        int original, selected;
+        if (!(source >> e.shape.type >> e.shape.k >> e.shape.m >> e.shape.n >>
+              original >> selected >> e.pairs >> e.minimum_speedup >> e.workspace_bytes)) { return false; }
+        e.original = ggml_cuda_tuning_kernel(original);
+        e.selected = ggml_cuda_tuning_kernel(selected);
+        if (!valid(e)) { return false; }
+        parsed.entries[parsed.count++] = e;
+    }
+    std::sort(parsed.entries.begin(), parsed.entries.begin() + parsed.count,
+        [](const entry & a, const entry & b) { return a.shape < b.shape; });
+    for (size_t i = 1; i < parsed.count; ++i) {
+        if (parsed.entries[i - 1].shape == parsed.entries[i].shape) { return false; }
+    }
+    out = parsed;
+    return true;
+}
+
+inline bool serialize(std::ostream & out, const std::string & fingerprint, const policy & value) {
+    if (!fingerprint_valid(fingerprint) || value.count > max_entries) { return false; }
+    out << "wildllama-cuda-policy 1 " << fingerprint << " bitwise-finite\n";
+    out << std::setprecision(17);
+    for (size_t i = 0; i < value.count; ++i) {
+        const auto & e = value.entries[i];
+        if (!valid(e)) { return false; }
+        out << e.shape.type << ' ' << e.shape.k << ' ' << e.shape.m << ' ' << e.shape.n << ' '
+            << int(e.original) << ' ' << int(e.selected) << ' ' << e.pairs << ' ' << e.minimum_speedup << ' ' << e.workspace_bytes << '\n';
+    }
+    return bool(out);
+}
+} // namespace wildllama_cuda_tuning
