+static bool ggml_cuda_tuning_idle(ggml_backend_cuda_context & ctx) {
+    // A policy is immutable for the lifetime of any compiled CUDA graph.
+#ifdef USE_CUDA_GRAPH
+    if (ctx.any_cuda_graph_has_instance()) { return false; }
+#endif
+    if (ggml_cuda_lock_counter.load(std::memory_order_relaxed) != 0) { return false; }
+    cudaStreamCaptureStatus status;
+    return cudaStreamIsCapturing(ctx.stream(), &status) == cudaSuccess && status == cudaStreamCaptureStatusNone;
+}
+
+static bool ggml_cuda_tuning_configure(ggml_backend_t backend, const char * path, const char * fingerprint) {
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED(backend); GGML_UNUSED(path); GGML_UNUSED(fingerprint); return false;
+#else
+    if (!backend || !ggml_backend_is_cuda(backend)) { return false; }
+    auto & ctx = *static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(ctx.device);
+    if (!ggml_cuda_tuning_idle(ctx)) { return false; }
+    ctx.resident_tuning.reset();
+    if (!path || !*path) { return true; }
+    try {
+        if (!fingerprint || !wildllama_cuda_tuning::fingerprint_valid(fingerprint)) { return false; }
+        const std::filesystem::path file = std::filesystem::u8path(path);
+        std::error_code error;
+        if (!file.is_absolute() || !std::filesystem::is_regular_file(file, error) || error ||
+            std::filesystem::file_size(file, error) > wildllama_cuda_tuning::max_file_bytes || error) { return false; }
+        std::ifstream input(file, std::ios::binary);
+        auto policy = std::make_shared<wildllama_cuda_tuning::policy>();
+        if (!input || !wildllama_cuda_tuning::parse(input, fingerprint, *policy)) {
+            GGML_LOG_WARN("CUDA tuning: cache rejected; using original kernel heuristics\n");
+            return false;
+        }
+        ctx.resident_tuning = std::move(policy);
+        GGML_LOG_INFO("CUDA tuning: loaded %zu bitwise-validated dense kernel policies\n", ctx.resident_tuning->count);
+        return true;
+    } catch (const std::exception &) {
+        GGML_LOG_WARN("CUDA tuning: cache unavailable; using original kernel heuristics\n");
+        return false;
+    }
+#endif
+}
+
+static bool ggml_cuda_tuning_get_stats(ggml_backend_t backend, ggml_cuda_tuning_stats * stats) {
+    if (!backend || !stats || !ggml_backend_is_cuda(backend)) { return false; }
+    auto & ctx = *static_cast<ggml_backend_cuda_context *>(backend->context);
+    *stats = {};
+    if (ctx.resident_tuning) {
+        const auto & p = *ctx.resident_tuning;
+        *stats = {uint32_t(p.count), p.hits, p.misses, true};
+    }
+    return true;
+}
