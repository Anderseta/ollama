+static ggml_cuda_tuning_status ggml_cuda_tuning_calibrate(ggml_backend_t backend, ggml_tensor * op,
+        const ggml_cuda_tuning_limits * limits, ggml_cuda_tuning_result * result) {
+    if (!result) { return GGML_CUDA_TUNING_INVALID; }
+    *result = {};
+    result->status = GGML_CUDA_TUNING_INVALID;
+    auto finish = [&](ggml_cuda_tuning_status status) { result->status = status; return status; };
+#if defined(GGML_USE_HIP) || defined(GGML_USE_MUSA)
+    GGML_UNUSED(backend); GGML_UNUSED(op); GGML_UNUSED(limits);
+    return finish(GGML_CUDA_TUNING_UNSUPPORTED);
+#else
+    if (!backend || !ggml_backend_is_cuda(backend) || !op || !limits || limits->abi_version != 1 ||
+        limits->pairs < 3 || limits->pairs > 16 || !limits->max_time_ms || limits->max_time_ms > 10000 ||
+        !limits->max_scratch_bytes || limits->max_scratch_bytes > size_t(256) * 1024 * 1024) { return result->status; }
+    if (!limits->allow_warmup) { return finish(GGML_CUDA_TUNING_UNSUPPORTED); }
+    auto & source = *static_cast<ggml_backend_cuda_context *>(backend->context);
+    ggml_cuda_set_device(source.device);
+    if (!ggml_cuda_tuning_idle(source)) { return finish(GGML_CUDA_TUNING_CAPTURE); }
+    wildllama_cuda_tuning::key shape;
+    if (!ggml_cuda_tuning_key(source, op->src[0], op->src[1], op, shape, result->original)) {
+        return finish(GGML_CUDA_TUNING_UNSUPPORTED);
+    }
+    const auto begin = std::chrono::steady_clock::now();
+    auto stop = [&]() {
+        if (limits->abort_callback && limits->abort_callback(limits->abort_user_data)) { return GGML_CUDA_TUNING_CANCELLED; }
+        if (std::chrono::steady_clock::now() - begin >= std::chrono::milliseconds(limits->max_time_ms)) { return GGML_CUDA_TUNING_BUDGET; }
+        return GGML_CUDA_TUNING_APPROVED;
+    };
+    if (const auto reason = stop(); reason != GGML_CUDA_TUNING_APPROVED) { return finish(reason); }
+    const size_t output_bytes = ggml_nbytes(op);
+    if (output_bytes > limits->max_scratch_bytes / 4) { return finish(GGML_CUDA_TUNING_BUDGET); }
+    try {
+        std::vector<float> reference(output_bytes / sizeof(float)), candidate(reference.size());
+        const size_t arena_bytes = (limits->max_scratch_bytes - 2 * output_bytes) & ~size_t(255);
+        if (!arena_bytes) { return finish(GGML_CUDA_TUNING_BUDGET); }
+        if (cudaStreamSynchronize(source.stream()) != cudaSuccess) { return finish(GGML_CUDA_TUNING_CUDA_ERROR); }
+        ggml_backend_cuda_context calibration(source.device);
+        cudaStream_t stream = calibration.stream();
+        struct drain {
+            cudaStream_t stream;
+            ~drain() { (void) cudaStreamSynchronize(stream); }
+        } cleanup{stream};
+        calibration.pools[source.device][0] = std::make_unique<ggml_cuda_tuning_pool>(source.device, arena_bytes);
+        result->scratch_bytes = arena_bytes + 2 * output_bytes;
+        ggml_cuda_tuning_events events;
+        if (cudaEventCreate(&events.start) != cudaSuccess || cudaEventCreate(&events.stop) != cudaSuccess) {
+            return finish(GGML_CUDA_TUNING_CUDA_ERROR);
+        }
+        auto run = [&](ggml_cuda_tuning_kernel kernel, std::vector<float> & output, double & ms) {
+            if (const auto reason = stop(); reason != GGML_CUDA_TUNING_APPROVED) { return reason; }
+            if (cudaEventRecord(events.start, stream) != cudaSuccess) { return GGML_CUDA_TUNING_CUDA_ERROR; }
+            if (kernel == GGML_CUDA_TUNING_MMVQ) {
+                ggml_cuda_mul_mat_vec_q(calibration, op->src[0], op->src[1], nullptr, op);
+            } else {
+                ggml_cuda_mul_mat_q(calibration, op->src[0], op->src[1], nullptr, op);
+            }
+            if (cudaEventRecord(events.stop, stream) != cudaSuccess ||
+                cudaEventSynchronize(events.stop) != cudaSuccess) { return GGML_CUDA_TUNING_CUDA_ERROR; }
+            float elapsed;
+            if (cudaEventElapsedTime(&elapsed, events.start, events.stop) != cudaSuccess ||
+                cudaMemcpyAsync(output.data(), op->data, output_bytes, cudaMemcpyDeviceToHost, stream) != cudaSuccess ||
+                cudaStreamSynchronize(stream) != cudaSuccess) { return GGML_CUDA_TUNING_CUDA_ERROR; }
+            ms = elapsed;
+            return stop();
+        };
+        std::array<double, 16> mmvq{}, mmq{};
+        double ignored;
+        // Both candidates warm up explicitly; --no-warmup rejects before any
+        // launch. Measured pairs alternate order to avoid a fixed-order bias.
+        for (auto kernel : {GGML_CUDA_TUNING_MMVQ, GGML_CUDA_TUNING_MMQ}) {
+            const auto status = run(kernel, reference, ignored);
+            if (status != GGML_CUDA_TUNING_APPROVED) { return finish(status); }
+        }
+        for (uint32_t pair = 0; pair < limits->pairs; ++pair) {
+            for (unsigned i = 0; i < 2; ++i) {
+                const bool mv = ((pair + i) % 2) == 0;
+                const auto status = mv ? run(GGML_CUDA_TUNING_MMVQ, reference, mmvq[pair]) :
+                                         run(GGML_CUDA_TUNING_MMQ, candidate, mmq[pair]);
+                if (status != GGML_CUDA_TUNING_APPROVED) { return finish(status); }
+            }
+            if (!wildllama_cuda_tuning::has_finite_values(reference.data(), reference.size()) ||
+                !wildllama_cuda_tuning::has_finite_values(candidate.data(), candidate.size())) {
+                return finish(GGML_CUDA_TUNING_NONFINITE);
+            }
+            if (!wildllama_cuda_tuning::finite_bitwise_equal(reference.data(), candidate.data(), reference.size())) {
+                return finish(GGML_CUDA_TUNING_DIFFERENT);
+            }
+            ++result->pairs;
+            result->mmvq_ms += mmvq[pair] / limits->pairs;
+            result->mmq_ms += mmq[pair] / limits->pairs;
+        }
+        if (!wildllama_cuda_tuning::repeatable_gain(mmvq.data(), mmq.data(), limits->pairs, result->original, result->minimum_speedup)) {
+            return finish(GGML_CUDA_TUNING_NO_GAIN);
+        }
+        result->workspace_bytes = static_cast<ggml_cuda_tuning_pool *>(calibration.pools[source.device][0].get())->peak;
+        result->selected = result->original == GGML_CUDA_TUNING_MMVQ ? GGML_CUDA_TUNING_MMQ : GGML_CUDA_TUNING_MMVQ;
+        return finish(GGML_CUDA_TUNING_APPROVED);
+    } catch (const std::bad_alloc &) {
+        return finish(GGML_CUDA_TUNING_BUDGET);
+    } catch (const std::exception &) {
+        return finish(GGML_CUDA_TUNING_CUDA_ERROR);
+    }
+#endif
+}
