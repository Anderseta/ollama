+#if !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+// Fixed arena: normal quota-accounted CUDA allocation, no VMM expansion,
+// lookahead allocation or retained calibration workspace in the live context.
+struct ggml_cuda_tuning_pool final : ggml_cuda_pool {
+    int device;
+    char * data = nullptr;
+    size_t capacity, used = 0, peak = 0;
+    ggml_cuda_tuning_pool(int device, size_t capacity) : device(device), capacity(capacity) {
+        if (ggml_cuda_device_malloc(reinterpret_cast<void **>(&data), capacity, device) != cudaSuccess) {
+            (void) cudaGetLastError();
+            throw std::bad_alloc();
+        }
+    }
+    ~ggml_cuda_tuning_pool() override { if (data) { (void) ggml_cuda_device_free(data, device); } }
+    void * alloc(size_t size, size_t * actual) override {
+        if (size > SIZE_MAX - 255) { throw std::bad_alloc(); }
+        const size_t rounded = (size + 255) & ~size_t(255);
+        if (rounded > capacity - used) { throw std::bad_alloc(); }
+        void * result = data + used;
+        used += rounded;
+        peak = std::max(peak, used);
+        *actual = rounded;
+        return result;
+    }
+    void free(void * ptr, size_t size) override {
+        GGML_ASSERT(size <= used && ptr == data + used - size);
+        used -= size;
+    }
+};
+
+struct ggml_cuda_tuning_events {
+    cudaEvent_t start = nullptr, stop = nullptr;
+    ~ggml_cuda_tuning_events() {
+        if (start) { (void) cudaEventDestroy(start); }
+        if (stop) { (void) cudaEventDestroy(stop); }
+    }
+};
+#endif
