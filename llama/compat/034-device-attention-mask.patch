new file mode 100644
--- /dev/null
+++ b/src/llama-device-mask.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+// Admission is independent of backend/model names. Semantic capability and a
+// CUDA backend are checked separately before graph construction.
+struct llama_device_mask_plan {
+    uint64_t metadata_bytes = 0;
+    uint64_t dense_bytes = 0;
+    bool eligible = false;
+};
+
+inline llama_device_mask_plan llama_device_mask_admit(uint32_t n_kv, uint32_t n_tokens,
+        uint32_t n_stream, uint32_t n_sequences, bool f16) {
+    llama_device_mask_plan p;
+    if (!n_kv || !n_stream || !n_tokens || n_tokens % n_stream ||
+            !n_sequences || n_sequences > 32 || n_tokens > 65535) {
+        return p;
+    }
+    p.metadata_bytes = 2*sizeof(int32_t)*(uint64_t(n_kv)*n_stream + n_tokens);
+    p.dense_bytes = uint64_t(f16 ? 2 : 4)*n_kv*n_tokens;
+    p.eligible = n_tokens/n_stream >= 32 && p.dense_bytes >= 256*1024 &&
+        p.metadata_bytes <= 8*1024*1024 &&
+        p.metadata_bytes <= p.dense_bytes/4;
+    return p;
+}
+
+inline bool llama_device_mask_supported(bool causal, bool alibi, bool swa,
+        uint32_t n_pos, bool tokens, bool mixed, uint32_t n_sequences) {
+    return causal && !alibi && !swa && n_pos == 1 && tokens && !mixed &&
+        n_sequences > 0 && n_sequences <= 32;
+}
