+// Expand compact causal visibility metadata without doing floating-point math.
+void ggml_compute_forward_attn_mask(const ggml_compute_params * params, ggml_tensor * dst) {
+    const auto * keys = static_cast<const int32_t *>(dst->src[0]->data);
+    const auto * queries = static_cast<const int32_t *>(dst->src[1]->data);
+    const int64_t nk = dst->ne[0], nq = dst->ne[1];
+    const int64_t rows = nq * dst->ne[3];
+    const ggml_fp16_t drop16 = ggml_fp32_to_fp16(-INFINITY);
+    for (int64_t row = params->ith; row < rows; row += params->nth) {
+        const int64_t stream = row / nq, q = row % nq;
+        const int32_t * kp = keys + stream * 2 * nk;
+        const int32_t * qp = queries + stream * 2 * nq;
+        for (int64_t k = 0; k < nk; ++k) {
+            const bool keep = (uint32_t(kp[nk+k]) & uint32_t(qp[nq+q])) != 0 && kp[k] <= qp[q];
+            const int64_t i = row * nk + k;
+            if (dst->type == GGML_TYPE_F16) {
+                static_cast<ggml_fp16_t *>(dst->data)[i] = keep ? ggml_fp16_t(0) : drop16;
+            } else {
+                static_cast<float *>(dst->data)[i] = keep ? 0.0f : -INFINITY;
+            }
+        }
+    }
+}
