+
+// The output is exactly the existing 0/-inf mask. Only compact integer
+// metadata is staged from the host; the dense mask stays on the device.
+template<typename T>
+static __global__ void attn_mask_expand(const int32_t * keys, const int32_t * queries,
+        T * dst, int64_t nk, int64_t nq) {
+    const int64_t k = int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (k >= nk) {
+        return;
+    }
+    const int64_t row = blockIdx.y, q = row % nq, stream = row / nq;
+    const int64_t i = row * nk + k;
+    const int32_t * kp = keys + stream * 2 * nk;
+    const int32_t * qp = queries + stream * 2 * nq;
+    const bool keep = (uint32_t(kp[nk+k]) & uint32_t(qp[nq+q])) != 0 && kp[k] <= qp[q];
+    dst[i] = T(keep ? 0.0f : -INFINITY);
+}
+
+void ggml_cuda_op_attn_mask(ggml_backend_cuda_context & ctx, ggml_tensor * dst) {
+    GGML_ASSERT(dst->src[0]->type == GGML_TYPE_I32 && dst->src[1]->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(dst) && ggml_is_contiguous(dst->src[0]) && ggml_is_contiguous(dst->src[1]));
+    GGML_ASSERT(dst->ne[1] * dst->ne[3] <= 65535);
+    const dim3 blocks((unsigned) ((dst->ne[0] + 255) / 256), (unsigned) (dst->ne[1] * dst->ne[3]));
+    const auto * keys = static_cast<const int32_t *>(dst->src[0]->data);
+    const auto * queries = static_cast<const int32_t *>(dst->src[1]->data);
+    if (dst->type == GGML_TYPE_F16) {
+        attn_mask_expand<<<blocks, 256, 0, ctx.stream()>>>(keys, queries, static_cast<half *>(dst->data), dst->ne[0], dst->ne[1]);
+    } else {
+        GGML_ASSERT(dst->type == GGML_TYPE_F32);
+        attn_mask_expand<<<blocks, 256, 0, ctx.stream()>>>(keys, queries, static_cast<float *>(dst->data), dst->ne[0], dst->ne[1]);
+    }
+}
