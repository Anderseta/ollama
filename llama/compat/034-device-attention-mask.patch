+// ggml_attn_mask
+
+struct ggml_tensor * ggml_attn_mask(
+        struct ggml_context * ctx,
+        struct ggml_tensor * keys,
+        struct ggml_tensor * queries,
+        enum ggml_type type) {
+    GGML_ASSERT(keys->type == GGML_TYPE_I32 && queries->type == GGML_TYPE_I32);
+    GGML_ASSERT(ggml_is_contiguous(keys) && ggml_is_contiguous(queries));
+    GGML_ASSERT(keys->ne[0] > 0 && queries->ne[0] > 0);
+    GGML_ASSERT(keys->ne[1] == 2 && queries->ne[1] == 2);
+    GGML_ASSERT(keys->ne[2] == queries->ne[2] && keys->ne[3] == 1 && queries->ne[3] == 1);
+    GGML_ASSERT(type == GGML_TYPE_F16 || type == GGML_TYPE_F32);
+    struct ggml_tensor * result = ggml_new_tensor_4d(ctx, type, keys->ne[0], queries->ne[0], 1, keys->ne[2]);
