+// Component benchmark only: exact upstream-style first-row scan + row copies
+// and causal fringe updates, versus integer metadata upload + device expansion.
+// This does not claim an end-to-end model speedup. CUDA graph warmup is included
+// before timings; each measured iteration changes query positions.
+static void benchmark_staging(ggml_backend_t backend, int nk, int nq) {
+    ggml_context_ptr ctx(ggml_init({32*ggml_tensor_overhead()+ggml_graph_overhead_custom(32,false),nullptr,true}));
+    auto * keys=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,nk,2,1);
+    auto * queries=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,nq,2,1);
+    auto * out=ggml_attn_mask(ctx.get(),keys,queries,GGML_TYPE_F16);
+    auto * old=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F16,nk,nq);
+    auto * graph=ggml_new_graph_custom(ctx.get(),32,false);
+    ggml_build_forward_expand(graph,out);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),backend));
+    require(buffer!=nullptr,"cannot allocate bounded mask staging benchmark");
+    std::vector<int32_t> k(2*nk),q(2*nq);
+    std::vector<ggml_fp16_t> dense(size_t(nk)*nq),actual(dense.size());
+    const auto drop=ggml_fp32_to_fp16(-INFINITY);
+    auto fill=[&](int change) {
+        for(int j=0;j<nk;++j){k[j]=j;k[nk+j]=j%97 ? 1 : 0;}
+        for(int i=0;i<nq;++i){q[i]=nk-nq+i-(change&1);q[nq+i]=1;}
+    };
+    auto host_mask=[&] {
+        for(int j=0;j<nk;++j){dense[j]=(k[nk+j] && k[j]<=q[0]) ? ggml_fp16_t(0) : drop;}
+        const int fringe=std::max(0,q[0]-32);
+        for(int i=1;i<nq;++i){
+            auto * row=dense.data()+size_t(i)*nk;
+            std::memcpy(row,dense.data(),nk*sizeof(ggml_fp16_t));
+            for(int j=fringe;j<nk;++j){row[j]=(k[nk+j] && k[j]<=q[i]) ? ggml_fp16_t(0) : drop;}
+        }
+    };
+    std::vector<double> dense_times,compact_times;
+    for(int repeat=-8;repeat<24;++repeat){
+        // Alternate ordering to reduce one-sided thermal/background bias.
+        auto run=[&](bool compact){
+            const auto begin=std::chrono::steady_clock::now();
+            fill(repeat);
+            if(compact){
+                ggml_backend_tensor_set(keys,k.data(),0,k.size()*sizeof(int32_t));
+                ggml_backend_tensor_set(queries,q.data(),0,q.size()*sizeof(int32_t));
+                require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"mask staging benchmark compute failed");
+            } else {
+                host_mask();
+                ggml_backend_tensor_set(old,dense.data(),0,dense.size()*sizeof(ggml_fp16_t));
+                ggml_backend_synchronize(backend);
+            }
+            const double us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count();
+            if(repeat>=0){(compact ? compact_times : dense_times).push_back(us);}
+        };
+        run((repeat&1)!=0);run((repeat&1)==0);
+    }
+    fill(23);host_mask();
+    ggml_backend_tensor_get(out,actual.data(),0,actual.size()*sizeof(ggml_fp16_t));
+    require(actual==dense,"staging benchmark mask differs from optimized host reference");
+    std::sort(dense_times.begin(),dense_times.end());std::sort(compact_times.begin(),compact_times.end());
+    const double before=dense_times[dense_times.size()/2],after=compact_times[compact_times.size()/2];
+    std::printf("STAGING_COMPONENT nk=%d nq=%d repeats=24 dense_median_us=%.3f compact_median_us=%.3f speedup=%.3fx dense_upload=%zu compact_upload=%zu device_mask_bytes=%zu\n",
+        nk,nq,before,after,before/after,ggml_nbytes(old),(k.size()+q.size())*sizeof(int32_t),ggml_nbytes(out));
+}
+
+struct mask_observation { size_t ops=0, device_ops=0, input_bytes=0, output_bytes=0; } observed;
+static bool observe_mask(ggml_tensor * t, bool ask, void *) {
+    if (t->op != GGML_OP_ATTN_MASK) { return false; }
+    if (ask) { return true; }
+    ++observed.ops;
+    if (t->buffer && !ggml_backend_buffer_is_host(t->buffer)) { ++observed.device_ops; }
+    observed.input_bytes += ggml_nbytes(t->src[0])+ggml_nbytes(t->src[1]);
+    observed.output_bytes += ggml_nbytes(t);
+    return true;
+}
