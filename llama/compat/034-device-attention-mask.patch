+// Byte-exact output over unsorted positions, holes, shared sequence cells,
+// sign-bit sequence membership, INT32 position boundaries, and changed inputs
+// through repeated executions of the same graph (including CUDA graph replay).
+static size_t mask_case(ggml_backend_t backend, int nk, int nq, int ns, ggml_type type) {
+    ggml_context_ptr ctx(ggml_init({32*ggml_tensor_overhead()+ggml_graph_overhead_custom(32,false), nullptr, true}));
+    auto * keys = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_I32, nk, 2, ns);
+    auto * queries = ggml_new_tensor_3d(ctx.get(), GGML_TYPE_I32, nq, 2, ns);
+    auto * out = ggml_attn_mask(ctx.get(), keys, queries, type);
+    require(ggml_backend_supports_op(backend,out), "backend rejects compact attention mask");
+    auto * graph = ggml_new_graph_custom(ctx.get(),32,false);
+    ggml_build_forward_expand(graph,out);
+    ggml_backend_buffer_ptr buffer(ggml_backend_alloc_ctx_tensors(ctx.get(),backend));
+    require(buffer != nullptr, "cannot allocate tiny attention mask tensors");
+    const size_t element = type == GGML_TYPE_F16 ? 2 : 4;
+    std::vector<int32_t> k(2*nk*ns), q(2*nq*ns);
+    std::vector<unsigned char> expected(ggml_nbytes(out)), actual(expected.size());
+    const uint16_t inf16 = ggml_fp32_to_fp16(-INFINITY);
+    size_t checks = 0;
+    for (int change = 0; change < 6; ++change) {
+        for (int s = 0; s < ns; ++s) {
+            for (int i = 0; i < nk; ++i) {
+                const int at = s*2*nk+i;
+                k[at] = i%17 == 0 ? INT32_MIN : i%19 == 0 ? INT32_MAX : ((i*73+change*17+s*3)%nk)-4;
+                uint32_t bits = i%7 == 0 ? 0 : (uint32_t(1) << ((i+change+s)%32));
+                if (i%11 == 0) { bits |= 0x80000001u; }
+                std::memcpy(&k[at+nk],&bits,4);
+            }
+            for (int i = 0; i < nq; ++i) {
+                const int at = s*2*nq+i;
+                q[at] = i%13 == 0 ? INT32_MIN : i%23 == 0 ? INT32_MAX : (i*59+change*7+s)%nk;
+                const uint32_t bits = uint32_t(1) << ((i+3*change+s)%32);
+                std::memcpy(&q[at+nq],&bits,4);
+                for (int j = 0; j < nk; ++j) {
+                    const bool keep = (uint32_t(k[s*2*nk+nk+j]) & bits) != 0 && k[s*2*nk+j] <= q[at];
+                    const size_t dst = ((size_t(s)*nq+i)*nk+j)*element;
+                    if (type == GGML_TYPE_F16) {
+                        const uint16_t v = keep ? 0 : inf16;
+                        std::memcpy(expected.data()+dst,&v,2);
+                    } else {
+                        const float v = keep ? 0.0f : -INFINITY;
+                        std::memcpy(expected.data()+dst,&v,4);
+                    }
+                }
+            }
+        }
+        ggml_backend_tensor_set(keys,k.data(),0,k.size()*4);
+        ggml_backend_tensor_set(queries,q.data(),0,q.size()*4);
+        require(ggml_backend_graph_compute(backend,graph)==GGML_STATUS_SUCCESS,"attention mask compute failed");
+        ggml_backend_tensor_get(out,actual.data(),0,actual.size());
+        require(expected == actual,"compact visibility differs from exact reference");
+        checks += ggml_nelements(out);
+    }
+    std::printf("MASK nk=%d nq=%d streams=%d type=%s changed_inputs=6 exact_elements=%zu PASS\n",
+        nk,nq,ns,type==GGML_TYPE_F16 ? "F16" : "F32",checks);
+    return checks;
+}
