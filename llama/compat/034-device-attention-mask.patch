+void llama_kv_cache::set_input_mask_metadata(ggml_tensor * keys, ggml_tensor * queries, const llama_ubatch & ubatch) const {
+    GGML_ASSERT(ggml_backend_buffer_is_host(keys->buffer) && ggml_backend_buffer_is_host(queries->buffer));
+    const int64_t nk = keys->ne[0], nq = queries->ne[0], ns = keys->ne[2];
+    GGML_ASSERT(can_use_device_mask(ubatch, true, ns));
+    auto * kd = static_cast<int32_t *>(keys->data);
+    auto * qd = static_cast<int32_t *>(queries->data);
+    for (int64_t s = 0; s < ns; ++s) {
+        const auto stream = seq_to_stream[ubatch.seq_id[s*nq][0]];
+        const auto & cells = v_cells.at(stream);
+        auto * kp = kd + s * 2 * nk;
+        auto * qp = qd + s * 2 * nq;
+        for (int64_t k = 0; k < nk; ++k) {
+            uint32_t bits = 0;
+            if (!cells.is_empty(k)) {
+                for (uint32_t u = 0; u < ubatch.n_seqs_unq; ++u) {
+                    if (cells.seq_has(k, ubatch.seq_id_unq[u])) {
+                        bits |= uint32_t(1) << u;
+                    }
+                }
+                kp[k] = cells.pos_get(k);
+            } else {
