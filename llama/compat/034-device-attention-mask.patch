+using context_ptr = std::unique_ptr<llama_context, decltype(&llama_free)>;
+static context_ptr context(llama_model * model, bool cuda, bool fa) {
+    auto p = llama_context_default_params();
+    p.n_ctx=2048; p.n_batch=512; p.n_ubatch=512; p.n_seq_max=2;
+    p.kv_unified=true; p.n_threads=2; p.n_threads_batch=2;
+    p.op_offload=cuda; p.offload_kqv=cuda;
+    p.flash_attn_type=fa ? LLAMA_FLASH_ATTN_TYPE_ENABLED : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    p.cb_eval=observe_mask;
+    context_ptr ctx(llama_init_from_model(model,p),llama_free);
+    require(ctx != nullptr,"cannot initialize tiny mask model context");
+    return ctx;
+}
+static std::vector<float> decode(llama_context * ctx, int count, int pos, int nseq, int salt,
+        bool compact, bool expect_device) {
+    enabled(compact);
+    auto batch=llama_batch_init(count,0,1);
+    batch.n_tokens=count;
+    for (int i=0;i<count;++i) {
+        batch.token[i]=3+(i*13+salt)%256;
+        batch.pos[i]=pos+i/nseq;
+        batch.n_seq_id[i]=1; batch.seq_id[i][0]=i%nseq;
+        batch.logits[i]=1;
+    }
+    observed={};
+    const int rc=llama_decode(ctx,batch);
+    llama_batch_free(batch);
+    require(rc==0,"tiny mask model decode failed");
+    const bool require_op=compact && expect_device;
+    require(require_op ? observed.ops>0 && observed.device_ops==observed.ops : observed.ops==0,
+        "compact-mask execution/fallback assertion failed");
+    if (require_op) {
+        require(observed.input_bytes*4<=observed.output_bytes,"compact mask did not reduce staging by configured bound");
+        std::printf("MODEL_MASK ops=%zu cuda_ops=%zu compact_bytes=%zu dense_bytes=%zu\n",
+            observed.ops,observed.device_ops,observed.input_bytes,observed.output_bytes);
+    }
+    const int vocab=llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    const float * logits=llama_get_logits(ctx);
+    require(logits != nullptr,"missing tiny mask logits");
+    return {logits,logits+count*vocab};
+}
+static void equal_logits(const std::vector<float> & a,const std::vector<float> & b,const char * tag) {
+    require(a.size()==b.size(),"mask logits shape changed");
+    float max_scaled=0;
+    for (size_t i=0;i<a.size();++i) {
+        require(std::isfinite(a[i]) && std::isfinite(b[i]),"nonfinite compact-mask logits");
+        max_scaled=std::max(max_scaled,std::abs(a[i]-b[i])/(1+std::abs(a[i])));
+    }
+    std::printf("LOGITS stage=%s elements=%zu max_scaled=%.9g\n",tag,a.size(),max_scaled);
+    require(max_scaled<=1e-5f,"compact-mask logits changed beyond native bound");
+}
+static void integrated(const std::string & dir,bool cuda) {
+    std::filesystem::create_directories(dir);
+    const auto path=(std::filesystem::path(dir)/"device-mask-tiny.gguf").string();
+    make_fixture(path);
+    auto p=llama_model_default_params();
+    ggml_backend_dev_t devices[2]={nullptr,nullptr};
+    if (cuda) { devices[0]=ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU); }
+    p.devices=devices; p.n_gpu_layers=cuda ? 99 : 0;
+    std::unique_ptr<llama_model,decltype(&llama_model_free)> model(llama_model_load_from_file(path.c_str(),p),llama_model_free);
+    require(model != nullptr,"cannot load tiny mask fixture");
+    for (const bool fa : {false,true}) {
+        auto candidate=context(model.get(),cuda,fa), reference=context(model.get(),cuda,fa);
+        auto pair=[&](int count,int pos,int nseq,int salt,bool eligible,const char * stage) {
+            auto a=decode(reference.get(),count,pos,nseq,salt,false,false);
+            auto b=decode(candidate.get(),count,pos,nseq,salt,true,cuda && eligible);
+            equal_logits(a,b,stage);
+        };
+        pair(512,0,1,1,true,"prefill");
+        // Shared KV prefix membership and two interleaved query sequences.
+        for (auto * ctx : {candidate.get(),reference.get()}) {
+            llama_memory_seq_cp(llama_get_memory(ctx),0,1,0,512);
+        }
+        pair(512,512,2,7,true,"shared-two-sequences");
+        // Remove only one sequence's memberships. Physical cells still shared
+        // by the other sequence must remain visible only to that other query.
+        for (auto * ctx : {candidate.get(),reference.get()}) {
+            require(llama_memory_seq_rm(llama_get_memory(ctx),0,12,20),"cannot make sparse membership hole");
+        }
+        pair(512,768,2,11,true,"sparse-memberships");
+        pair(1,1024,1,15,false,"decode-fallback");
+        for (auto * ctx : {candidate.get(),reference.get()}) {
+            llama_memory_clear(llama_get_memory(ctx),true);
+            llama_set_causal_attn(ctx,false);
+        }
+        pair(512,0,1,19,false,"noncausal-fallback");
+    }
+    enabled(false);
+    std::printf("INTEGRATED backend=%s flash_on_off PASS\n",cuda ? "CUDA" : "CPU-fallback");
+}
+int main(int argc,char ** argv) {
+    try {
+        std::setvbuf(stdout,nullptr,_IONBF,0);
+        const bool cuda=argc>1 && std::strcmp(argv[1],"--cuda")==0;
+        const std::string dir=argc>(cuda ? 2 : 1) ? argv[cuda ? 2 : 1] : ".";
+        ggml_backend_load_all();
+        auto * dev=ggml_backend_dev_by_type(cuda ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU);
+        if (!dev) { return cuda ? 77 : 1; }
+        if (cuda) {
+            const auto * name=ggml_backend_reg_name(ggml_backend_dev_backend_reg(dev));
+            if (std::strcmp(name,"CUDA")!=0) { return 77; }
+        }
+        std::unique_ptr<ggml_backend,decltype(&ggml_backend_free)> backend(ggml_backend_dev_init(dev,nullptr),ggml_backend_free);
+        require(backend!=nullptr,"cannot initialize mask fixture backend");
+        admission();
+        size_t total=0;
+        for (const auto type : {GGML_TYPE_F16,GGML_TYPE_F32}) {
+            for (const int nk : {1,31,256,4096}) {
+                for (const int nq : {1,32,65}) {
+                    for (const int ns : {1,2}) { total+=mask_case(backend.get(),nk,nq,ns,type); }
+                }
+            }
+        }
+        std::printf("VISIBILITY backend=%s exact_elements=%zu PASS\n",ggml_backend_name(backend.get()),total);
+        if (cuda) {
+            benchmark_staging(backend.get(),256,32);
+            benchmark_staging(backend.get(),4096,32);
+            benchmark_staging(backend.get(),4096,128);
+            benchmark_staging(backend.get(),4096,512);
+        }
+        backend.reset();
+        integrated(dir,cuda);
+        return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr,"FAIL: %s\n",e.what()); return 1;
+    }
+}
