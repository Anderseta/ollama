+static void admission() {
+    const auto wide = llama_device_mask_admit(4096, 512, 1, 2, true);
+    require(wide.eligible && wide.metadata_bytes == 36864 && wide.dense_bytes == 4194304, "incorrect compact admission/accounting");
+    require(!llama_device_mask_admit(256, 32, 1, 1, true).eligible,"small staging must keep faster old path");
+    require(!llama_device_mask_admit(4096, 1, 1, 1, true).eligible, "single-token decode must retain old path");
+    require(!llama_device_mask_admit(1, 32, 1, 1, true).eligible, "metadata larger than mask admitted");
+    require(!llama_device_mask_admit(4096, 512, 1, 33, true).eligible, "sequence bit budget ignored");
+    require(!llama_device_mask_admit(1024*1024, 512, 1, 1, true).eligible, "metadata byte budget ignored");
+    require(!llama_device_mask_admit(4096, 65, 2, 2, true).eligible, "uneven stream layout admitted");
+    require(!llama_device_mask_admit(4096, 65536, 1, 1, true).eligible, "CUDA row-grid budget ignored");
+    require(llama_device_mask_supported(true,false,false,1,true,false,32),"supported causal layout rejected");
+    require(!llama_device_mask_supported(false,false,false,1,true,false,1),"noncausal admitted");
+    require(!llama_device_mask_supported(true,true,false,1,true,false,1),"ALiBi admitted");
+    require(!llama_device_mask_supported(true,false,true,1,true,false,1),"SWA admitted");
+    require(!llama_device_mask_supported(true,false,false,3,true,false,1),"M-RoPE admitted");
+    require(!llama_device_mask_supported(true,false,false,1,false,false,1),"media/embedding input admitted");
+    require(!llama_device_mask_supported(true,false,false,1,true,true,1),"mixed input admitted");
+    std::printf("ADMISSION host_upload=%llu dense_upload=%llu reduction=%.3fx budget_fallbacks=7 semantic_fallbacks=6 PASS\n",
+        (unsigned long long)wide.metadata_bytes, (unsigned long long)wide.dense_bytes,
