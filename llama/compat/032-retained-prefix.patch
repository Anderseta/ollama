+int main(int argc, char ** argv) {
+    if (argc == 3 && std::string(argv[2]) == "--cuda") { mode = test_mode::cuda; }
+    else if (argc == 3 && std::string(argv[2]) == "--hybrid") { mode = test_mode::hybrid; }
+    else if (argc != 2) { std::fprintf(stderr, "usage: test-retained-prefix fixture-directory [--cuda|--hybrid]\n"); return 2; }
+    try {
+        ggml_backend_load_all(); llama_backend_init();
+        auto * cuda = ggml_backend_reg_by_name("CUDA");
+        if (mode != test_mode::cpu && (!cuda || !ggml_backend_reg_dev_count(cuda))) {
+            std::puts("SKIP: CUDA required"); return 77;
+        }
+        ggml_backend_dev_t devices[] = {mode == test_mode::cpu ? nullptr : ggml_backend_reg_dev_get(cuda, 0), nullptr};
+        if (mode != test_mode::cpu) {
+            require(devices[0] && ggml_backend_dev_type(devices[0]) == GGML_BACKEND_DEVICE_TYPE_GPU,
+                    "CUDA fixture selected a non-GPU device");
+        }
+        std::filesystem::create_directories(argv[1]);
+        const auto path = (std::filesystem::path(argv[1]) / "retained-prefix.gguf").string();
+        make_fixture(path);
+        require(std::filesystem::file_size(path) < 4 * 1024 * 1024, "fixture exceeded small-model bound");
+        auto p = llama_model_default_params();
+        p.devices = devices;
+        p.n_gpu_layers = mode == test_mode::cuda ? 99 : mode == test_mode::hybrid ? 1 : 0;
+        p.gpu_exclusive = mode == test_mode::cuda;
+        std::unique_ptr<llama_model, decltype(&llama_model_free)> model(llama_model_load_from_file(path.c_str(), p), llama_model_free);
+        require(model != nullptr, "cannot load tiny prefix fixture");
+        sharing_and_lifetime(model.get()); invalidation_and_pressure(model.get()); server_cache(model.get());
+        short_prefix_in_long_context(model.get());
+        model.reset(); llama_backend_free();
+        std::printf("PASS retained prefix branches, ownership, bounds, pressure, shifts, serialization and server cache (%s)\n",
+                mode == test_mode::cpu ? "CPU" : mode == test_mode::cuda ? "CUDA" : "hybrid CPU/CUDA layers");
+    } catch (const std::exception & error) { std::fprintf(stderr, "FAIL: %s\n", error.what()); return 1; }
+}
