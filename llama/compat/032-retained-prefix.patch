+
+void llama_kv_cache::release_prefix(llama_kv_prefix_state & prefix) const {
+    if (!prefix.alive) { return; }
+    prefix.alive = false;
+    GGML_ASSERT(prefix_count > 0);
+    --prefix_count;
+    // Only optional alias metadata is removed, never another sequence's cells.
+    // v_cells is a shared reference; this is also valid while writing a const
+    // state view, which must not serialize internal alias IDs.
+    auto & cells = v_cells[0];
+    // Visit only this prefix's indexed cells. A short retained prefix must not
+    // turn eviction into a scan of the complete logical context capacity.
+    // Erasing the current item does not allocate; reacquire begin after removal.
+    const auto & positions = cells.seq_pos_get(prefix.alias);
+    uint32_t released_head = cells.size();
+    while (!positions.empty()) {
+        const auto index = positions.begin()->second;
+        if (cells.seq_rm(index, prefix.alias)) { released_head = std::min(released_head, index); }
+    }
+    // Match seq_rm: retry preparation from newly freed low cells instead of
+    // needlessly wrapping around the cache and changing attention row order.
+    auto & head = v_heads[0];
+    if (released_head < head) { head = released_head; }
+}
+
+void llama_kv_cache::invalidate_prefixes() const {
+    for (auto & weak : prefixes) {
+        if (auto prefix = weak.lock()) { release_prefix(*prefix); }
+        weak.reset();
+    }
+}
+
+void llama_kv_cache::invalidate_prefix_alias(llama_seq_id alias) const {
+    if (prefix_internal || prefix_count == 0) { return; }
+    for (auto & weak : prefixes) {
+        if (auto prefix = weak.lock()) {
+            if (prefix->alias == alias) { release_prefix(*prefix); weak.reset(); }
+        }
+    }
+}
