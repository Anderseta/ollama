+        tensor(p + "attn_output.weight", dim, dim);
+        tensor(p + "ffn_norm.weight", dim);
+        tensor(p + "ffn_gate.weight", dim, ff);
+        tensor(p + "ffn_up.weight", dim, ff);
+        tensor(p + "ffn_down.weight", ff, dim);
+    }
+    require(gguf_write_to_file(meta.get(), path.c_str(), false), "cannot write tiny fixture");
+}
+
+using context_ptr = std::unique_ptr<llama_context, decltype(&llama_free)>;
+static context_ptr make_context(llama_model * model, bool unified = true, uint32_t context_tokens = 256) {
+    auto p = llama_context_default_params();
+    p.op_offload = mode != test_mode::cpu;
+    if (mode == test_mode::hybrid) { p.cb_eval = observe_matrix_backend; }
+    p.n_ctx = context_tokens; p.n_batch = 256; p.n_ubatch = 32; p.n_seq_max = unified ? 1 : 2;
+    p.kv_unified = unified; p.n_threads = 2; p.n_threads_batch = 2;
+    p.type_k = p.type_v = GGML_TYPE_F32;
+    context_ptr result(llama_init_from_model(model, p), llama_free);
+    require(result != nullptr, "cannot create tiny context");
+    return result;
+}
+static llama_tokens pattern(int count, int salt = 0) {
+    llama_tokens result;
+    for (int i = 0; i < count; ++i) { result.push_back(3 + ((i * 13 + salt) % 256)); }
+    return result;
+}
+static std::vector<float> decode(llama_context * ctx, const llama_tokens & tokens, int position) {
+    auto batch = llama_batch_init(tokens.size(), 0, 1);
+    batch.n_tokens = tokens.size();
+    for (int i = 0; i < batch.n_tokens; ++i) {
+        batch.token[i] = tokens[i]; batch.pos[i] = position + i;
+        batch.n_seq_id[i] = 1; batch.seq_id[i][0] = 0; batch.logits[i] = i + 1 == batch.n_tokens;
+    }
+    observed = {};
+    const int ret = llama_decode(ctx, batch);
+    llama_batch_free(batch);
+    require(ret == 0, "tiny prefix decode failed");
+    const auto * logits = llama_get_logits_ith(ctx, -1);
+    require(logits != nullptr, "missing tiny logits");
+    llama_gpu_execution_stats execution{};
+    require(llama_gpu_execution_stats_get(ctx, &execution), "missing backend execution diagnostics");
+    if (mode == test_mode::cpu) {
+        require(execution.gpu_heavy_ops_submitted == 0, "CPU fixture submitted CUDA arithmetic");
+    } else if (mode == test_mode::cuda) {
+        require(execution.gpu_heavy_ops_submitted > 0, "CUDA fixture silently used CPU-only arithmetic");
+        require(execution.cpu_heavy_ops_submitted == 0, "fully offloaded fixture fell back to CPU arithmetic");
+    } else {
+        // Ordinary-runner heavy-op counters are collected only in exclusive
+        // mode. Observe actual result buffers through the existing callback
+        // instead; this instrumentation exists only in this tiny fixture.
+        require(observed.cpu > 0 && observed.cuda > 0,
+                "hybrid fixture did not execute both CPU and CUDA arithmetic");
+    }
+    return {logits, logits + llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)))};
+}
+static void equal_logits(const std::vector<float> & a, const std::vector<float> & b) {
+    require(a.size() == b.size(), "logit shape changed");
+    for (size_t i = 0; i < a.size(); ++i) {
+        require(std::isfinite(a[i]) && std::isfinite(b[i]) &&
+                std::abs(a[i] - b[i]) <= 1e-5f * (1 + std::abs(a[i])), "retained prefix changed logits");
+    }
+}
+static void clear(llama_context * ctx) { llama_memory_clear(llama_get_memory(ctx), true); }
+
+static void sharing_and_lifetime(llama_model * model) {
+    auto ctx = make_context(model), reference = make_context(model);
+    const auto a = pattern(12), b = pattern(5, 71);
+    equal_logits(decode(ctx.get(), a, 0), decode(reference.get(), a, 0));
+    auto prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(prefix && prefix->valid() && prefix->n_tokens() == a.size() && prefix->size() > 0, "retained prefix missing");
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 0), "zero budget retained prefix");
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 11), "oversized prefix ignored budget");
+    require(!llama_memory_prefix_restore(reference.get(), prefix, 0), "prefix crossed context ownership");
+    equal_logits(decode(ctx.get(), {77}, 12), decode(reference.get(), {77}, 12));
+    require(prefix->valid(), "append invalidated immutable prefix");
+    llama_memory_seq_rm(llama_get_memory(ctx.get()), 0, -1, -1);
+    decode(ctx.get(), b, 0);
+    require(llama_memory_prefix_restore(ctx.get(), prefix, 0), "A to B to A restore failed");
+    equal_logits(decode(ctx.get(), {77}, 12), std::vector<float>(llama_get_logits_ith(reference.get(), -1),
+            llama_get_logits_ith(reference.get(), -1) + llama_vocab_n_tokens(llama_model_get_vocab(model))));
+    require(llama_memory_prefix_restore(ctx.get(), prefix, 0), "branch restore failed");
+    clear(reference.get()); decode(reference.get(), a, 0);
+    equal_logits(decode(ctx.get(), {78}, 12), decode(reference.get(), {78}, 12));
+    prefix.reset();
+    equal_logits(decode(ctx.get(), {79}, 13), decode(reference.get(), {79}, 13));
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    ctx.reset();
+    require(prefix && !prefix->valid() && !llama_memory_prefix_restore(reference.get(), prefix, 0), "handle survived destroyed owner");
+    prefix.reset();
+}
+
+static void invalidation_and_pressure(llama_model * model) {
+    auto ctx = make_context(model), reference = make_context(model);
+    const auto a = pattern(8);
+    decode(ctx.get(), a, 0);
+    std::vector<llama_memory_prefix_ptr> refs;
+    for (int i = 0; i < 4; ++i) {
+        refs.push_back(llama_memory_prefix_retain(ctx.get(), 0, 32));
+        require(refs.back() && refs.back()->valid(), "bounded alias not retained");
+    }
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 64), "alias count bound exceeded");
+    llama_memory_seq_rm(llama_get_memory(ctx.get()), LLAMA_MAX_SEQ - 1, -1, -1);
+    require(!refs.front()->valid() && refs[1]->valid(), "external alias collision not isolated");
+    refs.front() = llama_memory_prefix_retain(ctx.get(), 0, 32);
+    require(refs.front() && refs.front()->valid(), "released alias not reusable");
+    llama_memory_seq_keep(llama_get_memory(ctx.get()), 0);
+    for (auto & p : refs) { require(!p->valid(), "seq_keep retained hidden alias"); }
+    auto prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    llama_memory_seq_add(llama_get_memory(ctx.get()), 0, 0, -1, 1);
+    require(!prefix->valid(), "position shift retained stale prefix");
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    llama_memory_seq_div(llama_get_memory(ctx.get()), 0, 0, -1, 2);
+    require(!prefix->valid(), "position division retained stale prefix");
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    (void) llama_state_get_size(ctx.get());
+    require(!prefix->valid(), "full external state kept hidden alias IDs");
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    const auto state_size = llama_state_seq_get_size_ext(ctx.get(), 0, 0);
+    std::vector<uint8_t> state(state_size);
+    require(llama_state_seq_get_data_ext(ctx.get(), state.data(), state.size(), 0, 0) == state.size(), "cannot capture tiny external state");
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(llama_state_seq_set_data_ext(ctx.get(), state.data(), state.size(), 0, 0) == state.size(), "cannot restore tiny external state");
+    require(!prefix->valid(), "external state read retained stale aliases");
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    llama_set_causal_attn(ctx.get(), false);
+    require(!prefix->valid() && !llama_memory_prefix_retain(ctx.get(), 0, 64), "attention mode change retained causal prefix");
+    llama_set_causal_attn(ctx.get(), true);
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(prefix && prefix->valid(), "warmup test prefix missing");
+    llama_set_warmup(ctx.get(), true);
+    require(!prefix->valid(), "warmup mode change retained stale prefix");
+    require(!llama_memory_prefix_retain(ctx.get(), 0, 64), "warmup state was retained");
+    llama_set_warmup(ctx.get(), false);
+    require(!prefix->valid(), "leaving warmup revived invalid prefix");
+    clear(ctx.get()); decode(ctx.get(), pattern(40), 0);
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 64);
+    require(prefix && prefix->valid(), "pressure prefix missing");
+    llama_memory_seq_rm(llama_get_memory(ctx.get()), 0, -1, -1);
+    const auto large = pattern(230, 99);
+    equal_logits(decode(ctx.get(), large, 0), decode(reference.get(), large, 0));
+    require(!prefix->valid(), "cache pressure failed to reclaim references");
+    require(llama_n_ctx(ctx.get()) == 256, "retention changed logical context capacity");
+    clear(ctx.get()); decode(ctx.get(), pattern(65), 0);
+    require(!llama_memory_prefix_retain(ctx.get(), 0, UINT32_MAX), "retained more than one quarter of cache capacity");
+    auto split = make_context(model, false);
+    decode(split.get(), a, 0);
+    require(!llama_memory_prefix_retain(split.get(), 0, 64), "unsupported split-stream layout retained aliases");
+}
+
+static void server_cache(llama_model * model) {
+    auto ctx = make_context(model), reference = make_context(model);
+    const auto a = pattern(12), b = pattern(5, 71);
+    decode(ctx.get(), a, 0); decode(reference.get(), a, 0);
+    server_prompt prompt; prompt.tokens = server_tokens(a, false);
+    server_prompt_cache cache(1, 256); cache.retain_tokens = 64;
+    require(cache.save_resident(prompt, ctx.get(), 0), "server did not retain eligible prefix");
+    require(cache.states.size() == 1 && cache.states.front().data.main.empty() && cache.size() > 0, "resident snapshot accounting failed");
+    llama_memory_seq_rm(llama_get_memory(ctx.get()), 0, -1, -1);
+    decode(ctx.get(), b, 0);
+    server_prompt live; live.tokens = server_tokens(b, false);
+    auto next = a; next.push_back(78);
+    require(cache.load(live, server_tokens(next, false), ctx.get(), nullptr, 0, nullptr), "server metadata restore failed");
+    require(cache.states.empty() && live.tokens.get_tokens() == a, "server prompt ownership not transferred");
+    equal_logits(decode(ctx.get(), {78}, 12), decode(reference.get(), {78}, 12));
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    require(cache.save_resident(prompt, ctx.get(), 0), "second server prefix missing");
+    llama_memory_seq_add(llama_get_memory(ctx.get()), 0, 0, -1, 1);
+    const auto pos_before = llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0);
+    require(cache.find_best(server_prompt{}, server_tokens(next, false)) == cache.states.end() && cache.states.empty(), "invalid retained candidate won lookup");
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == pos_before, "pruning modified active sequence");
+    clear(ctx.get()); decode(ctx.get(), a, 0);
+    cache.limit_size = 1;
+    require(!cache.save_resident(prompt, ctx.get(), 0) && cache.states.empty(), "resident state ignored byte budget");
+}
+
+static void short_prefix_in_long_context(llama_model * model) {
+    // Exercise release with a context much larger than the referenced range.
+    // No fragile timing threshold: all affected metadata and subsequent logits
+    // are checked. The production release loop visits the indexed range only.
+    auto ctx = make_context(model, true, 16384), reference = make_context(model);
+    const auto a = pattern(8);
+    equal_logits(decode(ctx.get(), a, 0), decode(reference.get(), a, 0));
+    auto prefix = llama_memory_prefix_retain(ctx.get(), 0, 32);
+    require(prefix && prefix->valid(), "short prefix in long context missing");
+    prefix.reset();
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), LLAMA_MAX_SEQ - 1) == -1,
+            "released alias retained indexed cells");
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 7,
+            "release removed another sequence's indexed cells");
+    equal_logits(decode(ctx.get(), {93}, 8), decode(reference.get(), {93}, 8));
+    prefix = llama_memory_prefix_retain(ctx.get(), 0, 32);
+    require(prefix && prefix->valid(), "second long-context prefix missing");
+    llama_memory_seq_rm(llama_get_memory(ctx.get()), 0, -1, -1);
+    prefix.reset();
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), LLAMA_MAX_SEQ - 1) == -1,
+            "last-owner release retained orphaned cells");
+    require(llama_n_ctx(ctx.get()) == 16384, "release changed logical context capacity");
+}
