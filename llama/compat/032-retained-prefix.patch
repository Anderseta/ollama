+std::shared_ptr<llama_memory_prefix> llama_kv_cache::retain_prefix(llama_seq_id sequence, uint32_t max_tokens) {
+    if (!max_tokens || other || growth_initial_tokens || v_cells_impl.use_count() != 1 || n_stream != 1 || n_swa ||
+            hparams.n_pos_per_embd() != 1 || seq_to_stream.size() != LLAMA_MAX_SEQ ||
+            sequence < 0 || uint32_t(sequence) >= n_seq_max || get_has_shift()) { return {}; }
+    auto & cells = v_cells[0];
+    const auto & positions = cells.seq_pos_get(sequence);
+    const uint32_t count = positions.size();
+    // Complete one-dimensional prefixes only. Gaps or shifted prefixes retain
+    // the existing serialized path rather than inventing missing KV state.
+    if (!count || positions.begin()->first != 0 || positions.rbegin()->first != llama_pos(count - 1)) { return {}; }
+    llama_pos expected = 0;
+    for (const auto & position : positions) { if (position.first != expected++) { return {}; } }
+    max_tokens = std::min(max_tokens, get_size() / 4);
+    uint64_t retained = count;
+    size_t slot = prefixes.size();
+    for (size_t i = 0; i < prefixes.size(); ++i) {
+        auto prefix = prefixes[i].lock();
+        if (prefix && prefix->valid()) { retained += prefix->tokens; }
+        else if (slot == prefixes.size()) { slot = i; }
+    }
+    if (slot == prefixes.size() || retained > max_tokens) { return {}; }
+    llama_seq_id alias = -1;
+    for (int candidate = LLAMA_MAX_SEQ - 1; candidate >= int(n_seq_max); --candidate) {
+        if (cells.seq_pos_get(candidate).empty()) { alias = candidate; break; }
+    }
+    if (alias < 0) { return {}; }
+    const size_t bytes_per_cell = (size_k_bytes() + size_v_bytes() + get_size() - 1) / get_size();
+    if (bytes_per_cell && count > SIZE_MAX / bytes_per_cell) { return {}; }
+    if (!prefix_owner) { prefix_owner = std::make_shared<llama_kv_prefix_owner>(llama_kv_prefix_owner{this}); }
+    auto prefix = std::make_shared<llama_kv_prefix_state>(prefix_owner, alias, count, count * bytes_per_cell);
+    const bool previous = prefix_internal;
+    prefix_internal = true;
+    // Mark before the first insertion so an allocating map failure also rolls
+    // back a partially constructed alias. seq_add publishes its index first.
+    prefix->alive = true;
+    ++prefix_count;
+    try { seq_cp(sequence, alias, -1, -1); }
+    catch (...) { release_prefix(*prefix); prefix_internal = previous; throw; }
+    prefix_internal = previous;
+    prefixes[slot] = prefix;
+    return prefix;
+}
 
