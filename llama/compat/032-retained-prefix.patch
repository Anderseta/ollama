+bool llama_memory_prefix_restore(llama_context * ctx, const llama_memory_prefix_ptr & prefix, llama_seq_id destination) {
+    if (!ctx || !prefix || !prefix->valid()) { return false; }
+    try {
+        ctx->synchronize();
+        return prefix->restore(ctx->get_memory(), destination);
+    } catch (const std::exception & error) {
+        LLAMA_LOG_WARN("KV prefix restore skipped: %s\n", error.what());
