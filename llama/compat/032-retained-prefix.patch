+static bool observe_matrix_backend(ggml_tensor * tensor, bool ask, void *) {
+    if (tensor->op != GGML_OP_MUL_MAT) { return false; }
+    if (ask) { return true; }
+    auto * buffer = tensor->buffer;
+    if (!buffer) { return true; }
+    const auto device = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buffer));
+    const auto registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+    // CUDA_Host is pinned CPU memory even though its buffer-type device is a
+    // CUDA device. Do not mistake host result storage for CUDA execution.
+    if (ggml_backend_buffer_is_host(buffer)) { ++observed.cpu; }
+    else if (registry && std::strcmp(ggml_backend_reg_name(registry), "CUDA") == 0) { ++observed.cuda; }
+    return true;
