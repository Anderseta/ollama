+llama_memory_prefix_ptr llama_memory_prefix_retain(llama_context * ctx, llama_seq_id sequence, uint32_t max_tokens) {
+    if (!ctx || !max_tokens || ctx->get_cparams().warmup || !ctx->get_cparams().causal_attn ||
