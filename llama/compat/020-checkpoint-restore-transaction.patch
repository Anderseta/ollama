+
+// A checkpoint can own the same three blobs in a different container. Borrow
+// their vectors only for the synchronous restore; do not duplicate large states
+// just to adapt their storage to the transactional helper.
+struct common_state_view {
+    const std::vector<uint8_t> & main;
+    const std::vector<uint8_t> & drft;
+    const std::vector<uint8_t> & spec;
 };
 
