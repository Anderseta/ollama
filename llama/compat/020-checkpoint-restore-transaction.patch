+
+template <typename Main, typename Draft, typename Spec, typename Clear>
+bool common_state_restore(const common_state_data & data, Main restore_main,
+                          Draft restore_draft, Spec restore_spec, Clear clear) {
+    return common_state_restore(common_state_view{data.main, data.drft, data.spec},
+            std::move(restore_main), std::move(restore_draft), std::move(restore_spec), std::move(clear));
+}
