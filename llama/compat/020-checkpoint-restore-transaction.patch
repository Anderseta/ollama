 static void require(bool value, const char * message) {
     if (!value) { throw std::runtime_error(message); }
+}
+
+static void borrowed_checkpoint_restore() {
+    const std::vector<uint8_t> target{21,22,23,24}, draft{25,26}, speculative{27,28};
+    const auto saved_target = target, saved_draft = draft, saved_speculative = speculative;
+    const common_state_view entry{target, draft, speculative};
+    require(&entry.main == &target && &entry.drft == &draft && &entry.spec == &speculative,
+            "borrowed view copied checkpoint vectors");
+    common_state_data live;
+    int failure = 0;
+    size_t clears = 0, main_calls = 0, draft_calls = 0, spec_calls = 0;
+    auto main = [&](const uint8_t * src, size_t size) {
+        require(src == target.data() && size == target.size(), "target restore did not borrow original bytes");
+        ++main_calls;
+        live.main.assign(src, src+size);
+        if (failure == 4) { throw std::runtime_error("target backend allocation failure"); }
+        return failure == 1 ? size-1 : size;
+    };
+    auto drft = [&](const uint8_t * src, size_t size) {
+        require(src == draft.data() && size == draft.size(), "draft restore did not borrow original bytes");
+        ++draft_calls;
+        live.drft.assign(src, src+size);
+        return failure == 2 ? size-1 : size;
+    };
+    auto spec = [&](const std::vector<uint8_t> & data) {
+        require(&data == &speculative, "spec restore did not borrow original vector");
+        ++spec_calls;
+        live.spec = data;
+        if (failure == 3) { throw std::runtime_error("invalid speculative checkpoint state"); }
+    };
+    auto clear = [&] { live = {}; ++clears; };
+    for (failure = 1; failure <= 4; ++failure) {
+        main_calls = draft_calls = spec_calls = 0;
+        live = {{99}, {98}, {97}};
+        require(!common_state_restore(entry, main, drft, spec, clear), "partial borrowed checkpoint accepted");
+        require(live.size() == 0 && clears == size_t(failure), "failed borrowed restore left live state");
+        require(main_calls == 1 && draft_calls == size_t(failure == 2 || failure == 3) &&
+                spec_calls == size_t(failure == 3), "restore continued after a failed checkpoint component");
+        require(target == saved_target && draft == saved_draft && speculative == saved_speculative,
+                "failed restore changed checkpoint bytes");
+        const int injected = failure;
+        failure = 0;
+        require(common_state_restore(entry, main, drft, spec, clear), "borrowed checkpoint retry failed");
+        require(live.main == target && live.drft == draft && live.spec == speculative,
+                "borrowed checkpoint retry changed state bytes");
+        require(clears == size_t(injected), "successful retry cleared state");
+        failure = injected;
+    }
+    const std::vector<uint8_t> empty;
+    const common_state_view target_only{target, empty, empty};
+    size_t optional_calls = 0;
+    require(common_state_restore(target_only, main,
+            [&](const uint8_t *, size_t size) { ++optional_calls; return size; },
+            [&](const auto & data) { require(&data == &empty, "empty spec storage copied"); live.spec = data; }, clear),
+            "target-only checkpoint rejected");
+    require(optional_calls == 0 && live.main == target && live.spec.empty(), "optional draft was restored");
+    const common_state_view missing_target{empty, draft, speculative};
+    main_calls = draft_calls = spec_calls = 0;
+    require(!common_state_restore(missing_target, main, drft, spec, clear), "checkpoint without target accepted");
+    require(live.size() == 0 && !main_calls && !draft_calls && !spec_calls,
+            "missing-target checkpoint changed contexts before fallback");
 }
 
