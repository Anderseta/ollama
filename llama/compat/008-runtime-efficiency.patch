+
+static void test_partial_upload_batches(const char * directory, ggml_backend_t backend) {
+    constexpr size_t page=65536, mib=1024*1024, size=10*mib, budget=8*mib, prefix=37;
+    struct fixture {
+        std::filesystem::path path;
+        ~fixture() { std::error_code error; std::filesystem::remove(path,error); }
+    } file { std::filesystem::path(directory)/("moe-upload-prefix-"+std::to_string(std::random_device{}())+".bin") };
+    std::vector<uint8_t> raw(size+prefix), expected(size,0x91), actual(size);
+    for (size_t i=0; i<raw.size(); ++i) { raw[i]=uint8_t(i*31+i/127); }
+    auto write = [&] {
+        std::ofstream stream(file.path,std::ios::binary|std::ios::trunc);
+        stream.write(reinterpret_cast<const char *>(raw.data()),raw.size());
+        require(stream.good(),"cannot write upload-prefix fixture");
+    };
+    write();
+    llama_files files;
+    files.emplace_back(new llama_file(file.path.string().c_str(),"rb"));
+    ggml_context_ptr source(ggml_init({4*ggml_tensor_overhead(),nullptr,true}));
+    ggml_context_ptr target(ggml_init({4*ggml_tensor_overhead(),nullptr,true}));
+    require(source && target,"cannot create upload-prefix contexts");
+    auto * weights=ggml_new_tensor_1d(source.get(),GGML_TYPE_I8,size);
+    // A tensor view makes source addressing include its original region offset.
+    auto * view=ggml_view_1d(source.get(),weights,size-page,page);
+    auto * destination=ggml_new_tensor_1d(target.get(),GGML_TYPE_I8,size);
+    ggml_backend_buffer_ptr output(ggml_backend_alloc_ctx_tensors(target.get(),backend));
+    require(output!=nullptr,"cannot allocate upload-prefix output");
+    llama_model_ram_cache cache(budget,files,true);
+    cache.bind(weights,0,prefix);
+    view->data=static_cast<uint8_t *>(weights->data)+page;
+    const std::vector<llama_model_ram_copy> copies = {
+        {weights,destination,11,19,2*mib+47},
+        {view,destination,2*mib+23,3*mib+53,2*mib+61},
+        {weights,destination,mib+31,6*mib+7,2*mib+83},
+    };
+    for (const auto & copy:copies) {
+        const size_t base=copy.src==view ? page : 0;
+        std::copy_n(raw.data()+prefix+base+copy.src_offset,copy.size,expected.data()+copy.dst_offset);
+    }
+    auto guard=cache.acquire();
+    auto transfer = [&] {
+        std::fill(actual.begin(),actual.end(),0x91);
+        ggml_backend_tensor_set(destination,actual.data(),0,size);
+        require(cache.copy_batch(backend,copies),"partial-page multi-chunk batch rejected");
+        ggml_backend_synchronize(backend);
+        ggml_backend_tensor_get(destination,actual.data(),0,size);
+        require(actual==expected,"partial-page multi-chunk upload changed bytes or destination gaps");
+        const auto stats=cache.stats(guard);
+        require(stats.resident<=budget && stats.peak<=budget,"multi-chunk upload exceeded RAM budget");
+    };
+    transfer();
+    const auto cold=cache.stats(guard);
+    require(cold.read_calls>4,"multi-chunk test did not exercise repeated I/O completions");
+    transfer();
+    require(cache.stats(guard).bytes_read==cold.bytes_read,"all-hot multi-chunk batch repeated SSD reads");
+    // Evict enough source pages and force a new batch to validate residency
+    // again, rather than inheriting the completed cursors from the warm batch.
+    cache.prefetch({{weights,6*mib,4*mib}});
+    const auto evicted=cache.stats(guard);
+    transfer();
+    require(cache.stats(guard).bytes_read>evicted.bytes_read,"new batch bypassed reloaded source pages");
+    printf("PASS multi-chunk upload readiness: overlapping sources, tensor view, partial pages, warm reuse and eviction\n");
 }
 
