diff --git a/src/llama-state-transfer.h b/src/llama-state-transfer.h
new file mode 100644
--- /dev/null
+++ b/src/llama-state-transfer.h
@@ -0,0 +1,140 @@
+#pragma once
+
+#include "ggml-cpp.h"
+#include "ggml-cuda-kv-growth.h"
+#include "../ggml/src/ggml-backend-impl.h"
+
+#include <exception>
+#include <utility>
+#include <vector>
+
+// A state operation already owns a synchronized context. Use its existing
+// backend streams, never a second stream with an independent tensor lifetime.
+// Buffers with nonstandard layouts retain their synchronous buffer callbacks.
+class llama_state_transfer_context {
+public:
+    explicit llama_state_transfer_context(const std::vector<ggml_backend_ptr> & backends) {
+        entries.reserve(backends.size());
+        for (const auto & backend : backends) {
+            if (!backend || !backend->iface.synchronize) { continue; }
+            auto * buft = ggml_backend_get_default_buffer_type(backend.get());
+            if (!buft || ggml_backend_buft_is_host(buft)) { continue; }
+            const ggml_backend_cuda_kv_growth_api * growth = nullptr;
+            auto * device = ggml_backend_get_device(backend.get());
+            auto * registry = device ? ggml_backend_dev_backend_reg(device) : nullptr;
+            if (registry) {
+                growth = static_cast<const ggml_backend_cuda_kv_growth_api *>(
+                    ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_kv_growth_api"));
+                if (growth && (growth->version != 1 || !growth->committed)) { continue; }
+            }
+            entries.push_back({backend.get(), buft, growth, false});
+        }
+    }
+
+    template<class Transfers>
+    void get(const Transfers & transfers) {
+        run(transfers, true, [](ggml_backend_t backend, const auto & item) {
+            if (backend) {
+                backend->iface.get_tensor_async(backend, item.tensor, item.ptr, item.offset, item.size);
+            } else {
+                auto * buffer = buffer_for(item.tensor);
+                buffer->iface.get_tensor(buffer, item.tensor, item.ptr, item.offset, item.size);
+            }
+        });
+    }
+
+    template<class Transfers>
+    void set(const Transfers & transfers) {
+        run(transfers, false, [](ggml_backend_t backend, const auto & item) {
+            if (backend) {
+                backend->iface.set_tensor_async(backend, item.tensor, item.ptr, item.offset, item.size);
+            } else {
+                auto * buffer = buffer_for(item.tensor);
+                buffer->iface.set_tensor(buffer, item.tensor, item.ptr, item.offset, item.size);
+            }
+        });
+    }
+
+private:
+    struct entry {
+        ggml_backend_t backend;
+        ggml_backend_buffer_type_t buft;
+        const ggml_backend_cuda_kv_growth_api * growth;
+        bool pending;
+    };
+    std::vector<entry> entries;
+    std::vector<std::pair<ggml_backend_buffer_t, bool>> mapped_buffers;
+
+    static ggml_backend_buffer_t buffer_for(const ggml_tensor * tensor) {
+        return tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    }
+
+    bool fully_mapped(const entry & backend, ggml_backend_buffer_t buffer) {
+        if (!backend.growth) { return true; }
+        for (const auto & checked : mapped_buffers) {
+            if (checked.first == buffer) { return checked.second; }
+        }
+        // VMM buffers deliberately retain CUDA's default buft. Async accessors
+        // do not commit pages; retain the buffer callbacks until all pages are
+        // mapped. Mapped pages never shrink during a state operation. Cache a
+        // conservative answer only within this operation, including views.
+        const size_t committed = backend.growth->committed(buffer);
+        const bool mapped = committed != SIZE_MAX && committed >= ggml_backend_buffer_get_size(buffer);
+        mapped_buffers.emplace_back(buffer, mapped);
+        return mapped;
+    }
+
+    entry * find(const ggml_tensor * tensor, bool get) {
+        // Match the buffer selected by ggml's own tensor accessors, including
+        // views. supports_buft is insufficient: CUDA, for example, can execute
+        // on split buffers but its async tensor accessors require its default.
+        auto * buffer = buffer_for(tensor);
+        if (!buffer) { return nullptr; }
+        auto * buft = ggml_backend_buffer_get_type(buffer);
+        for (auto & candidate : entries) {
+            if (candidate.buft == buft &&
+                    (get ? candidate.backend->iface.get_tensor_async != nullptr :
+                           candidate.backend->iface.set_tensor_async != nullptr)) {
+                return fully_mapped(candidate, buffer) ? &candidate : nullptr;
+            }
+        }
+        return nullptr;
+    }
+
+    // Call the interfaces directly after the same range/buffer checks as ggml.
+    // MSVC /EHsc assumes the public extern-C wrappers cannot throw and can omit
+    // their unwind handlers. Backend callbacks can throw (e.g. quota denial),
+    // so these C++ indirect calls must stay inside the explicit drain boundary.
+    template<class Transfers, class Submit>
+    void run(const Transfers & transfers, bool get, Submit submit) {
+        mapped_buffers.clear(); // classification belongs to this operation, not the helper lifetime
+        std::exception_ptr failure;
+        try {
+            for (const auto & item : transfers) {
+                if (!item.size) { continue; }
+                GGML_ASSERT(item.tensor && item.tensor->data && buffer_for(item.tensor));
+                const size_t bytes = ggml_nbytes(item.tensor);
+                GGML_ASSERT(item.offset <= bytes && item.size <= bytes - item.offset);
+                entry * target = find(item.tensor, get);
+                // Mark before submitting: an accessor may enqueue some work and
+                // then throw. Neither the snapshot nor tensors may expire yet.
+                if (target) { target->pending = true; }
+                submit(target ? target->backend : nullptr, item);
+            }
+        } catch (...) {
+            failure = std::current_exception();
+        }
+        // Explicitly drain every participating stream, even when a previous
+        // submit/fence failed. Destruction must never perform transfers or throw.
+        for (auto & item : entries) {
+            if (!item.pending) { continue; }
+            item.pending = false;
+            try {
+                item.backend->iface.synchronize(item.backend);
+            } catch (...) {
+                if (!failure) { failure = std::current_exception(); }
+            }
+        }
+        if (failure) { std::rethrow_exception(failure); }
+    }
+};
