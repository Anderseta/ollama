+#include "../src/llama-model-ram-ready.h"
+#include "../src/llama-model-ram-pipeline.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+void require(bool value, const char * message) { if (!value) { throw std::runtime_error(message); } }
+
+struct counted_flag {
+    bool value = false;
+    size_t * checks = nullptr;
+    operator bool() const { if (checks) { ++*checks; } return value; }
+};
+struct page { counted_flag resident; };
+
+bool baseline(const page * first, const page * end) {
+    for (; first != end; ++first) { if (!first->resident) { return false; } }
+    return true;
+}
+
+void exact_completion_order() {
+    std::mt19937 random(42);
+    for (size_t count : {size_t(1), size_t(2), size_t(17), size_t(32), size_t(129)}) {
+        for (int iteration = 0; iteration < 32; ++iteration) {
+            std::vector<page> pages(count);
+            std::vector<size_t> order(count);
+            std::iota(order.begin(), order.end(), size_t(0));
+            if (iteration) { std::shuffle(order.begin(), order.end(), random); }
+            const size_t first = count > 2 ? 1 : 0;
+            llama_model_ram_ready_range<page> cursor {pages.data()+first, pages.data()+count};
+            require(!cursor.ready(), "cold range was reported ready");
+            for (size_t index : order) {
+                pages[index].resident.value = true;
+                const bool expected = baseline(pages.data()+first,pages.data()+count);
+                require(cursor.ready() == expected, "out-of-order I/O changed upload readiness");
+                require(cursor.ready() == expected, "duplicate readiness callback changed its answer");
+            }
+            require(cursor.ready(), "completed range stayed pending");
+            // A later batch must start a new cursor: a completed cursor is not
+            // a cross-batch residency cache and must never bypass new misses.
+            pages[first].resident.value = false;
+            llama_model_ram_ready_range<page> next_batch {pages.data()+first,pages.data()+count};
+            require(!next_batch.ready(), "new batch reused obsolete readiness");
+        }
+    }
+    llama_model_ram_ready_range<page> empty;
+    require(empty.ready(), "empty range was not ready");
+}
+
+void shared_pages_and_work_bound() {
+    constexpr size_t pages_per_range = 32, overlapping_ranges = 64;
+    std::vector<page> pages(pages_per_range);
+    std::vector<llama_model_ram_ready_range<page>> ranges(overlapping_ranges,
+        {pages.data(), pages.data()+pages.size()});
+    size_t old_checks = 0, new_checks = 0;
+    for (size_t step = 0; step <= pages.size(); ++step) {
+        if (step) { pages[step-1].resident.value = true; }
+        for (auto & range : ranges) {
+            for (auto & page : pages) { page.resident.checks = &old_checks; }
+            const bool expected = baseline(pages.data(),pages.data()+pages.size());
+            for (auto & page : pages) { page.resident.checks = &new_checks; }
+            require(range.ready() == expected, "shared-page upload became ready too early");
+        }
+    }
+    require(new_checks == overlapping_ranges*2*pages_per_range,
+            "incremental range reread a previously validated resident page");
+    require(old_checks > new_checks*8, "baseline did not exercise repeated page-prefix scans");
+    printf("readiness checks, 64 overlapping 32-page ranges: baseline=%zu incremental=%zu\n", old_checks,new_checks);
+}
+
+void pipeline_refill_and_failures() {
+    constexpr size_t depth=4, jobs=19;
+    struct injected_failure {};
+    // Inject failure at each phase, including after several completions. A
+    // pending read owns its staging slot until completion or explicit drain.
+    for (int failure=-1; failure<3; ++failure) {
+        std::vector<size_t> pending;
+        size_t submitted=0, completed=0, callbacks=0, drained=0;
+        bool threw=false;
+        auto submit = [&] {
+            if (submitted==jobs) { return false; }
+            if (failure==0 && submitted==7) { throw injected_failure{}; }
+            require(pending.size()<depth,"I/O queue exceeded its staging capacity");
+            pending.push_back(submitted++);
+            return true;
+        };
+        auto complete = [&] {
+            require(!pending.empty(),"completed an I/O with no live staging slot");
+            if (failure==1 && completed==3) { throw injected_failure{}; }
+            // Alternate ends to model out-of-order OS completions.
+            pending.erase(pending.begin()+(completed%2 ? 0 : pending.size()-1));
+            ++completed;
+        };
+        auto ready = [&] {
+            require(pending.size()==std::min(depth,jobs-completed),
+                    "upload consumer ran before refilling its freed SSD slot");
+            require(submitted==completed+pending.size(),"I/O ownership accounting changed");
+            if (failure==2 && callbacks==3) { throw injected_failure{}; }
+            ++callbacks;
+        };
+        try { llama_model_ram_run_io<depth>(submit,complete,ready); }
+        catch (const injected_failure &) {
+            threw=true;
+            // Mirrors the cache owner's required cleanup; real I/O recovery is
+            // covered by test-moe-ram-pool with a truncated backing file.
+            drained=pending.size(); pending.clear();
+        }
+        require(threw==(failure>=0),"pipeline did not preserve an injected failure");
+        require(pending.empty() && submitted==completed+drained,"failed pipeline lost an in-flight read");
+        if (failure<0) { require(completed==jobs && callbacks==jobs,"pipeline dropped a ready notification"); }
+    }
+    size_t callbacks=0;
+    llama_model_ram_run_io<1>([] { return false; },[] { throw std::runtime_error("unexpected empty completion"); },
+        [&] { ++callbacks; });
+    require(callbacks==0,"empty I/O batch dispatched a ready callback");
+    size_t submitted=0, completed=0;
+    llama_model_ram_run_io<1>([&] { if (submitted==5) { return false; } ++submitted; return true; },
+        [&] { ++completed; }, [&] { require(submitted==completed,"synchronous reader delayed uploads behind the next disk read"); });
+    require(completed==5,"single-slot pipeline dropped a completion");
+}
+
+// Deliberately isolated CPU scheduling benchmark, not an inference TPS test.
+// Both versions see identical pages and completion notifications. All-hot
+// checks are included separately because a cursor cannot improve one scan.
+template<bool incremental>
+double measure(size_t pages_count, size_t completions, size_t repetitions, size_t & ready_count) {
+    std::vector<page> pages(pages_count);
+    const auto start = std::chrono::steady_clock::now();
+    for (size_t repeat = 0; repeat < repetitions; ++repeat) {
+        for (auto & page : pages) { page.resident.value = false; }
+        llama_model_ram_ready_range<page> range {pages.data(),pages.data()+pages.size()};
+        for (size_t completion = 0; completion < completions; ++completion) {
+            const size_t begin = completion*pages_count/completions;
+            const size_t end = (completion+1)*pages_count/completions;
+            for (size_t index = begin; index < end; ++index) { pages[index].resident.value = true; }
+            ready_count += incremental ? range.ready() : baseline(pages.data(),pages.data()+pages.size());
+        }
+    }
+    return std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+}
+
+void benchmark() {
+    for (size_t completions : {size_t(1),size_t(2),size_t(32)}) {
+        std::vector<double> before,after;
+        for (int sample=0; sample<7; ++sample) {
+            size_t old_ready=0,new_ready=0;
+            // Alternate order to avoid giving one implementation every warm CPU.
+            if (sample&1) {
+                after.push_back(measure<true>(32,completions,100000,new_ready));
+                before.push_back(measure<false>(32,completions,100000,old_ready));
+            } else {
+                before.push_back(measure<false>(32,completions,100000,old_ready));
+                after.push_back(measure<true>(32,completions,100000,new_ready));
+            }
+            require(old_ready==100000 && old_ready==new_ready, "benchmark changed scheduling decisions");
+        }
+        std::sort(before.begin(),before.end()); std::sort(after.begin(),after.end());
+        printf("readiness CPU median, 100000 x 32 pages / %zu completion(s): baseline=%.3f ms incremental=%.3f ms\n",
+            completions,before[before.size()/2],after[after.size()/2]);
+    }
+}
+}
+
+int main() {
+    try {
+        exact_completion_order();
+        shared_pages_and_work_bound();
+        pipeline_refill_and_failures();
+        benchmark();
+        printf("PASS readiness: exact cold/warm, shared pages, reordered completions, renewed batches, linear prefix work and bounded refill-before-upload/failure ownership\n");
+        return 0;
+    } catch (const std::exception & error) {
+        fprintf(stderr,"FAIL: %s\n",error.what());
+        return 1;
+    }
+}
