diff --git a/src/llama-model-ram-ready.h b/src/llama-model-ram-ready.h
new file mode 100644
--- /dev/null
+++ b/src/llama-model-ram-ready.h
@@ -0,0 +1,16 @@
+#pragma once
+
+// A batch pins all of its source pages through the RAM cache epoch. Residency
+// can therefore only advance until that batch has completed its uploads. Keep
+// the validated prefix instead of rescanning it after every I/O completion.
+// Recreate this cursor for every batch; it must never survive cache eviction.
+template<class Page>
+struct llama_model_ram_ready_range {
+    const Page * next = nullptr;
+    const Page * end = nullptr;
+
+    bool ready() {
+        while (next != end && next->resident) { ++next; }
+        return next == end;
+    }
+};
diff --git a/src/llama-model-ram-pipeline.h b/src/llama-model-ram-pipeline.h
new file mode 100644
--- /dev/null
+++ b/src/llama-model-ram-pipeline.h
@@ -0,0 +1,34 @@
+#pragma once
+
+#include <cstddef>
+
+// complete() must consume one submitted read and copy its staging bytes into
+// their protected destination pages before returning. Refill that freed slot
+// before notifying upload consumers, whose waits/copies may otherwise leave
+// the storage queue idle. The single-slot reader is synchronous on supported
+// POSIX platforms: preserve upload-before-next-read there. The owner drains
+// outstanding reads on exceptions.
+template<std::size_t Depth, class Submit, class Complete, class Ready>
+void llama_model_ram_run_io(Submit && submit, Complete && complete, Ready && ready) {
+    static_assert(Depth > 0, "I/O depth must be positive");
+    std::size_t active = 0;
+    bool exhausted = false;
+    auto refill = [&] {
+        while (active < Depth && !exhausted) {
+            if (submit()) { ++active; }
+            else { exhausted = true; }
+        }
+    };
+    refill();
+    while (active) {
+        complete();
+        --active;
+        if constexpr (Depth > 1) {
+            refill();
+            ready();
+        } else {
+            ready();
+            refill();
+        }
+    }
+}
