+#include "ggml-alloc.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <functional>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+struct transfer {
+    ggml_tensor * tensor;
+    uint8_t * ptr;
+    size_t offset;
+    size_t size;
+};
+
+struct deferred_backend {
+    ggml_backend_buffer_type buft{};
+    ggml_backend_reg registry{};
+    ggml_backend_device device{};
+    ggml_backend backend{};
+    ggml_backend_buffer buffer{};
+    std::vector<std::function<void()>> pending;
+    size_t fences = 0, sync_gets = 0, sync_sets = 0, submissions = 0;
+    size_t fail_submission = 0;
+    size_t committed_bytes = 0, committed_queries = 0;
+    bool fail_fence = false, fail_sync = false;
+    std::vector<uint8_t> bytes;
+
+    explicit deferred_backend(size_t size) : bytes(size) {
+        buft.context = this;
+        buft.device = &device;
+        buft.iface.is_host = [](ggml_backend_buffer_type_t) { return false; };
+        device.context = this;
+        device.iface.get_buffer_type = [](ggml_backend_dev_t dev) {
+            return &static_cast<deferred_backend *>(dev->context)->buft;
+        };
+        buffer.buft = &buft;
+        buffer.context = this;
+        buffer.size = size;
+        buffer.iface.get_tensor = [](ggml_backend_buffer_t buf, const ggml_tensor * tensor, void * dst, size_t off, size_t n) {
+            auto & self = *static_cast<deferred_backend *>(buf->context);
+            ++self.sync_gets;
+            if (self.fail_sync) { throw std::runtime_error("injected synchronous failure"); }
+            std::memcpy(dst, static_cast<const uint8_t *>(tensor->data) + off, n);
+        };
+        buffer.iface.set_tensor = [](ggml_backend_buffer_t buf, ggml_tensor * tensor, const void * src, size_t off, size_t n) {
+            ++static_cast<deferred_backend *>(buf->context)->sync_sets;
+            std::memcpy(static_cast<uint8_t *>(tensor->data) + off, src, n);
+        };
+        backend.device = &device;
+        backend.context = this;
+        backend.iface.free = [](ggml_backend_t) {};
+        backend.iface.get_tensor_async = [](ggml_backend_t backend, const ggml_tensor * tensor, void * dst, size_t off, size_t n) {
+            auto & self = *static_cast<deferred_backend *>(backend->context);
+            self.pending.push_back([=] { std::memcpy(dst, static_cast<const uint8_t *>(tensor->data) + off, n); });
+            if (++self.submissions == self.fail_submission) { throw std::runtime_error("injected async failure"); }
+        };
+        backend.iface.set_tensor_async = [](ggml_backend_t backend, ggml_tensor * tensor, const void * src, size_t off, size_t n) {
+            auto & self = *static_cast<deferred_backend *>(backend->context);
+            self.pending.push_back([=] { std::memcpy(static_cast<uint8_t *>(tensor->data) + off, src, n); });
+            if (++self.submissions == self.fail_submission) { throw std::runtime_error("injected async failure"); }
+        };
+        backend.iface.synchronize = [](ggml_backend_t backend) {
+            auto & self = *static_cast<deferred_backend *>(backend->context);
+            ++self.fences;
+            for (auto & apply : self.pending) { apply(); }
+            self.pending.clear();
+            if (self.fail_fence) { throw std::runtime_error("injected fence failure"); }
+        };
+    }
+};
+
+static void test_deferred() {
+    constexpr size_t count = 64, part = 1024;
+    ggml_context_ptr context(ggml_init({(count + 8)*ggml_tensor_overhead(), nullptr, true}));
+    require(context != nullptr, "cannot allocate mock metadata");
+    deferred_backend first(count*part), second(count*part);
+    std::vector<ggml_backend_ptr> backends;
+    backends.emplace_back(&first.backend);
+    backends.emplace_back(&second.backend);
+    llama_state_transfer_context copy(backends);
+    std::vector<uint8_t> source(count*part), result(source.size());
+    for (size_t i = 0; i < source.size(); ++i) { source[i] = uint8_t(i*23 + i/37); }
+    std::vector<transfer> items;
+    for (size_t i = 0; i < count; ++i) {
+        auto * tensor = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, part/sizeof(float));
+        auto & owner = i%2 ? second : first;
+        tensor->buffer = &owner.buffer;
+        tensor->data = owner.bytes.data() + i*part;
+        items.push_back({tensor, source.data() + i*part, 0, part});
+    }
+    copy.set(items);
+    require(first.fences == 1 && second.fences == 1 && first.sync_sets == 0 && second.sync_sets == 0,
+            "async restore did not use one fence per device");
+    for (size_t i = 0; i < count; ++i) { items[i].ptr = result.data() + i*part; }
+    copy.get(items);
+    require(source == result && first.fences == 2 && second.fences == 2,
+            "batched save lost bytes or used per-tensor fences");
+    require(first.pending.empty() && second.pending.empty(), "successful copy left work in flight");
+
+    auto * view = ggml_view_1d(context.get(), items[0].tensor, 32, 16);
+    view->buffer = nullptr; // buffer must be resolved through the source
+    std::vector<uint8_t> view_result(128);
+    copy.get(std::vector<transfer>{{view, view_result.data(), 0, view_result.size()}});
+    require(std::memcmp(view_result.data(), source.data() + 16, view_result.size()) == 0,
+            "view bytes or source-buffer discovery are wrong");
+    require(first.fences == 3 && first.sync_gets == 0, "view missed async path");
+
+    ggml_backend_buffer_type special = first.buft;
+    ggml_backend_buffer special_buffer = first.buffer;
+    special_buffer.buft = &special;
+    auto * tensor = items[0].tensor;
+    tensor->buffer = &special_buffer;
+    copy.get(std::vector<transfer>{{tensor, result.data(), 0, part}});
+    require(first.sync_gets == 1 && first.fences == 3, "nondefault buffer did not retain synchronous callback");
+    special.iface.is_host = [](ggml_backend_buffer_type_t) { return true; };
+    copy.set(std::vector<transfer>{{tensor, source.data(), 0, part}});
+    require(first.sync_sets == 1 && first.fences == 3, "host buffer did not retain synchronous callback");
+    tensor->buffer = &first.buffer;
+
+    first.backend.iface.get_tensor_async = nullptr;
+    copy.get(std::vector<transfer>{{tensor, result.data(), 0, part}});
+    require(first.sync_gets == 2 && first.fences == 3, "backend without async acquired extra fences");
+    first.backend.iface.get_tensor_async = second.backend.iface.get_tensor_async;
+    auto first_fences = first.fences, second_fences = second.fences;
+    second.fail_submission = second.submissions + 1;
+    bool failed = false;
+    try { copy.get(items); }
+    catch (const std::runtime_error & e) { failed = std::string(e.what()) == "injected async failure"; }
+    require(failed && first.pending.empty() && second.pending.empty(), "failed submit was not drained before unwind");
+    require(first.fences == first_fences + 1 && second.fences == second_fences + 1,
+            "failed submit did not drain all submitted devices");
+    second.fail_submission = 0;
+
+    first.fail_fence = true;
+    first_fences = first.fences; second_fences = second.fences;
+    failed = false;
+    try { copy.get(items); }
+    catch (const std::runtime_error & e) { failed = std::string(e.what()) == "injected fence failure"; }
+    require(failed && first.pending.empty() && second.pending.empty() &&
+            first.fences == first_fences + 1 && second.fences == second_fences + 1,
+            "one fence failure prevented draining another device");
+    first.fail_fence = false;
+
+    // A synchronous fallback can also fail after a different stream was queued.
+    tensor->buffer = &special_buffer;
+    first.fail_sync = true;
+    failed = false;
+    try { copy.get(std::vector<transfer>{items[1], items[0]}); }
+    catch (const std::runtime_error & e) { failed = std::string(e.what()) == "injected synchronous failure"; }
+    require(failed && second.pending.empty(), "fallback failure abandoned earlier asynchronous work");
+    first.fail_sync = false;
+    tensor->buffer = &first.buffer;
+    std::fill(result.begin(), result.end(), 0);
+    copy.get(items);
+    require(source == result, "context could not be reused after transfer failure");
+    first_fences = first.fences; second_fences = second.fences;
+    copy.get(std::vector<transfer>{{tensor, nullptr, 0, 0}});
+    require(first.fences == first_fences && second.fences == second_fences, "empty copy submitted work");
+    // Reusing the helper must not reuse a buffer classification. Simulate an
+    // allocator returning the same buffer address for a new sparse backing.
+    first.registry.iface.get_proc_address = [](ggml_backend_reg_t, const char * name) -> void * {
+        static const ggml_backend_cuda_kv_growth_api api = {
+            1, nullptr, nullptr, nullptr,
+            [](ggml_backend_buffer_t buffer) -> size_t {
+                auto & self = *static_cast<deferred_backend *>(buffer->context);
+                ++self.committed_queries;
+                return self.committed_bytes;
+            }, nullptr
+        };
+        return std::strcmp(name, "ggml_backend_cuda_kv_growth_api") == 0 ?
+            const_cast<ggml_backend_cuda_kv_growth_api *>(&api) : nullptr;
+    };
+    first.device.reg = &first.registry;
+    llama_state_transfer_context repeated(backends);
+    first.committed_bytes = first.buffer.size;
+    first_fences = first.fences;
+    const size_t old_sync_gets = first.sync_gets;
+    repeated.get(std::vector<transfer>{items[0], items[2]});
+    require(first.fences == first_fences + 1 && first.committed_queries == 1,
+            "fully mapped buffer was not checked once within an operation");
+    first.committed_bytes = 0;
+    repeated.get(std::vector<transfer>{items[0], items[2]});
+    require(first.fences == first_fences + 1 && first.sync_gets == old_sync_gets + 2 && first.committed_queries == 2,
+            "new operation reused an obsolete fully mapped classification");
+    first.committed_bytes = first.buffer.size;
+    repeated.get(std::vector<transfer>{items[0], items[2]});
+    require(first.fences == first_fences + 2 && first.committed_queries == 3,
+            "new operation retained an obsolete sparse classification");
+    std::printf("state-transfer mock PASS: 64 tensors, 2 devices, 2 fences per operation; views, fallback, submit/fence/fallback failure, recovery, renewed mapping classification\n");
+}
+
+static void test_partial_vmm(ggml_backend_t backend) {
+    auto * device = ggml_backend_get_device(backend);
+    auto * registry = ggml_backend_dev_backend_reg(device);
+    const auto * api = static_cast<const ggml_backend_cuda_kv_growth_api *>(
+        ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_kv_growth_api"));
+    auto * buft = ggml_backend_get_default_buffer_type(backend);
+    require(api && api->version == 1, "KV growth API unavailable for sparse snapshot regression");
+    const size_t page = api->granularity(buft);
+    require(page != 0, "VMM unavailable for sparse snapshot regression");
+    const size_t capacity = page*16;
+    ggml_context_ptr context(ggml_init({8*ggml_tensor_overhead(), nullptr, true}));
+    require(context != nullptr, "cannot allocate sparse snapshot metadata");
+    auto * tensor = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, capacity/sizeof(float));
+    ggml_backend_buffer_ptr buffer(api->reserve(buft, capacity));
+    require(buffer != nullptr, "cannot reserve sparse snapshot storage");
+    auto allocator = ggml_tallocr_new(buffer.get());
+    require(ggml_tallocr_alloc(&allocator, tensor) == GGML_STATUS_SUCCESS, "cannot place sparse snapshot tensor");
+    require(api->committed(buffer.get()) == 0, "sparse fixture unexpectedly precommitted its pages");
+    auto * view = ggml_view_1d(context.get(), tensor, 4096, page*3 + 128);
+    require(ggml_backend_view_init(view) == GGML_STATUS_SUCCESS, "cannot place sparse snapshot view");
+    std::vector<ggml_backend_ptr> borrowed;
+    borrowed.emplace_back(backend);
+    struct release_borrow { std::vector<ggml_backend_ptr> & value; ~release_borrow() { value[0].release(); } } release{borrowed};
+    llama_state_transfer_context grouped(borrowed);
+    std::vector<uint8_t> bytes(8192, 0xff);
+    // A read from untouched virtual storage must first commit/zero its range.
+    // The view has its own base offset and the transfer adds another offset.
+    grouped.get(std::vector<transfer>{{view, bytes.data(), 64, bytes.size()}});
+    require(std::all_of(bytes.begin(), bytes.end(), [](uint8_t x) { return x == 0; }),
+            "sparse read bypassed physical commitment or zero initialization");
+    require(api->committed(buffer.get()) == page, "sparse read committed more than its touched page");
+    for (size_t i = 0; i < bytes.size(); ++i) { bytes[i] = uint8_t(i*17 + i/31); }
+    const auto expected = bytes;
+    grouped.set(std::vector<transfer>{{tensor, bytes.data(), page*9 + 256, bytes.size()}});
+    require(api->committed(buffer.get()) == 2*page, "sparse write bypassed commitment or committed the full cache");
+    std::fill(bytes.begin(), bytes.end(), 0);
+    // A fresh operation must independently classify the still-partial buffer.
+    llama_state_transfer_context(borrowed).get(std::vector<transfer>{{tensor, bytes.data(), page*9 + 256, bytes.size()}});
+    require(bytes == expected, "sparse snapshot transfer changed bytes");
+    std::printf("state-transfer VMM PASS: untouched read and write, nonzero view/transfer offsets, committed=%zu logical=%zu\n",
+            api->committed(buffer.get()), capacity);
+}
+static double median(std::vector<double> values) {
+    std::sort(values.begin(), values.end());
+    return (values[(values.size() - 1)/2] + values[values.size()/2])/2;
+}
+
+static void benchmark(ggml_backend_t backend, size_t part, bool pinned) {
+    constexpr size_t count = 64;
+    const size_t total = part*count;
+    ggml_context_ptr context(ggml_init({(count + 4)*ggml_tensor_overhead(), nullptr, true}));
+    require(context != nullptr, "cannot allocate GPU transfer metadata");
+    std::vector<transfer> items;
+    for (size_t i = 0; i < count; ++i) {
+        auto * tensor = ggml_new_tensor_1d(context.get(), GGML_TYPE_F32, part/sizeof(float));
+        items.push_back({tensor, nullptr, 0, part});
+    }
+    ggml_backend_buffer_ptr device_buffer(ggml_backend_alloc_ctx_tensors(context.get(), backend));
+    require(device_buffer != nullptr, "cannot allocate GPU transfer buffers");
+    std::vector<uint8_t> pageable;
+    ggml_backend_buffer_ptr host_buffer;
+    uint8_t * host;
+    if (pinned) {
+        auto * buft = ggml_backend_dev_host_buffer_type(ggml_backend_get_device(backend));
+        require(buft != nullptr, "backend has no pinned host buffer");
+        host_buffer.reset(ggml_backend_buft_alloc_buffer(buft, total));
+        require(host_buffer != nullptr, "cannot allocate pinned transfer buffer");
+        require(ggml_backend_buffer_get_type(host_buffer.get()) == buft, "pinned allocation fell back to pageable storage");
+        host = static_cast<uint8_t *>(ggml_backend_buffer_get_base(host_buffer.get()));
+    } else {
+        pageable.resize(total);
+        host = pageable.data();
+    }
+    std::vector<uint8_t> expected(total);
+    for (size_t i = 0; i < total; ++i) { expected[i] = uint8_t(i*13 + i/29); }
+    std::memcpy(host, expected.data(), total);
+    for (size_t i = 0; i < count; ++i) { items[i].ptr = host + i*part; }
+    // The helper borrows the existing context's stream; this owner is released
+    // below so the caller keeps the actual backend alive for the next case.
+    std::vector<ggml_backend_ptr> borrowed;
+    borrowed.emplace_back(backend);
+    struct release_borrow { std::vector<ggml_backend_ptr> & value; ~release_borrow() { value[0].release(); } } release{borrowed};
+    llama_state_transfer_context grouped(borrowed);
+    auto run = [&](bool batched, bool get) {
+        const auto start = std::chrono::steady_clock::now();
+        if (batched) {
+            if (get) { grouped.get(items); } else { grouped.set(items); }
+        } else {
+            for (const auto & item : items) {
+                if (get) { ggml_backend_tensor_get(item.tensor, item.ptr, item.offset, item.size); }
+                else { ggml_backend_tensor_set(item.tensor, item.ptr, item.offset, item.size); }
+            }
+        }
+        return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    };
+    grouped.set(items);
+    for (bool get : {true, false}) {
+        std::vector<double> baseline, batched;
+        for (int repetition = 0; repetition < 19; ++repetition) {
+            // Alternate order to reduce clock/order bias. Validate every pair
+            // outside its timer; the H2D check downloads into the same host area.
+            for (int order = 0; order < 2; ++order) {
+                const bool use_batch = (repetition + order)%2 != 0;
+                if (get) {
+                    std::memset(host, 0, total);
+                } else {
+                    // Change every tensor at both ends so a missed/stale upload
+                    // cannot pass merely because the initial bytes matched.
+                    for (size_t i = 0; i < count; ++i) {
+                        expected[i*part] ^= 0x5a;
+                        expected[(i + 1)*part - 1] ^= 0xa5;
+                    }
+                    std::memcpy(host, expected.data(), total);
+                }
+                const double ms = run(use_batch, get);
+                if (repetition >= 3) { (use_batch ? batched : baseline).push_back(ms); }
+                if (!get) { grouped.get(items); }
+                require(std::memcmp(host, expected.data(), total) == 0, "GPU transfer changed snapshot bytes");
+            }
+        }
+        const double before = median(baseline), after = median(batched);
+        std::printf("state-transfer GPU: host=%s direction=%s tensors=%zu bytes=%zu baseline_ms=%.6f batched_ms=%.6f ratio=%.4f repeats=%zu bytes=identical\n",
+                pinned ? "pinned" : "pageable", get ? "D2H" : "H2D", count, total,
+                before, after, before/after, baseline.size());
+    }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        test_deferred();
+        if (argc > 1 && std::strcmp(argv[1], "--gpu") == 0) {
+            ggml_backend_load_all();
+            auto * device = ggml_backend_dev_by_name("CUDA0");
+            if (!device) { std::fprintf(stderr, "SKIP: CUDA0 unavailable\n"); return 77; }
+            ggml_backend_ptr backend(ggml_backend_dev_init(device, nullptr));
+            require(backend != nullptr, "cannot initialize CUDA backend");
+            test_partial_vmm(backend.get());
+            for (const size_t part : {size_t(4096), size_t(256*1024)}) {
+                benchmark(backend.get(), part, false);
+                benchmark(backend.get(), part, true);
+            }
+        }
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "state-transfer FAIL: %s\n", error.what());
+        return 1;
+    }
+}
