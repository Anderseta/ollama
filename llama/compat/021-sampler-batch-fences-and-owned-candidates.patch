+static void sort_reference_candidates(reference_sampler & sampler) {
+    auto & cur = sampler.current;
+    if (cur.sorted) { return; }
+    const llama_token selected = cur.data[cur.selected].id;
+    std::sort(cur.data, cur.data + cur.size, [](const llama_token_data & a, const llama_token_data & b) { return a.p > b.p; });
+    for (size_t i = 0; i < cur.size; ++i) { if (cur.data[i].id == selected) { cur.selected = i; break; } }
+    cur.sorted = true;
+}
+
+static std::vector<llama_token> reference_batch(reference_sampler & sampler, llama_context * context,
+        const std::vector<int> & idxs, const llama_tokens & draft, bool grammar_first) {
+    std::vector<llama_token> result;
+    const auto * vocab = llama_model_get_vocab(llama_get_model(context));
+    size_t i = 0;
+    for (; i < draft.size(); ++i) {
+        const auto token = sampler.sample(context, idxs[i], grammar_first, false);
+        sampler.accept(token); result.push_back(token);
+        if (token != draft[i] || (llama_vocab_is_eog(vocab, token) && i + 1 < draft.size())) { break; }
+    }
+    if (i == draft.size()) { const auto token = sampler.sample(context, idxs[i], grammar_first, false); sampler.accept(token); result.push_back(token); }
+    return result;
+}
+
+static std::vector<llama_token> reference_batch_rejection(reference_sampler & sampler, std::mt19937 & rng,
+        llama_context * context, const std::vector<int> & idxs, const llama_tokens & draft,
+        const std::vector<std::vector<llama_token_data>> & draft_q, bool grammar_first) {
+    std::vector<llama_token> result;
+    std::uniform_real_distribution<float> uni(0.f, 1.f);
+    auto probability = [](const std::vector<llama_token_data> & values, llama_token id) {
+        for (const auto & entry : values) { if (entry.id == id) { return entry.p; } }
+        return 0.f;
+    };
+    size_t i = 0;
+    for (; i < draft.size(); ++i) {
+        const auto fallback = sampler.sample(context, idxs[i], grammar_first, false);
+        sort_reference_candidates(sampler);
+        auto & cur = sampler.current;
+        std::vector<llama_token_data> masked;
+        const bool apply_mask = !grammar_first && bool(sampler.grammar);
+        if (apply_mask) {
+            masked.assign(cur.data, cur.data + cur.size);
+            llama_token_data_array arr{masked.data(), masked.size(), -1, false};
+            llama_sampler_apply(sampler.grammar.get(), &arr);
+        }
+        auto p_raw = [&](size_t k) { return apply_mask && masked[k].logit == -INFINITY ? 0.f : cur.data[k].p; };
+        float p_sum = 0.f;
+        if (apply_mask) { for (size_t k = 0; k < cur.size; ++k) { p_sum += p_raw(k); } }
+        const float p_norm = apply_mask && p_sum > 0.f ? 1.f / p_sum : 1.f;
+        auto p_of = [&](size_t k) { return p_raw(k) * p_norm; };
+        const float q_x = probability(draft_q[i], draft[i]);
+        float p_x = 0.f;
+        for (size_t k = 0; k < cur.size; ++k) { if (cur.data[k].id == draft[i]) { p_x = p_of(k); break; } }
+        if (q_x > 0.f && (p_x >= q_x || uni(rng) < p_x / q_x)) {
+            sampler.accept(draft[i]); result.push_back(draft[i]); continue;
+        }
+        std::vector<llama_token_data> residual;
+        float sum = 0.f;
+        for (size_t k = 0; k < cur.size; ++k) {
+            const float r = p_of(k) - probability(draft_q[i], cur.data[k].id);
+            if (r > 0.f) { residual.push_back({cur.data[k].id, 0.f, r}); sum += r; }
+        }
+        llama_token token = fallback;
+        if (sum > 0.f) {
+            float u = uni(rng) * sum; token = residual.back().id;
+            for (const auto & entry : residual) { u -= entry.p; if (u <= 0.f) { token = entry.id; break; } }
+        }
+        sampler.accept(token); result.push_back(token); break;
+    }
+    if (i == draft.size()) { const auto token = sampler.sample(context, idxs[i], grammar_first, false); sampler.accept(token); result.push_back(token); }
+    return result;
+}
