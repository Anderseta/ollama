+static void sampler_candidate_ownership(llama_model * model, common_params_sampling params) {
+    auto context = fixture_context(model);
+    common_sampler_ptr source(common_sampler_init(model, params));
+    common_sampler_ptr empty(common_sampler_clone(source.get()));
+    require(!common_sampler_get_candidates(empty.get(), false)->data, "empty clone has candidate storage");
+    common_batch batch(context.get()); batch.add(3 + 'x', 0, 0, true);
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "clone fixture decode failed");
+    common_sampler_sample(source.get(), context.get(), 0);
+    auto * candidates = common_sampler_get_candidates(source.get(), false);
+    require(candidates->size > 2, "clone fixture needs several candidates");
+    // XTC can retain an interior candidate window instead of the vector base.
+    candidates->data += 1; candidates->size -= 1; candidates->selected = 0;
+    std::vector<llama_token_data> expected(candidates->data, candidates->data + candidates->size);
+    common_sampler_ptr cloned(common_sampler_clone(source.get()));
+    common_sampler_ptr copied(common_sampler_init(model, params));
+    common_sampler_copy(source.get(), copied.get());
+    for (auto * sampler : {cloned.get(), copied.get()}) {
+        const auto * actual = common_sampler_get_candidates(sampler, false);
+        require(actual->data != candidates->data, "copied candidates still alias source");
+        same_candidates(*candidates, *actual);
+    }
+    candidates->data[0].id = LLAMA_TOKEN_NULL;
+    source.reset();
+    for (auto * sampler : {cloned.get(), copied.get()}) {
+        const auto * actual = common_sampler_get_candidates(sampler, false);
+        require(actual->size == expected.size(), "candidate window size changed");
+        require(std::memcmp(actual->data, expected.data(), expected.size() * sizeof(llama_token_data)) == 0,
+                "cloned/copied candidate window changed after source mutation/destruction");
+    }
+}
