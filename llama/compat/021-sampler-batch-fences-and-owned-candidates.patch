+static void run_batch(llama_model * model, const char * name, common_params_sampling params, bool grammar_first = false) {
+    std::fprintf(stderr, "sampler-batch-view: %s\n", name);
+    for (bool rejection : {false, true}) {
+        for (int mismatch : {-1, 0, 1}) {
+            auto left = fixture_context(model), right = fixture_context(model);
+            reference_sampler reference(model, params);
+            auto next_params = params;
+            common_sampler_ptr next(common_sampler_init(model, next_params));
+            require(llama_set_sampler(left.get(), 0, common_sampler_get_backend(reference.chain.get())) &&
+                    llama_set_sampler(right.get(), 0, common_sampler_get_backend(next.get())), "batch backend registration failed");
+            if (!params.reasoning_budget_start.empty()) {
+                reference.accept(params.reasoning_budget_start.front());
+                common_sampler_accept(next.get(), params.reasoning_budget_start.front(), true);
+            }
+            common_batch a(left.get()), b(right.get());
+            for (auto * batch : {&a, &b}) {
+                batch->add(3 + 'x', 0, 0, true); batch->add(3 + 'y', 1, 0, false);
+                batch->add(3 + 'z', 2, 0, true); batch->add(3 + 'w', 3, 0, true);
+            }
+            require(llama_process(left.get(), LLAMA_PROCESS_TYPE_DECODE, a.get()) == 0 &&
+                    llama_process(right.get(), LLAMA_PROCESS_TYPE_DECODE, b.get()) == 0, "batch sparse decode failed");
+            const std::vector<int> idxs{0, 2, -1};
+            common_sampler_ptr preview(common_sampler_clone(next.get()));
+            llama_tokens draft;
+            std::vector<std::vector<llama_token_data>> draft_q;
+            for (int i = 0; i < 2; ++i) {
+                const auto token = common_sampler_sample(preview.get(), right.get(), idxs[i], grammar_first);
+                const auto * candidates = common_sampler_get_candidates(preview.get(), true);
+                draft.push_back(token); draft_q.emplace_back(candidates->data, candidates->data + candidates->size);
+                common_sampler_accept(preview.get(), token, true);
+            }
+            if (mismatch >= 0) { draft[mismatch] = 0; draft_q[mismatch] = {{0, 0.f, 1.f}}; }
+            std::mt19937 rng(common_sampler_get_seed(reference.chain.get()) ^ 0x9e3779b9u);
+            synchronizations = 0;
+            const auto expected = rejection ? reference_batch_rejection(reference, rng, left.get(), idxs, draft, draft_q, grammar_first) :
+                                              reference_batch(reference, left.get(), idxs, draft, grammar_first);
+            const auto old_fences = synchronizations.load();
+            synchronizations = 0;
+            const auto actual = rejection ? common_sampler_sample_and_accept_n_rejection(next.get(), right.get(), idxs, draft, draft_q, grammar_first) :
+                                            common_sampler_sample_and_accept_n(next.get(), right.get(), idxs, draft, grammar_first);
+            require(synchronizations.load() == 1, "batch sampling did not use exactly one context fence");
+            require(old_fences == expected.size(), "reference did not fence once per output token");
+            require(expected == actual, "batch sampling changed accepted tokens");
+            same_candidates(reference.current, *common_sampler_get_candidates(next.get(), false));
+            require(common_sampler_last(next.get()) == expected.back(), "batch acceptance history changed");
+            // The next sample also checks continued sampler/grammar/reasoning RNG state.
+            require(reference.sample(left.get(), -1, grammar_first) == common_sampler_sample(next.get(), right.get(), -1, grammar_first),
+                    "batch sampling changed subsequent sampler state");
+        }
+    }
+}
