+static void batch_eog(llama_model * model, common_params_sampling params) {
+    auto context = fixture_context(model);
+    const auto eog = llama_vocab_eos(llama_model_get_vocab(model));
+    params.logit_bias = {{eog, 100.f}};
+    common_batch batch(context.get());
+    for (int i = 0; i < 3; ++i) { batch.add(3 + 'x', i, 0, true); }
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "EOG fixture decode failed");
+    const std::vector<int> idxs{0, 1, 2};
+    const llama_tokens draft{eog, 3 + 'A'};
+    const std::vector<std::vector<llama_token_data>> q{{{eog, 0.f, 1.f}}, {{3 + 'A', 0.f, 1.f}}};
+    reference_sampler old(model, params);
+    std::mt19937 rng(common_sampler_get_seed(old.chain.get()) ^ 0x9e3779b9u);
+    require(reference_batch_rejection(old, rng, context.get(), idxs, draft, q, false).size() > 1,
+            "legacy rejection did not demonstrate acceptance after EOG");
+    for (bool rejection : {false, true}) {
+        common_sampler_ptr sampler(common_sampler_init(model, params));
+        synchronizations = 0;
+        const auto actual = rejection ? common_sampler_sample_and_accept_n_rejection(sampler.get(), context.get(), idxs, draft, q) :
+                                        common_sampler_sample_and_accept_n(sampler.get(), context.get(), idxs, draft);
+        require(synchronizations.load() == 1 && actual == llama_tokens{eog}, "batch accepted tokens after early EOG");
+        require(common_sampler_last(sampler.get()) == eog, "post-EOG token contaminated sampler history");
+        // A trailing EOG can be the target token of an existing replay. Preserve
+        // the matching verifier's established behavior for that case.
+        common_sampler_reset(sampler.get());
+        const std::vector<int> trailing_idxs{0, 1};
+        const llama_tokens trailing_draft{eog};
+        const auto trailing = rejection ? common_sampler_sample_and_accept_n_rejection(sampler.get(), context.get(), trailing_idxs, trailing_draft, {q[0]}) :
+                                          common_sampler_sample_and_accept_n(sampler.get(), context.get(), trailing_idxs, trailing_draft);
+        require(trailing == llama_tokens({eog, eog}), "trailing replay EOG behavior changed");
     }
 }
 
