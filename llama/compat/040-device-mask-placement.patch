+// Only an ordinary allocation owned by the selected CUDA device qualifies.
+// CUDA_Host, split/meta buffers and implicit host storage must not turn a
+// compact upload into a dense device-to-host mask transfer later in the graph.
+static bool device_mask_regular_storage(const ggml_tensor * tensor,ggml_backend_dev_t device) {
+    while (tensor && tensor->view_src) { tensor=tensor->view_src; }
+    if (!tensor || !tensor->buffer || ggml_backend_buffer_is_host(tensor->buffer)) { return false; }
+    const auto buft=ggml_backend_buffer_get_type(tensor->buffer);
+    return buft==ggml_backend_dev_buffer_type(device) && ggml_backend_buft_get_device(buft)==device;
