+static bool observe_mask(ggml_tensor * t,bool ask,void *) {
+    bool consumes_mask=false;
+    for(int i=0;i<GGML_MAX_SRC;++i){
+        if(t->src[i] && std::strncmp(t->src[i]->name,"attn_inp_kq_mask_device",23)==0){consumes_mask=true;}
