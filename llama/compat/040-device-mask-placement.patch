+    const bool attention=t->op==GGML_OP_FLASH_ATTN_EXT || t->op==GGML_OP_SOFT_MAX;
+    if(t->op!=GGML_OP_ATTN_MASK && t->op!=GGML_OP_MUL_MAT && !attention && !consumes_mask)return false;
+    if(ask)return true;
+    const bool host=t->buffer && ggml_backend_buffer_is_host(t->buffer);
+    if(t->op==GGML_OP_MUL_MAT || attention){
+        if(host){if(attention)++observed.cpu_attention;else ++observed.cpu_mm;}
+        else{
+            const auto device=ggml_backend_buft_get_device(ggml_backend_buffer_get_type(t->buffer));
+            const auto reg=device ? ggml_backend_dev_backend_reg(device) : nullptr;
+            if(reg&&std::strcmp(ggml_backend_reg_name(reg),"CUDA")==0){
+                if(attention)++observed.cuda_attention;else ++observed.cuda_mm;
+            }
+        }
+    }
+    if(consumes_mask){++observed.mask_consumers;if(host)++observed.host_consumers;}
+    if(t->op==GGML_OP_ATTN_MASK){
+        ++observed.ops;if(!host)++observed.device_ops;
+        observed.input_bytes+=ggml_nbytes(t->src[0])+ggml_nbytes(t->src[1]);
+        observed.output_bytes+=ggml_nbytes(t);
+    }
