+
+static long fail_allocation = -1;
+
+#if defined(_MSC_VER)
+#define TEST_NOINLINE __declspec(noinline)
+#else
+#define TEST_NOINLINE __attribute__((noinline))
+#endif
+
+TEST_NOINLINE void * operator new(size_t size) {
+    if (fail_allocation >= 0 && fail_allocation-- == 0) { throw std::bad_alloc(); }
+    if (void * p = std::malloc(size ? size : 1)) { return p; }
+    throw std::bad_alloc();
+}
+TEST_NOINLINE void * operator new[](size_t size) { return ::operator new(size); }
+TEST_NOINLINE void operator delete(void * p) noexcept { std::free(p); }
+TEST_NOINLINE void operator delete[](void * p) noexcept { std::free(p); }
+TEST_NOINLINE void operator delete(void * p, size_t) noexcept { std::free(p); }
+TEST_NOINLINE void operator delete[](void * p, size_t) noexcept { std::free(p); }
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+template <typename T>
+static size_t linear_lcp(const std::vector<T> & a, const std::vector<T> & b) {
+    size_t i = 0;
+    while (i < a.size() && i < b.size() && a[i] == b[i]) { ++i; }
+    return i;
+}
+
+static void check_query(const server_prefix_index<int, size_t> & index,
+                        const std::vector<std::vector<int>> & spans,
+                        const std::vector<bool> & active, const std::vector<int> & query) {
+    std::vector<size_t> found(spans.size(), std::numeric_limits<size_t>::max());
+    fail_allocation = 0;
+    index.query(query.data(), query.size(), [&](size_t key, size_t lcp) { found[key] = lcp; });
+    require(fail_allocation == 0, "lookup allocated memory");
+    fail_allocation = -1;
+    for (size_t i = 0; i < spans.size(); ++i) {
+        const size_t expected = active[i] ? linear_lcp(spans[i], query) : std::numeric_limits<size_t>::max();
+        require(found[i] == expected, "indexed prefix differs from exact scan");
+    }
+}
+
+static void exhaustive_and_lifetimes() {
+    std::vector<std::vector<int>> spans = {{}};
+    size_t first = 0, last = 1;
+    for (int depth = 0; depth < 4; ++depth) {
+        for (size_t i = first; i < last; ++i) {
+            for (int token = 0; token < 3; ++token) {
+                auto value = spans[i];
+                value.push_back(token);
+                spans.push_back(std::move(value));
+            }
+        }
+        first = last;
+        last = spans.size();
+    }
+    // Include exact duplicates and zero/negative/max token values.
+    spans.push_back(spans[40]);
+    spans.push_back({-1, 0, std::numeric_limits<int>::max()});
+    std::vector<size_t> order(spans.size());
+    std::iota(order.begin(), order.end(), 0);
+    std::mt19937 random(87123);
+    std::shuffle(order.begin(), order.end(), random);
+    server_prefix_index<int, size_t> index;
+    std::vector<bool> active(spans.size(), false);
+    for (size_t key : order) {
+        require(index.insert(key, spans[key].data(), spans[key].size()), "insert failed");
+        active[key] = true;
+        for (const auto & query : spans) { check_query(index, spans, active, query); }
+    }
+    std::shuffle(order.begin(), order.end(), random);
+    for (size_t key : order) {
+        index.erase(key);
+        active[key] = false;
+        for (const auto & query : spans) { check_query(index, spans, active, query); }
+        // Erased spans may be destroyed immediately, even before the next query.
+        std::vector<int>().swap(spans[key]);
+    }
+    require(index.size() == 0, "erase left entries");
+}
+
+static void random_branch_updates() {
+    std::mt19937 random(829041);
+    std::vector<std::vector<int>> spans(64);
+    for (size_t i = 0; i < spans.size(); ++i) {
+        spans[i].assign(128 + random() % 128, 7);
+        for (size_t j = 0; j < 12; ++j) { spans[i].push_back(random() % 4); }
+    }
+    server_prefix_index<int, size_t> index;
+    std::vector<bool> active(spans.size(), false);
+    for (int step = 0; step < 1000; ++step) {
+        const size_t key = random() % spans.size();
+        if (active[key]) {
+            index.erase(key);
+            active[key] = false;
+        } else {
+            require(index.insert(key, spans[key].data(), spans[key].size()), "random insert failed");
+            active[key] = true;
+        }
+        auto query = spans[random() % spans.size()];
+        if (step % 3 == 0) { query.resize(random() % (query.size() + 1)); }
+        if (step % 5 == 0) { query.push_back(9); }
+        check_query(index, spans, active, query);
+    }
+}
+
+static void allocation_and_bounds() {
+    std::vector<std::vector<int>> spans = {{1, 2, 3}, {1, 2, 4}, {1, 2}, {1, 3}, {2, 2}, {9}};
+    server_prefix_index<int, size_t> index;
+    fail_allocation = 0;
+    const bool inserted = index.insert(0, spans[0].data(), spans[0].size());
+    fail_allocation = -1;
+    require(!inserted && index.size() == 0, "failed initial reserve published entry");
+    std::vector<bool> active(spans.size(), false);
+    for (size_t i = 0; i < 4; ++i) {
+        require(index.insert(i, spans[i].data(), spans[i].size()), "retry insert failed");
+        active[i] = true;
+    }
+    const size_t before_bytes = index.allocated_bytes();
+    fail_allocation = 0;
+    const bool grown = index.insert(4, spans[4].data(), spans[4].size());
+    fail_allocation = -1;
+    require(!grown && index.size() == 4 && index.allocated_bytes() == before_bytes,
+            "failed growth changed existing index");
+    for (const auto & query : spans) { check_query(index, spans, active, query); }
+    require(index.insert(4, spans[4].data(), spans[4].size()), "growth retry failed");
+    active[4] = true;
+    for (const auto & query : spans) { check_query(index, spans, active, query); }
+
+    server_prefix_index<int, size_t> bounded(3);
+    for (size_t i = 0; i < 3; ++i) {
+        require(bounded.insert(i, spans[i].data(), spans[i].size()), "bounded insert failed");
+    }
+    require(!bounded.insert(3, spans[3].data(), spans[3].size()), "entry bound exceeded");
+    bounded.erase(1);
+    require(bounded.insert(3, spans[3].data(), spans[3].size()), "freed entry capacity unavailable");
+}
+
+struct counted_token {
+    int value;
+    static size_t comparisons;
+    bool operator==(counted_token other) const { ++comparisons; return value == other.value; }
+    bool operator<(counted_token other) const { ++comparisons; return value < other.value; }
+};
+size_t counted_token::comparisons = 0;
+
+static void shared_prefix_work() {
+    constexpr size_t count = 128, prefix = 8192;
+    std::vector<std::vector<counted_token>> spans(count, std::vector<counted_token>(prefix, {1}));
+    server_prefix_index<counted_token, size_t> index;
+    for (size_t i = 0; i < count; ++i) {
+        spans[i].push_back({int(i)});
+        spans[i].push_back({19});
+        require(index.insert(i, spans[i].data(), spans[i].size()), "shared-prefix insert failed");
+    }
+    auto query = spans[67];
+    query.push_back({3});
+    counted_token::comparisons = 0;
+    std::array<size_t, count> indexed{};
+    index.query(query.data(), query.size(), [&](size_t key, size_t lcp) { indexed[key] = lcp; });
+    const size_t indexed_work = counted_token::comparisons;
+    counted_token::comparisons = 0;
+    for (size_t i = 0; i < count; ++i) {
+        require(indexed[i] == linear_lcp(spans[i], query), "shared-prefix result mismatch");
+    }
+    const size_t linear_work = counted_token::comparisons;
+    require(indexed_work < prefix + 64, "shared prefix was rescanned per cache entry");
+    require(linear_work > count * prefix, "reference did not inspect common prefixes");
+    std::printf("shared-prefix token comparisons: linear=%zu indexed=%zu entries=%zu prefix=%zu\n",
+                linear_work, indexed_work, count, prefix);
+}
+
+static void benchmark() {
+    for (size_t prefix : {size_t(16), size_t(8192)}) {
+    for (size_t count : {size_t(1), size_t(2), size_t(4), size_t(32), size_t(128)}) {
+        constexpr size_t loops = 500;
+        std::vector<std::vector<int>> spans(count, std::vector<int>(prefix, 1));
+        server_prefix_index<int, size_t> index;
+        for (size_t i = 0; i < count; ++i) {
+            spans[i].push_back(int(i));
+            spans[i].push_back(9);
+            index.insert(i, spans[i].data(), spans[i].size());
+        }
+        auto query = spans[count / 2];
+        query.push_back(7);
+        volatile size_t sum = 0;
+        for (int iteration = 0; iteration < 4; ++iteration) {
+            const bool indexed = iteration == 1 || iteration == 2;
+            const auto start = std::chrono::steady_clock::now();
+            for (size_t loop = 0; loop < loops; ++loop) {
+                if (indexed) {
+                    index.query(query.data(), query.size(), [&](size_t, size_t lcp) { sum += lcp; });
+                } else {
+                    for (const auto & span : spans) { sum += linear_lcp(span, query); }
+                }
+            }
+            const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+            std::printf("benchmark entries=%zu prefix=%zu indexed=%d loops=%zu us=%.3f index_bytes=%zu checksum=%zu\n",
+                        count, prefix, indexed, loops, us, index.allocated_bytes(), size_t(sum));
+        }
+    }
+    }
+}
+
+static void benchmark_maintenance() {
+    for (size_t prefix : {size_t(16), size_t(8192)}) {
+        for (size_t count : {size_t(1), size_t(2), size_t(4), size_t(32)}) {
+            for (int iteration = 0; iteration < 4; ++iteration) {
+                const bool indexed = iteration == 1 || iteration == 2;
+                std::vector<std::vector<int>> spans(count, std::vector<int>(prefix, 1));
+                server_prefix_index<int, size_t> index;
+                for (size_t i = 0; i < count; ++i) {
+                    spans[i].push_back(int(i));
+                    spans[i].push_back(9);
+                    if (indexed && count >= 4) { index.insert(i, spans[i].data(), spans[i].size()); }
+                }
+                std::vector<int> query(prefix, 1);
+                query.push_back(0);
+                query.push_back(0);
+                volatile size_t sum = 0;
+                const auto start = std::chrono::steady_clock::now();
+                for (size_t loop = 0; loop < 500; ++loop) {
+                    const size_t key = loop % count;
+                    query[prefix] = int(key);
+                    query.back() = int(loop + 20);
+                    // The two existing scans are containment and obsolete-prefix
+                    // checks. Replace a fixed key afterward to measure upkeep.
+                    for (int pass = 0; pass < 2; ++pass) {
+                        if (indexed && count >= 4) {
+                            index.query(query.data(), query.size(), [&](size_t, size_t lcp) { sum += lcp; });
+                        } else {
+                            for (const auto & span : spans) { sum += linear_lcp(span, query); }
+                        }
+                    }
+                    if (indexed && count >= 4) { index.erase(key); }
+                    auto replacement = query;
+                    spans[key] = std::move(replacement);
+                    if (indexed && count >= 4) { index.insert(key, spans[key].data(), spans[key].size()); }
+                }
+                const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+                std::printf("maintenance entries=%zu prefix=%zu indexed=%d us=%.3f checksum=%zu\n",
+                            count, prefix, indexed, us, size_t(sum));
+            }
+        }
+    }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        exhaustive_and_lifetimes();
+        random_branch_updates();
+        allocation_and_bounds();
+        shared_prefix_work();
+        if (argc > 1 && std::string(argv[1]) == "--bench") { benchmark(); benchmark_maintenance(); }
+        std::puts("prompt prefix index: PASS");
+        return 0;
+    } catch (const std::exception & error) {
+        fail_allocation = -1;
+        std::fprintf(stderr, "prompt prefix index: FAIL: %s\n", error.what());
+        return 1;
+    }
+}
