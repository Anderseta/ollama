+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+static server_prompt make_prompt(const llama_tokens & tokens, bool media = false) {
+    server_prompt result;
+    result.tokens = server_tokens(tokens, media);
+    return result;
+}
+
+static server_prompt_data make_data(size_t bytes, uint8_t tag = 1) {
+    server_prompt_data result;
+    result.main.assign(bytes, tag);
+    result.drft.assign(7, tag + 1);
+    result.spec.assign(11, tag + 2);
+    return result;
+}
+
+// Independent copy of the pre-index selection rules: ordering and restore-cost
+// decisions must remain identical, including the unmeasured legacy heuristic.
+static server_prompt_cache_state * reference_best(server_prompt_cache & cache,
+        const server_prompt & live, const server_tokens & query) {
+    if (query.empty()) { return nullptr; }
+    const int baseline = live.tokens.get_common_prefix(query);
+    if (size_t(baseline) == query.size()) { return nullptr; }
+    server_prompt_cache_state * best = nullptr;
+    if (cache.prompt_us_per_token > 0 && cache.restore_us_per_byte > 0) {
+        double saving_best = 0;
+        for (auto & state : cache.states) {
+            const int lcp = state.prompt.tokens.get_common_prefix(query);
+            if (lcp <= baseline) { continue; }
+            const double saving = (lcp - baseline)*cache.prompt_us_per_token -
+                1.1*state.size()*cache.restore_us_per_byte;
+            if (saving > saving_best || (saving == saving_best && best && state.size() < best->size())) {
+                best = &state;
+                saving_best = saving;
+            }
+        }
+        return best;
+    }
+    float keep = live.tokens.size() ? float(baseline) / live.tokens.size() : -1.0f;
+    float similarity = float(baseline) / query.size();
+    for (auto & state : cache.states) {
+        const int lcp = state.prompt.tokens.get_common_prefix(query);
+        const float candidate_keep = float(lcp) / state.prompt.tokens.size();
+        const float candidate_similarity = float(lcp) / query.size();
+        if (candidate_keep >= 0.25f && keep < candidate_keep && similarity < candidate_similarity) {
+            best = &state;
+            keep = candidate_keep;
+            similarity = candidate_similarity;
+        }
+    }
+    return best;
+}
+
+static void check_selection(server_prompt_cache & cache, const server_prompt & live, const server_tokens & query) {
+    const auto expected = reference_best(cache, live, query);
+    const auto found = cache.find_best(live, query);
+    require((found == cache.states.end() ? nullptr : &*found) == expected,
+            "prefix index changed cache selection");
+}
+
+static void selection_and_mutation() {
+    server_prompt_cache cache(0, 0);
+    std::vector<llama_tokens> prompts;
+    for (int i = 0; i < 32; ++i) {
+        llama_tokens tokens(128 + i, 7);
+        tokens.push_back(100 + i);
+        tokens.insert(tokens.end(), i + 1, 5);
+        prompts.push_back(tokens);
+        auto prompt = make_prompt(tokens);
+        auto * entry = cache.alloc(prompt, make_data(32 + i, uint8_t(i)));
+        require(entry && entry->data.drft.size() == 7 && entry->data.spec.size() == 11,
+                "snapshot auxiliary state changed");
+    }
+    const auto empty = make_prompt({});
+    std::mt19937 random(78231);
+    for (int mode = 0; mode < 3; ++mode) {
+        cache.prompt_us_per_token = mode == 0 ? 0 : 10;
+        cache.restore_us_per_byte = mode == 2 ? 1e9 : 0.01;
+        for (int iteration = 0; iteration < 500; ++iteration) {
+            auto query = prompts[random() % prompts.size()];
+            if (iteration % 2 == 0) { query.resize(random() % (query.size() + 1)); }
+            if (iteration % 3 == 0) { query.push_back(77); }
+            const server_tokens incoming(query, false);
+            check_selection(cache, empty, incoming);
+            check_selection(cache, make_prompt(llama_tokens(iteration % 160, 7)), incoming);
+        }
+        cache.states.reverse(); // list order matters for the unmeasured rule
+    }
+    require(!cache.can_save(make_prompt(prompts[0]), 1), "contained prompt was saved twice");
+    auto extended = prompts[0];
+    extended.push_back(42);
+    require(cache.alloc(make_prompt(extended), make_data(80)), "extension not published");
+    require(cache.states.size() == 32, "obsolete prefix not removed");
+    check_selection(cache, empty, server_tokens(extended, false));
+
+    // Moving the owning list preserves its nodes and their immutable token spans.
+    server_prompt_cache moved = std::move(cache);
+    moved.restore_us_per_byte = 0.001;
+    check_selection(moved, empty, server_tokens(extended, false));
+    moved.limit_size = 300;
+    moved.update();
+    require(moved.size() <= moved.limit_size, "memory eviction exceeded bound");
+    check_selection(moved, empty, server_tokens(prompts[31], false));
+    moved.limit_size = 0;
+    moved.limit_tokens = 1;
+    moved.update();
+    require(moved.states.empty(), "token eviction retained snapshots");
+    for (int i = 0; i < 8; ++i) {
+        require(moved.alloc(make_prompt(prompts[i]), make_data(32)), "reinsert after eviction failed");
+    }
+    check_selection(moved, empty, server_tokens(prompts[4], false));
+}
+
+static void fallback_paths() {
+    server_prompt_cache cache(0, 0);
+    for (int i = 0; i < 8; ++i) {
+        // Media-capable token containers use their original exact comparator.
+        // Real media IDs and checkpoint serialization are not flattened by the index.
+        require(cache.alloc(make_prompt({1, 2, 3, llama_token(i + 10)}, i == 3), make_data(16)),
+                "mixed cache insertion failed");
+    }
+    const auto live = make_prompt({1});
+    for (bool media : {false, true}) {
+        for (int i = 0; i < 8; ++i) {
+            check_selection(cache, live, server_tokens({1, 2, 3, llama_token(i + 10), 22}, media));
+        }
+    }
+    require(!cache.can_save(make_prompt({1, 2, 3}), 1), "fallback containment differs");
+    const size_t before = cache.states.size();
+    require(!cache.alloc(make_prompt({99}), {}), "empty capture published");
+    require(cache.states.size() == before, "failed capture evicted snapshots");
+}
+
+static void benchmark() {
+    const auto live = make_prompt({});
+    for (size_t length : {size_t(16), size_t(8192)}) {
+        for (size_t count : {size_t(1), size_t(2), size_t(4), size_t(32)}) {
+            server_prompt_cache cache(0, 0);
+            std::vector<llama_tokens> prompts(count, llama_tokens(length, 1));
+            for (size_t i = 0; i < count; ++i) {
+                prompts[i].push_back(llama_token(i + 2));
+                require(cache.alloc(make_prompt(prompts[i]), make_data(32)), "benchmark insert failed");
+            }
+            auto next = prompts[count / 2];
+            next.push_back(99);
+            const server_tokens query(next, false);
+            cache.prompt_us_per_token = 100;
+            cache.restore_us_per_byte = 0.001;
+            volatile size_t checksum = 0;
+            for (int iteration = 0; iteration < 4; ++iteration) {
+                const bool indexed = iteration == 1 || iteration == 2;
+                const auto start = std::chrono::steady_clock::now();
+                for (int loop = 0; loop < 1000; ++loop) {
+                    if (indexed) {
+                        const auto best = cache.find_best(live, query);
+                        checksum += best == cache.states.end() ? 0 : best->size();
+                    } else {
+                        const auto best = reference_best(cache, live, query);
+                        checksum += best ? best->size() : 0;
+                    }
+                }
+                const double us = std::chrono::duration<double, std::micro>(std::chrono::steady_clock::now() - start).count();
+                std::printf("cache selection entries=%zu prefix=%zu indexed=%d us=%.3f checksum=%zu\n",
+                            count, length, indexed, us, size_t(checksum));
+            }
+        }
+    }
+}
