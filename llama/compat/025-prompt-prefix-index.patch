diff --git a/tools/server/server-prefix-index.h b/tools/server/server-prefix-index.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-prefix-index.h
@@ -0,0 +1,153 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <new>
+#include <vector>
+
+// Exact shared-prefix lookup over immutable, borrowed token spans. Sorted spans
+// plus adjacent LCP lengths encode a compact radix index without copying a token
+// or allocating a node per token. Owners must erase a key before moving/freeing
+// its span. All operations are confined to the server's inference thread.
+template <typename Token, typename Key>
+class server_prefix_index {
+    struct entry {
+        Key key;
+        const Token * tokens;
+        size_t count;
+        size_t previous_lcp;
+    };
+
+    struct comparison {
+        int order;
+        size_t lcp;
+    };
+
+    struct position {
+        size_t offset;
+        size_t previous_lcp;
+        size_t next_lcp;
+    };
+
+    std::vector<entry> entries;
+    size_t max_entries;
+
+    static comparison compare(const Token * tokens, size_t count, const entry & other, size_t start = 0) {
+        const size_t end = std::min(count, other.count);
+        while (start < end && tokens[start] == other.tokens[start]) {
+            ++start;
+        }
+        if (start < end) {
+            return { tokens[start] < other.tokens[start] ? -1 : 1, start };
+        }
+        return { count < other.count ? -1 : count > other.count ? 1 : 0, start };
+    }
+
+    size_t between(size_t a, size_t b) const {
+        if (a > b) { std::swap(a, b); }
+        size_t lcp = entries[a].count;
+        for (size_t i = a + 1; i <= b; ++i) {
+            lcp = std::min(lcp, entries[i].previous_lcp);
+        }
+        return lcp;
+    }
+
+    comparison compare_from_anchor(const Token * tokens, size_t count, size_t other,
+                                   size_t anchor, size_t anchor_lcp) const {
+        const size_t shared = between(anchor, other);
+        if (shared < anchor_lcp) {
+            // The query follows the anchor beyond this branch. Its ordering
+            // relative to the other span is therefore already known exactly.
+            return { anchor < other ? -1 : 1, shared };
+        }
+        return compare(tokens, count, entries[other], anchor_lcp);
+    }
+
+    position locate(const Token * tokens, size_t count) const {
+        if (entries.empty()) { return { 0, 0, 0 }; }
+        comparison low = compare(tokens, count, entries.front());
+        if (low.order <= 0) { return { 0, 0, low.lcp }; }
+        const size_t last = entries.size() - 1;
+        if (last == 0) { return { 1, low.lcp, 0 }; }
+        comparison high = compare_from_anchor(tokens, count, last, 0, low.lcp);
+        if (high.order > 0) { return { entries.size(), high.lcp, 0 }; }
+
+        size_t left = 0, right = last;
+        while (right - left > 1) {
+            const size_t mid = left + (right - left) / 2;
+            const comparison found = low.lcp >= high.lcp
+                ? compare_from_anchor(tokens, count, mid, left, low.lcp)
+                : compare_from_anchor(tokens, count, mid, right, high.lcp);
+            if (found.order > 0) {
+                left = mid;
+                low = found;
+            } else {
+                right = mid;
+                high = found;
+            }
+        }
+        return { right, low.lcp, high.lcp };
+    }
+
+public:
+    // At most one MiB of index entries by default, independent of prompt length.
+    // Cache snapshots and their token arrays remain owned by the existing cache.
+    explicit server_prefix_index(size_t max_entries = (1u << 20) / sizeof(entry)) : max_entries(max_entries) {}
+
+    size_t size() const { return entries.size(); }
+    size_t allocated_bytes() const { return entries.capacity() * sizeof(entry); }
+    void clear() { entries.clear(); }
+
+    bool insert(Key key, const Token * tokens, size_t count) {
+        if (entries.size() >= max_entries) { return false; }
+        const position where = locate(tokens, count);
+        // Reserve before changing any existing neighbor or entry. A failed
+        // optional index allocation must never invalidate a cache snapshot.
+        if (entries.size() == entries.capacity()) {
+            const size_t capacity = std::min(max_entries, std::max(size_t(4), entries.capacity() * 2));
+            try {
+                entries.reserve(capacity);
+            } catch (const std::bad_alloc &) {
+                return false;
+            }
+        }
+        entries.insert(entries.begin() + where.offset, { key, tokens, count, where.previous_lcp });
+        if (where.offset + 1 < entries.size()) {
+            entries[where.offset + 1].previous_lcp = where.next_lcp;
+        }
+        return true;
+    }
+
+    void erase(Key key) {
+        for (size_t i = 0; i < entries.size(); ++i) {
+            if (entries[i].key != key) { continue; }
+            if (i + 1 < entries.size()) {
+                entries[i + 1].previous_lcp = i == 0 ? 0
+                    : std::min(entries[i].previous_lcp, entries[i + 1].previous_lcp);
+            }
+            entries.erase(entries.begin() + i);
+            return;
+        }
+    }
+
+    template <typename Emit>
+    void query(const Token * tokens, size_t count, Emit emit) const {
+        if (entries.empty()) { return; }
+        const position where = locate(tokens, count);
+        const bool use_previous = where.offset == entries.size() ||
+            (where.offset > 0 && where.previous_lcp > where.next_lcp);
+        const size_t pivot = use_previous ? where.offset - 1 : where.offset;
+        const size_t pivot_lcp = use_previous ? where.previous_lcp : where.next_lcp;
+        emit(entries[pivot].key, pivot_lcp);
+        size_t lcp = pivot_lcp;
+        for (size_t i = pivot; i > 0; --i) {
+            lcp = std::min(lcp, entries[i].previous_lcp);
+            emit(entries[i - 1].key, lcp);
+        }
+        lcp = pivot_lcp;
+        for (size_t i = pivot + 1; i < entries.size(); ++i) {
+            lcp = std::min(lcp, entries[i].previous_lcp);
+            emit(entries[i].key, lcp);
+        }
+    }
+};
