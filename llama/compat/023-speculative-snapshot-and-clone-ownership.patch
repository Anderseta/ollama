+struct clone_tracker {
+    int * live;
+    bool * fail;
+    bool cloned;
+};
+
+static const char * tracked_name(const llama_sampler *) { return "clone-lifetime-fixture"; }
+static void tracked_apply(llama_sampler *, llama_token_data_array *) {}
+static void tracked_accept(llama_sampler * sampler, llama_token) {
+    const auto * tracker = static_cast<const clone_tracker *>(sampler->ctx);
+    if (*tracker->fail) { throw std::bad_alloc(); }
+}
+static llama_sampler * tracked_clone(const llama_sampler * sampler);
+static void tracked_free(llama_sampler * sampler) {
+    auto * tracker = static_cast<clone_tracker *>(sampler->ctx);
+    if (tracker->cloned) { --*tracker->live; }
+    delete tracker;
+}
+static llama_sampler * tracked_sampler(int * live, bool * fail, bool cloned = false) {
+    static llama_sampler_i iface = {
+        tracked_name, tracked_accept, tracked_apply, nullptr, tracked_clone, tracked_free,
+        nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
+    };
+    auto tracker = std::unique_ptr<clone_tracker>(new clone_tracker{live, fail, cloned});
+    auto * result = llama_sampler_init(&iface, tracker.get());
+    tracker.release();
+    if (cloned) { ++*live; }
+    return result;
+}
+static llama_sampler * tracked_clone(const llama_sampler * sampler) {
+    const auto * tracker = static_cast<const clone_tracker *>(sampler->ctx);
+    if (*tracker->fail) { throw std::bad_alloc(); }
+    return tracked_sampler(tracker->live, tracker->fail, true);
+}
+
+#if defined(_MSC_VER)
+__declspec(noinline)
+#elif defined(__GNUC__)
+__attribute__((noinline))
+#endif
+static void owned_accept(int * live, bool * fail) {
+    llama_sampler_ptr pending(tracked_sampler(live, fail, true));
+    llama_sampler_accept(pending.get(), 0);
+}
+
+static void sampler_callback_recovery() {
+    int live = 0;
+    bool fail = true;
+    for (int repeat = 0; repeat < 32; ++repeat) {
+        bool rejected = false;
+        try { owned_accept(&live, &fail); }
+        catch (const std::bad_alloc &) { rejected = true; }
+        require(rejected && live == 0, "throwing accept callback skipped caller cleanup");
+    }
+    fail = false;
+    owned_accept(&live, &fail);
+    require(live == 0, "successful accept did not release owned sampler");
+    std::puts("PASS: 32 throwing accept callbacks preserve C++ caller cleanup");
+}
+
+static void sampler_clone_recovery(llama_model * model, common_params_sampling params) {
+    auto context = fixture_context(model);
+    params.grammar = common_grammar(COMMON_GRAMMAR_TYPE_USER, "root ::= [A-Z]+\n");
+    common_sampler_ptr source(common_sampler_init(model, params));
+    common_batch batch(context.get()); batch.add(3 + 'x', 0, 0, true);
+    require(llama_process(context.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "clone recovery decode failed");
+    common_sampler_sample(source.get(), context.get(), 0);
+    common_sampler_ptr reference(common_sampler_clone(source.get()));
+    const auto * view = common_sampler_get_candidates(source.get(), false);
+    const std::vector<llama_token_data> expected(view->data, view->data + view->size);
+    auto * chain = common_sampler_get(source.get());
+    const auto original_children = llama_sampler_chain_n(chain);
+    int live = 0;
+    bool pass = false, fail = true;
+    llama_sampler_chain_add(chain, tracked_sampler(&live, &pass));
+    llama_sampler_chain_add(chain, tracked_sampler(&live, &fail));
+    for (bool common : {false, true}) {
+        for (int repeat = 0; repeat < 32; ++repeat) {
+            bool rejected = false;
+            try {
+                if (common) { common_sampler_ptr clone(common_sampler_clone(source.get())); }
+                else { llama_sampler_ptr clone(llama_sampler_clone(chain)); }
+            } catch (const std::bad_alloc &) { rejected = true; }
+            require(rejected, "clone did not preserve child allocation failure");
+            require(live == 0, "failed chain clone leaked an already cloned child");
+            require(llama_sampler_chain_n(chain) == original_children + 2, "failed clone changed source chain");
+            view = common_sampler_get_candidates(source.get(), false);
+            require(view->size == expected.size() &&
+                    std::memcmp(view->data, expected.data(), expected.size()*sizeof(llama_token_data)) == 0,
+                    "failed clone changed source candidate values");
+            fail = false;
+            {
+                common_sampler_ptr retry(common_sampler_clone(source.get()));
+                require(live == 2, "successful retry lost a child");
+                same_candidates(*view, *common_sampler_get_candidates(retry.get(), false));
+            }
+            require(live == 0, "successful clone did not release children");
+            fail = true;
+        }
+    }
+    fail = false;
+    for (int i = 0; i < 8; ++i) {
+        const auto expected_token = common_sampler_sample(reference.get(), context.get(), 0);
+        const auto token = common_sampler_sample(source.get(), context.get(), 0);
+        require(token == expected_token, "failed clone changed source grammar/RNG state");
+        common_sampler_accept(source.get(), token, true);
+        common_sampler_accept(reference.get(), token, true);
+    }
+    std::puts("PASS: 64 failed clones release returned children, preserve source state and allow retries");
+}
