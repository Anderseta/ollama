+static void speculative_checkpoint_requirements() {
+    size_t checked = 0, avoided = 0;
+    for (auto type : {COMMON_CONTEXT_SEQ_RM_TYPE_NO, COMMON_CONTEXT_SEQ_RM_TYPE_PART,
+                     COMMON_CONTEXT_SEQ_RM_TYPE_FULL, COMMON_CONTEXT_SEQ_RM_TYPE_RS}) {
+        for (uint32_t recurrent = 0; recurrent <= 8; ++recurrent) {
+            for (size_t draft = 1; draft <= 8; ++draft) {
+                const bool save = common_context_needs_rollback_checkpoint(type, draft, recurrent);
+                if (!save) { ++avoided; }
+                for (size_t accepted = 1; accepted <= draft + 1; ++accepted) {
+                    const auto rollback = draft + 1 - accepted;
+                    const bool expected = rollback > 0 && (type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+                            (type == COMMON_CONTEXT_SEQ_RM_TYPE_RS && rollback > recurrent));
+                    const bool restore = common_context_needs_rollback_checkpoint(type, rollback, recurrent);
+                    require(restore == expected, "rollback checkpoint condition changed");
+                    require(!restore || save, "skipped a sampler snapshot needed by rollback");
+                    ++checked;
+                }
+            }
+        }
+    }
+    require(!common_context_needs_rollback_checkpoint(COMMON_CONTEXT_SEQ_RM_TYPE_FULL, 0, 0),
+            "zero rollback unexpectedly needs checkpoint");
+    require(avoided == 180 && checked == 1584, "rollback coverage changed");
+    std::printf("PASS: %zu rollback cases, %zu of 288 artificial verification rounds avoid sampler clones\n", checked, avoided);
 }
 
