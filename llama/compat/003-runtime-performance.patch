+static void test_prompt_cache_selection(testing & t) {
+    server_prompt_cache cache(8, 20000);
+    llama_tokens incoming(10000, 1);
+    llama_tokens live(1000, 9);
+    std::fill_n(live.begin(), 100, 1);
+    server_prompt prompt;
+    prompt.tokens = server_tokens(live, false);
+
+    for (const auto & lengths : {std::pair<int, int>{5000, 3000}, {10000, 5000}}) {
+        llama_tokens tokens(lengths.first, 2);
+        std::fill_n(tokens.begin(), lengths.second, 1);
+        server_prompt_cache_state state;
+        state.prompt.tokens = server_tokens(tokens, false);
+        state.data.main.resize(1000);
+        cache.states.push_back(std::move(state));
+    }
+    cache.observe_prompt(1000, 1000000);
+    cache.restore_us_per_byte = 0.001;
+    const server_tokens next(incoming, false);
+    for (int i = 0; i < 2; ++i) {
+        auto best = cache.find_best(prompt, next);
+        t.assert_true("candidate found", best != cache.states.end());
+        if (best != cache.states.end()) {
+            t.assert_equal("best useful prefix", 5000, best->prompt.tokens.get_common_prefix(next));
+        }
+        cache.states.reverse();
+    }
+    cache.restore_us_per_byte = 1e9;
+    t.assert_true("expensive restore skipped", cache.find_best(prompt, next) == cache.states.end());
+    t.assert_true("empty request skipped", cache.find_best(prompt, server_tokens({}, false)) == cache.states.end());
+    server_prompt_cache unmeasured(8, 20000);
+    unmeasured.observe_prompt(1, 1);
+    t.assert_equal("tiny timing ignored", 0.0, unmeasured.prompt_us_per_token);
+}
+
+static void test_adaptive_speculation(testing & t) {
+    server_speculation_control control;
+    control.enabled = true;
+    int64_t now = 1;
+    auto step = [&](int proposed, int produced, int duration) {
+        control.begin(now);
+        control.proposed = proposed;
+        now += duration;
+        control.observe(now, produced);
+        ++now;
+    };
+    for (int i = 0; i < 8; ++i) { step(0, 1, 1000); }
+    t.assert_equal("baseline before drafting", 1, control.cap);
+    for (int i = 0; i < 4; ++i) { step(1, 2, 1000); }
+    t.assert_equal("profitable draft grows", 2, control.cap);
+    for (int i = 0; i < 4; ++i) { step(2, 1, 2000); }
+    t.assert_equal("slow draft shrinks", 1, control.cap);
+    for (int i = 0; i < 4; ++i) { step(1, 1, 2000); }
+    t.assert_equal("unprofitable drafting stops", 0, control.cap);
+    t.assert_equal("probe cooldown", 32, control.cooldown);
+    for (int i = 0; i < 32; ++i) { step(0, 1, 1000); }
+    t.assert_equal("eventual recheck", 1, control.cap);
+}
