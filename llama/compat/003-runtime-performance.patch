 //
 // stats and metrics
 //
+
+struct server_speculation_control {
+    bool enabled = false;
+    int cap = 0;
+    int normal_samples = 0;
+    int cooldown = 0;
+    int samples = 0;
+    int proposed = 0;
+    int64_t started = 0;
+    double normal_us = 0;
+    double window_us = 0;
+    uint64_t window_tokens = 0;
+
+    void begin(int64_t now) {
+        if (enabled && started == 0) {
+            started = now;
+        }
+    }
+
+    void observe(int64_t now, uint64_t produced) {
+        if (!enabled || started <= 0 || now <= started || produced == 0) {
+            return;
+        }
+        const double duration = double(now - started);
+        started = 0;
+        if (proposed == 0) {
+            const double sample = duration / produced;
+            normal_us = normal_us > 0 ? 0.75*normal_us + 0.25*sample : sample;
+            normal_samples = std::min(normal_samples + 1, 8);
+            if (cooldown > 0) {
+                --cooldown;
+            }
+            if (normal_samples == 8 && cooldown == 0) {
+                cap = 1;
+            }
+        } else {
+            window_us += duration;
+            window_tokens += produced;
+            if (++samples >= 4) {
+                if (normal_us <= 0 || window_us / window_tokens >= normal_us*0.95) {
+                    cap /= 2;
+                    cooldown = cap == 0 ? 32 : 0;
+                } else {
+                    cap = std::min(cap + 1, 8);
+                }
+                samples = 0;
+                window_us = 0;
+                window_tokens = 0;
+            }
+        }
+        proposed = 0;
+    }
+};
 
