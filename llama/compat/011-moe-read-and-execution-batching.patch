+
+namespace {
+constexpr size_t page = 65536, alignment = 4096, capacity = 1024*1024+alignment;
+void require(bool condition, const char * message) { if (!condition) { throw std::runtime_error(message); } }
+void environment(const char * name, const char * value) {
+#ifdef _WIN32
+    _putenv_s(name,value);
+#else
+    setenv(name,value,1);
+#endif
+}
+bool append(llama_model_ram_read_plan & plan, uint16_t file, size_t offset, size_t size) {
+    return plan.append(file,offset,size,alignment,capacity,page/4);
+}
+void test_planner() {
+    llama_model_ram_read_plan plan;
+    require(append(plan,0,31,page+13),"unaligned first span rejected");
+    const size_t b = 31+page+13+32, c = b+page+4096;
+    require(append(plan,0,b,page) && append(plan,0,c,page),"small tensor gaps were not coalesced");
+    require(plan.offset==0 && plan.bytes==((c+page+alignment-1)/alignment)*alignment,
+            "merged request does not cover the exact aligned source window");
+    require(plan.payload==3*page+13 && plan.required==c+page,"gaps were charged as requested payload");
+    const auto before=plan;
+    require(!append(plan,1,c+page,127),"different shards were merged");
+    require(plan.bytes==before.bytes && plan.required==before.required && plan.payload==before.payload,
+            "rejected append changed the admitted read");
+    require(!append(plan,0,7,128),"out-of-order source accepted");
+    require(!append(plan,0,c+page+page/4+1,128),"gap ceiling ignored");
+    plan={};
+    require(append(plan,0,0,page),"aligned span rejected");
+    require(!append(plan,0,page+page/4,page),"small payload admitted excessive read amplification");
+    require(append(plan,0,page/2,page),"overlapping regions rejected");
+    require(plan.payload==page+page/2 && plan.bytes==page+page/2,"overlap counted more than once");
+    require(append(plan,0,page/2,127) && plan.payload==page+page/2,"contained span enlarged union");
+    plan={};
+    require(append(plan,7,37,1024*1024),"full legacy chunk plus alignment rejected");
+    require(plan.bytes==capacity,"full chunk staging geometry changed");
+    require(!append(plan,7,37+1024*1024,page),"read exceeded its fixed staging slot");
+    plan={};
+    require(!append(plan,0,SIZE_MAX-7,8),"source overflow accepted");
+    require(!append(plan,0,SIZE_MAX-1,1),"aligned source end overflow accepted");
+    require(!append(plan,0,0,0),"empty read accepted");
+    require(!plan.append(0,0,1,0,capacity,0),"zero alignment accepted");
+    require(!plan.append(0,0,alignment+1,alignment,alignment,0),"rounded staging overflow accepted");
+    // A rounded request may pass EOF; only the final requested byte is needed.
+    require(append(plan,0,2*page+31,127) && plan.required==158 && plan.bytes==alignment,
+            "partial EOF span lost its short-read requirement");
+    printf("PASS portable read planner: shard boundaries, exact unions, overlap, bounded holes, alignment, capacity, overflow and EOF\n");
+}
+
+struct fixture {
+    std::filesystem::path path;
+    std::vector<uint8_t> raw;
+    fixture(const char * directory, size_t size, uint32_t salt) :
+        path(std::filesystem::path(directory)/("moe-read-plan-"+std::to_string(std::random_device{}())+".bin")),raw(size) {
+        for (size_t i=0;i<raw.size();++i) { raw[i]=uint8_t(i*31+i/197+salt); }
+        write();
+    }
+    ~fixture() { std::error_code error; std::filesystem::remove(path,error); }
+    void write() {
+        std::ofstream output(path,std::ios::binary|std::ios::trunc);
