@@ -0,0 +1,51 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// A single aligned read can serve pages from several tensor reservations. Only
+// requested pages enter the RAM cache; holes stay in bounded I/O staging. Keep
+// the additional traffic small, even when many individually small gaps occur.
+struct llama_model_ram_read_plan {
+    uint16_t file = 0;
+    size_t offset = 0;       // aligned source offset
+    size_t bytes = 0;        // aligned request size, including harmless EOF padding
+    size_t required = 0;     // last requested byte relative to offset
+    size_t payload = 0;      // union of the requested, possibly overlapping spans
+    size_t first = 0;
+    size_t last = 0;
+
+    bool append(uint16_t source_file, size_t source, size_t size, size_t alignment,
+                size_t capacity, size_t max_gap, size_t extra_divisor = 32) {
+        constexpr size_t maximum = std::numeric_limits<size_t>::max();
+        if (!size || !alignment || source > maximum - size) { return false; }
+        const size_t end = source + size;
+        if (bytes && (source_file != file || source < last ||
+                      (source > offset + required && source - (offset + required) > max_gap))) { return false; }
+        const size_t base = bytes ? offset : source - source % alignment;
+        const size_t new_end = bytes && offset + required > end ? offset + required : end;
+        const size_t span = new_end - base;
+        const size_t pad = span % alignment ? alignment - span % alignment : 0;
+        if (span > capacity || pad > capacity - span) { return false; }
+        const size_t request = span + pad;
+        if (request > maximum - base) { return false; }
+        const size_t added = !bytes || source >= offset + required ? size :
+                             end > offset + required ? end - (offset + required) : 0;
+        const size_t useful = payload + added; // bounded by span, so cannot overflow
+        const size_t prefix = (bytes ? first : source) - base;
+        const size_t ideal = prefix + useful;
+        const size_t ideal_pad = ideal % alignment ? alignment - ideal % alignment : 0;
+        // Ideal aligned contiguous payload is no larger than the actual span.
+        const size_t ideal_request = ideal + ideal_pad;
+        if (request - ideal_request > (extra_divisor ? useful / extra_divisor : 0)) { return false; }
+        if (!bytes) { first = source; }
+        file = source_file;
+        offset = base;
+        bytes = request;
+        required = span;
+        payload = useful;
+        last = source;
+        return true;
+    }
+};
