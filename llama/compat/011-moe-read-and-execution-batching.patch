+llama_model_ram_stats test_cache(const char * directory, bool coalesce) {
+    environment("WILDLLAMA_MOE_READ_COALESCE",coalesce ? "1" : "0");
+    const size_t aoff=31, asize=page+13, boff=aoff+asize+32, bsize=page;
+    const size_t coff=boff+bsize+4096, csize=page, doff=coff+csize+32, dsize=127;
+    fixture file(directory,doff+dsize,17);
+    llama_files files;
+    files.emplace_back(new llama_file(file.path.string().c_str(),"rb"));
+    ggml_context_ptr context(ggml_init({8*ggml_tensor_overhead(),nullptr,true}));
+    require(context!=nullptr,"cannot create read-plan context");
+    auto * a=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,asize);
+    auto * b=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,bsize);
+    auto * c=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,csize);
+    auto * d=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,dsize);
+    constexpr size_t budget=5*page;
+    llama_model_ram_cache cache(budget,files,true);
+    cache.bind(a,0,aoff); cache.bind(b,0,boff); cache.bind(c,0,coff); cache.bind(d,0,doff);
+    const std::vector<llama_model_ram_range> ranges={{a,0,asize},{b,0,bsize},{c,0,csize},{d,0,dsize}};
+    auto guard=cache.acquire();
+    require(cache.prefetch(ranges),"multi-region prefetch rejected");
+    const auto cold=cache.stats(guard);
+    require(cold.resident==budget && cold.peak==budget,"holes enlarged the managed cache quota");
+    require(cold.read_calls==(coalesce ? 1 : 4),"multi-region read count did not follow the selected plan");
+    std::vector<uint8_t> actual(asize);
+    for (const auto & range:ranges) {
+        const size_t at=range.tensor==a ? aoff : range.tensor==b ? boff : range.tensor==c ? coff : doff;
+        cache.read(range.tensor,0,actual.data(),range.size);
+        require(!memcmp(actual.data(),file.raw.data()+at,range.size),"read scatter changed tensor bytes");
+    }
+    require(cache.prefetch(ranges) && cache.stats(guard).read_calls==cold.read_calls,
+            "all-hot batch performed I/O");
+    // All requested bytes are required, even when the last read is merged and
+    // earlier source bytes could have been returned successfully by the OS.
+    for (size_t cut:{aoff+asize-1,boff+bsize-1,doff+dsize-1}) {
+        // Start cold for each failure location, then reuse the same cache for
+        // recovery and an eviction/reload cycle.
+        file.write();
+        ggml_context_ptr other(ggml_init({2*ggml_tensor_overhead(),nullptr,true}));
+        auto * alternate=ggml_new_tensor_1d(other.get(),GGML_TYPE_I8,5*page);
+        // A separate file supplies enough distinct pages to evict every old one.
+        fixture evict(directory,5*page,91);
+        llama_files failed_files;
+        failed_files.emplace_back(new llama_file(file.path.string().c_str(),"rb"));
+        failed_files.emplace_back(new llama_file(evict.path.string().c_str(),"rb"));
+        // Build fresh logical reservations for failure/recovery, without
+        // changing the already-hot cache's identifiers.
+        llama_model_ram_cache failed(budget,failed_files,true);
+        ggml_context_ptr failed_ctx(ggml_init({8*ggml_tensor_overhead(),nullptr,true}));
+        auto * fa=ggml_new_tensor_1d(failed_ctx.get(),GGML_TYPE_I8,asize);
+        auto * fb=ggml_new_tensor_1d(failed_ctx.get(),GGML_TYPE_I8,bsize);
+        auto * fc=ggml_new_tensor_1d(failed_ctx.get(),GGML_TYPE_I8,csize);
+        auto * fd=ggml_new_tensor_1d(failed_ctx.get(),GGML_TYPE_I8,dsize);
+        failed.bind(fa,0,aoff); failed.bind(fb,0,boff); failed.bind(fc,0,coff); failed.bind(fd,0,doff);
+        failed.bind(alternate,1,0);
+        const std::vector<llama_model_ram_range> failed_ranges={{fa,0,asize},{fb,0,bsize},{fc,0,csize},{fd,0,dsize}};
+        auto failed_guard=failed.acquire();
+        std::filesystem::resize_file(file.path,cut);
+        bool rejected=false;
+        try { failed.prefetch(failed_ranges); } catch (const std::exception &) { rejected=true; }
+        require(rejected,"truncated multi-region read accepted");
+        require(failed.stats(failed_guard).resident<=budget && failed.stats(failed_guard).peak<=budget,
+                "failed read enlarged the cache");
+        file.write();
+        require(failed.prefetch(failed_ranges),"read-plan cache did not recover from truncation");
+        for (const auto & range:failed_ranges) {
+            const size_t at=range.tensor==fa ? aoff : range.tensor==fb ? boff : range.tensor==fc ? coff : doff;
+            failed.read(range.tensor,0,actual.data(),range.size);
+            require(!memcmp(actual.data(),file.raw.data()+at,range.size),"recovered scatter changed bytes");
+        }
+        require(failed.prefetch({{alternate,0,5*page}}),"cannot evict completed read plan");
+        const auto evicted=failed.stats(failed_guard);
+        require(failed.prefetch(failed_ranges) && failed.stats(failed_guard).bytes_read>evicted.bytes_read,
+                "new batch reused an evicted read plan");
+    }
+    printf("read-plan cache coalesce=%d calls=%llu bytes=%llu staging=%zu peak=%zu\n",coalesce,
+        (unsigned long long)cold.read_calls,(unsigned long long)cold.bytes_read,cold.io_buffer_bytes,cold.peak);
+    return cold;
+}
+
+void test_overlap_and_shards(const char * directory) {
+    environment("WILDLLAMA_MOE_READ_COALESCE","1");
+    fixture first(directory,4*page,13), second(directory,4*page,71);
+    llama_files files;
+    files.emplace_back(new llama_file(first.path.string().c_str(),"rb"));
+    files.emplace_back(new llama_file(second.path.string().c_str(),"rb"));
+    ggml_context_ptr context(ggml_init({8*ggml_tensor_overhead(),nullptr,true}));
+    require(context!=nullptr,"cannot create overlap context");
+    auto * a=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,page);
+    auto * b=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,page);
+    auto * c=ggml_new_tensor_1d(context.get(),GGML_TYPE_I8,page);
+    llama_model_ram_cache cache(3*page,files,true);
+    cache.bind(a,0,0); cache.bind(b,0,page/2); cache.bind(c,1,0);
+    auto guard=cache.acquire();
+    require(cache.prefetch({{c,0,page},{b,0,page},{a,0,page}}),"overlap/shard batch rejected");
+    require(cache.stats(guard).read_calls==2,"overlap was reread or shards were combined");
+    std::vector<uint8_t> actual(page);
+    cache.read(a,0,actual.data(),page);
+    require(!memcmp(actual.data(),first.raw.data(),page),"first overlap span differs");
+    cache.read(b,0,actual.data(),page);
+    require(!memcmp(actual.data(),first.raw.data()+page/2,page),"second overlap span differs");
+    cache.read(c,0,actual.data(),page);
+    require(!memcmp(actual.data(),second.raw.data(),page),"shard boundary selected wrong bytes");
+}
+}
+
+int main(int argc,char ** argv) {
+    try {
+        require(argc==2,"read-plan test needs an explicit temporary directory");
+        std::filesystem::create_directories(argv[1]);
+        environment("WILDLLAMA_MOE_RUNTIME","1");
+        test_planner();
+        const auto baseline=test_cache(argv[1],false), merged=test_cache(argv[1],true);
+        require(merged.bytes_read<=baseline.bytes_read && merged.io_buffer_bytes==baseline.io_buffer_bytes &&
+                merged.peak==baseline.peak,"merged fixture increased traffic, staging or managed weights");
+        test_overlap_and_shards(argv[1]);
+        printf("PASS bounded SSD plans: exact multi-region bytes, partial EOF, fallback, quotas, cold/hot reuse, overlap, shards, failure, recovery and eviction\n");
+        return 0;
+    } catch (const std::exception & error) {
+        fprintf(stderr,"FAIL: %s\n",error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-moe-work-batch.cpp b/tests/test-moe-work-batch.cpp
new file mode 100644
index 0000000..a8f685e
--- /dev/null
+++ b/tests/test-moe-work-batch.cpp
@@ -0,0 +1,138 @@
+#include "../src/llama-moe-work-batch.h"
+#include "ggml-cpp.h"
+
+#include <cstdio>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+struct work {
+    ggml_context_ptr context;
+    std::vector<int32_t> ids;
+};
+
+static size_t lifetimes(size_t limit, bool gpu) {
+    llama_moe_work_batch<work> batch(limit);
+    std::vector<const int32_t *> pending;
+    std::vector<int32_t> expected;
+    size_t fences = 0;
+    ggml_backend_ptr backend;
+    ggml_context_ptr output_context;
+    ggml_backend_buffer_ptr output_buffer;
+    ggml_tensor * output = nullptr;
+    ggml_tensor * slots = nullptr;
+    ggml_tensor * embedding = nullptr;
+    ggml_tensor * scratch = nullptr;
+    if (gpu) {
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        require(registry && ggml_backend_reg_dev_count(registry), "CUDA unavailable");
+        backend.reset(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        require(backend != nullptr, "cannot initialize CUDA queue fixture");
+        output_context.reset(ggml_init({5*ggml_tensor_overhead(), nullptr, true}));
+        require(output_context != nullptr, "cannot allocate CUDA queue context");
+        output = ggml_new_tensor_2d(output_context.get(), GGML_TYPE_F32, 8, 32);
+        slots = ggml_new_tensor_1d(output_context.get(), GGML_TYPE_I32, 1);
+        scratch = ggml_new_tensor_1d(output_context.get(), GGML_TYPE_F32, 8);
+        embedding = ggml_new_tensor_2d(output_context.get(), GGML_TYPE_F32, 8, 256);
+        output_buffer.reset(ggml_backend_alloc_ctx_tensors(output_context.get(), backend.get()));
+        require(output_buffer != nullptr, "cannot allocate CUDA queue output");
+        std::vector<float> values(8*256);
+        for (size_t i = 0; i < values.size(); ++i) { values[i] = float(i); }
+        ggml_backend_tensor_set(embedding, values.data(), 0, ggml_nbytes(embedding));
+    }
+    auto drain = [&] {
+        if (backend) { ggml_backend_synchronize(backend.get()); }
+        for (size_t i = 0; i < pending.size(); ++i) {
+            require(*pending[i] == expected[i], "queued source was destroyed or changed before completion");
+        }
+        pending.clear();
+        expected.clear();
+        ++fences;
+    };
+    try {
+        for (int32_t i = 0; i < 32; ++i) {
+            auto & item = batch.next(drain);
+            item.context.reset(ggml_init({12*ggml_tensor_overhead()+ggml_graph_overhead_custom(8,false), nullptr, true}));
+            require(item.context != nullptr, "cannot allocate queued graph metadata");
+            item.ids = {i*7+3};
+            pending.push_back(item.ids.data());
+            expected.push_back(item.ids[0]);
+            if (backend) {
+                auto * source = ggml_new_tensor_1d(item.context.get(), GGML_TYPE_I32, 1);
+                source->buffer = slots->buffer;
+                source->data = slots->data;
+                ggml_backend_tensor_set_async(backend.get(), source, item.ids.data(), 0, sizeof(int32_t));
+                auto * weights = ggml_dup_tensor(item.context.get(), embedding);
+                weights->buffer = embedding->buffer;
+                weights->data = embedding->data;
+                auto * gathered = ggml_get_rows(item.context.get(), weights, source);
+                gathered->buffer = scratch->buffer;
+                gathered->data = scratch->data;
+                auto * destination = ggml_new_tensor_2d(item.context.get(), GGML_TYPE_F32, 8, 1);
+                destination->buffer = output->buffer;
+                destination->data = static_cast<float *>(output->data)+8*i;
+                auto * copy = ggml_cpy(item.context.get(), gathered, destination);
+                require(ggml_backend_view_init(copy) == GGML_STATUS_SUCCESS, "cannot initialize queued result view");
+                auto * graph = ggml_new_graph_custom(item.context.get(), 8, false);
+                ggml_build_forward_expand(graph, copy);
+                require(ggml_backend_graph_compute_async(backend.get(), graph) == GGML_STATUS_SUCCESS,
+                        "queued CUDA graph failed");
+            }
+            require(batch.size() <= limit, "metadata queue exceeded bound");
+        }
+        batch.flush(drain);
+    } catch (...) {
+        batch.flush(drain);
+        throw;
+    }
+    batch.flush(drain);
+    if (backend) {
+        std::vector<float> actual(8*32);
+        ggml_backend_tensor_get(output, actual.data(), 0, ggml_nbytes(output));
+        for (int32_t i = 0; i < 32; ++i) {
+            for (int32_t j = 0; j < 8; ++j) {
+                require(actual[8*i+j] == float(8*(i*7+3)+j), "queued CUDA source bytes changed");
+            }
+        }
+    }
+    return fences;
+}
+
+static void failed_drain() {
+    llama_moe_work_batch<work> batch;
+    auto & item = batch.next([] {});
+    item.ids = {42};
+    const int32_t * retained = item.ids.data();
+    bool rejected = false;
+    try { batch.flush([] { throw std::runtime_error("injected drain failure"); }); }
+    catch (const std::runtime_error &) { rejected = true; }
+    require(rejected && batch.size() == 1 && *retained == 42, "failed drain discarded a live source");
+    batch.flush([&] { require(*retained == 42, "failure recovery lost async bytes"); });
+    require(batch.size() == 0, "successful recovery left pending work");
+    bool invalid = false;
+    try { llama_moe_work_batch<work> bad(0); }
+    catch (const std::invalid_argument &) { invalid = true; }
+    require(invalid, "zero batch bound accepted");
+}
+
+int main(int argc, char ** argv) {
+    try {
+        ggml_backend_load_all();
+        const bool gpu = argc > 1 && std::string(argv[1]) == "--gpu";
+        if (gpu && !ggml_backend_reg_by_name("CUDA")) { std::puts("SKIP: CUDA unavailable"); return 77; }
+        failed_drain();
+        const auto serial = lifetimes(1, gpu), batched = lifetimes(4, gpu);
+        require(serial == 32 && batched == 8, "batch did not reduce explicit drains");
+        std::printf("PASS: async metadata/source lifetimes, failure recovery, bounded queue; drains %zu -> %zu (%s)\n",
+                    serial, batched, gpu ? "CUDA" : "CPU fixture");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
