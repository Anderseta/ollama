diff --git a/tests/test-moe-copy-plan.cpp b/tests/test-moe-copy-plan.cpp
new file mode 100644
index 0000000..3753853
--- /dev/null
+++ b/tests/test-moe-copy-plan.cpp
@@ -0,0 +1,170 @@
+#include "../src/llama-moe-copy-plan.h"
+#include "ggml-cpp.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+void boundaries() {
+    ggml_tensor source[2] {}, destination[2] {};
+    std::vector<llama_model_ram_copy> copies;
+    auto add = [&](int s, int d, size_t from, size_t to, size_t size) {
+        llama_moe_append_copy(copies, {source+s, destination+d, from, to, size});
+    };
+    add(0,0,0,16,32);
+    add(0,0,32,48,32);
+    add(0,0,64,80,0);
+    require(copies.size() == 1 && copies[0].size == 64, "adjacent expert copies did not merge exactly");
+    add(0,0,96,80,32);       // source gap: row tiles cannot merge
+    add(0,0,128,144,32);     // destination gap: unrelated cache slots
+    add(1,0,160,176,32);     // source tensor boundary
+    add(1,1,192,208,32);     // destination bank boundary
+    add(1,1,208,224,16);     // overlapping source: preserve write order
+    require(copies.size() == 6, "a gap, overlap, bank or tensor boundary was merged");
+    require(copies[1].src_offset == 96 && copies[2].dst_offset == 144 &&
+            copies[3].src == source+1 && copies[4].dst == destination+1 && copies[5].src_offset == 208,
+            "copy order or ranges changed");
+    const size_t maximum = std::numeric_limits<size_t>::max();
+    copies.clear();
+    add(0,0,maximum-3,0,8);
+    add(0,0,4,8,8);
+    require(copies.size() == 2, "overflowing source end merged with an unrelated range");
+    copies.clear();
+    add(0,0,0,maximum-3,8);
+    add(0,0,8,4,8);
+    require(copies.size() == 2, "overflowing destination end merged with an unrelated range");
+    copies.clear();
+    add(0,0,0,0,maximum-7);
+    add(0,0,maximum-7,maximum-7,16);
+    require(copies.size() == 2, "merged copy size overflowed");
+}
+
+struct result {
+    double milliseconds = 0;
+    uint64_t calls = 0;
+    size_t peak = 0;
+};
+
+result transfer(ggml_backend_t backend, const std::filesystem::path & path, bool merged,
+                bool gpu, const std::vector<uint8_t> & raw) {
+    constexpr size_t experts=64, expert_bytes=4096, plane_bytes=experts*expert_bytes, planes=3, guard_bytes=64;
+    constexpr size_t quota=1024*1024;
+    llama_files files;
+    files.emplace_back(new llama_file(path.string().c_str(), "rb"));
+    ggml_context_ptr source_ctx(ggml_init({planes*ggml_tensor_overhead(),nullptr,true}));
+    ggml_context_ptr target_ctx(ggml_init({planes*ggml_tensor_overhead(),nullptr,true}));
+    require(source_ctx && target_ctx,"test metadata allocation failed");
+    ggml_tensor * sources[planes], * targets[planes];
+    llama_model_ram_cache cache(quota,files);
+    cache.set_diagnostics(true);
+    for (size_t plane=0; plane<planes; ++plane) {
+        sources[plane]=ggml_new_tensor_1d(source_ctx.get(),GGML_TYPE_I8,plane_bytes);
+        targets[plane]=ggml_new_tensor_1d(target_ctx.get(),GGML_TYPE_I8,plane_bytes+2*guard_bytes);
+        cache.bind(sources[plane],0,31+plane*(plane_bytes+17));
+    }
+    ggml_backend_buffer_ptr target_buffer(ggml_backend_alloc_ctx_tensors(target_ctx.get(),backend));
+    require(target_buffer != nullptr,"test bank allocation failed");
+    ggml_backend_buffer_clear(target_buffer.get(),0xa5);
+    std::vector<llama_model_ram_copy> copies;
+    copies.reserve(planes*experts);
+    for (size_t plane=0; plane<planes; ++plane) {
+        for (size_t expert=0; expert<experts; ++expert) {
+            const llama_model_ram_copy next {sources[plane],targets[plane],expert*expert_bytes,
+                guard_bytes+expert*expert_bytes,expert_bytes};
+            if (merged) { llama_moe_append_copy(copies,next); }
+            else { copies.push_back(next); }
+        }
+    }
+    require(copies.size() == (merged ? planes : planes*experts),"unexpected expert upload run count");
+    result output;
+    {
+        auto lock=cache.acquire();
+        require(cache.copy_batch(backend,copies),"warmup exceeded the fixed RAM quota");
+        ggml_backend_synchronize(backend);
+        const auto before=cache.stats(lock);
+        const auto start=std::chrono::steady_clock::now();
+        require(cache.copy_batch(backend,copies),"warm transfer exceeded the fixed RAM quota");
+        ggml_backend_synchronize(backend);
+        output.milliseconds=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+        const auto after=cache.stats(lock);
+        require(after.peak <= quota && after.bytes_read == before.bytes_read,
+            "coalescing exceeded its RAM quota or warm copies reread the SSD");
+        output.calls=after.h2d_calls-before.h2d_calls;
+        output.peak=after.peak;
+        require(after.h2d_bytes-before.h2d_bytes == (gpu ? planes*plane_bytes : 0),"uploaded bytes changed");
+        if (gpu && after.upload_buffer_bytes) {
+            require(output.calls == copies.size(),"coalesced copies did not reduce actual backend upload calls");
+        }
+    }
+    std::vector<uint8_t> actual(plane_bytes+2*guard_bytes);
+    for (size_t plane=0; plane<planes; ++plane) {
+        ggml_backend_tensor_get(targets[plane],actual.data(),0,actual.size());
+        require(std::all_of(actual.begin(),actual.begin()+guard_bytes,[](uint8_t x){return x==0xa5;}) &&
+                std::all_of(actual.end()-guard_bytes,actual.end(),[](uint8_t x){return x==0xa5;}),
+                "coalescing overwrote an unrequested bank range");
+        require(!std::memcmp(actual.data()+guard_bytes,raw.data()+31+plane*(plane_bytes+17),plane_bytes),
+                "merged expert upload changed weight bytes");
+    }
+    return output;
+}
+}
+
+int main(int argc, char ** argv) {
+    try {
+        if (argc<2 || argc>3 || (argc==3 && std::string(argv[2])!="--gpu")) {
+            throw std::runtime_error("usage: test-moe-copy-plan DIRECTORY [--gpu]");
+        }
+        boundaries();
+        std::filesystem::create_directories(argv[1]);
+        const bool gpu=argc==3;
+        ggml_backend_load_all();
+        ggml_backend_ptr backend(ggml_backend_init_by_type(gpu ? GGML_BACKEND_DEVICE_TYPE_GPU : GGML_BACKEND_DEVICE_TYPE_CPU,nullptr));
+        if (gpu && !backend) { std::fprintf(stderr,"SKIP: no GPU backend\n"); return 77; }
+        require(backend != nullptr,"no test backend");
+        struct fixture {
+            std::filesystem::path path;
+            ~fixture() { std::error_code ec; std::filesystem::remove(path,ec); }
+        } file {std::filesystem::path(argv[1])/("moe-copy-plan-"+std::to_string(std::random_device{}())+".bin")};
+        std::vector<uint8_t> raw(31+3*(64*4096+17));
+        for (size_t i=0; i<raw.size(); ++i) { raw[i]=uint8_t(i*29+i/127); }
+        { std::ofstream stream(file.path,std::ios::binary); stream.write((const char *)raw.data(),raw.size());
+          require(stream.good(),"cannot write test expert fixture"); }
+        std::vector<double> baseline_times, merged_times;
+        result baseline, merged;
+        for (int round=0; round<7; ++round) {
+            if (round%2==0) {
+                baseline=transfer(backend.get(),file.path,false,gpu,raw);
+                merged=transfer(backend.get(),file.path,true,gpu,raw);
+            } else {
+                merged=transfer(backend.get(),file.path,true,gpu,raw);
+                baseline=transfer(backend.get(),file.path,false,gpu,raw);
+            }
+            baseline_times.push_back(baseline.milliseconds);
+            merged_times.push_back(merged.milliseconds);
+            require(baseline.peak == merged.peak,"merged expert copies changed managed RAM residency");
+        }
+        std::sort(baseline_times.begin(),baseline_times.end());
+        std::sort(merged_times.begin(),merged_times.end());
+        std::printf("PASS %s exact expert bytes, ordered boundaries/overflows, 1 MiB RAM quota; "
+                    "192 -> 3 copy ranges, actual H2D calls %llu -> %llu; "
+                    "warm upload median %.4f -> %.4f ms (7 alternating pairs, not model TPS)\n",
+                    gpu ? "CUDA" : "CPU",(unsigned long long)baseline.calls,(unsigned long long)merged.calls,
+                    baseline_times[3],merged_times[3]);
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr,"%s\n",error.what()); return 1;
+    }
+}
