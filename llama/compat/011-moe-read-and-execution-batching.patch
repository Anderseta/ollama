diff --git a/src/llama-moe-copy-plan.h b/src/llama-moe-copy-plan.h
new file mode 100644
index 0000000..bd3a667
--- /dev/null
+++ b/src/llama-moe-copy-plan.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "llama-model-ram.h"
+
+#include <limits>
+#include <vector>
+
+// Preserve copy order and bytes exactly. Only consecutive ranges from the same
+// tensor to the same bank, adjacent at BOTH ends, can share an upload. A row tile
+// normally has gaps between experts on disk, so it deliberately stays separate.
+inline void llama_moe_append_copy(std::vector<llama_model_ram_copy> & copies, const llama_model_ram_copy & next) {
+    if (next.size == 0) { return; }
+    if (!copies.empty()) {
+        auto & previous = copies.back();
+        const size_t maximum = std::numeric_limits<size_t>::max();
+        if (previous.src == next.src && previous.dst == next.dst &&
+            previous.size <= maximum - previous.src_offset &&
+            previous.size <= maximum - previous.dst_offset &&
+            previous.size <= maximum - next.size &&
+            previous.src_offset + previous.size == next.src_offset &&
+            previous.dst_offset + previous.size == next.dst_offset) {
+            previous.size += next.size;
+            return;
+        }
+    }
+    copies.push_back(next);
+}
