diff --git a/src/llama-moe-work-batch.h b/src/llama-moe-work-batch.h
new file mode 100644
index 0000000..25a8ddf
--- /dev/null
+++ b/src/llama-moe-work-batch.h
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <stdexcept>
+
+// Retain graph metadata and async source bytes until their stream is complete.
+// This owns no device allocation. The caller must also drain on exceptional
+// exits; a destructor cannot safely submit or wait for backend work.
+template<class Work, size_t Capacity = 4>
+class llama_moe_work_batch {
+public:
+    explicit llama_moe_work_batch(size_t limit = Capacity) : limit(limit) {
+        if (!limit || limit > Capacity) { throw std::invalid_argument("invalid MoE work batch capacity"); }
+    }
+
+    template<class Synchronize>
+    Work & next(Synchronize && synchronize) {
+        if (used == limit) { flush(synchronize); }
+        return work[used++];
+    }
+
+    template<class Synchronize>
+    void flush(Synchronize && synchronize) {
+        if (!used) { return; }
+        // A failed drain retains every source and graph for error cleanup.
+        synchronize();
+        for (size_t i = 0; i < used; ++i) { work[i] = Work{}; }
+        used = 0;
+    }
+
+    size_t size() const { return used; }
+
+private:
+    std::array<Work, Capacity> work;
+    size_t used = 0;
+    const size_t limit;
+};
