+                    // prefix; the row will be reconsidered in the next group.
+                    for (size_t i=before; i<needed.size(); ++i) { needed[i]->epoch=0; }
+                    needed.resize(before);
+                    break;
+                }
+                ++group;
+            }
+            if (!group) {
+                // A single row can straddle more pages than a very small quota.
+                // read() preserves the original chunked source addressing.
+                read(src,size_t(rows[first+at])*row_bytes,target+at*row_bytes,row_bytes);
+                group=1;
+            } else {
+                p.ensure(needed);
+                const int64_t copied = p.clock();
+                for (size_t i=0; i<group; ++i) {
+                    p.copy_out(src,size_t(rows[first+at+i])*row_bytes,target+(at+i)*row_bytes,row_bytes);
+                }
+                p.elapsed(copied,p.host_copy_us);
+            }
+            at += group;
+        }
+        if (!api->copy(upload->queue,dst,target,first*row_bytes,packet*row_bytes) ||
+            !api->record(upload->queue,slot)) { throw std::runtime_error("MoE row upload: transfer failed"); }
+        p.uploaded(true,packet*row_bytes);
+        upload->next_slot ^= 1;
+        first += packet;
+    }
+    if (!api->end(upload->queue,backend)) { throw std::runtime_error("MoE row upload: incomplete batch"); }
+    guard.complete = true;
+    p.elapsed(started,p.h2d_us);
+    llama_runtime_activity::ram(p.resident,p.limit,p.bytes_read,p.h2d_bytes);
+    return true;
+}
