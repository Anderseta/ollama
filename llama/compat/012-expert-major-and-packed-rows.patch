diff --git a/src/llama-model-ram-admission.h b/src/llama-model-ram-admission.h
new file mode 100644
index 0000000..3bb981c
--- /dev/null
+++ b/src/llama-model-ram-admission.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+
+// History belongs to logical weight pages, including nonresident pages. It
+// survives eviction, so a reused expert need not start cold after every scan.
+// Aging is lazy: neither a reference nor an eviction walks the whole model.
+struct llama_model_ram_frequency {
+    uint64_t observations = 0;
+    uint64_t interval;
+    uint64_t stale_after;
+
+    explicit llama_model_ram_frequency(size_t capacity) : interval(
+        std::max<uint64_t>(1024, capacity > std::numeric_limits<uint64_t>::max()/16
+            ? std::numeric_limits<uint64_t>::max() : uint64_t(capacity)*16)),
+        stale_after(std::max<uint64_t>(64,capacity>std::numeric_limits<uint32_t>::max()/2
+            ? std::numeric_limits<uint32_t>::max()/2 : uint64_t(capacity)*2)) {}
+
+    uint32_t generation() const { return uint32_t(observations/interval); }
+    uint16_t estimate(uint16_t count,uint32_t stamp) const {
+        // The stamp stores the low reference clock, not a coarse generation:
+        // an old topic must stop blocking a new working set well before its
+        // once-large frequency would halve away. Modulo subtraction also
+        // follows nearby references across the 32-bit clock's wrap.
+        const uint32_t distance=uint32_t(observations)-stamp;
+        if (uint64_t(distance)>observations) { return 0; }
+        const uint64_t age=observations/interval-(observations-distance)/interval;
+        const uint16_t decayed=age>=16 ? 0 : uint16_t(count>>age);
+        return distance>stale_after ? std::min<uint16_t>(1,decayed) : decayed;
+    }
+    void observe(uint16_t & count,uint32_t & stamp) {
+        ++observations;
+        const uint16_t decayed=estimate(count,stamp);
+        count=decayed==std::numeric_limits<uint16_t>::max() ? decayed : uint16_t(decayed+1);
+        stamp=uint32_t(observations);
+    }
+};
+
+// Preserve the existing tier order and current-batch protection. Only when its
+// oldest eligible page has demonstrated reuse do we examine a bounded sample
+// for a colder page. Sequential one-use traffic therefore keeps its O(1)
+// selection. Ties keep the oldest candidate, retaining recency as the fallback.
+template<class Iterator,class Eligible,class Score>
+Iterator llama_model_ram_victim(Iterator first,Iterator end,Eligible eligible,Score score,
+                               bool adaptive,size_t scan_limit,size_t & probes) {
+    auto selected=end;
+    uint16_t best=std::numeric_limits<uint16_t>::max();
+    size_t candidates=0;
+    for (auto it=first;it!=end && probes<scan_limit;++it) {
+        ++probes;
+        if (!eligible(*it)) { continue; }
+        if (!adaptive) { return it; }
+        const uint16_t value=score(*it);
+        if (selected==end || value<best) { selected=it; best=value; }
+        if (best<=1 || ++candidates==64) { break; }
+    }
+    return selected;
+}
