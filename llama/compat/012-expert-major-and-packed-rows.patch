diff --git a/src/llama-moe-expert-graph.h b/src/llama-moe-expert-graph.h
new file mode 100644
index 0000000..1576199
--- /dev/null
+++ b/src/llama-moe-expert-graph.h
@@ -0,0 +1,153 @@
+#pragma once
+
+#include "ggml-cpp.h"
+#include "ggml-cuda-moe.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+namespace llama_moe_expert_graph {
+inline size_t vector_batch_limit(ggml_backend_t backend, ggml_type type) {
+    if (!backend || !ggml_is_quantized(type)) { return 0; }
+    auto * device=ggml_backend_get_device(backend);
+    const auto * api=static_cast<const ggml_backend_cuda_moe_api *>(ggml_backend_reg_get_proc_address(
+        ggml_backend_dev_backend_reg(device),"ggml_backend_cuda_moe_api"));
+    if (!api || api->version!=1 || !api->mmvq_batch_limit) { return 0; }
+    const int32_t limit=api->mmvq_batch_limit(device,type);
+    return limit>0 ? size_t(limit) : 0;
+}
+inline size_t sum(size_t a, size_t b) {
+    if (b>std::numeric_limits<size_t>::max()-a) { throw std::length_error("expert-major workspace sum overflow"); }
+    return a+b;
+}
+inline size_t product(size_t a, size_t b) {
+    if (b && a>std::numeric_limits<size_t>::max()/b) { throw std::length_error("expert-major workspace product overflow"); }
+    return a*b;
+}
+inline size_t align(size_t bytes, size_t alignment) {
+    if (!alignment) { throw std::invalid_argument("expert-major workspace alignment is zero"); }
+    return bytes%alignment ? sum(bytes,alignment-bytes%alignment) : bytes;
+}
+struct layout {
+    size_t part=0, input_ids=0, slot_ids=0, output_ids=0, bytes=0;
+};
+inline layout carve(size_t input_rows, size_t output_rows, size_t entries, size_t alignment) {
+    layout result;
+    result.part=align(product(product(input_rows,entries),sizeof(float)),alignment);
+    result.input_ids=align(sum(result.part,product(product(output_rows,entries),sizeof(float))),alignment);
+    const size_t ids=product(entries,sizeof(int32_t));
+    result.slot_ids=align(sum(result.input_ids,ids),alignment);
+    result.output_ids=align(sum(result.slot_ids,ids),alignment);
+    result.bytes=align(sum(result.output_ids,ids),alignment);
+    return result;
+}
+inline size_t entry_capacity(size_t input_rows, size_t output_rows, size_t entries,
+                             size_t alignment, size_t available) {
+    if (!input_rows || !output_rows || !entries || !alignment) { return 0; }
+    size_t lo=0, hi=std::min(entries,size_t(std::numeric_limits<int32_t>::max()));
+    while (lo<hi) {
+        const size_t middle=lo+(hi-lo+1)/2;
+        if (carve(input_rows,output_rows,middle,alignment).bytes<=available) { lo=middle; }
+        else { hi=middle-1; }
+    }
+    return lo;
+}
+struct work {
+    ggml_context_ptr ctx;
+    std::vector<int32_t> input_rows, slot_ids, output_rows;
+};
+struct graph {
+    ggml_cgraph * value=nullptr;
+    ggml_tensor * gather=nullptr, * part=nullptr, * scatter=nullptr;
+    ggml_tensor * input_ids=nullptr, * slots=nullptr, * output_ids=nullptr;
+};
+
+inline bool geometry(const ggml_tensor * input, const ggml_tensor * output, size_t k, size_t tokens) {
+    return input && output && k && tokens && input->type==GGML_TYPE_F32 && output->type==GGML_TYPE_F32 &&
+           input->ne[0]>0 && input->ne[2]==int64_t(tokens) && input->ne[3]==1 &&
+           (input->ne[1]==1 || input->ne[1]==int64_t(k)) && input->nb[0]==sizeof(float) &&
+           (input->ne[1]==1 || input->nb[2]==input->nb[1]*k) &&
+           output->ne[1]==int64_t(k) && output->ne[2]==int64_t(tokens) && output->ne[3]==1 &&
+           output->nb[0]==sizeof(float) && output->nb[2]==output->nb[1]*k &&
+           tokens<=size_t(std::numeric_limits<int32_t>::max())/k;
+}
+inline ggml_tensor * alias(ggml_context * ctx, const ggml_tensor * source) {
+    auto * buffer=source->buffer;
+    for (const ggml_tensor * root=source; !buffer && root->view_src;) { root=root->view_src; buffer=root->buffer; }
+    if (!buffer || !source->data) { throw std::runtime_error("expert-major tensor is not allocated"); }
+    auto * result=ggml_new_tensor_4d(ctx,source->type,source->ne[0],source->ne[1],source->ne[2],source->ne[3]);
+    std::memcpy(result->nb,source->nb,sizeof(result->nb));
+    result->buffer=buffer; result->data=source->data; result->extra=source->extra;
+    return result;
+}
+inline void view(ggml_tensor * tensor) {
+    if (ggml_backend_view_init(tensor)!=GGML_STATUS_SUCCESS) { throw std::runtime_error("expert-major view initialization failed"); }
+}
+inline void allocate(ggml_backend_buffer_t workspace, ggml_tensor * tensor, size_t offset) {
+    auto * bytes=static_cast<uint8_t *>(ggml_backend_buffer_get_base(workspace));
+    if (ggml_backend_tensor_alloc(workspace,tensor,bytes+offset)!=GGML_STATUS_SUCCESS) {
+        throw std::runtime_error("expert-major bounded workspace allocation failed");
+    }
+}
+
+// All async host index arrays belong to `item`. The caller retains it through
+// its stream fence. The workspace is the EXISTING dynamic-prefill reservation;
+// no tensor allocator or extra device buffer is used here.
+inline graph build(work & item, const ggml_tensor * input, ggml_tensor * output,
+                   const ggml_tensor * weight, size_t output_row, size_t rows,
+                   size_t k, size_t tokens, ggml_backend_buffer_t workspace) {
+    const size_t entries=item.slot_ids.size();
+    if (!entries || item.input_rows.size()!=entries || item.output_rows.size()!=entries ||
+        !geometry(input,output,k,tokens) || !workspace || !weight || weight->ne[0]!=input->ne[0] ||
+        weight->ne[1]!=int64_t(rows) || output_row>size_t(output->ne[0]) || rows>size_t(output->ne[0])-output_row) {
+        throw std::invalid_argument("invalid expert-major graph geometry");
+    }
+    const size_t source_rows=input->ne[1]==1 ? tokens : product(tokens,k);
+    for (size_t entry=0; entry<entries; ++entry) {
+        if (item.input_rows[entry]<0 || size_t(item.input_rows[entry])>=source_rows ||
+            item.output_rows[entry]<0 || size_t(item.output_rows[entry])>=product(tokens,k) ||
+            item.slot_ids[entry]<0 || item.slot_ids[entry]>=weight->ne[2]) {
+            throw std::invalid_argument("expert-major graph contains an out-of-range index");
+        }
+    }
+    const size_t alignment=ggml_backend_buft_get_alignment(ggml_backend_buffer_get_type(workspace));
+    const auto area=carve(size_t(input->ne[0]),rows,entries,alignment);
+    if (area.bytes>ggml_backend_buffer_get_size(workspace)) { throw std::length_error("expert-major graph exceeds existing workspace"); }
+    item.ctx.reset(ggml_init({32*ggml_tensor_overhead()+ggml_graph_overhead_custom(32,false),nullptr,true}));
+    auto * ctx=item.ctx.get();
+    if (!ctx) { throw std::runtime_error("expert-major metadata allocation failed"); }
+    auto * source=alias(ctx,input);
+    auto * target=alias(ctx,output);
+    auto * bank=alias(ctx,weight);
+    auto * source_view=ggml_view_2d(ctx,source,input->ne[0],int64_t(source_rows),
+        input->ne[1]==1 ? input->nb[2] : input->nb[1],0);
+    view(source_view);
+    graph result;
+    result.input_ids=ggml_new_tensor_1d(ctx,GGML_TYPE_I32,int64_t(entries));
+    result.slots=ggml_new_tensor_2d(ctx,GGML_TYPE_I32,1,int64_t(entries));
+    result.output_ids=ggml_new_tensor_1d(ctx,GGML_TYPE_I32,int64_t(entries));
+    allocate(workspace,result.input_ids,area.input_ids);
+    allocate(workspace,result.slots,area.slot_ids);
+    allocate(workspace,result.output_ids,area.output_ids);
+    result.gather=ggml_get_rows(ctx,source_view,result.input_ids);
+    allocate(workspace,result.gather,0);
+    auto * inputs=ggml_reshape_3d(ctx,result.gather,input->ne[0],1,int64_t(entries));
+    view(inputs);
+    result.part=ggml_mul_mat_id(ctx,bank,inputs,result.slots);
+    allocate(workspace,result.part,area.part);
+    auto * values=ggml_reshape_2d(ctx,result.part,int64_t(rows),int64_t(entries));
+    view(values);
+    auto * destination=ggml_view_2d(ctx,target,int64_t(rows),int64_t(product(tokens,k)),output->nb[1],output_row*sizeof(float));
+    view(destination);
+    result.scatter=ggml_set_rows(ctx,destination,values,result.output_ids);
+    view(result.scatter);
+    result.value=ggml_new_graph_custom(ctx,32,false);
+    ggml_build_forward_expand(result.value,result.scatter);
+    return result;
+}
+}
