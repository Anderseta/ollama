+struct group {
+    size_t expert_begin = 0, expert_count = 0;
+    size_t entry_begin = 0, entry_count = 0;
+};
+struct plan {
+    // Stable routed-entry permutation. The destination is ALWAYS the original
+    // rank/token row, so no reduction order or selected expert is changed.
+    std::vector<int32_t> entries;
+    std::vector<int32_t> experts;
+    std::vector<group> groups;
+    size_t window_uploads = 0;
+    bool profitable = false;
+};
+
+inline plan make(const int32_t * ids, size_t tokens, size_t k, size_t capacity,
+                 size_t expert_count, const std::vector<llama_moe_partition::window> & windows) {
+    plan result;
+    if (!capacity || !expert_count || !k || (tokens && !ids) ||
+        tokens > size_t(std::numeric_limits<int32_t>::max()) / k ||
+        expert_count > size_t(std::numeric_limits<int32_t>::max())) {
+        throw std::invalid_argument("invalid expert-major route dimensions");
+    }
+    const size_t count = tokens*k;
+    std::vector<size_t> offsets(expert_count+1,0);
+    for (size_t entry=0; entry<count; ++entry) {
+        if (ids[entry]<0 || size_t(ids[entry])>=expert_count) {
+            throw std::invalid_argument("invalid expert-major routed expert");
+        }
+        ++offsets[size_t(ids[entry])+1];
+    }
+    for (size_t expert=0; expert<expert_count; ++expert) {
+        if (offsets[expert+1]) { result.experts.push_back(int32_t(expert)); }
+        offsets[expert+1]+=offsets[expert];
+    }
+    for (const auto & window:windows) {
+        if (window.unique > std::numeric_limits<size_t>::max()-result.window_uploads) {
+            throw std::length_error("expert-major traffic estimate overflow");
+        }
+        result.window_uploads+=window.unique;
+    }
+    // Reordering has gather/scatter costs. Leave short windows, an expert union
+    // that fits, and low repetition on the original token-major path. This is
+    // an upload estimate, not a prediction of wall time or actual cache hits.
+    result.profitable = tokens>=32 && result.experts.size()>capacity &&
+                        result.window_uploads/result.experts.size()>=2;
+    if (!result.profitable) { return result; }
+    result.entries.resize(count);
+    auto cursor=offsets;
+    for (size_t entry=0; entry<count; ++entry) {
+        result.entries[cursor[size_t(ids[entry])]++]=int32_t(entry);
+    }
+    for (size_t begin=0; begin<result.experts.size(); begin+=capacity) {
+        const size_t end=std::min(begin+capacity,result.experts.size());
+        const size_t first=offsets[size_t(result.experts[begin])];
+        const size_t last=offsets[size_t(result.experts[end-1])+1];
+        result.groups.push_back({begin,end-begin,first,last-first});
+    }
+    return result;
+}
+}
