+bool llama_sampler_backend_can_bind_graph(const llama_sampler * sampler) {
+    if (!sampler || !sampler->iface) { return false; }
+    if (sampler->iface == &llama_sampler_chain_i) {
+        const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+        return chain.is_init && !chain.samplers.empty() &&
+            std::all_of(chain.samplers.begin(), chain.samplers.end(), [](const llama_sampler_chain::info & child) {
+                return child.is_backend && llama_sampler_backend_can_bind_graph(child.ptr);
+            });
+    }
+    // Custom callbacks may retain additional tensor pointers. They require an
+    // explicit binding contract before they can use multiple graph arenas.
+    return graph_binding_leaf(sampler->iface);
+}
+
+std::unique_ptr<llama_sampler_graph_binding> llama_sampler_backend_capture_bindings(llama_sampler * sampler) {
+    if (!llama_sampler_backend_can_bind_graph(sampler)) { return nullptr; }
+    return std::unique_ptr<llama_sampler_graph_binding>(new sampler_graph_binding(sampler));
+}
