+llm_graph_input_sampling::llm_graph_input_sampling(std::map<llama_seq_id, llama_sampler *> samplers) :
+    samplers(std::move(samplers)) { }
+
+llm_graph_input_sampling::~llm_graph_input_sampling() = default;
+
+bool llm_graph_input_sampling::capture_bindings() {
+    return capture_bindings(llama_sampler_backend_capture_bindings);
+}
+
+bool llm_graph_input_sampling::capture_bindings(binding_factory capture) {
+    try {
+        for (const auto & entry : samplers) {
+            auto binding = capture(entry.second);
+            if (!binding) { bindings.clear(); return false; }
+            bindings.emplace(entry.first, std::move(binding));
+        }
+        return true;
+    } catch (const std::bad_alloc &) {
+        // This is an optional cache. The newly built graph's original binding
+        // remains valid, so inference can continue in the conventional arena.
+        bindings.clear();
+        return false;
+    }
+}
+
+size_t llm_graph_input_sampling::binding_bytes() const {
+    size_t bytes = 0;
+    for (const auto & entry : bindings) {
+        // Include a conservative map-node allowance, not just pointer payloads.
+        bytes += sizeof(entry) + 4*sizeof(void *) + entry.second->memory_size();
+    }
+    return bytes;
+}
