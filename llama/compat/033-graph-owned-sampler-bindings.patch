+static void graph_binding_budget(const char * value) {
+#ifdef _WIN32
+    require(_putenv_s("WILDLLAMA_GRAPH_VARIANTS_MIB", value) == 0, "graph binding budget failed");
+#else
+    require(setenv("WILDLLAMA_GRAPH_VARIANTS_MIB", value, 1) == 0, "graph binding budget failed");
+#endif
+}
+
+static llama_sampler_ptr graph_binding_chain(int seed, bool compact, bool penalties, bool partial = false) {
+    llama_sampler_ptr chain(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    const llama_logit_bias biases[] = {{0, -INFINITY}, {1, -INFINITY}, {2, -INFINITY}, {3+'a', .1f}};
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_logit_bias(n_vocab, 4, biases));
+    if (penalties) { llama_sampler_chain_add(chain.get(), llama_sampler_init_penalties(n_vocab, 8, 1.1f, .1f, .1f)); }
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_top_k(20));
+    if (partial) { llama_sampler_chain_add(chain.get(), llama_sampler_init_typical(.8f, 1)); }
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_temp(.7f));
+    llama_sampler_chain_add(chain.get(), llama_sampler_init_dist(seed));
+    if (compact) { require(llama_sampler_backend_set_selected_only(chain.get()), "compact graph binding contract failed"); }
+    return chain;
+}
+
+static int binding_capture_calls = 0;
+static std::unique_ptr<llama_sampler_graph_binding> binding_capture_failure(llama_sampler * sampler) {
+    if (++binding_capture_calls == 2) { throw std::bad_alloc(); }
+    return llama_sampler_backend_capture_bindings(sampler);
+}
+
+static void graph_binding_outputs(const llama_sampler_output & a, const llama_sampler_output & b) {
+    require(a.sampled_token == b.sampled_token && a.sampled_probs_count == b.sampled_probs_count &&
+            a.sampled_logits_count == b.sampled_logits_count && a.candidates_count == b.candidates_count,
+            "graph arena changed sampler output shape/token");
+    require(bool(a.raw_logits) == bool(b.raw_logits) && bool(a.sampled_probs) == bool(b.sampled_probs) &&
+            bool(a.sampled_logits) == bool(b.sampled_logits) && bool(a.candidates) == bool(b.candidates),
+            "graph arena changed sampler output availability");
+    if (a.raw_logits) { require(std::equal(a.raw_logits, a.raw_logits+n_vocab, b.raw_logits), "graph arena changed raw logits"); }
+    if (a.sampled_probs) { require(std::equal(a.sampled_probs, a.sampled_probs+a.sampled_probs_count, b.sampled_probs), "graph arena changed probabilities"); }
+    if (a.sampled_logits) { require(std::equal(a.sampled_logits, a.sampled_logits+a.sampled_logits_count, b.sampled_logits), "graph arena changed filtered logits"); }
+    if (a.candidates) { require(std::equal(a.candidates, a.candidates+a.candidates_count, b.candidates), "graph arena changed candidate IDs"); }
+}
+
+static void graph_owned_sampler_variants(llama_model * model, bool penalties, bool mixed, bool partial = false) {
+    // Construct the same tiny CPU/CUDA model with different graph retention
+    // policies. The contexts snapshot their environment at construction.
+    const char * old_env = std::getenv("WILDLLAMA_GRAPH_VARIANTS_MIB");
+    const std::string old_budget = old_env ? old_env : "";
+    struct restore_budget { std::string value; ~restore_budget() { graph_binding_budget(value.c_str()); } } restore{old_budget};
+    auto make_context = [&](const char * budget) {
+        graph_binding_budget(budget);
+        auto params = llama_context_default_params();
+        params.n_ctx = 256; params.n_batch = params.n_ubatch = 8; params.n_seq_max = 2; params.n_rs_seq = 2;
+        params.n_outputs_max_per_seq = penalties ? 1 : 3;
+        params.n_threads = params.n_threads_batch = 1; params.no_perf = false;
+        params.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+        llama_context_ptr context(llama_init_from_model(model, params));
+        require(bool(context), "graph binding context unavailable"); return context;
+    };
+    auto left = make_context("0"), right = make_context("64");
+    std::vector<llama_sampler_ptr> a, b;
+    for (int seq = 0; seq < 2; ++seq) {
+        const bool compact = mixed && seq == 0;
+        a.push_back(graph_binding_chain(451+seq, compact, penalties, partial));
+        b.push_back(graph_binding_chain(451+seq, compact, penalties, partial));
+        require(llama_set_sampler(left.get(), seq, a.back().get()) && llama_set_sampler(right.get(), seq, b.back().get()),
+                "graph binding sampler attach failed");
+        require(llama_sampler_backend_can_bind_graph(b.back().get()) == !partial, "graph binding capability accepted CPU suffix");
+    }
+    llama_pos positions[2]{};
+    size_t arenas = 0;
+    // Repeated A B C B A shapes plus sparse/reordered sequence rows. The same
+    // logical RNG/history must fill each old arena, not the newest one built.
+    const int shapes[] = {1,3,2,3,1,4,3,2,3,1,4,3,2,3,1};
+    for (size_t step=0; step<sizeof(shapes)/sizeof(shapes[0]); ++step) {
+        if (step == 10) {
+            for (int seq=0; seq<2; ++seq) {
+                auto na=graph_binding_chain(981+seq, mixed && seq==0, penalties, partial);
+                auto nb=graph_binding_chain(981+seq, mixed && seq==0, penalties, partial);
+                require(llama_set_sampler(left.get(),seq,na.get()) && llama_set_sampler(right.get(),seq,nb.get()), "replacement attach failed");
+                // Destroy the old sampler BEFORE reserve/arena invalidation.
+                a[seq]=std::move(na); b[seq]=std::move(nb);
+            }
+        }
+        std::vector<llama_sampler_ptr> checkpoints_a, checkpoints_b;
+        if (step==6) {
+            for (int seq=0; seq<2; ++seq) {
+                checkpoints_a.emplace_back(llama_sampler_clone(a[seq].get()));
+                checkpoints_b.emplace_back(llama_sampler_clone(b[seq].get()));
+                require(!llama_sampler_backend_capture_bindings(checkpoints_b.back().get()), "clone borrowed graph bindings");
+            }
+        }
+        common_batch ba(left.get()), bb(right.get());
+        std::vector<std::pair<int,int>> outputs;
+        const int n=shapes[step];
+        int last[2]={-1,-1};
+        for (int i=0;i<n;++i) { last[(n==1 ? 0 : (i+1)%2)]=i; }
+        for (int i=0;i<n;++i) {
+            const int seq=n==1 ? 0 : (i+1)%2;
+            const bool output=i==last[seq] || (!penalties && n==4 && i==0);
+            const auto token=3+'a'+int((step+i)%21);
+            ba.add(token,positions[seq],seq,output); bb.add(token,positions[seq],seq,output);
+            ++positions[seq];
+            if (output) { outputs.emplace_back(i,seq); }
+        }
+        require(llama_process(left.get(),LLAMA_PROCESS_TYPE_DECODE,ba.get())==0 &&
+                llama_process(right.get(),LLAMA_PROCESS_TYPE_DECODE,bb.get())==0, "graph binding shape decode failed");
+        for (const auto & item:outputs) {
+            const auto av=llama_get_sampler_output_ith(left.get(),item.first);
+            const auto bv=llama_get_sampler_output_ith(right.get(),item.first);
+            graph_binding_outputs(av,bv);
+            require(partial || bv.sampled_token!=LLAMA_TOKEN_NULL, "graph binding fixture did not sample on backend");
+            // Do not commit the second generated row: the next decode must
+            // resume from accepted RNG state, regardless of selected arena.
+            if (!penalties && n==4 && item.first==2 && item.second==1) { continue; }
+            const auto expected=llama_sampler_sample(a[item.second].get(),left.get(),item.first);
+            const auto actual=llama_sampler_sample(b[item.second].get(),right.get(),item.first);
+            require(expected==actual,"graph-owned input binding changed logical RNG/history");
+        }
+        if (step==6) {
+            for (int seq=0;seq<2;++seq) {
+                llama_sampler_copy(checkpoints_a[seq].get(),a[seq].get());
+                llama_sampler_copy(checkpoints_b[seq].get(),b[seq].get());
+                llama_sampler_accept(a[seq].get(),3+'q'); llama_sampler_accept(b[seq].get(),3+'q');
+            }
+        }
+        const auto stats=right->get_graph_variant_stats();
+        arenas=std::max(arenas,stats.arenas);
+        require(stats.compute_bytes+stats.metadata_bytes<=64*1024*1024,"sampler bindings escaped graph retention quota");
+    }
+    if (partial) { require(arenas==0,"partial/custom chain retained graph bindings"); }
+    else {
+        require(arenas>0 && llama_perf_context(right.get()).n_reused>llama_perf_context(left.get()).n_reused,
+                "stochastic fixture never used the graph variant cache");
+        llm_graph_input_sampling failed({{0,b[0].get()},{1,b[1].get()}});
+        binding_capture_calls=0;
+        require(!failed.capture_bindings(binding_capture_failure) && failed.bindings.empty() && failed.binding_bytes()==0,
+                "partial snapshot allocation failure retained borrowed bindings");
+        auto binding=llama_sampler_backend_capture_bindings(b[0].get());
+        require(binding && binding->matches(b[0].get()),"live graph binding not matched");
+        auto * terminal=llama_sampler_chain_remove(b[0].get(),llama_sampler_chain_n(b[0].get())-1);
+        require(!binding->matches(b[0].get()),"removed stage kept graph binding valid");
+        llama_sampler_chain_add(b[0].get(),terminal);
+        require(!binding->matches(b[0].get()),"re-added stage kept old graph binding valid");
+        int live=0; bool fail=false;
+        llama_sampler_ptr custom(tracked_sampler(&live,&fail));
+        require(!llama_sampler_backend_can_bind_graph(custom.get()),"custom callback claimed graph binding capability");
+    }
+    // Bindings may outlive their logical sampler at destruction. Detach before
+    // vector cleanup, matching an ordinary client replacing a sampler.
+    for(int seq=0;seq<2;++seq) { llama_set_sampler(left.get(),seq,nullptr); llama_set_sampler(right.get(),seq,nullptr); }
+    std::printf("PASS graph-owned sampler arenas: %s%s%s, %zu retained arenas\n", penalties?"penalties ":"seeded ", mixed?"mixed compact ":"detailed ",partial?"CPU suffix fallback":"",arenas);
+}
