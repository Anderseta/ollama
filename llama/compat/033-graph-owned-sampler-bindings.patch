+// Graph binding snapshots deliberately contain no RNG, penalty history, token
+// counters or candidate arrays. Restoring sampler state must never redirect an
+// input write to another graph's compute arena.
+namespace {
+bool graph_binding_leaf(const llama_sampler_i * iface) {
+    return iface == &llama_sampler_empty_i     || iface == &llama_sampler_greedy_i ||
+           iface == &llama_sampler_dist_i      || iface == &llama_sampler_top_k_i  ||
+           iface == &llama_sampler_top_p_i     || iface == &llama_sampler_min_p_i  ||
+           iface == &llama_sampler_temp_i      || iface == &llama_sampler_temp_ext_i ||
+           iface == &llama_sampler_penalties_i || iface == &llama_sampler_logit_bias_i;
+}
+
+class sampler_graph_binding final : public llama_sampler_graph_binding {
+    struct entry {
+        llama_sampler * identity = nullptr;
+        const llama_sampler_i * iface = nullptr;
+        const void * context = nullptr;
+        uint64_t chain_id = 0, chain_revision = 0;
+        size_t children = 0;
+        bool selected_only = false, selects_token = false;
+
+        // dist's graph inputs and immutable per-graph draw mode.
+        std::vector<ggml_tensor *> uniforms;
+        bool transactional = false;
+
+        // penalties/logit-bias graph inputs. Penalty scratch follows the graph
+        // geometry, without cloning or exchanging the logical token history.
+        ggml_tensor * input0 = nullptr, * input1 = nullptr;
+        int32_t n_max = 0;
+        bool has_candidates = false;
+        std::vector<int32_t> token_ids, counts;
+    };
+    std::vector<entry> entries;
+
+    void capture(llama_sampler * sampler) {
+        entry e;
+        e.identity = sampler; e.iface = sampler->iface; e.context = sampler->ctx;
+        if (sampler->iface == &llama_sampler_chain_i) {
+            const auto & chain = *static_cast<llama_sampler_chain *>(sampler->ctx);
+            e.chain_id = chain.graph_binding_id; e.chain_revision = chain.graph_binding_revision;
+            e.children = chain.samplers.size(); e.selected_only = chain.selected_only;
+            e.selects_token = chain.backend_selects_token;
+        } else if (sampler->iface == &llama_sampler_dist_i) {
+            const auto & ctx = *static_cast<llama_sampler_dist *>(sampler->ctx);
+            e.uniforms = ctx.inp_uniforms; e.transactional = ctx.backend_transactional;
+        } else if (sampler->iface == &llama_sampler_penalties_i) {
+            const auto & ctx = *static_cast<llama_sampler_penalties *>(sampler->ctx);
+            e.input0 = ctx.inp_token_ids; e.input1 = ctx.inp_counts;
+            e.n_max = ctx.n_max; e.has_candidates = ctx.has_candidates;
+            e.token_ids = ctx.host_token_ids; e.counts = ctx.host_counts;
+        } else if (sampler->iface == &llama_sampler_logit_bias_i) {
+            const auto & ctx = *static_cast<llama_sampler_logit_bias *>(sampler->ctx);
+            e.input0 = ctx.inp_logit_bias; e.input1 = ctx.inp_logit_idxs;
+        }
+        entries.push_back(std::move(e));
+        if (sampler->iface == &llama_sampler_chain_i) {
+            for (const auto & child : static_cast<llama_sampler_chain *>(sampler->ctx)->samplers) {
+                capture(child.ptr);
+            }
+        }
+    }
+
+    bool matches_impl(const llama_sampler * sampler, size_t & index) const noexcept {
+        if (!sampler || index >= entries.size()) { return false; }
+        const auto & e = entries[index++];
+        // Compare identities before inspecting live objects. Stored identities
+        // are never dereferenced; destruction/replacement may precede eviction.
+        if (e.identity != sampler || e.iface != sampler->iface || e.context != sampler->ctx) { return false; }
+        if (sampler->iface == &llama_sampler_chain_i) {
+            const auto & chain = *static_cast<const llama_sampler_chain *>(sampler->ctx);
+            if (!chain.is_init || e.chain_id != chain.graph_binding_id ||
+                e.chain_revision != chain.graph_binding_revision || e.children != chain.samplers.size() ||
+                e.selected_only != chain.selected_only || e.selects_token != chain.backend_selects_token) { return false; }
+            for (const auto & child : chain.samplers) {
+                if (!child.is_backend || !matches_impl(child.ptr, index)) { return false; }
+            }
+        }
+        return true;
+    }
+public:
+    explicit sampler_graph_binding(llama_sampler * sampler) { capture(sampler); }
+
+    bool matches(const llama_sampler * sampler) const noexcept override {
+        size_t index = 0;
+        return matches_impl(sampler, index) && index == entries.size();
+    }
+
+    void swap_bindings(llama_sampler * sampler) noexcept override {
+        GGML_ASSERT(matches(sampler));
+        for (auto & e : entries) {
+            if (e.iface == &llama_sampler_dist_i) {
+                auto & ctx = *static_cast<llama_sampler_dist *>(e.identity->ctx);
+                ctx.inp_uniforms.swap(e.uniforms);
+                std::swap(ctx.backend_transactional, e.transactional);
+            } else if (e.iface == &llama_sampler_penalties_i) {
+                auto & ctx = *static_cast<llama_sampler_penalties *>(e.identity->ctx);
+                std::swap(ctx.inp_token_ids, e.input0); std::swap(ctx.inp_counts, e.input1);
+                std::swap(ctx.n_max, e.n_max); std::swap(ctx.has_candidates, e.has_candidates);
+                ctx.host_token_ids.swap(e.token_ids); ctx.host_counts.swap(e.counts);
+            } else if (e.iface == &llama_sampler_logit_bias_i) {
+                auto & ctx = *static_cast<llama_sampler_logit_bias *>(e.identity->ctx);
+                std::swap(ctx.inp_logit_bias, e.input0); std::swap(ctx.inp_logit_idxs, e.input1);
+            }
+        }
+    }
+
+    size_t memory_size() const noexcept override {
+        size_t bytes = sizeof(*this) + entries.capacity()*sizeof(entry);
+        for (const auto & e : entries) {
+            bytes += e.uniforms.capacity()*sizeof(ggml_tensor *);
+            bytes += (e.token_ids.capacity() + e.counts.capacity())*sizeof(int32_t);
+        }
+        return bytes;
+    }
+};
