+static int fail_allocation_after = -1;
+#if defined(_MSC_VER)
+#define TEST_NOINLINE __declspec(noinline)
+#elif defined(__GNUC__)
+#define TEST_NOINLINE __attribute__((noinline))
+#else
+#define TEST_NOINLINE
