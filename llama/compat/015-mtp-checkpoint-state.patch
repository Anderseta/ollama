+bool common_speculative_set_state(common_speculative * spec, llama_seq_id seq_id, const std::vector<uint8_t> & data) {
+    if (spec == nullptr) { return data.empty(); }
+    if (seq_id < 0 || size_t(seq_id) >= spec->dparams.size()) { return false; }
+    bool accepted = false;
+    for (auto & impl : spec->impls) { accepted = impl->set_state(seq_id, data) || accepted; }
+    return accepted;
+}
+
+bool common_speculative_copy_state(common_speculative * spec, llama_seq_id source, llama_seq_id destination, llama_pos next_position) {
+    if (!spec) { return true; }
+    if (source < 0 || destination < 0 || size_t(source) >= spec->dparams.size() ||
+        size_t(destination) >= spec->dparams.size()) { return false; }
+    if (source == destination) { return common_speculative_can_resume(spec, source, next_position); }
+    try {
+        std::vector<uint8_t> data;
+        common_speculative_get_state(spec, source, data);
+        if (common_speculative_set_state(spec, destination, data) &&
+            common_speculative_can_resume(spec, destination, next_position)) { return true; }
+    } catch (const std::exception &) {
+        // Destination native KV must also be discarded by the caller.
+    }
+    common_speculative_set_state(spec, destination, {});
+    return false;
+}
+
+bool common_speculative_can_resume(const common_speculative * spec, llama_seq_id seq_id, llama_pos next_position) {
+    if (!spec) { return true; }
+    if (seq_id < 0 || size_t(seq_id) >= spec->dparams.size() || next_position < 0) { return false; }
+    for (const auto & impl : spec->impls) { if (!impl->can_resume(seq_id, next_position)) { return false; } }
+    return true;
 }
 
