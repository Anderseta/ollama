@@ -0,0 +1,64 @@
+#include "../common/mtp-state.h"
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+
+static void require(bool value, const char * message) { if (!value) { throw std::runtime_error(message); } }
+
+int main() {
+    try {
+        common_mtp_state state(4);
+        require(state.begin_record(0, 3), "start record rejected");
+        for (int i = 0; i < 3; ++i) {
+            state.positions[i] = i;
+            std::fill_n(state.verify.data() + 4*i, 4, float(10+i));
+        }
+        state.finish_record();
+        auto * const storage = state.verify.data();
+        require(state.begin_record(3, 3), "sequential record rejected");
+        require(state.boundary_pos == 2 && state.boundary[0] == 12, "verification predecessor lost");
+        for (int i = 0; i < 3; ++i) {
+            state.positions[i] = 3+i;
+            std::fill_n(state.verify.data() + 4*i, 4, float(13+i));
+        }
+        state.finish_record();
+        require(state.verify.data() == storage, "hot path discarded reusable history capacity");
+        require(state.accept(0) && state.pending_pos == 3 && state.pending[0] == 13, "accept(0) selected wrong carry");
+        require(state.positions.size() == 1 && state.verify.size() == 4 && !state.at(4) && !state.can_resume(5),
+                "rejected target rows leaked into reusable history");
+        require(state.at(2) && state.at(2)[0] == 12 && state.can_resume(3), "first-token replay used h_current instead of h_previous");
+        std::vector<uint8_t> a;
+        require(state.save(a, 64), "valid snapshot rejected");
+        common_mtp_state b(4);
+        require(b.load(a, 4, 64) && b.pending_pos == 3 && b.at(2)[0] == 12, "A/B snapshot restored wrong boundary");
+        require(b.begin_record(3, 1), "cached last-token record rejected");
+        b.positions[0] = 3; std::fill_n(b.verify.data(), 4, 13); b.finish_record();
+        require(b.pending_pos == 3 && b.boundary_pos == 2 && b.boundary[0] == 12, "unit-batch replay lost predecessor");
+        require(!b.can_resume(1) && b.can_resume(0), "out-of-history prefix was considered reusable");
+        const auto saved = a;
+        auto invalid = saved; invalid.pop_back();
+        require(!state.load(invalid, 4, 64), "truncated snapshot accepted");
+        invalid = saved; invalid[0] ^= 1;
+        require(!state.load(invalid, 4, 64), "wrong snapshot magic accepted");
+        invalid = saved; uint32_t wrong = 8; std::memcpy(invalid.data()+8, &wrong, sizeof(wrong));
+        require(!state.load(invalid, 4, 64), "wrong embedding width accepted");
+        invalid = saved; wrong = UINT32_MAX; std::memcpy(invalid.data()+12, &wrong, sizeof(wrong));
+        require(!state.load(invalid, 4, 64), "unbounded verification count accepted");
+        invalid = saved; const float nan = std::numeric_limits<float>::quiet_NaN(); std::memcpy(invalid.data()+32, &nan, sizeof(nan));
+        require(!state.load(invalid, 4, 64), "nonfinite carry accepted");
+        invalid = saved; const int64_t huge = INT64_MAX;
+        const size_t positions_offset = 32 + (state.positions.size() + 2)*4*sizeof(float);
+        std::memcpy(invalid.data() + positions_offset, &huge, sizeof(huge));
+        require(!state.load(invalid, 4, 64), "out-of-range snapshot position accepted");
+        invalid = saved; const float wrong_row = 42;
+        std::memcpy(invalid.data() + 32, &wrong_row, sizeof(wrong_row));
+        require(!state.load(invalid, 4, 64), "pending row differed from its verification copy");
+        std::vector<uint8_t> unchanged;
+        require(state.save(unchanged, 64) && unchanged == saved, "malformed snapshot partially replaced valid state");
+        require(state.load({}, 4, 64) && state.positions.empty() && state.pending_pos == -1 && state.boundary_pos == -1,
+                "empty reset retained history provenance");
+        require(state.can_resume(0) && !state.can_resume(1) && state.pending == std::vector<float>(4,0), "empty reset retained usable carry");
+        std::puts("PASS: MTP position-aware state, one-row cached replay, A/B boundary, accept(0), bounded/malformed payloads, empty reset and hot-path capacity reuse");
+        return 0;
+    } catch (const std::exception & e) { std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1; }
+}
