+struct session {
+    llama_context_ptr target;
+    llama_context_ptr draft;
+    common_speculative_ptr spec;
+    bool target_nextn_required = true;
+    explicit session(llama_model * model, uint32_t sequences = 1, llama_model * head = nullptr,
+                     common_speculative_type type = COMMON_SPECULATIVE_TYPE_DRAFT_MTP) {
+        target_nextn_required = type == COMMON_SPECULATIVE_TYPE_DRAFT_MTP;
+        auto cp = llama_context_default_params();
+        cp.n_ctx = 128*sequences; cp.n_batch = cp.n_ubatch = 64; cp.n_seq_max = sequences; cp.n_rs_seq = 2;
+        cp.n_threads = cp.n_threads_batch = 1;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_DISABLED;
+        target.reset(llama_init_from_model(model, cp));
+        require(bool(target), "target context unavailable");
+        cp.ctx_other = target.get();
+        if (type == COMMON_SPECULATIVE_TYPE_DRAFT_MTP) { cp.ctx_type = LLAMA_CONTEXT_TYPE_MTP; }
+        draft.reset(llama_init_from_model(head ? head : model, cp));
+        require(bool(draft), "draft context unavailable");
+        common_params_speculative cfg;
+        cfg.types = {type};
+        cfg.draft.ctx_tgt = target.get(); cfg.draft.ctx_dft = draft.get();
+        cfg.draft.n_max = 2; cfg.draft.n_min = 0; cfg.draft.p_min = 0; cfg.draft.backend_sampling = false;
+        spec.reset(common_speculative_init(cfg, sequences));
+        require(bool(spec), "MTP implementation unavailable");
+    }
+    void clear(bool carry = true) {
+        llama_memory_clear(llama_get_memory(target.get()), true);
+        llama_memory_clear(llama_get_memory(draft.get()), true);
+        if (carry) { require(common_speculative_set_state(spec.get(), 0, {}), "empty reset failed"); }
+    }
+    void process(llama_token token, llama_pos pos, llama_seq_id sequence = 0) {
+        require(common_speculative_can_resume(spec.get(), sequence, pos), "resume guard missed required predecessor");
+        common_batch batch(target.get());
+        batch.add(token, pos, sequence, true);
+        require(llama_process(target.get(), LLAMA_PROCESS_TYPE_DECODE, batch.get()) == 0, "target decode failed");
+        if (target_nextn_required) { require(llama_get_embeddings_nextn(target.get()) != nullptr, "target nextn embeddings were not captured"); }
+        require(common_speculative_process(spec.get(), batch), "draft catch-up failed");
+    }
+    void prefill(const llama_tokens & tokens, size_t begin = 0) {
+        for (size_t i = begin; i < tokens.size(); ++i) { process(tokens[i], llama_pos(i)); }
+    }
+    std::vector<float> logits() {
+        const float * p = llama_get_logits_ith(target.get(), -1);
+        require(p != nullptr, "target logits missing");
+        return {p, p + 64};
+    }
+    common_state_data save(llama_state_seq_flags flags = LLAMA_STATE_SEQ_FLAGS_NONE) {
+        common_state_data data;
+        const auto nt = llama_state_seq_get_size_ext(target.get(), 0, flags), nd = llama_state_seq_get_size_ext(draft.get(), 0, flags);
+        require(common_state_capture(data, nt, nd,
+            [&](uint8_t * p, size_t n) { return llama_state_seq_get_data_ext(target.get(), p, n, 0, flags); },
+            [&](uint8_t * p, size_t n) { return llama_state_seq_get_data_ext(draft.get(), p, n, 0, flags); },
+            [&](auto & p) { require(common_speculative_get_state(spec.get(), 0, p), "MTP carry snapshot unavailable"); }), "capture failed");
+        return data;
+    }
+    bool restore(const common_state_data & data, int fail = 0, llama_state_seq_flags flags = LLAMA_STATE_SEQ_FLAGS_NONE) {
+        return common_state_restore(data,
+            [&](const uint8_t * p, size_t n) { const auto r = llama_state_seq_set_data_ext(target.get(), p, n, 0, flags); return fail == 1 ? size_t(0) : r; },
+            [&](const uint8_t * p, size_t n) { const auto r = llama_state_seq_set_data_ext(draft.get(), p, n, 0, flags); return fail == 2 ? size_t(0) : r; },
+            [&](const auto & p) { if (fail == 3 || !common_speculative_set_state(spec.get(), 0, p)) { throw std::runtime_error("injected/invalid carry"); } },
+            [&] { clear(); });
+    }
+    void rewind(llama_pos position) {
+        require(llama_memory_seq_rm(llama_get_memory(target.get()), 0, position, -1), "target rewind failed");
+        require(llama_memory_seq_rm(llama_get_memory(draft.get()), 0, position, -1), "draft rewind failed");
+    }
+};
+
+static void equal(const common_state_data & a, const common_state_data & b, const char * message) {
+    auto diff = [](const char * name, const auto & first, const auto & second) {
+        if (first == second) { return; }
+        const size_t common = std::min(first.size(), second.size());
+        size_t offset = 0, differing = 0;
+        while (offset < common && first[offset] == second[offset]) { ++offset; }
+        for (size_t i = 0; i < common; ++i) { differing += first[i] != second[i]; }
+        std::fprintf(stderr, "mtp-state DIFF %s sizes=%zu/%zu first=%zu differing=%zu\n", name, first.size(), second.size(), offset, differing);
+        if (offset < common) { std::fprintf(stderr, "mtp-state DIFF %s first-bytes=%u/%u\n", name, unsigned(first[offset]), unsigned(second[offset])); }
+    };
+    diff("target", a.main, b.main); diff("draft", a.drft, b.drft); diff("carry", a.spec, b.spec);
+    if (a.spec != b.spec) {
+        common_mtp_state first, second;
+        if (first.load(a.spec, 32, 64) && second.load(b.spec, 32, 64)) {
+            double maximum = 0;
+            for (size_t i = 0; i < first.pending.size(); ++i) { maximum = std::max(maximum, std::abs(double(first.pending[i]) - second.pending[i])); }
+            std::fprintf(stderr, "mtp-state DIFF carry pending_max_abs=%.12g\n", maximum);
+        }
+    }
+    std::fflush(stderr);
+    require(a.main == b.main && a.drft == b.drft && a.spec == b.spec, message);
+}
+
+int main() {
+    try {
+#ifdef GGML_TEST_CPU_BACKEND_PATH
+        require(ggml_backend_load(GGML_TEST_CPU_BACKEND_PATH) != nullptr, "cannot load CPU backend");
+#else
+        ggml_backend_load_all();
+#endif
+        llama_backend_init();
+        auto model = tiny_model();
+        require(llama_model_size(model.get()) < 4*1024*1024, "fixture exceeds 4 MiB");
+        const llama_tokens a = {3,4,5,6}, b = {17,18,19,20};
+        step("construct reference and switching sessions");
+        session reference(model.get()), switching(model.get());
+        step("sessions constructed; prefill A");
+        for (size_t i = 0; i + 1 < a.size(); ++i) { reference.process(a[i], llama_pos(i)); switching.process(a[i], llama_pos(i)); }
+        // A serialized recurrent snapshot contains its current SSM state, not
+        // the in-context rollback ring. Mirror server checkpoint selection:
+        // restore full attention KV, then an earlier partial SSM/carry state
+        // before re-evaluating the otherwise fully cached final token.
+        const auto before_final = switching.save(LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY);
+        reference.process(a.back(), 3); switching.process(a.back(), 3);
+        step("prefill A complete; save snapshot");
+        const auto saved = switching.save();
+        step("snapshot A saved");
+        common_mtp_state history;
+        require(history.load(saved.spec, 32, 64), "invalid saved format");
+        require(history.pending_pos == 3 && history.boundary_pos == 2 && history.can_resume(3), "one-row checkpoint lost previous h");
+        require(history.at(2) != nullptr && std::memcmp(history.at(2), history.pending.data(), 32*sizeof(float)) != 0, "fixture does not distinguish predecessor and current h");
+        step("restore pre-final checkpoint and replay reference last token");
+        require(reference.restore(before_final, 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY), "reference pre-final checkpoint restore failed");
+        reference.rewind(3); reference.process(a[3], 3);
+        step("reference last token replay complete");
+        const auto expected_replay = reference.save();
+        step("clear switching before B prefill");
+        switching.clear(); switching.prefill(b);
+        step("B prefill complete");
+        step("restore A snapshot begin");
+        require(switching.restore(saved), "A/B restore failed");
+        step("restore A snapshot complete");
+        require(switching.restore(before_final, 0, LLAMA_STATE_SEQ_FLAGS_PARTIAL_ONLY), "pre-final recurrent checkpoint restore failed");
+        switching.rewind(3); switching.process(a[3], 3);
+        equal(expected_replay, switching.save(), "A/B last-token replay changed target, draft or carry bytes");
+        // Appending after restoring A must feed h_A, never h_B at the same position.
+        reference.process(7, 4); const auto expected_next = reference.save();
+        const auto target_next = reference.logits();
+        switching.clear(); switching.prefill(b);
+        require(switching.restore(saved), "A/B continuation restore failed");
+        switching.process(7, 4);
+        equal(expected_next, switching.save(), "A/B catch-up contaminated draft state");
+        require(target_next == switching.logits(), "MTP carry changed target logits");
+        // A checkpoint earlier than the final LCP restores its own positional carry.
+        switching.clear(); switching.process(a[0], 0); switching.process(a[1], 1);
+        const auto checkpoint = switching.save(); switching.prefill(a, 2);
+        const auto expected_checkpoint = switching.save();
+        switching.clear(); switching.prefill(b);
+        require(switching.restore(checkpoint), "short-LCP checkpoint restore failed");
+        require(common_speculative_can_resume(switching.spec.get(), 0, 2), "short-LCP checkpoint predecessor missing");
+        switching.prefill(a, 2);
+        equal(expected_checkpoint, switching.save(), "short-LCP checkpoint replay changed state");
+        // Cold-start token zero must ignore an old conversation even when a raw
+        // memory-only caller omitted the explicit carry reset.
+        switching.clear(false); switching.prefill(b); const auto warm_b = switching.save();
+        reference.clear(); reference.prefill(b);
+        equal(reference.save(), warm_b, "first token used stale carry instead of zero/start row");
+        for (int fail = 1; fail <= 3; ++fail) {
+            require(!switching.restore(saved, fail), "injected target/draft/spec failure was accepted");
+            require(llama_memory_seq_pos_max(llama_get_memory(switching.target.get()), 0) == -1 &&
+                    llama_memory_seq_pos_max(llama_get_memory(switching.draft.get()), 0) == -1,
+                    "failed transaction retained partial model state");
+            require(!common_speculative_can_resume(switching.spec.get(), 0, 1) &&
+                    common_speculative_can_resume(switching.spec.get(), 0, 0), "empty reset retained a usable stale predecessor");
+            require(switching.restore(saved), "retry after failed transaction failed");
+        }
+        auto invalid = saved;
+        invalid.spec.resize(invalid.spec.size() - 1);
+        require(!switching.restore(invalid), "truncated MTP state accepted");
+        require(switching.restore(saved), "valid state did not recover after truncated restore");
+        require(!common_speculative_can_resume(switching.spec.get(), 0, 1), "out-of-history prefix was incorrectly reusable");
+        session rejection(model.get()); rejection.prefill(a);
+        llama_tokens proposals;
+        auto & dp = common_speculative_get_draft_params(rejection.spec.get(), 0);
+        dp.drafting = true; dp.n_max = 2; dp.pos0 = 4; dp.id_last = 7;
+        dp.prompt = &a; dp.result = &proposals;
+        common_speculative_draft(rejection.spec.get());
+        require(proposals.size() == 2, "tiny drafter did not propose the requested width");
+        step("verification: trim unverified draft tail before target catch-up");
+        require(llama_memory_seq_rm(llama_get_memory(rejection.draft.get()), 0, 4, -1), "unverified draft tail removal failed");
+        common_batch verification(rejection.target.get());
+        verification.add(7, 4, 0, true);
+        verification.add(proposals[0], 5, 0, true);
+        verification.add(proposals[1], 6, 0, true);
+        require(llama_process(rejection.target.get(), LLAMA_PROCESS_TYPE_DECODE, verification.get()) == 0 &&
+                common_speculative_process(rejection.spec.get(), verification), "MTP verification fixture failed");
+        common_speculative_accept(rejection.spec.get(), 0, 0);
+        require(common_speculative_get_state(rejection.spec.get(), 0, invalid.spec), "accepted state unavailable");
+        common_mtp_state accepted;
+        require(accepted.load(invalid.spec, 32, 64) && accepted.positions.size() == 1 && accepted.pending_pos == 4,
+                "accept(0) retained rejected verification rows");
+        require(!common_speculative_can_resume(rejection.spec.get(), 0, 6) && common_speculative_can_resume(rejection.spec.get(), 0, 5),
+                "rejected candidate h was exposed as reusable prefix state");
+        step("nonunitary positions regression");
+        session nonunit(model.get());
+        common_batch gaps(nonunit.target.get());
+        gaps.add(3, 0, 0, true); gaps.add(4, 2, 0, true); gaps.add(5, 5, 0, true);
+        require(llama_process(nonunit.target.get(), LLAMA_PROCESS_TYPE_DECODE, gaps.get()) == 0 &&
+                common_speculative_process(nonunit.spec.get(), gaps), "nonunitary positions aborted the existing catch-up path");
+        std::vector<uint8_t> not_reusable;
+        require(!common_speculative_get_state(nonunit.spec.get(), 0, not_reusable) &&
+                !common_speculative_can_resume(nonunit.spec.get(), 0, 6), "nonunitary positions advertised reusable 1D provenance");
+        step("two-sequence MTP copy regression");
+        session forked(model.get(), 2);
+        for (size_t i = 0; i < a.size(); ++i) { forked.process(a[i], llama_pos(i), 0); forked.process(b[i], llama_pos(i), 1); }
+        std::vector<uint8_t> source_aux, old_destination, copied_aux;
+        require(common_speculative_get_state(forked.spec.get(), 0, source_aux) &&
+                common_speculative_get_state(forked.spec.get(), 1, old_destination) && source_aux != old_destination,
+                "copy fixture did not distinguish source A and destination B carry");
+        auto copy_native = [&] {
+            for (auto * context : {forked.target.get(), forked.draft.get()}) {
+                require(llama_memory_seq_rm(llama_get_memory(context), 1, -1, -1), "child clear failed");
+                llama_memory_seq_cp(llama_get_memory(context), 0, 1, -1, -1);
+            }
+        };
+        copy_native();
+        require(common_speculative_copy_state(forked.spec.get(), 0, 1, 4) &&
+                common_speculative_get_state(forked.spec.get(), 1, copied_aux) && copied_aux == source_aux,
+                "occupied child retained destination B carry");
+        forked.process(7, 4, 1); const auto child_logits = forked.logits();
+        forked.process(7, 4, 0);
+        require(child_logits == forked.logits(), "copied child catch-up changed target logits");
+        require(common_speculative_get_state(forked.spec.get(), 0, source_aux) &&
+                common_speculative_get_state(forked.spec.get(), 1, copied_aux) && source_aux == copied_aux,
+                "copied child catch-up changed head state");
+        require(common_speculative_set_state(forked.spec.get(), 1, {}), "empty child carry reset failed");
+        copy_native();
+        require(common_speculative_copy_state(forked.spec.get(), 0, 1, 5) &&
+                common_speculative_get_state(forked.spec.get(), 1, copied_aux) && copied_aux == source_aux,
+                "empty child did not receive source carry");
+        require(!common_speculative_copy_state(forked.spec.get(), 0, 1, 1) &&
+                !common_speculative_can_resume(forked.spec.get(), 1, 5),
+                "incompatible child copy retained stale destination carry");
+        step("dense Eagle3 copy and replay regression");
+        auto dense_model = tiny_dense_model(); auto eagle_model = tiny_eagle_fixture("eagle3");
+        require(!llama_model_is_recurrent(dense_model.get()) && !llama_model_is_hybrid(dense_model.get()), "Eagle dense fixture is not dense");
+        session eagle(dense_model.get(), 2, eagle_model.get(), COMMON_SPECULATIVE_TYPE_DRAFT_EAGLE3);
+        for (size_t i = 0; i < a.size(); ++i) { eagle.process(a[i], llama_pos(i), 0); eagle.process(b[i], llama_pos(i), 1); }
+        require(common_speculative_get_state(eagle.spec.get(), 0, source_aux) &&
+                common_speculative_get_state(eagle.spec.get(), 1, old_destination) && source_aux != old_destination,
+                "dense Eagle3 did not populate distinct deferred carry rows");
+        for (auto * context : {eagle.target.get(), eagle.draft.get()}) {
+            require(llama_memory_seq_rm(llama_get_memory(context), 1, -1, -1), "Eagle child clear failed");
+            llama_memory_seq_cp(llama_get_memory(context), 0, 1, -1, -1);
+        }
+        require(common_speculative_copy_state(eagle.spec.get(), 0, 1, 4) &&
+                common_speculative_get_state(eagle.spec.get(), 1, copied_aux) && copied_aux == source_aux,
+                "dense Eagle child retained old deferred carry");
+        // Unlike a forward-only MTP guard, Eagle's original last-token replay
+        // remains eligible and does not require a whole-prompt restart.
+        require(common_speculative_can_resume(eagle.spec.get(), 1, 3), "dense Eagle last-token replay was disabled");
+        for (auto * context : {eagle.target.get(), eagle.draft.get()}) {
+            require(llama_memory_seq_rm(llama_get_memory(context), 1, 3, -1), "dense Eagle last-token rewind failed");
+        }
+        eagle.process(a[3], 3, 1);
+        require(common_speculative_get_state(eagle.spec.get(), 1, copied_aux) && copied_aux == source_aux,
+                "dense Eagle last-token replay changed deferred carry");
+        std::puts("PASS: CPU Qwen35/MTP nonzero 4MiB A/B/checkpoint replay, reset/failure/retry, rejected tails, nonunitary positions, cross-sequence copy and dense Eagle3 carry/replay");
+        return 0;
+    } catch (const std::exception & e) { std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1; }
+}
