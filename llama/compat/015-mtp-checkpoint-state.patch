new file mode 100644
--- /dev/null
+++ b/common/mtp-state.h
@@ -0,0 +1,172 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+// Host carryover used to feed the MTP head. This is separate from the target
+// SSM/KV and from the draft KV, and must follow a conversation checkpoint too.
+struct common_mtp_state {
+    uint32_t width = 0;
+    int64_t pending_pos = -1;
+    int64_t boundary_pos = -1;
+    std::vector<float> pending;
+    std::vector<float> boundary;
+    std::vector<float> verify;
+    std::vector<int64_t> positions;
+
+    explicit common_mtp_state(uint32_t width = 0) : width(width), pending(width, 0), boundary(width, 0) {}
+
+    void clear() {
+        pending_pos = boundary_pos = -1;
+        std::fill(pending.begin(), pending.end(), 0.0f);
+        std::fill(boundary.begin(), boundary.end(), 0.0f);
+        verify.clear();
+        positions.clear();
+    }
+
+    const float * at(int64_t position) const {
+        if (position < 0 || position > pending_pos) { return nullptr; }
+        if (pending_pos == position) { return pending.data(); }
+        const auto it = std::lower_bound(positions.begin(), positions.end(), position);
+        if (it != positions.end() && *it == position) { return verify.data() + (it - positions.begin())*width; }
+        return boundary_pos == position ? boundary.data() : nullptr;
+    }
+
+    bool can_resume(int64_t next_position) const { return next_position == 0 || (next_position > 0 && at(next_position - 1)); }
+
+    // Preserve the predecessor of the first verification row before replacing
+    // history. It is needed when the server re-evaluates a cached final token,
+    // including a one-row verification batch and accept(0).
+    bool record(std::vector<int64_t> next_positions, std::vector<float> rows) {
+        if (!width || next_positions.empty() || rows.size() != next_positions.size()*size_t(width)) { return false; }
+        std::vector<float> previous(width, 0.0f);
+        const int64_t previous_pos = next_positions.front() - 1;
+        if (previous_pos >= 0) {
+            const float * row = at(previous_pos);
+            if (!row) { return false; }
+            std::copy(row, row + width, previous.begin());
+        }
+        boundary = std::move(previous);
+        boundary_pos = previous_pos;
+        positions = std::move(next_positions);
+        verify = std::move(rows);
+        pending_pos = positions.back();
+        std::copy(verify.end() - width, verify.end(), pending.begin());
+        return true;
+    }
+
+    // Decode hot path reuses vector capacity instead of allocating a new
+    // verification history and zero row for every speculative round.
+    bool begin_record(int64_t first_position, size_t count) {
+        if (!width || !count || count > SIZE_MAX/width || first_position < 0 ||
+            uint64_t(first_position) + count - 1 > uint64_t(INT32_MAX)) { return false; }
+        const float * previous = first_position ? at(first_position - 1) : nullptr;
+        if (first_position && !previous) { return false; }
+        if (previous) { std::copy_n(previous, width, boundary.begin()); }
+        else { std::fill(boundary.begin(), boundary.end(), 0.0f); }
+        boundary_pos = first_position - 1;
+        positions.resize(count);
+        verify.resize(count*width);
+        return true;
+    }
+    void finish_record() {
+        pending_pos = positions.back();
+        std::copy(verify.end() - width, verify.end(), pending.begin());
+    }
+
+    bool accept(size_t row) {
+        if (row >= positions.size()) { return false; }
+        pending_pos = positions[row];
+        std::copy_n(verify.data() + row*width, width, pending.begin());
+        // Target rows after this boundary belonged to rejected proposals.
+        // Keep capacity, but never expose them as a reusable cached prefix.
+        positions.resize(row + 1);
+        verify.resize((row + 1)*width);
+        return true;
+    }
+
+    bool valid(uint32_t expected_width, size_t max_rows) const {
+        if (!expected_width || width != expected_width || pending.size() != width || boundary.size() != width ||
+            positions.size() > max_rows || positions.size() > SIZE_MAX/width || verify.size() != positions.size()*width) { return false; }
+        if (positions.empty()) {
+            if (pending_pos != -1 || boundary_pos != -1) { return false; }
+        } else {
+            // Validate numeric bounds and ordering before binary_search or
+            // predecessor arithmetic on untrusted snapshot positions.
+            for (size_t i = 0; i < positions.size(); ++i) {
+                if (positions[i] < 0 || positions[i] > INT32_MAX ||
+                    (i && positions[i] != positions[i-1] + 1)) { return false; }
+            }
+            if (boundary_pos != positions.front() - 1 || pending_pos != positions.back() ||
+                !std::binary_search(positions.begin(), positions.end(), pending_pos)) { return false; }
+            if (std::memcmp(pending.data(), verify.data() + (positions.size()-1)*width, width*sizeof(float)) != 0) { return false; }
+        }
+        const auto finite = [](const auto & row) {
+            return std::all_of(row.begin(), row.end(), [](float v) { return std::isfinite(v); });
+        };
+        return finite(pending) && finite(boundary) && finite(verify);
+    }
+
+    bool save(std::vector<uint8_t> & destination, size_t max_rows) const {
+        if (!valid(width, max_rows) || positions.size() > UINT32_MAX) { return false; }
+        const size_t count = positions.size();
+        constexpr size_t header_size = 4*sizeof(uint32_t) + 2*sizeof(int64_t);
+        if (width > SIZE_MAX/sizeof(float)/2 || count > (SIZE_MAX/sizeof(float))/width - 2 ||
+            count > (SIZE_MAX - header_size)/sizeof(int64_t)) { return false; }
+        const size_t float_bytes = (count + 2)*size_t(width)*sizeof(float);
+        const size_t position_bytes = count*sizeof(int64_t);
+        if (float_bytes > SIZE_MAX - header_size - position_bytes) { return false; }
+        std::vector<uint8_t> data;
+        data.reserve(header_size + float_bytes + position_bytes);
+        auto append = [&](const void * ptr, size_t n) {
+            const auto * p = static_cast<const uint8_t *>(ptr);
+            if (n) { data.insert(data.end(), p, p + n); }
+        };
+        const uint32_t header[] = {0x5350544d, 1, width, uint32_t(positions.size())}; // "MTPS"
+        append(header, sizeof(header));
+        append(&pending_pos, sizeof(pending_pos));
+        append(&boundary_pos, sizeof(boundary_pos));
+        append(pending.data(), pending.size()*sizeof(float));
+        append(boundary.data(), boundary.size()*sizeof(float));
+        append(verify.data(), verify.size()*sizeof(float));
+        append(positions.data(), positions.size()*sizeof(int64_t));
+        destination = std::move(data);
+        return true;
+    }
+
+    // Validate dimensions/counts and the entire byte range before allocating
+    // or publishing state. A malformed nonempty blob leaves the old state intact.
+    bool load(const std::vector<uint8_t> & data, uint32_t expected_width, size_t max_rows) {
+        if (data.empty()) { clear(); return true; }
+        constexpr size_t header_size = 4*sizeof(uint32_t) + 2*sizeof(int64_t);
+        if (data.size() < header_size || !expected_width) { return false; }
+        uint32_t header[4];
+        std::memcpy(header, data.data(), sizeof(header));
+        if (header[0] != 0x5350544d || header[1] != 1 || header[2] != expected_width || header[3] > max_rows) { return false; }
+        const size_t count = header[3];
+        if (expected_width > SIZE_MAX/sizeof(float)/2 || count > (SIZE_MAX/sizeof(float))/expected_width - 2 ||
+            count > (SIZE_MAX - header_size)/sizeof(int64_t)) { return false; }
+        const size_t float_bytes = (count + 2)*size_t(expected_width)*sizeof(float);
+        const size_t position_bytes = count*sizeof(int64_t);
+        if (float_bytes > SIZE_MAX - header_size - position_bytes || data.size() != header_size + float_bytes + position_bytes) { return false; }
+        common_mtp_state next(expected_width);
+        size_t offset = sizeof(header);
+        auto read = [&](void * ptr, size_t n) { if (n) { std::memcpy(ptr, data.data() + offset, n); } offset += n; };
+        read(&next.pending_pos, sizeof(next.pending_pos));
+        read(&next.boundary_pos, sizeof(next.boundary_pos));
+        read(next.pending.data(), next.pending.size()*sizeof(float));
+        read(next.boundary.data(), next.boundary.size()*sizeof(float));
+        next.verify.resize(count*size_t(expected_width));
+        next.positions.resize(count);
+        read(next.verify.data(), next.verify.size()*sizeof(float));
+        read(next.positions.data(), next.positions.size()*sizeof(int64_t));
+        if (!next.valid(expected_width, max_rows)) { return false; }
+        *this = std::move(next);
+        return true;
+    }
+};
