+static void test_binding_failures(const llama_files & files, ggml_tensor * shape, const std::vector<uint8_t> & raw) {
+    constexpr size_t page = 65536;
+    unsigned failures = 0;
+    bool completed = false;
+    for (int allocation = 0; allocation < 16; ++allocation) {
+        llama_model_ram_cache cache(2*page, files);
+        ggml_tensor established = *shape, candidate = *shape, alias = *shape;
+        uint8_t original = 0;
+        candidate.data = &original;
+        cache.bind(&established, 0, 31);
+        const auto * previous = established.data;
+        bool failed = false;
+        fail_binding_allocation_after = allocation;
+        try { cache.bind(&candidate, 0, 31 + page); }
+        catch (const std::bad_alloc &) { failed = true; }
+        fail_binding_allocation_after = -1;
+        if (!failed) { completed = true; break; }
+        ++failures;
+        require(candidate.data == &original, "failed binding published a released reservation into the tensor");
+        require(!cache.contains(&candidate), "failed binding published an unowned address");
+        require(established.data == previous && cache.contains(&established), "failed binding damaged an existing region");
+        cache.bind(&candidate, 0, 31 + page);
+        require(cache.contains(&candidate), "binding retry lost the region lookup");
+        // Tied tensors continue to reuse their live region without allocation.
+        fail_binding_allocation_after = 0;
+        try { cache.bind(&alias, 0, 31 + page); }
+        catch (...) { fail_binding_allocation_after = -1; throw; }
+        fail_binding_allocation_after = -1;
+        require(alias.data == candidate.data, "binding retry duplicated tied weights");
+        uint8_t bytes[73];
+        cache.read(&candidate, 17, bytes, sizeof(bytes));
+        require(!std::memcmp(bytes, raw.data() + 31 + page + 17, sizeof(bytes)), "binding retry read incorrect bytes");
+        cache.read(&established, 17, bytes, sizeof(bytes));
+        require(!std::memcmp(bytes, raw.data() + 31 + 17, sizeof(bytes)), "binding failure corrupted previous weight bytes");
+    }
+    require(failures >= 4, "binding regression did not cover region, page, owner and lookup allocations");
+    require(completed, "binding regression did not reach a successful allocation control");
+    std::printf("PASS binding transaction: %u allocation failures preserve tensors, prior regions and tied-weight retries\n", failures);
+}
