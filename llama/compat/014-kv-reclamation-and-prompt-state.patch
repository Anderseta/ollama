diff --git a/tests/test-kv-trim-ranges.cpp b/tests/test-kv-trim-ranges.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test-kv-trim-ranges.cpp
@@ -0,0 +1,44 @@
+#include "../ggml/include/ggml-kv-trim.h"
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+int main() {
+    try {
+        constexpr size_t page = 2*1024*1024, capacity = 64*page;
+        // A mapping can cover several CUDA pages. Neither a prefix boundary
+        // nor a tiny quantized padding tail may cause a partial unmap.
+        const ggml_kv_trim_range keep[] = {{13, page/2}, {20*page + 17, 129}};
+        require(ggml_kv_trim_ranges_valid(capacity, keep, 2), "valid keep ranges rejected");
+        require(ggml_kv_trim_keep(0, 3*page, keep, 2), "mapping crossing initial prefix was released");
+        require(ggml_kv_trim_keep(19*page, 3*page, keep, 2), "mapping crossing padding tail was released");
+        require(!ggml_kv_trim_keep(3*page, 16*page, keep, 2), "unused middle mapping retained");
+        require(!ggml_kv_trim_keep(22*page, page, keep, 2), "unused high mapping retained");
+        const ggml_kv_trim_range adjacent[] = {{page, page}};
+        require(!ggml_kv_trim_keep(0, page, adjacent, 1) && !ggml_kv_trim_keep(2*page, page, adjacent, 1), "adjacent ranges treated as overlapping");
+        const ggml_kv_trim_range empty[] = {{page + 1, 0}};
+        require(!ggml_kv_trim_keep(page, page, empty, 1), "zero-byte range retained mapping");
+        const ggml_kv_trim_range overflow[] = {{std::numeric_limits<size_t>::max() - 1, 9}};
+        require(!ggml_kv_trim_ranges_valid(capacity, overflow, 1), "overflowing range accepted");
+        require(!ggml_kv_trim_ranges_valid(capacity, nullptr, 1), "null nonempty keep list accepted");
+        require(ggml_kv_trim_ranges_valid(capacity, nullptr, 0), "empty keep list rejected");
+        std::vector<ggml_kv_trim_range> mappings = {{0, 3*page}, {3*page, 16*page}, {19*page, 3*page}, {22*page, page}};
+        auto trim = [&] {
+            size_t released = 0;
+            for (auto it = mappings.begin(); it != mappings.end();) {
+                if (ggml_kv_trim_keep(it->offset, it->size, keep, 2)) { ++it; }
+                else { released += it->size; it = mappings.erase(it); }
+            }
+            return released;
+        };
+        require(trim() == 17*page && mappings.size() == 2, "whole-mapping reclamation plan incorrect");
+        require(trim() == 0 && mappings.size() == 2, "trim was not idempotent");
+        std::puts("PASS: whole mappings, prefix/padding boundaries, overflow validation and idempotence");
+        return 0;
+    } catch (const std::exception & e) { std::fprintf(stderr, "FAIL: %s\n", e.what()); return 1; }
+}
