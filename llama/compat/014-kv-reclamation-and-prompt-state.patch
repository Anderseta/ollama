new file mode 100644
--- /dev/null
+++ b/common/state-transaction.h
@@ -0,0 +1,52 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// The serialized state and its drafter state are one transaction. A failed
+// capture must never replace a valid entry with a partially populated one.
+struct common_state_data {
+    std::vector<uint8_t> main;
+    std::vector<uint8_t> drft;
+    std::vector<uint8_t> spec;
+
+    size_t size() const { return main.size() + drft.size() + spec.size(); }
+};
+
+template <typename Main, typename Draft, typename Spec>
+bool common_state_capture(common_state_data & data, size_t main_size, size_t draft_size,
+                          Main capture_main, Draft capture_draft, Spec capture_spec) {
+    if (!main_size) { return false; }
+    try {
+        common_state_data pending;
+        pending.main.resize(main_size);
+        pending.drft.resize(draft_size);
+        if (capture_main(pending.main.data(), main_size) != main_size ||
+            (draft_size && capture_draft(pending.drft.data(), draft_size) != draft_size)) {
+            return false;
+        }
+        capture_spec(pending.spec);
+        data = std::move(pending);
+        return true;
+    } catch (...) {
+        return false;
+    }
+}
+
+template <typename Main, typename Draft, typename Spec, typename Clear>
+bool common_state_restore(const common_state_data & data, Main restore_main,
+                          Draft restore_draft, Spec restore_spec, Clear clear) {
+    try {
+        if (!data.main.empty() && restore_main(data.main.data(), data.main.size()) == data.main.size() &&
+            (data.drft.empty() || restore_draft(data.drft.data(), data.drft.size()) == data.drft.size())) {
+            restore_spec(data.spec);
+            return true;
+        }
+    } catch (...) {
+        // A backend can fail after committing only some of its destinations.
+    }
+    clear();
+    return false;
+}
