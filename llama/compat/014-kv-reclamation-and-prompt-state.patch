new file mode 100644
--- /dev/null
+++ b/ggml/include/ggml-kv-trim.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include <cstddef>
+
+// Offsets within one virtually reserved buffer. All arithmetic is validated
+// before CUDA is allowed to unmap any physical mapping.
+struct ggml_kv_trim_range {
+    size_t offset;
+    size_t size;
+};
+
+inline bool ggml_kv_trim_ranges_valid(size_t capacity, const ggml_kv_trim_range * ranges, size_t count) {
+    if (count && !ranges) { return false; }
+    for (size_t i = 0; i < count; ++i) {
+        if (ranges[i].offset > capacity || ranges[i].size > capacity - ranges[i].offset) { return false; }
+    }
+    return true;
+}
+
+// CUDA cannot unmap part of a cuMemMap allocation. Keep the whole mapping
+// if even one byte intersects a protected initial-prefix/padding range.
+inline bool ggml_kv_trim_keep(size_t offset, size_t size, const ggml_kv_trim_range * ranges, size_t count) {
+    for (size_t i = 0; i < count; ++i) {
+        if (ranges[i].size && offset < ranges[i].offset + ranges[i].size && ranges[i].offset < offset + size) {
+            return true;
+        }
+    }
+    return false;
+}
