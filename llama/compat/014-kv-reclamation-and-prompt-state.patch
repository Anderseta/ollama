+size_t llama_kv_cache::trim_empty() {
+    if (!growth_initial_tokens || other) { return 0; }
+    for (const auto & cells : v_cells) { if (cells.get_used()) { return 0; } }
+    // Lower the commitment watermark before any mapping is released, including
+    // partial failure or allocation exceptions while staging another buffer.
+    growth_committed_tokens = growth_initial_tokens;
+    size_t released = 0;
+    for (auto & entry : ctxs_bufs) {
+        auto & ctx = entry.first;
+        auto & buf = entry.second;
+        const auto * api = llama_kv_growth_api(ggml_backend_buffer_get_type(buf.get()));
+        if (!api) { continue; }
+        auto * dev = ggml_backend_buft_get_device(ggml_backend_buffer_get_type(buf.get()));
+        auto trim = reinterpret_cast<ggml_backend_cuda_kv_trim_t>(ggml_backend_reg_get_proc_address(
+                ggml_backend_dev_backend_reg(dev), "ggml_backend_cuda_kv_trim_empty"));
+        if (!trim) { continue; }
+        auto * base = static_cast<uint8_t *>(ggml_backend_buffer_get_base(buf.get()));
+        std::vector<ggml_kv_trim_range> keep;
+        for (auto * tensor = ggml_get_first_tensor(ctx.get()); tensor; tensor = ggml_get_next_tensor(ctx.get(), tensor)) {
+            if (tensor->view_src) { continue; }
+            const size_t offset = static_cast<uint8_t *>(tensor->data) - base;
+            keep.push_back({offset, tensor->nb[1]*growth_initial_tokens});
+            const size_t actual = ggml_nbytes(tensor);
+            const size_t allocated = ggml_backend_buft_get_alloc_size(ggml_backend_buffer_get_type(buf.get()), tensor);
+            if (allocated > actual) { keep.push_back({offset + actual, allocated - actual}); }
+        }
+        const size_t before = api->committed(buf.get());
+        if (!trim(buf.get(), keep.data(), keep.size())) {
+            LLAMA_LOG_WARN("KV trim: physical reclamation incomplete; retained mappings remain charged\n");
+        }
+        const size_t after = api->committed(buf.get());
+        if (before != SIZE_MAX && after < before) { released += before - after; }
+    }
+    return released;
+}
