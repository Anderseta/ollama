diff --git a/ggml/src/ggml-cuda/graph-reuse.h b/ggml/src/ggml-cuda/graph-reuse.h
new file mode 100644
--- /dev/null
+++ b/ggml/src/ggml-cuda/graph-reuse.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+namespace ggml_cuda_graph_reuse {
+
+struct eligibility {
+    bool has_custom;
+    bool compatible;
+};
+
+// accepted_uid/node_count must come from the SAME backend graph object. Its
+// uid is published only after compatibility, all vector growth, and property
+// copies have succeeded. Allocation failure must not certify a partial update.
+// Matching nonzero GGML UIDs identify the same graph; uid 0 never certifies reuse.
+// The count guard is conservative, not permission to mutate a graph under its UID.
+template <typename ScanCustom, typename CheckCompatibility>
+eligibility classify(uint64_t uid, uint64_t accepted_uid, size_t node_count,
+                     size_t accepted_node_count, bool enabled,
+                     ScanCustom scan_custom, CheckCompatibility check_compatibility) {
+    if (enabled && uid != 0 && uid == accepted_uid && node_count != 0 &&
+            node_count == accepted_node_count) {
+        return {false, true};
+    }
+    const bool has_custom = scan_custom();
+    return {has_custom, enabled && check_compatibility()};
+}
+
+} // namespace ggml_cuda_graph_reuse
