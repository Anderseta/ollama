+        } catch (...) {
+            return {};
+        }
+    }
+    // Stage every component before publication. The caller makes room inside
+    // its RAM-cache budget before materializing this one cold entry.
+    static bool load(const handle & saved, const std::vector<std::vector<uint8_t> *> & parts) noexcept {
+        if (!saved || saved->lengths.size() != parts.size()) { return false; }
+        try {
+            std::error_code ec;
+            if (std::filesystem::file_size(saved->path, ec) != saved->file_bytes || ec) { return false; }
+            std::ifstream file(saved->path, std::ios::binary);
+            uint64_t marker = 0, count = 0;
+            if (!read(file, marker) || marker != magic || !read(file, count) || count != parts.size()) { return false; }
+            std::vector<std::vector<uint8_t>> pending(parts.size());
+            for (size_t i = 0; i < parts.size(); ++i) {
+                uint64_t n = 0;
+                if (!parts[i] || !read(file, n) || n != saved->lengths[i] || n > SIZE_MAX) { return false; }
+                pending[i].resize(size_t(n));
+                for (size_t offset = 0; offset < n;) {
+                    const size_t size = std::min(page_bytes, size_t(n)-offset);
+                    uint64_t expected = 0;
