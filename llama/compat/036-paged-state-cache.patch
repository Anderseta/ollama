+bool server_prompt_cache::spill(server_prompt_cache_state & state) {
+    if (!pager.enabled() || state.backing || state.resident || state.data.main.empty() || state.prompt.tokens.has_mtmd) { return false; }
+    try {
+        auto buffers = state.buffers();
+        std::vector<const std::vector<uint8_t> *> sources(buffers.begin(), buffers.end());
+        auto saved = pager.store(sources);
+        if (!saved) { return false; }
+        // Publish only after complete write; release capacities, not just sizes.
+        for (auto * buffer : buffers) { std::vector<uint8_t>().swap(*buffer); }
+        state.backing = std::move(saved);
+        return true;
+    } catch (...) { return false; }
+}
+
+void server_prompt_cache::make_room(size_t bytes, server_prompt_cache_state * preserve) {
+    if (!limit_size || bytes > limit_size) { return; }
+    while (size() > limit_size - bytes) {
+        auto victim = states.end();
+        for (auto it = states.begin(); it != states.end(); ++it) {
+            if (&*it != preserve && !it->backing) { victim = it; break; }
+        }
+        if (victim == states.end()) {
+            victim = std::find_if(states.begin(), states.end(), [&](server_prompt_cache_state & state) { return &state != preserve; });
+        }
+        if (victim == states.end()) { break; }
+        if (!spill(*victim)) { erase_state(victim); }
+    }
+}
+
+bool server_prompt_cache::materialize(std::list<server_prompt_cache_state>::iterator state) {
+    if (!state->backing) { return true; }
