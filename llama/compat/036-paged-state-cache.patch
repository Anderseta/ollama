+static size_t llama_file_tensor_chunk_size(const ggml_tensor * tensor, size_t offset, size_t size) {
+    if (!tensor) { throw std::runtime_error("state tensor is missing"); }
+    const size_t bytes = ggml_nbytes(tensor);
+    if (offset > bytes || size > bytes - offset) { throw std::runtime_error("state tensor range is out of bounds"); }
+    if (!size) { return 0; }
+    if (!tensor->data) { throw std::runtime_error("state tensor is not allocated"); }
+    auto * buffer = tensor->view_src ? tensor->view_src->buffer : tensor->buffer;
+    if (!buffer) { throw std::runtime_error("state tensor buffer is missing"); }
+    // Meta/split callbacks can require full rows or a complete tensor. Preserve
+    // their existing transfer contract instead of imposing byte-sized chunks.
+    auto * buft = ggml_backend_buffer_get_type(buffer);
+    auto * device = ggml_backend_buft_get_device(buft);
+    const bool ordinary = !ggml_backend_buffer_is_meta(buffer) &&
+        (buft == ggml_backend_cpu_buffer_type() || (device && buft == ggml_backend_dev_buffer_type(device)));
+    return ordinary ? std::min<size_t>(size, 4 * 1024 * 1024) : size;
+}
