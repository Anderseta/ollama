+            pending->file_bytes = total; pending->owner = owner;
+            // Reserve before the first write. Failed write/close paths use the
+            // same owned cleanup as successful entries; undeletable partial
+            // files keep both their byte and entry reservations.
+            owner->used += total; ++owner->entries;
