+// Optional, process-local cold snapshot storage. No default directory: enabling
+// this cache must never silently select the system disk. Payload pages carry
+// checksums; only completely written entries are published. RAM snapshots remain
+// unchanged if optional storage fails. All files are owned by this cache session.
+class server_state_pager {
+    static constexpr size_t page_bytes = 256 * 1024;
+    static constexpr uint64_t magic = 0x31524750534c5755ull;
+    struct pool {
+        std::filesystem::path directory;
+        uint64_t limit = 0, used = 0;
+        size_t entries = 0;
+        uint64_t serial = 0;
+        ~pool() { std::error_code ec; std::filesystem::remove(directory, ec); }
+    };
+    std::shared_ptr<pool> owner;
+    static uint64_t checksum(const uint8_t * data, size_t n) {
+        uint64_t h = 14695981039346656037ull;
+        size_t i = 0;
