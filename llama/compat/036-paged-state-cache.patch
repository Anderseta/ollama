+        make_room(size_t(bytes), &*state);
+        if (limit_size && size() > limit_size - size_t(bytes)) { return false; }
+        if (!server_state_pager::load(state->backing, state->buffers())) { return false; }
+        state->backing.reset();
+        return true;
+    } catch (...) { return false; }
+}
