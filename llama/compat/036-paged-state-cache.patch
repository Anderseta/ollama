+            for (auto * part : parts) {
+                write(file, uint64_t(part->size()));
+                for (size_t offset = 0; offset < part->size();) {
+                    const size_t n = std::min(page_bytes, part->size()-offset);
+                    write(file, checksum(part->data()+offset, n));
+                    file.write(reinterpret_cast<const char *>(part->data()+offset), n);
+                    offset += n;
+                }
+            }
+            file.close();
