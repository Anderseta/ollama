+        out.write(reinterpret_cast<const char *>(&value), sizeof(value));
+    }
+    template<class T> static bool read(std::istream & in, T & value) {
+        return bool(in.read(reinterpret_cast<char *>(&value), sizeof(value)));
+    }
+public:
+    struct entry {
+        std::shared_ptr<pool> owner;
+        std::filesystem::path path;
+        std::vector<uint64_t> lengths;
+        uint64_t payload_bytes = 0, file_bytes = 0;
+        ~entry() {
+            std::error_code ec;
+            std::filesystem::remove(path, ec);
+            if (owner) {
+                // A failed deletion retains its charge, preventing orphaned
+                // owned files from silently bypassing the configured quota.
+                if (!ec) { owner->used -= file_bytes; --owner->entries; }
+            }
+        }
+        entry() = default;
+        entry(const entry &) = delete;
+        entry & operator=(const entry &) = delete;
+    };
+    using handle = std::shared_ptr<entry>;
+
+    server_state_pager() {
