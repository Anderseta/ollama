+static void selected_only_sparse(llama_model * model, common_params_sampling params) {
+    params.backend_sampling = true; params.n_probs = 0;
+    for (const bool mixed : {false, true}) {
+        auto left = fixture_context(model, 2), right = fixture_context(model, 2);
+        std::vector<common_sampler_ptr> full, compact;
+        for (int seq=0; seq<2; ++seq) {
+            auto a=params, b=params; a.seed += seq; b.seed += seq;
+            full.emplace_back(common_sampler_init(model, a)); compact.emplace_back(common_sampler_init(model, b));
+            auto * lhs=common_sampler_get_backend(full.back().get());
+            auto * rhs=mixed && seq==1 ? common_sampler_get_backend(compact.back().get())
+                : common_sampler_get_backend_selected_only(compact.back().get());
+            require(llama_set_sampler(left.get(),seq,lhs) && llama_set_sampler(right.get(),seq,rhs), "sparse compact attach failed");
+        }
+        common_batch a(left.get()), b(right.get());
+        for (auto * batch : {&a,&b}) {
+            batch->add(3+'a',0,1,true); batch->add(3+'b',0,0,false);
+            batch->add(3+'c',1,1,true); batch->add(3+'d',1,0,true);
+        }
+        require(llama_process(left.get(),LLAMA_PROCESS_TYPE_DECODE,a.get())==0 &&
+                llama_process(right.get(),LLAMA_PROCESS_TYPE_DECODE,b.get())==0, "sparse compact decode failed");
+        for (auto item : {std::pair<int,int>{0,1},{2,1},{3,0}}) {
+            const auto x=common_sampler_sample(full[item.second].get(),left.get(),item.first);
+            const auto y=common_sampler_sample(compact[item.second].get(),right.get(),item.first);
+            require(x==y,"sparse/reordered compact token changed");
+            const auto view=llama_get_sampler_output_ith(right.get(),item.first);
+            if (!mixed || item.second==0) {
+                require(!view.sampled_logits && !view.sampled_probs && view.sampled_token==y,
+                    "sparse compact row emitted candidate output");
+            } else { require(view.sampled_logits,"mixed detailed row lost output"); }
+            common_sampler_accept(full[item.second].get(),x,true); common_sampler_accept(compact[item.second].get(),y,true);
+        }
+    }
+    // Unsupported stages must keep candidate outputs for the remaining CPU
+    // suffix rather than suppressing data merely because compact was asked for.
+    params.samplers={COMMON_SAMPLER_TYPE_TOP_K,COMMON_SAMPLER_TYPE_TYPICAL_P,COMMON_SAMPLER_TYPE_TEMPERATURE};
+    params.typ_p=.8f;
+    auto a=params,b=params;
+    common_sampler_ptr full(common_sampler_init(model,a)), compact(common_sampler_init(model,b));
+    auto left=fixture_context(model),right=fixture_context(model);
+    auto * lhs=common_sampler_get_backend(full.get());
+    auto * rhs=common_sampler_get_backend_selected_only(compact.get());
+    require(llama_set_sampler(left.get(),0,lhs) && llama_set_sampler(right.get(),0,rhs),"partial backend attach failed");
+    require(!llama_sampler_backend_selected_only_ready(rhs),"unsupported backend stage reported complete");
+    common_batch l(left.get()),r(right.get()); l.add(3+'a',0,0,true);r.add(3+'a',0,0,true);
+    require(llama_process(left.get(),LLAMA_PROCESS_TYPE_DECODE,l.get())==0 &&
+            llama_process(right.get(),LLAMA_PROCESS_TYPE_DECODE,r.get())==0,"partial backend decode failed");
+    const auto out=llama_get_sampler_output_ith(right.get(),-1);
+    require(out.sampled_token==LLAMA_TOKEN_NULL && out.sampled_logits,"partial backend discarded CPU suffix logits");
+    require(common_sampler_sample(full.get(),left.get(),-1)==common_sampler_sample(compact.get(),right.get(),-1),"partial backend token changed");
+    std::puts("PASS selected-only: sparse/reordered hybrid rows, mixed detailed output and partial-backend fallback");
+}
