+static void selected_only_filter_chain(llama_model * model) {
+    llama_sampler_ptr filters(llama_sampler_chain_init(llama_sampler_chain_default_params()));
+    llama_sampler_chain_add(filters.get(), llama_sampler_init_top_k(20));
+    require(llama_sampler_backend_set_selected_only(filters.get()), "filter-only output intent not accepted");
+    auto context=fixture_context(model);
+    require(llama_set_sampler(context.get(),0,filters.get()), "filter-only backend attach failed");
+    require(!llama_sampler_backend_selected_only_ready(filters.get()), "filter-only backend advertised a selected token");
+    common_batch batch(context.get()); batch.add(3+'x',0,0,true);
+    require(llama_process(context.get(),LLAMA_PROCESS_TYPE_DECODE,batch.get())==0,"filter-only decode failed");
+    const auto out=llama_get_sampler_output_ith(context.get(),-1);
+    require(out.sampled_token==LLAMA_TOKEN_NULL && out.sampled_logits && out.sampled_logits_count==20 && out.candidates_count==20,
+        "filter-only chain lost CPU continuation output");
+    require(llama_set_sampler(context.get(),0,nullptr), "filter-only detach failed");
+    std::puts("PASS selected-only: filter-only chains retain their CPU continuation outputs");
+}
