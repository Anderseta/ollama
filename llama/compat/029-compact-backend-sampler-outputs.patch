+static void selected_only_outputs(llama_model * model, common_params_sampling params) {
+    for (const bool greedy : {false, true}) {
+        params.backend_sampling = true; params.n_probs = 0;
+        params.temp = greedy ? 0.f : .7f;
+        auto left = fixture_context(model), right = fixture_context(model);
+        auto left_params = params, right_params = params;
+        common_sampler_ptr reference(common_sampler_init(model, left_params));
+        common_sampler_ptr compact(common_sampler_init(model, right_params));
+        auto * full_backend = common_sampler_get_backend(reference.get());
+        auto * compact_backend = common_sampler_get_backend_selected_only(compact.get());
+        require(full_backend && compact_backend && llama_sampler_backend_selected_only(compact_backend), "selected-only eligibility failed");
+        require(llama_set_sampler(left.get(), 0, full_backend) && llama_set_sampler(right.get(), 0, compact_backend), "selected-only backend attach failed");
+        require(!llama_sampler_backend_set_selected_only(full_backend), "output topology mutated after backend init");
+        for (int position = 0; position < 24; ++position) {
+            common_batch a(left.get()), b(right.get());
+            const auto input = 3 + 'a' + position%17;
+            a.add(input, position, 0, true); b.add(input, position, 0, true);
+            require(llama_process(left.get(), LLAMA_PROCESS_TYPE_DECODE, a.get()) == 0 &&
+                    llama_process(right.get(), LLAMA_PROCESS_TYPE_DECODE, b.get()) == 0, "selected-only decode failed");
+            const auto full = llama_get_sampler_output_ith(left.get(), -1);
+            const auto small = llama_get_sampler_output_ith(right.get(), -1);
+            require(full.sampled_logits && full.sampled_token != LLAMA_TOKEN_NULL, "reference did not execute backend sampling");
+            require(small.sampled_token != LLAMA_TOKEN_NULL && !small.sampled_logits && !small.sampled_probs &&
+                    !small.raw_logits && small.sampled_logits_count == 0 && small.sampled_probs_count == 0 && small.candidates_count == 0,
+                    "unused candidate output/transfer survived selected-only graph");
+            const auto expected = common_sampler_sample(reference.get(), left.get(), -1);
+            const auto actual = common_sampler_sample(compact.get(), right.get(), -1);
+            require(expected == actual, "selected-only changed token/RNG");
+            require(common_sampler_get_candidates(compact.get(), false)->size == 0, "selected-only fabricated probabilities");
+            common_sampler_accept(reference.get(), expected, true); common_sampler_accept(compact.get(), actual, true);
+        }
+        require(common_sampler_get_candidate_rows(compact.get()) == 0, "selected-only materialized host candidates");
+        std::printf("PASS selected-only %s: 24 identical tokens, zero host candidate rows and omitted probabilities/logits/IDs\n", greedy ? "greedy" : "seeded");
+        auto cloned = common_sampler_ptr(common_sampler_clone(compact.get()));
+        require(llama_sampler_backend_selected_only(common_sampler_get(cloned.get())), "clone lost selected-output contract");
+    }
+    // Requests for probabilities keep normal output even if a compact client
+    // helper was used; grammar/backend-incompatible chains also remain intact.
+    params.backend_sampling = true; params.n_probs = 5;
+    common_sampler_ptr detailed(common_sampler_init(model, params));
+    require(!llama_sampler_backend_selected_only(common_sampler_get_backend_selected_only(detailed.get())), "probability request discarded candidates");
+    params.n_probs = 0; params.grammar = common_grammar(COMMON_GRAMMAR_TYPE_USER, "root ::= [A-Z]+\n");
+    common_sampler_ptr grammar(common_sampler_init(model, params));
+    require(!common_sampler_get_backend_selected_only(grammar.get()), "grammar changed its CPU fallback");
+}
