+        static_cast<const llama_sampler_chain *>(sampler->ctx)->selected_only;
+}
+
+bool llama_sampler_backend_selected_only_ready(const llama_sampler * sampler) {
+    if (!llama_sampler_backend_selected_only(sampler)) { return false; }
+    const auto * chain = static_cast<const llama_sampler_chain *>(sampler->ctx);
+    return chain->is_init && chain->backend_selects_token && !chain->samplers.empty() &&
+        std::all_of(chain->samplers.begin(), chain->samplers.end(),
+            [](const llama_sampler_chain::info & child) { return child.is_backend; });
 }
 
