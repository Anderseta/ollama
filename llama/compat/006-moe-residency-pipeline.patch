diff --git a/src/llama-expert-trace.h b/src/llama-expert-trace.h
new file mode 100644
index 0000000..22f22f2
--- /dev/null
+++ b/src/llama-expert-trace.h
@@ -0,0 +1,222 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <string>
+#include <thread>
+
+#include <fcntl.h>
+#include <sys/stat.h>
+#ifdef _WIN32
+#include <io.h>
+#else
+#include <unistd.h>
+#endif
+
+// This optional trace records expert identities and quantized byte costs only.
+// It is independent of prompts, sampled token IDs, model paths and diagnostics.
+namespace llama_expert_trace {
+
+inline bool enabled() noexcept {
+    static const bool value = [] {
+        const char * path = std::getenv("WILDLLAMA_EXPERT_TRACE");
+        return path && path[0];
+    }();
+    return value;
+}
+
+class recorder {
+public:
+    recorder() noexcept {
+        try {
+            const char * path = std::getenv("WILDLLAMA_EXPERT_TRACE");
+            if (!path || !absolute(path)) { return; }
+            if (const char * value = std::getenv("WILDLLAMA_EXPERT_TRACE_MAX_BYTES")) {
+                char * end = nullptr;
+                const unsigned long long parsed = std::strtoull(value, &end, 10);
+                if (value[0] && value[0] != '-' && end && !*end && parsed >= 1024 && parsed <= (uint64_t(1) << 30)) {
+                    max_bytes = uint64_t(parsed);
+                }
+            }
+            // Exclusive creation protects an earlier observation from accidental reuse.
+            file = create_exclusive(path);
+            if (!file) { return; }
+            std::setvbuf(file, nullptr, _IOFBF, 64 * 1024);
+            const std::string header = "{\"kind\":\"header\",\"version\":1,\"unit\":\"expert_bundle\",\"scope\":\"runner_shared\"}\n";
+            if (std::fwrite(header.data(), 1, header.size(), file) != header.size()) {
+                std::fclose(file); file = nullptr; return;
+            }
+            planned_bytes = header.size();
+            active = true;
+            worker = std::thread([this] { consume(); });
+        } catch (...) {
+            active = false;
+            if (file) { std::fclose(file); file = nullptr; }
+        }
+    }
+
+    ~recorder() { finish(); }
+    recorder(const recorder &) = delete;
+    recorder & operator=(const recorder &) = delete;
+
+    void route(uint64_t evaluation, int32_t layer, const int32_t * ids, size_t n_ids,
+               uint32_t tokens, uint32_t k, uint64_t bytes, uint64_t model) noexcept {
+        if (!active.load(std::memory_order_relaxed)) { return; }
+        try {
+            std::lock_guard<std::mutex> guard(mutex);
+            if (!active.load(std::memory_order_relaxed) || stopping) { return; }
+            ++seen_routes;
+            if (!ids || layer < 0 || !tokens || !k || !bytes || n_ids > max_ids ||
+                uint64_t(tokens) * k != n_ids) {
+                ++dropped_routes; ++invalid_routes; return;
+            }
+            for (size_t i = 0; i < n_ids; ++i) {
+                if (ids[i] < 0) { ++dropped_routes; ++invalid_routes; return; }
+            }
+            std::string line;
+            line.reserve(192 + n_ids * 4);
+            line = "{\"kind\":\"route\",\"seq\":" + std::to_string(seen_routes) +
+                ",\"model\":" + std::to_string(model) + ",\"eval\":" + std::to_string(evaluation) +
+                ",\"layer\":" + std::to_string(layer) + ",\"tokens\":" + std::to_string(tokens) +
+                ",\"k\":" + std::to_string(k) + ",\"bytes\":" + std::to_string(bytes) + ",\"experts\":[";
+            for (size_t i = 0; i < n_ids; ++i) {
+                if (i) { line += ','; }
+                line += std::to_string(ids[i]);
+            }
+            line += "]}\n";
+            if (line.size() > max_bytes - footer_reserve - planned_bytes) {
+                ++dropped_routes; cap_reached = true; stopping = true;
+                condition.notify_one(); return;
+            }
+            if (queue.size() >= 1024 || line.size() > max_queue_bytes - queued_bytes) {
+                ++dropped_routes; ++queue_drops; return;
+            }
+            const size_t line_bytes = line.size();
+            queue.emplace_back(std::move(line));
+            planned_bytes += line_bytes; queued_bytes += line_bytes;
+            ++accepted_routes;
+            condition.notify_one();
+        } catch (...) {
+            // Tracing never changes whether inference succeeds.
+            std::lock_guard<std::mutex> guard(mutex);
+            ++dropped_routes; ++allocation_drops;
+        }
+    }
+
+    void finish() noexcept {
+        try {
+            std::lock_guard<std::mutex> finish_guard(finish_mutex);
+            {
+                std::lock_guard<std::mutex> guard(mutex);
+                stopping = true;
+                condition.notify_one();
+            }
+            if (worker.joinable()) { worker.join(); }
+        } catch (...) {}
+    }
+
+private:
+    static constexpr size_t max_ids = 65536;
+    static constexpr size_t max_queue_bytes = 1024 * 1024;
+    static constexpr uint64_t footer_reserve = 512;
+    std::atomic<bool> active { false };
+    FILE * file = nullptr;
+    std::thread worker;
+    std::mutex finish_mutex;
+    std::mutex mutex;
+    std::condition_variable condition;
+    std::deque<std::string> queue;
+    size_t queued_bytes = 0;
+    uint64_t max_bytes = 64 * 1024 * 1024;
+    uint64_t planned_bytes = 0, seen_routes = 0, accepted_routes = 0, written_routes = 0;
+    uint64_t dropped_routes = 0, queue_drops = 0, invalid_routes = 0, allocation_drops = 0;
+    bool stopping = false, cap_reached = false, io_error = false;
+
+    static FILE * create_exclusive(const char * path) noexcept {
+#ifdef _WIN32
+        // MinGW can target a CRT that predates fopen's C11 'x' mode.
+        const int descriptor = _open(path, _O_WRONLY | _O_CREAT | _O_EXCL | _O_BINARY, _S_IREAD | _S_IWRITE);
+        if (descriptor < 0) { return nullptr; }
+        FILE * result = _fdopen(descriptor, "wb");
+        if (!result) { _close(descriptor); }
+#else
+        const int descriptor = open(path, O_WRONLY | O_CREAT | O_EXCL, S_IRUSR | S_IWUSR);
+        if (descriptor < 0) { return nullptr; }
+        FILE * result = fdopen(descriptor, "wb");
+        if (!result) { close(descriptor); }
+#endif
+        return result;
+    }
+
+    static bool absolute(const char * path) noexcept {
+#ifdef _WIN32
+        return (path[0] && path[1] == ':' && (path[2] == '\\' || path[2] == '/')) ||
+            (path[0] == '\\' && path[1] == '\\');
+#else
+        return path[0] == '/';
+#endif
+    }
+
+    void consume() noexcept {
+        auto last_flush = std::chrono::steady_clock::now();
+        for (;;) {
+            std::string line;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                condition.wait_for(lock, std::chrono::milliseconds(250), [this] { return stopping || !queue.empty(); });
+                if (queue.empty() && stopping) { break; }
+                if (!queue.empty()) {
+                    line = std::move(queue.front()); queue.pop_front(); queued_bytes -= line.size();
+                }
+            }
+            const auto now = std::chrono::steady_clock::now();
+            const bool write_failed = !line.empty() && std::fwrite(line.data(), 1, line.size(), file) != line.size();
+            const bool flush_due = now - last_flush >= std::chrono::milliseconds(250);
+            const bool flush_failed = flush_due && std::fflush(file) != 0;
+            if (write_failed || flush_failed) {
+                std::lock_guard<std::mutex> guard(mutex);
+                io_error = true;
+                active.store(false, std::memory_order_relaxed);
+                dropped_routes += queue.size() + (!line.empty() ? 1 : 0);
+                queue.clear(); queued_bytes = 0;
+                break;
+            }
+            if (!line.empty()) { ++written_routes; }
+            if (flush_due) { last_flush = now; }
+        }
+        {
+            std::lock_guard<std::mutex> guard(mutex);
+            active.store(false, std::memory_order_relaxed);
+            const bool truncated = cap_reached || dropped_routes || io_error;
+            std::fprintf(file, "{\"kind\":\"end\",\"truncated\":%s,\"routes\":%llu,\"seen_routes\":%llu,\"dropped_routes\":%llu,\"queue_drops\":%llu,\"invalid_routes\":%llu,\"allocation_drops\":%llu,\"io_error\":%s}\n",
+                truncated ? "true" : "false", (unsigned long long) written_routes,
+                (unsigned long long) seen_routes, (unsigned long long) dropped_routes,
+                (unsigned long long) queue_drops, (unsigned long long) invalid_routes,
+                (unsigned long long) allocation_drops, io_error ? "true" : "false");
+            std::fclose(file); file = nullptr;
+        }
+    }
+};
+
+inline recorder & instance() noexcept { static recorder value; return value; }
+
+inline void record_route(uint64_t evaluation, int32_t layer, const int32_t * ids, size_t n_ids,
+                         uint32_t tokens, uint32_t experts_per_token, uint64_t bytes_per_expert,
+                         uint64_t model_id = 0) noexcept {
+    if (!enabled()) { return; }
+    instance().route(evaluation, layer, ids, n_ids, tokens, experts_per_token, bytes_per_expert, model_id);
+}
+
+// Call during graceful runner teardown; abrupt termination produces an incomplete
+// file that the replay tool refuses unless explicitly allowed by its caller.
+inline void finish() noexcept { if (enabled()) { instance().finish(); } }
+
+}
