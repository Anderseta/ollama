+    ggml_custom_op_params cpu;
+    memcpy(&cpu, node->op_params, sizeof(cpu));
+    if (!cpu.fun) { return false; }
+    const ggml_cuda_host_op_params params { ggml_cuda_host_op_magic, callback, data0, data1 };
+    memcpy(reinterpret_cast<char *>(node->op_params) + sizeof(ggml_custom_op_params), &params, sizeof(params));
+    return true;
