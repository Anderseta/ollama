index 0000000..e6e7147
--- /dev/null
+++ b/ggml/include/ggml-cuda-host-op.h
@@ -0,0 +1,26 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// A runtime-only CUDA provider attached to an existing GGML_OP_CUSTOM node.
+// The normal custom-op fields remain valid, including its fail-closed CPU
+// function. The provider receives ready device inputs and must complete its
+// output (or establish its own parent-stream dependency) before returning.
+typedef bool (*ggml_backend_cuda_host_op_callback)(ggml_backend_dev_t device, struct ggml_tensor * node,
+                                                  void * data0, void * data1);
+
+// Optional CUDA registry extension named "ggml_backend_cuda_host_op_api".
+// Its proc address points directly to this versioned table.
+struct ggml_backend_cuda_host_op_api {
+    uint32_t version;
+    bool (*set)(struct ggml_tensor * node, ggml_backend_cuda_host_op_callback callback, void * data0, void * data1);
+    bool (*supports)(const struct ggml_tensor * node);
+};
+
+#ifdef __cplusplus
+}
+#endif
diff --git a/ggml/include/ggml-cuda-upload.h b/ggml/include/ggml-cuda-upload.h
new file mode 100644
index 0000000..6782840
--- /dev/null
+++ b/ggml/include/ggml-cuda-upload.h
@@ -0,0 +1,30 @@
+#pragma once
+
+#include "ggml-backend.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+// Optional registry extension named "ggml_backend_cuda_upload_api". Its proc
+// address is a pointer to this versioned table, not a callable function. Calls
+// on a queue must be serialized by its owner. Sources must be pinned and remain
+// unchanged until their recorded slot completes or synchronize() succeeds.
+struct ggml_backend_cuda_upload_api {
+    uint32_t version;
+    void * (*create)(ggml_backend_t backend);
+    void   (*free)(void * queue);
+    // Fence previously submitted consumers before overwriting device ranges.
+    bool (*begin)(void * queue, ggml_backend_t backend);
+    bool (*copy)(void * queue, struct ggml_tensor * tensor, const void * source, size_t offset, size_t size);
+    bool (*record)(void * queue, unsigned slot);
+    bool (*wait_host)(void * queue, unsigned slot);
+    // Make subsequently submitted compute wait for the completed uploads.
+    bool (*end)(void * queue, ggml_backend_t backend);
+    // Drain uploads and close an unfinished batch, including I/O-error cleanup.
+    bool (*synchronize)(void * queue);
+};
+
+#ifdef __cplusplus
+}
+#endif
