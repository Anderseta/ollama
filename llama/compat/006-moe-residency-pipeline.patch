new file mode 100644
index 0000000..25f8081
--- /dev/null
+++ b/src/llama-moe-executor.inl
@@ -0,0 +1,265 @@
+    // Included inside llama_moe_cache::impl. The parent graph keeps fixed shapes;
+    // only this provider's bounded child CUDA work changes with actual routing.
+    ggml_backend_ptr executor_backend;
+    ggml_backend_buffer_ptr executor_workspace;
+    size_t executor_workspace_size = 0;
+    size_t executor_output_size = 0;
+    size_t executor_ids_size = 0;
+    std::mutex executor_mutex;
+    std::unordered_map<const ggml_tensor *, std::vector<int32_t>> executor_routes;
+    std::vector<int32_t> executor_slot_ids;
+
+    static bool executor_enabled() {
+        const char * value = std::getenv("WILDLLAMA_MOE_DYNAMIC_PREFILL");
+        return llama_moe_runtime::enabled() && value && std::strcmp(value, "1") == 0;
+    }
+
+    static size_t executor_product(size_t a, size_t b) {
+        if (b && a > std::numeric_limits<size_t>::max() / b) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill workspace overflow");
+        }
+        return a * b;
+    }
+
+    static size_t executor_sum(size_t a, size_t b) {
+        if (a > std::numeric_limits<size_t>::max() - b) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill workspace overflow");
+        }
+        return a + b;
+    }
+
+    static size_t executor_align(size_t value, size_t alignment) {
+        if (!alignment) { throw std::runtime_error("gpu-exclusive: invalid CUDA alignment"); }
+        const size_t remainder = value % alignment;
+        return remainder ? executor_sum(value, alignment - remainder) : value;
+    }
+
+    static ggml_tensor * executor_alias(ggml_context * ctx, const ggml_tensor * source) {
+        ggml_backend_buffer_t buffer = source->buffer;
+        for (const ggml_tensor * root = source; !buffer && root->view_src;) {
+            root = root->view_src;
+            buffer = root->buffer;
+        }
+        if (!buffer || !source->data) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill input is not allocated");
+        }
+        auto * alias = ggml_new_tensor_4d(ctx, source->type,
+            source->ne[0], source->ne[1], source->ne[2], source->ne[3]);
+        std::memcpy(alias->nb, source->nb, sizeof(alias->nb));
+        alias->buffer = buffer;
+        alias->data = source->data;
+        alias->extra = source->extra;
+        // Do not attach the parent operation or its ancestors to the child graph.
+        return alias;
+    }
+
+    static void executor_view(ggml_tensor * view) {
+        if (ggml_backend_view_init(view) != GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill view initialization failed");
+        }
+    }
+
+    static void executor_cpu_unavailable(ggml_tensor *, int, int, void *) {
+        GGML_ABORT("gpu-exclusive: dynamic expert prefill requires its CUDA provider");
+    }
+
+    void executor_begin() {
+        std::lock_guard<std::mutex> guard(executor_mutex);
+        executor_routes.clear();
+    }
+
+    void executor_reserve(size_t output_bytes, size_t ids_bytes) {
+        const size_t alignment = ggml_backend_buft_get_alignment(devices[0].buft);
+        output_bytes = executor_align(std::max(output_bytes, executor_output_size), alignment);
+        ids_bytes = executor_align(std::max(ids_bytes, executor_ids_size), alignment);
+        const size_t needed = executor_sum(output_bytes, ids_bytes);
+        if (needed <= executor_workspace_size) {
+            executor_output_size = output_bytes;
+            executor_ids_size = ids_bytes;
+            return;
+        }
+        if (!executor_backend) {
+            executor_backend.reset(ggml_backend_dev_init(ggml_backend_get_device(devices[0].backend), nullptr));
+            if (!executor_backend) {
+                throw std::runtime_error("gpu-exclusive: cannot initialize dynamic prefill CUDA backend");
+            }
+        }
+        ggml_backend_synchronize(executor_backend.get());
+        executor_workspace.reset();
+        executor_workspace_size = 0;
+        executor_workspace.reset(ggml_backend_buft_alloc_buffer(devices[0].buft, needed));
+        if (!executor_workspace) {
+            throw std::runtime_error("gpu-exclusive: cannot allocate bounded dynamic prefill workspace");
+        }
+        ggml_backend_buffer_set_usage(executor_workspace.get(), GGML_BACKEND_BUFFER_USAGE_COMPUTE);
+        executor_output_size = output_bytes;
+        executor_ids_size = ids_bytes;
+        executor_workspace_size = ggml_backend_buffer_get_size(executor_workspace.get());
+    }
+
+    ggml_tensor * make_streamed_matmul(ggml_context * ctx, const ggml_tensor * weight,
+                                      ggml_tensor * input, ggml_tensor * selected) {
+        if (!executor_enabled() || !model.gpu_exclusive() || model.hparams.no_alloc || selected->ne[1] <= 1) {
+            return nullptr;
+        }
+        const auto found = stream_weights.find(weight);
+        if (found == stream_weights.end() || found->second.empty()) { return nullptr; }
+        if (devices.size() != 1 || input->ne[0] != weight->ne[0] || input->ne[2] != selected->ne[1] ||
+            input->ne[3] != 1 || (input->ne[1] != 1 && input->ne[1] != selected->ne[0]) ||
+            selected->type != GGML_TYPE_I32 || selected->ne[0] <= 0 || selected->ne[2] != 1 || selected->ne[3] != 1 ||
+            selected->nb[0] != sizeof(int32_t) || weight->ne[2] <= 0) {
+            throw std::runtime_error("gpu-exclusive: unsupported dynamic prefill tensor geometry");
+        }
+        auto * device = ggml_backend_get_device(devices[0].backend);
+        const auto * api = static_cast<const ggml_backend_cuda_host_op_api *>(
+            ggml_backend_reg_get_proc_address(ggml_backend_dev_backend_reg(device), "ggml_backend_cuda_host_op_api"));
+        if (!api || api->version != 1 || !api->set) {
+            throw std::runtime_error("gpu-exclusive: CUDA dynamic prefill provider is unavailable");
+        }
+        const size_t count = executor_product(size_t(selected->ne[0]), size_t(selected->ne[1]));
+        size_t rows = 0;
+        for (const auto & tile : found->second) { rows = std::max(rows, size_t(tile.rows)); }
+        {
+            std::lock_guard<std::mutex> guard(executor_mutex);
+            executor_reserve(executor_product(executor_product(rows, count), sizeof(float)),
+                             executor_product(count, sizeof(int32_t)));
+        }
+        ggml_tensor * sources[] = { input, selected };
+        auto * result = ggml_custom_4d(ctx, GGML_TYPE_F32, weight->ne[1], selected->ne[0], selected->ne[1], 1,
+            sources, 2, executor_cpu_unavailable, 1, nullptr);
+        if (!api->set(result, executor_callback, this, const_cast<ggml_tensor *>(weight))) {
+            throw std::runtime_error("gpu-exclusive: cannot attach dynamic prefill CUDA provider");
+        }
+        ggml_format_name(result, "moe_dynamic.%s", weight->name);
+        return result;
+    }
+
+    static bool executor_callback(ggml_backend_dev_t device, ggml_tensor * output, void * data0, void * data1) noexcept {
+        auto * self = static_cast<impl *>(data0);
+        try {
+            return self->executor_compute(device, output, static_cast<const ggml_tensor *>(data1));
+        } catch (const std::exception & error) {
+            LLAMA_LOG_ERROR("gpu-exclusive: dynamic prefill failed: %s\n", error.what());
+        } catch (...) {
+            LLAMA_LOG_ERROR("gpu-exclusive: dynamic prefill failed\n");
+        }
+        if (self && self->executor_backend) { ggml_backend_synchronize(self->executor_backend.get()); }
+        return false;
+    }
+
+    bool executor_compute(ggml_backend_dev_t device, ggml_tensor * output, const ggml_tensor * weight) {
+        std::lock_guard<std::mutex> guard(executor_mutex);
+        if (!executor_backend || !executor_workspace || device != ggml_backend_get_device(executor_backend.get()) ||
+            !weight || !output || !output->src[0] || !output->src[1]) {
+            throw std::runtime_error("gpu-exclusive: invalid dynamic prefill execution state");
+        }
+        const auto * input = output->src[0];
+        const auto * selected = output->src[1];
+        const auto weight_tiles = stream_weights.find(weight);
+        if (weight_tiles == stream_weights.end() || weight_tiles->second.empty()) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill has no expert tiles");
+        }
+        const size_t k = size_t(selected->ne[0]), tokens = size_t(selected->ne[1]);
+        const size_t count = executor_product(k, tokens);
+        if (executor_product(count, sizeof(int32_t)) > executor_ids_size) {
+            throw std::runtime_error("gpu-exclusive: dynamic prefill IDs exceed reserved workspace");
+        }
+        const int layer = llama_runtime_activity::layer(weight->name);
+        size_t capacity = std::numeric_limits<size_t>::max();
+        for (const auto & entry : stream_weights) {
+            if (llama_runtime_activity::layer(entry.first->name) != layer) { continue; }
+            if (entry.first->ne[2] != weight->ne[2]) {
+                throw std::runtime_error("gpu-exclusive: inconsistent dynamic prefill expert counts");
+            }
+            for (const auto & tile : entry.second) { capacity = std::min(capacity, size_t(tile.slots)); }
+        }
+        auto route = executor_routes.find(selected);
+        if (route == executor_routes.end()) {
+            std::vector<int32_t> actual(count);
+            ggml_backend_tensor_get_2d(selected, actual.data(), 0, k * sizeof(int32_t), tokens,
+                                      selected->nb[1], k * sizeof(int32_t));
+            route = executor_routes.emplace(selected, std::move(actual)).first;
+            if (llama_expert_trace::enabled()) {
+                uint64_t bytes = 0;
+                if (layer >= 0 && layer < int(model.layers.size())) {
+                    for (const auto * tensor : llama_moe_cache_layer_experts(model.layers[layer])) { bytes += tensor->nb[2]; }
+                }
+                llama_expert_trace::record_route(evaluation, layer, route->second.data(), count,
+                    uint32_t(tokens), uint32_t(k), bytes);
+            }
+        }
+        const auto windows = llama_moe_partition::plan(route->second.data(), tokens, k, capacity, size_t(weight->ne[2]));
+        for (const auto & window : windows) {
+            const size_t begin = executor_product(window.begin, k), end = executor_sum(begin, executor_product(window.tokens, k));
+            ids.assign(route->second.begin() + begin, route->second.begin() + end);
+            for (const auto & tile : weight_tiles->second) {
+                const size_t output_bytes = executor_product(executor_product(size_t(tile.rows), ids.size()), sizeof(float));
+                if (output_bytes > executor_output_size) {
+                    throw std::runtime_error("gpu-exclusive: dynamic prefill output exceeds reserved workspace");
+                }
+                const auto binding = stream_maps.find(tile.slot_map);
+                if (binding == stream_maps.end()) {
+                    throw std::runtime_error("gpu-exclusive: dynamic prefill tile mapping is missing");
+                }
+                const ggml_init_params params = { 32 * ggml_tensor_overhead() + ggml_graph_overhead_custom(32, false), nullptr, true };
+                ggml_context_ptr ctx(ggml_init(params));
+                if (!ctx) { throw std::runtime_error("gpu-exclusive: dynamic prefill metadata allocation failed"); }
+                try {
+                    prepare_stream_binding(executor_backend.get(), binding->second);
+                    const auto & group = stream_groups[binding->second.group];
+                    const int32_t * mapping = group.adaptive ? group.admission.slot_map[binding->second.key] :
+                        group.slru.slot_map[binding->second.key];
+                    executor_slot_ids.resize(ids.size());
+                    for (size_t index = 0; index < ids.size(); ++index) {
+                        const int32_t slot = mapping[ids[index]];
+                        if (slot < 0 || slot >= tile.slots) {
+                            throw std::runtime_error("gpu-exclusive: dynamic prefill expert has no resident slot");
+                        }
+                        executor_slot_ids[index] = slot;
+                    }
+                    auto * input_alias = executor_alias(ctx.get(), input);
+                    auto * output_alias = executor_alias(ctx.get(), output);
+                    auto * weight_alias = executor_alias(ctx.get(), tile.weight);
+                    auto * input_view = ggml_view_3d(ctx.get(), input_alias, input->ne[0], input->ne[1], int64_t(window.tokens),
+                        input->nb[1], input->nb[2], executor_product(window.begin, input->nb[2]));
+                    executor_view(input_view);
+                    auto * slots = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_I32, int64_t(k), int64_t(window.tokens));
+                    auto * workspace = static_cast<uint8_t *>(ggml_backend_buffer_get_base(executor_workspace.get()));
+                    if (ggml_backend_tensor_alloc(executor_workspace.get(), slots, workspace + executor_output_size) != GGML_STATUS_SUCCESS) {
+                        throw std::runtime_error("gpu-exclusive: dynamic prefill ID tensor allocation failed");
+                    }
+                    auto * part = ggml_mul_mat_id(ctx.get(), weight_alias, input_view, slots);
+                    const auto precision = model.prec_policy.prec_src1.find(weight);
+                    if (precision != model.prec_policy.prec_src1.end()) { ggml_prec_set_src(part, precision->second, 1); }
+                    if (weight->type == GGML_TYPE_NVFP4) { ggml_prec_set_acc(part, GGML_PREC_BF16); }
+                    if (ggml_backend_tensor_alloc(executor_workspace.get(), part, workspace) != GGML_STATUS_SUCCESS) {
+                        throw std::runtime_error("gpu-exclusive: dynamic prefill output tensor allocation failed");
+                    }
+                    const size_t offset = executor_sum(executor_product(window.begin, output->nb[2]),
+                                                       executor_product(size_t(tile.row), output->nb[0]));
+                    auto * destination = ggml_view_3d(ctx.get(), output_alias, tile.rows, int64_t(k), int64_t(window.tokens),
+                        output->nb[1], output->nb[2], offset);
+                    executor_view(destination);
+                    auto * copy = ggml_cpy(ctx.get(), part, destination);
+                    executor_view(copy);
+                    if (!ggml_backend_supports_op(executor_backend.get(), part) ||
+                        !ggml_backend_supports_op(executor_backend.get(), copy)) {
+                        throw std::runtime_error("gpu-exclusive: CUDA does not support a dynamic prefill operation");
+                    }
+                    auto * graph = ggml_new_graph_custom(ctx.get(), 32, false);
+                    ggml_build_forward_expand(graph, copy);
+                    ggml_backend_tensor_set_async(executor_backend.get(), slots, executor_slot_ids.data(), 0,
+                                                  executor_product(executor_slot_ids.size(), sizeof(int32_t)));
+                    if (ggml_backend_graph_compute_async(executor_backend.get(), graph) != GGML_STATUS_SUCCESS) {
+                        throw std::runtime_error("gpu-exclusive: dynamic prefill CUDA execution failed");
+                    }
+                    ggml_backend_synchronize(executor_backend.get());
+                } catch (...) {
