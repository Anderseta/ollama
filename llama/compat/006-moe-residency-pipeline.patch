+            const int32_t id = key_of[slot];
+            if (id < 0) { continue; }
+            if (id / n_expert == key && seen[id % n_expert] == seen_generation) {
+                next_transient.push_back(slot);
+            } else { invalidate(slot, true); }
+        }
+        transient.swap(next_transient);
+        selected_persistent.clear();
+        for (int32_t expert : unique) {
+            const int32_t slot = slot_map[key][expert];
+            if (slot < 0) { continue; }
+            ++hits;
+            last_use[slot] = tick;
+            if (retained[slot]) {
+                erase_heap(slot);
+                selected_persistent.push_back(slot);
+            }
+        }
+        for (int32_t expert : unique) {
+            const int32_t id = key * n_expert + expert;
+            decay(id, generation);
+            if (frequency[id] != std::numeric_limits<uint16_t>::max()) { ++frequency[id]; }
+        }
+
+        std::sort(unique.begin(), unique.end());
+        for (int32_t expert : unique) {
+            if (slot_map[key][expert] >= 0) { continue; }
+            const int32_t id = key * n_expert + expert;
+            int32_t slot = -1;
+            bool keep = false;
+            if (persistent_count < persistent_limit && !free_slots.empty()) {
+                slot = take_free(); keep = true;
+            } else if (!heap.empty() && admits(id, heap.front())) {
+                slot = heap.front();
+                invalidate(slot, false); keep = true;
+            } else if (!free_slots.empty()) {
+                slot = take_free();
+            } else if (!heap.empty()) {
+                slot = heap.front();
+                invalidate(slot, false);
+            }
+            if (slot < 0) { throw std::logic_error("current experts exceeded planned slots"); }
+            key_of[slot] = id;
+            slot_map[key][expert] = slot;
+            retained[slot] = keep;
+            last_use[slot] = tick;
+            if (keep) {
+                ++persistent_count;
+                ++layer_count[layer_of[key]];
+                selected_persistent.push_back(slot);
+            } else { transient.push_back(slot); ++bypasses; }
+            fills.push_back({ expert, slot });
+        }
+        for (int32_t slot : selected_persistent) { insert_heap(slot); }
+        return true;
+    }
+
+    template<class Fill>
+    void abort(int32_t key, const std::vector<Fill> & fills) noexcept {
+        for (const auto & fill : fills) {
+            if (fill.slot >= 0 && fill.slot < n_slots &&
+                key_of[fill.slot] == key * n_expert + fill.expert) {
+                invalidate(fill.slot, true);
+            }
+        }
+    }
+
+private:
+    int32_t persistent_limit = 0;
+    int32_t persistent_count = 0;
+    int32_t active_layers = 0;
+    uint64_t tick = 0;
+    uint64_t decay_window = 256;
+    uint32_t last_generation = 0;
+    uint32_t seen_generation = 0;
+    std::vector<uint16_t> frequency;
+    std::vector<uint32_t> frequency_generation;
+    std::vector<uint32_t> seen;
+    std::vector<uint64_t> last_use;
+    std::vector<uint64_t> byte_cost;
+    std::vector<bool> retained;
+    std::vector<int32_t> layer_of, layer_count, layer_keys, heap, position, free_slots;
+    std::vector<int32_t> transient, next_transient, selected_persistent, unique;
+
+    void decay(int32_t id, uint32_t generation) {
+        const uint32_t age = generation - frequency_generation[id];
+        frequency[id] = age >= 16 ? 0 : uint16_t(frequency[id] >> age);
+        frequency_generation[id] = generation;
+    }
+    uint64_t benefit(int32_t id) const {
+        const uint64_t cost = byte_cost[id / n_expert];
+        return frequency[id] && cost > std::numeric_limits<uint64_t>::max() / frequency[id]
+            ? std::numeric_limits<uint64_t>::max() : cost * frequency[id];
+    }
+    bool less(int32_t a, int32_t b) const {
+        const uint64_t sa = benefit(key_of[a]), sb = benefit(key_of[b]);
+        if (sa != sb) { return sa < sb; }
+        if (last_use[a] != last_use[b]) { return last_use[a] < last_use[b]; }
+        return a < b;
+    }
+    void swap_heap(size_t a, size_t b) {
+        std::swap(heap[a], heap[b]); position[heap[a]] = int32_t(a); position[heap[b]] = int32_t(b);
+    }
+    void up(size_t index) {
+        while (index && less(heap[index], heap[(index - 1) / 2])) {
+            const size_t parent = (index - 1) / 2; swap_heap(index, parent); index = parent;
+        }
+    }
+    void down(size_t index) {
+        for (;;) {
+            size_t child = index * 2 + 1;
+            if (child >= heap.size()) { return; }
+            if (child + 1 < heap.size() && less(heap[child + 1], heap[child])) { ++child; }
+            if (!less(heap[child], heap[index])) { return; }
+            swap_heap(index, child); index = child;
+        }
+    }
+    void insert_heap(int32_t slot) {
+        position[slot] = int32_t(heap.size()); heap.push_back(slot); up(heap.size() - 1);
+    }
+    void erase_heap(int32_t slot) {
+        const int32_t index = position[slot];
+        if (index < 0) { return; }
+        const int32_t replacement = heap.back();
+        heap.pop_back(); position[slot] = -1;
+        if (size_t(index) == heap.size()) { return; }
+        heap[index] = replacement; position[replacement] = index;
+        if (index && less(replacement, heap[(index - 1) / 2])) { up(index); }
+        else { down(index); }
+    }
+    void rebuild_heap() {
+        for (size_t index = heap.size() / 2; index > 0; --index) { down(index - 1); }
+    }
+    int32_t take_free() {
+        const int32_t slot = free_slots.back(); free_slots.pop_back(); return slot;
+    }
+    void invalidate(int32_t slot, bool release) noexcept {
+        const int32_t id = key_of[slot];
+        if (id < 0) { return; }
+        erase_heap(slot);
+        if (slot_map[id / n_expert]) { slot_map[id / n_expert][id % n_expert] = -1; }
+        if (retained[slot]) {
+            --persistent_count; --layer_count[layer_of[id / n_expert]];
+        }
+        retained[slot] = false;
+        key_of[slot] = -1;
+        invalidated_slots.push_back(slot);
+        ++evictions;
+        if (release) { free_slots.push_back(slot); }
+    }
+    bool admits(int32_t id, int32_t victim) const {
+        // Compare previous reuse, not the demand miss itself. Otherwise a
+        // repeated full scan gives each newcomer one extra count and still
+        // evicts the entire cache before the next pass can hit.
+        const uint64_t count = frequency[id] ? uint64_t(frequency[id] - 1) : 0;
+        const uint64_t cost = byte_cost[id / n_expert];
+        const uint64_t incoming = count && cost > std::numeric_limits<uint64_t>::max() / count
+            ? std::numeric_limits<uint64_t>::max() : cost * count;
+        const uint64_t existing = benefit(key_of[victim]);
+        if (incoming != existing) { return incoming > existing; }
+        const int32_t share = std::max(1, persistent_limit / std::max(1, active_layers));
+        const int32_t have = layer_count[layer_of[id / n_expert]];
+        const int32_t victim_have = layer_count[layer_of[key_of[victim] / n_expert]];
+        return have < share && victim_have > share;
+    }
+};
diff --git a/src/llama-moe-budget.h b/src/llama-moe-budget.h
new file mode 100644
index 0000000..ed0e674
--- /dev/null
+++ b/src/llama-moe-budget.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+
+namespace llama_moe_budget {
+constexpr uint64_t mib = uint64_t(1) << 20;
+constexpr uint64_t default_headroom = uint64_t(256) << 20;
+
+// managed_used includes the current cache. Only the extra allocation is charged
+// against free memory. Keep reserve in both the physical and managed budgets;
+// buffer alignment and a rebuilt graph can require more than the requested bank.
+// Zero quota means no explicit managed limit, not unlimited physical memory.
+inline uint64_t plan(uint64_t old_cache, uint64_t quota, uint64_t managed_used,
+                     uint64_t physical_free, uint64_t total_expert_bytes,
+                     uint64_t headroom = default_headroom) noexcept {
+    if (managed_used < old_cache || total_expert_bytes <= old_cache || physical_free <= headroom) {
+        return old_cache;
+    }
+    uint64_t available = physical_free - headroom;
+    if (quota) {
+        if (managed_used >= quota || quota - managed_used <= headroom) { return old_cache; }
+        available = std::min(available, quota - managed_used - headroom);
+    }
+    const uint64_t growth = std::min({ available, total_expert_bytes - old_cache,
+                                     std::numeric_limits<uint64_t>::max() - old_cache,
+                                     std::numeric_limits<uint64_t>::max() - managed_used });
+    const uint64_t target = old_cache + growth;
+    const uint64_t aligned = target - target % mib;
+    return aligned > old_cache ? aligned : old_cache;
+}
+}
