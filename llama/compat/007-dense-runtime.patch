+static size_t ggml_cuda_kv_granularity(ggml_backend_buffer_type_t buft) {
+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    if (!buft || !ggml_backend_buft_is_cuda(buft)) { return 0; }
+    const int device=static_cast<ggml_backend_cuda_buffer_type_context *>(buft->context)->device;
+    if (!ggml_cuda_info().devices[device].vmm) { return 0; }
+    CUmemAllocationProp prop = {};
+    prop.type=CU_MEM_ALLOCATION_TYPE_PINNED;
+    prop.location.type=CU_MEM_LOCATION_TYPE_DEVICE;
+    prop.location.id=ggml_cuda_get_physical_device(device);
+    size_t granularity=0;
+    if (cuMemGetAllocationGranularity(&granularity,&prop,CU_MEM_ALLOC_GRANULARITY_MINIMUM) != CUDA_SUCCESS) { return 0; }
+    return granularity;
+#else
+    GGML_UNUSED(buft); return 0;
+#endif
+}
+
+static ggml_backend_buffer_t ggml_cuda_kv_reserve(ggml_backend_buffer_type_t buft, size_t size) {
+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+    const size_t granularity=ggml_cuda_kv_granularity(buft);
+    if (!granularity || !size || size>SIZE_MAX-(granularity-1)) { return nullptr; }
+    const int device=static_cast<ggml_backend_cuda_buffer_type_context *>(buft->context)->device;
+    ggml_cuda_set_device(device);
+    try {
+        auto storage=std::unique_ptr<ggml_cuda_kv_vmm>(new ggml_cuda_kv_vmm(device,GGML_PAD(size,granularity),granularity));
+        CUdeviceptr address=0;
+        if (cuMemAddressReserve(&address,storage->capacity,granularity,0,0) != CUDA_SUCCESS) { return nullptr; }
+        storage->address=address;
+        auto ctx=std::unique_ptr<ggml_backend_cuda_buffer_context>(new ggml_backend_cuda_buffer_context(device,reinterpret_cast<void *>(address)));
+        ctx->kv_vmm=std::move(storage);
+        auto * buffer=ggml_backend_buffer_init(buft,ggml_backend_cuda_buffer_interface,ctx.get(),size);
+        ctx.release();
+        return buffer;
+    } catch (const std::bad_alloc &) { return nullptr; }
+#else
+    GGML_UNUSED(buft); GGML_UNUSED(size); return nullptr;
+#endif
+}
+
+static bool ggml_cuda_kv_commit(ggml_backend_buffer_t buffer,size_t offset,size_t size) {
+    if (!buffer || !ggml_backend_buffer_is_cuda(buffer) || offset>buffer->size || size>buffer->size-offset) { return false; }
+    auto * ctx=static_cast<ggml_backend_cuda_buffer_context *>(buffer->context);
+    return !ctx->kv_vmm || ctx->kv_vmm->ensure(offset,size);
+}
+
+static size_t ggml_cuda_kv_committed(ggml_backend_buffer_t buffer) {
+    if (!buffer || !ggml_backend_buffer_is_cuda(buffer)) { return SIZE_MAX; }
+    auto * ctx=static_cast<ggml_backend_cuda_buffer_context *>(buffer->context);
+    return ctx->kv_vmm ? ctx->kv_vmm->committed() : buffer->size;
+}
+
+static bool ggml_cuda_kv_clear_existing(ggml_backend_buffer_t buffer,size_t offset,size_t size) {
+    if (!buffer || !ggml_backend_buffer_is_cuda(buffer) || offset>buffer->size || size>buffer->size-offset) { return false; }
+    auto * ctx=static_cast<ggml_backend_cuda_buffer_context *>(buffer->context);
+    return ctx->kv_vmm && ctx->kv_vmm->clear_existing(offset,size);
+}
