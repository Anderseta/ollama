+
+static ggml_context_ptr context() {
+    return ggml_context_ptr(ggml_init({128 * ggml_tensor_overhead() + 2 * ggml_graph_overhead(), nullptr, true}));
+}
+
+static bool explicit_dense_opt() {
+    const char * value = std::getenv("GGML_CUDA_DENSE_OPT");
+    return value && std::strcmp(value, "1") == 0;
+}
+
+static bool has_gated_norm_pattern(ggml_cgraph * graph) {
+    for (int i = 0; i + 3 < ggml_graph_n_nodes(graph); ++i) {
+        if (ggml_graph_node(graph, i)->op == GGML_OP_RMS_NORM &&
+            ggml_graph_node(graph, i + 1)->op == GGML_OP_MUL &&
+            ggml_graph_node(graph, i + 2)->op == GGML_OP_UNARY &&
+            ggml_graph_node(graph, i + 3)->op == GGML_OP_MUL) { return true; }
+    }
+    return false;
+}
+
+static void test_gate_order() {
+    auto ctx = context();
+    auto * input = ggml_new_tensor_4d(ctx.get(), GGML_TYPE_F32, 128, 3, 1, 1);
+    auto * projection_input = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 384, 1);
+    auto * weight = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 384, 384);
+    auto * gamma = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 128);
+    auto * gate = ggml_reshape_4d(ctx.get(), ggml_mul_mat(ctx.get(), weight, projection_input), 128, 3, 1, 1);
+    auto * graph = ggml_new_graph(ctx.get());
+    if (explicit_dense_opt()) { ggml_build_forward_expand(graph, gate); }
+    auto * norm = ggml_rms_norm(ctx.get(), input, 1e-6f);
+    auto * weighted = ggml_mul(ctx.get(), norm, gamma);
+    auto * output = ggml_mul(ctx.get(), weighted, ggml_silu(ctx.get(), gate));
+    ggml_build_forward_expand(graph, output);
+    require(has_gated_norm_pattern(graph) == explicit_dense_opt(),
+            "Qwen-like gate producer order does not match the selected graph mode");
+}
+
+static void test_plan() {
+    auto ctx = context();
+    auto * input = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 256, 1);
+    std::array<float, 256> data{};
+    input->data = data.data();
+    std::array<ggml_tensor *, 4> weights, outputs;
+    std::array<std::array<float, 128>, 4> result{};
+    auto * graph = ggml_new_graph(ctx.get());
+    for (size_t i = 0; i < weights.size(); ++i) {
+        weights[i] = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_Q8_0, 256, 128);
+        outputs[i] = ggml_mul_mat(ctx.get(), weights[i], input);
+        outputs[i]->data = result[i].data();
+        ggml_build_forward_expand(graph, outputs[i]);
+    }
+    auto plans = ggml_cuda_dense_plan_inputs(graph);
+    require(plans.size() == 1 && plans[0].input == input && plans[0].consumers == 4,
+            "shared projection input not found");
+    outputs[1]->data = input->data;
+    require(ggml_cuda_dense_plan_inputs(graph).empty(), "overwritten input was shared");
+    outputs[1]->data = result[1].data();
+    input->ne[1] = 9;
+    require(ggml_cuda_dense_plan_inputs(graph).empty(), "prefill outside MMVQ was shared");
+    input->ne[1] = 1;
+    input->ne[2] = 2;
+    require(ggml_cuda_dense_plan_inputs(graph).empty(), "broadcast sequences were shared");
+    input->ne[2] = 1;
+    for (auto * weight : weights) { weight->type = GGML_TYPE_Q4_0; }
+    require(ggml_cuda_dense_plan_inputs(graph).empty(), "incompatible quantization was shared");
+    for (auto * weight : weights) { weight->type = GGML_TYPE_Q8_0; }
+
+    auto * changed = ggml_scale_inplace(ctx.get(), input, 2.0f);
+    changed->data = input->data;
+    auto * mutation = ggml_new_graph(ctx.get());
+    ggml_build_forward_expand(mutation, outputs[0]);
+    ggml_build_forward_expand(mutation, changed);
+    for (size_t i = 1; i < outputs.size(); ++i) { ggml_build_forward_expand(mutation, outputs[i]); }
+    require(ggml_cuda_dense_plan_inputs(mutation).empty(), "in-place mutation was not detected");
+
+    auto * alias = ggml_new_tensor_2d(ctx.get(), GGML_TYPE_F32, 256, 1);
+    alias->data = input->data;
+    outputs[1]->src[1] = alias;
+    plans = ggml_cuda_dense_plan_inputs(graph);
+    require(plans.size() == 1 && plans[0].input == input && plans[0].consumers == 3,
+            "different input versions were merged by address");
+    outputs[1]->src[1] = input;
+    auto * custom = ggml_new_tensor_1d(ctx.get(), GGML_TYPE_F32, 1);
+    custom->op = GGML_OP_CUSTOM;
+    ggml_build_forward_expand(graph, custom);
+    require(ggml_cuda_dense_plan_inputs(graph).empty(), "custom side effects were ignored");
+}
+
+struct fixture {
+    ggml_backend_t backend;
+    ggml_backend_ptr cpu_fallback;
+    ggml_context_ptr inputs = context();
+    ggml_context_ptr compute = context();
+    ggml_backend_buffer_ptr buffer;
+    ggml_backend_sched_ptr scheduler;
+    ggml_cgraph * graph;
+    std::vector<ggml_tensor *> output;
+    ggml_tensor * input = nullptr;
+    ggml_tensor * gate = nullptr;
+    explicit fixture(ggml_backend_t backend) : backend(backend), graph(ggml_new_graph(compute.get())) {}
+
+    void allocate() {
+        buffer.reset(ggml_backend_alloc_ctx_tensors(inputs.get(), backend));
+        require(buffer != nullptr, "input allocation failed");
+        ggml_backend_buffer_clear(buffer.get(), 0);
+        std::vector<ggml_backend_t> backends = {backend};
+        if (ggml_backend_dev_type(ggml_backend_get_device(backend)) != GGML_BACKEND_DEVICE_TYPE_CPU) {
+            // The scheduler requires its last backend to be CPU even when all
+            // arithmetic is explicitly assigned to CUDA and fallback is forbidden.
+            cpu_fallback.reset(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+            require(cpu_fallback != nullptr, "cannot initialize scheduler CPU sentinel");
+            backends.push_back(cpu_fallback.get());
+        }
+        scheduler.reset(ggml_backend_sched_new(backends.data(), nullptr, backends.size(), 128, false, true));
+        require(scheduler != nullptr, "scheduler initialization failed");
+        if (cpu_fallback) { ggml_backend_sched_set_gpu_exclusive(scheduler.get(), true); }
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            auto * node = ggml_graph_node(graph, i);
+            if (!ggml_cuda_dense_no_write(node)) { ggml_backend_sched_set_tensor_backend(scheduler.get(), node, backend); }
+        }
+        require(ggml_backend_sched_alloc_graph(scheduler.get(), graph), "graph allocation failed");
+        check_placement();
+    }
+
+    void check_placement() {
+        for (int i = 0; i < ggml_graph_n_nodes(graph); ++i) {
+            auto * node = ggml_graph_node(graph, i);
+            if (!ggml_cuda_dense_no_write(node)) {
+                require(ggml_backend_sched_get_tensor_backend(scheduler.get(), node) == backend,
+                        "arithmetic operation escaped the selected backend");
+            }
+        }
+    }
+
+    void add_output(ggml_tensor * tensor) {
+        ggml_set_output(tensor);
+        output.push_back(tensor);
+        ggml_build_forward_expand(graph, tensor);
+    }
+
+    std::vector<std::vector<float>> run(int iteration) {
+        std::vector<float> values(ggml_nelements(input));
+        for (size_t i = 0; i < values.size(); ++i) {
+            values[i] = std::sin(float(i) * 0.13f + iteration * 0.37f) * (iteration + 1);
+        }
+        ggml_backend_tensor_set(input, values.data(), 0, ggml_nbytes(input));
+        if (gate) {
+            for (size_t i = 0; i < values.size(); ++i) { values[i] = std::cos(float(i) * 0.07f + iteration) * 5.0f; }
+            ggml_backend_tensor_set(gate, values.data(), 0, ggml_nbytes(gate));
+        }
+        require(ggml_backend_sched_graph_compute(scheduler.get(), graph) == GGML_STATUS_SUCCESS, "graph compute failed");
+        check_placement();
+        if (cpu_fallback) {
+            const auto stats = ggml_backend_sched_get_gpu_stats(scheduler.get());
+            require(stats.cpu_heavy_ops_submitted == 0, "CUDA test submitted arithmetic to the CPU sentinel");
+        }
+        std::vector<std::vector<float>> result;
+        for (const auto * tensor : output) {
+            result.emplace_back(ggml_nelements(tensor));
+            ggml_backend_tensor_get(tensor, result.back().data(), 0, ggml_nbytes(tensor));
+        }
+        return result;
+    }
+};
+
+static void projections(fixture & f, int tokens, int sequences, bool lora) {
+    constexpr int width = 256;
+    f.input = ggml_new_tensor_4d(f.inputs.get(), GGML_TYPE_F32, width, tokens, sequences, 1);
+    ggml_set_input(f.input);
+    std::array<ggml_tensor *, 4> weights;
+    for (size_t i = 0; i < weights.size(); ++i) {
+        weights[i] = ggml_new_tensor_2d(f.inputs.get(), GGML_TYPE_Q8_0, width, i < 2 ? 128 : 32);
+        auto * result = ggml_mul_mat(f.compute.get(), weights[i], f.input);
+        if (lora && i == 0) {
+            auto * adapter = ggml_new_tensor_2d(f.inputs.get(), GGML_TYPE_F32, width, 128);
+            result = ggml_add(f.compute.get(), result, ggml_scale(f.compute.get(), ggml_mul_mat(f.compute.get(), adapter, f.input), 0.1f));
+        }
+        f.add_output(result);
+    }
+    f.allocate();
+    for (size_t k = 0; k < weights.size(); ++k) {
+        std::vector<float> values(ggml_nelements(weights[k]));
+        for (size_t i = 0; i < values.size(); ++i) { values[i] = std::sin(float(i) * 0.021f + k) * 0.03f; }
+        std::vector<uint8_t> quantized(ggml_nbytes(weights[k]));
+        ggml_quantize_chunk(GGML_TYPE_Q8_0, values.data(), quantized.data(), 0, weights[k]->ne[1], width, nullptr);
+        ggml_backend_tensor_set(weights[k], quantized.data(), 0, quantized.size());
+    }
+    if (lora) {
+        auto * adapter = f.output[0]->src[1]->src[0]->src[0];
+        std::vector<float> values(ggml_nelements(adapter), 0.001f);
+        ggml_backend_tensor_set(adapter, values.data(), 0, ggml_nbytes(adapter));
+    }
+}
+
+static void normalization(fixture & f, int width, int tokens, int sequences, bool keep_norm, bool project_gate) {
+    f.input = ggml_new_tensor_4d(f.inputs.get(), GGML_TYPE_F32, width, 3, tokens, sequences);
+    f.gate = ggml_dup_tensor(f.inputs.get(), f.input);
+    auto * gamma = ggml_new_tensor_1d(f.inputs.get(), GGML_TYPE_F32, width);
+    ggml_set_input(f.input);
+    ggml_set_input(f.gate);
+    ggml_tensor * projection = nullptr;
+    ggml_tensor * gate = f.gate;
+    if (project_gate) {
+        // Qwen's Z is a projection with ancestors that would otherwise be
+        // visited between RMSNorm/gamma and SiLU/MUL, not an already-ready input.
+        projection = ggml_new_tensor_2d(f.inputs.get(), GGML_TYPE_F32, width * 3, width * 3);
+        auto * flat = ggml_reshape_2d(f.compute.get(), f.gate, width * 3, tokens * sequences);
+        gate = ggml_reshape_4d(f.compute.get(), ggml_mul_mat(f.compute.get(), projection, flat), width, 3, tokens, sequences);
+        if (explicit_dense_opt()) { ggml_build_forward_expand(f.graph, gate); }
+    }
+    auto * norm = ggml_rms_norm(f.compute.get(), f.input, 1e-6f);
+    auto * weighted = ggml_mul(f.compute.get(), norm, gamma);
+    auto * silu = ggml_silu(f.compute.get(), gate);
+    auto * output = ggml_mul(f.compute.get(), weighted, silu);
+    if (keep_norm) { f.add_output(norm); }
+    f.add_output(output);
+    if (project_gate) {
+        require(has_gated_norm_pattern(f.graph) == explicit_dense_opt(), "projected gate prevents the intended fusion order");
+    }
+    f.allocate();
+    if (projection) {
+        const int size = width * 3;
+        std::vector<float> values(size_t(size) * size, 0.0f);
+        for (int i = 0; i < size; ++i) { values[size_t(i) * size + i] = 1.0f; }
+        ggml_backend_tensor_set(projection, values.data(), 0, ggml_nbytes(projection));
+    }
+    std::vector<float> values(width);
+    for (int i = 0; i < width; ++i) { values[i] = 0.7f + i * 0.0003f; }
+    ggml_backend_tensor_set(gamma, values.data(), 0, ggml_nbytes(gamma));
+}
+
+static void compare(const std::vector<std::vector<float>> & a, const std::vector<std::vector<float>> & b, float tolerance) {
+    require(a.size() == b.size(), "output count changed");
+    for (size_t i = 0; i < a.size(); ++i) {
+        require(a[i].size() == b[i].size(), "output geometry changed");
+        for (size_t j = 0; j < a[i].size(); ++j) {
+            const float error = std::abs(a[i][j] - b[i][j]);
+            if (!std::isfinite(a[i][j]) || !std::isfinite(b[i][j]) || error > tolerance * (1 + std::abs(a[i][j]))) {
+                std::fprintf(stderr, "output %zu element %zu: reference=%g CUDA=%g error=%g\n", i, j, a[i][j], b[i][j], error);
+                throw std::runtime_error("CUDA result differs from the reference");
+            }
+        }
+    }
+}
+
+int main(int argc, char ** argv) {
+    try {
+        test_plan();
+        test_gate_order();
+        if (argc > 1 && std::string(argv[1]) == "--host-only") {
+            std::puts("PASS: dense input planner guards immutable values and fallbacks");
+            return 0;
+        }
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) { std::puts("SKIP: no CUDA device"); return 77; }
+        auto fusion_count = reinterpret_cast<uint64_t (*)()>(
+            ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_test_norm_silu_fusions"));
+        require(fusion_count != nullptr, "CUDA fusion-activation test hook unavailable");
+        ggml_backend_ptr cpu(ggml_backend_init_by_type(GGML_BACKEND_DEVICE_TYPE_CPU, nullptr));
+        ggml_backend_ptr gpu(ggml_backend_dev_init(ggml_backend_reg_dev_get(registry, 0), nullptr));
+        require(cpu && gpu, "cannot create reference/CUDA backends");
+        for (const auto test : {std::array<int, 3>{1, 1, 0}, {8, 1, 0}, {1, 2, 0}, {1, 1, 1}}) {
+            fixture reference(cpu.get()), candidate(gpu.get()), other(gpu.get());
+            projections(reference, test[0], test[1], test[2]);
+            projections(candidate, test[0], test[1], test[2]);
+            projections(other, 2, 1, false);
+            for (int iteration = 0; iteration < 6; ++iteration) {
+                // Alternate graph captures on one context/pool, then replay with new input values.
+                (void) other.run(iteration + 1);
+                compare(reference.run(iteration), candidate.run(iteration), 0.01f);
+            }
+        }
+        for (const auto test : {std::array<int, 5>{128, 1, 1, 0, 0}, {128, 17, 2, 0, 0}, {257, 3, 1, 0, 0},
+                               {4096, 1, 1, 0, 0}, {128, 2, 1, 1, 0}, {128, 1, 1, 0, 1}}) {
+            const auto before = fusion_count();
+            fixture reference(cpu.get()), candidate(gpu.get());
+            normalization(reference, test[0], test[1], test[2], test[3], test[4]);
+            normalization(candidate, test[0], test[1], test[2], test[3], test[4]);
+            for (int iteration = 0; iteration < 6; ++iteration) { compare(reference.run(iteration), candidate.run(iteration), 3e-5f); }
+            const auto submitted = fusion_count() - before;
+            const bool expected = explicit_dense_opt() && !test[3];
+            std::fprintf(stderr, "gated-norm width=%d tokens=%d sequences=%d keep_norm=%d projected_gate=%d fused_submissions=%llu expected=%d\n",
+                test[0], test[1], test[2], test[3], test[4], (unsigned long long) submitted, int(expected));
+            require(expected ? submitted > 0 : submitted == 0,
+                    "gated normalization did not take the required fusion/fallback path");
+        }
+        std::puts("PASS: CUDA dense projections and gated RMSNorm match the CPU reference, including replay and fallbacks");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-cuda-kv-growth.cpp b/tests/test-cuda-kv-growth.cpp
new file mode 100644
index 0000000..426ca45
--- /dev/null
+++ b/tests/test-cuda-kv-growth.cpp
@@ -0,0 +1,211 @@
+#include "ggml-cpp.h"
+#include "ggml-cuda.h"
+#include "ggml-cuda-kv-growth.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdio>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+static void expect_fill(const ggml_tensor * tensor, size_t offset, size_t size, uint8_t fill) {
+    std::vector<uint8_t> actual(size);
+    ggml_backend_tensor_get(tensor, actual.data(), offset, size);
+    require(std::all_of(actual.begin(), actual.end(), [fill](uint8_t value) { return value == fill; }),
+            "committed or future page has an unexpected fill value");
+}
+
+int main() {
+    try {
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) {
+            std::fprintf(stderr, "SKIP: no CUDA device\n");
+            return 77;
+        }
+        auto * device = ggml_backend_reg_dev_get(registry, 0);
+        auto * buft = ggml_backend_dev_buffer_type(device);
+        auto * api = static_cast<const ggml_backend_cuda_kv_growth_api *>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_kv_growth_api"));
+        require(api && api->version == 1 && api->granularity && api->reserve && api->commit && api->committed && api->clear_existing,
+                "CUDA KV growth API unavailable");
+        constexpr size_t mib = 1024*1024;
+        const size_t page = api->granularity(buft);
+        if (!page || page > 4*mib) {
+            std::fprintf(stderr, "SKIP: VMM unavailable or granularity exceeds the 32 MiB test budget\n");
+            return 77;
+        }
+        require(page >= 1024, "unexpectedly small CUDA VMM granularity");
+        require(api->granularity(nullptr) == 0 && !api->reserve(nullptr, mib) && !api->reserve(buft, 0),
+                "invalid reserve inputs accepted");
+        require(!api->reserve(buft, std::numeric_limits<size_t>::max()), "overflowing reserve accepted");
+        require(!api->commit(nullptr, 0, 1) && api->committed(nullptr) == std::numeric_limits<size_t>::max(),
+                "invalid buffer inputs accepted");
+
+        auto set_limit = reinterpret_cast<decltype(&ggml_backend_cuda_set_memory_limit)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_set_memory_limit"));
+        auto get_stats = reinterpret_cast<decltype(&ggml_backend_cuda_get_memory_stats)>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_get_memory_stats"));
+        require(set_limit && get_stats, "CUDA memory policy API unavailable");
+        // Establish enforcement before creating any backend allocation or pool.
+        require(set_limit(device, 16*mib, true), "cannot enable the 16 MiB quota");
+        struct policy_owner {
+            decltype(set_limit) release;
+            ggml_backend_dev_t device;
+            bool active = true;
+            ~policy_owner() { if (active) { release(device, 0, false); } }
+        } policy { set_limit, device };
+        auto stats = [&] {
+            ggml_backend_cuda_memory_stats result = {};
+            require(get_stats(device, &result), "cannot read CUDA policy stats");
+            return result;
+        };
+        const size_t baseline = stats().managed_used_bytes;
+        require(stats().enabled && stats().limit_bytes == 16*mib, "test quota was not activated");
+
+        // Reserve more logical capacity than either physical quota, including
+        // a non-page-aligned tail. No tensor-sized cudaMalloc is permitted.
+        const size_t logical = 128*mib + 129;
+        ggml_backend_buffer_ptr buffer(api->reserve(buft, logical));
+        require(buffer && ggml_backend_buffer_get_size(buffer.get()) == logical, "logical KV reservation failed");
+        void * const address = ggml_backend_buffer_get_base(buffer.get());
+        require(address && api->committed(buffer.get()) == 0 && stats().managed_used_bytes == baseline,
+                "virtual reservation committed full physical storage");
+        ggml_context_ptr context(ggml_init({16*ggml_tensor_overhead(), nullptr, true}));
+        require(context != nullptr, "cannot create metadata-only tensor context");
+        auto * flat = ggml_new_tensor_1d(context.get(), GGML_TYPE_I8, int64_t(logical));
+        require(ggml_backend_tensor_alloc(buffer.get(), flat, address) == GGML_STATUS_SUCCESS,
+                "cannot attach logical tensor to reserved VAS");
+        require(api->committed(buffer.get()) == 0, "plain tensor initialization committed full KV");
+
+        require(api->commit(buffer.get(), page + 13, 1), "first sparse page commit failed");
+        require(api->committed(buffer.get()) == page && stats().managed_used_bytes == baseline + page,
+                "sparse commit was not charged at physical page granularity");
+        expect_fill(flat, page, page, 0);
+
+        // A CPU-origin write through a view crosses two physical pages. Growing
+        // the map must preserve earlier bytes and zero untouched page padding.
+        std::vector<uint8_t> pattern(257);
+        for (size_t i = 0; i < pattern.size(); ++i) { pattern[i] = uint8_t(i*37 + 11); }
+        const size_t cross_offset = 2*page - 64;
+        auto * cross = ggml_view_1d(context.get(), flat, int64_t(pattern.size()), cross_offset);
+        require(ggml_backend_view_init(cross) == GGML_STATUS_SUCCESS, "cannot initialize offset view");
+        ggml_backend_tensor_set(cross, pattern.data(), 0, pattern.size());
+        require(api->committed(buffer.get()) == 2*page, "view write committed incorrect pages");
+        std::vector<uint8_t> two_pages(2*page);
+        ggml_backend_tensor_get(flat, two_pages.data(), page, two_pages.size());
+        for (size_t i = 0; i < two_pages.size(); ++i) {
+            const size_t relative = i - std::min(i, page - 64);
+            const uint8_t expected = i >= page - 64 && relative < pattern.size() ? pattern[relative] : 0;
+            require(two_pages[i] == expected, "growth changed existing bytes or exposed uninitialized padding");
+        }
+        const size_t twice = api->committed(buffer.get());
+        require(api->commit(buffer.get(), page + 1, page - 2) && api->commit(buffer.get(), logical, 0),
+                "idempotent/empty commit failed");
+        require(api->committed(buffer.get()) == twice && stats().managed_used_bytes == baseline + twice,
+                "repeated commit was charged twice");
+        require(!api->commit(buffer.get(), logical + 1, 0) && !api->commit(buffer.get(), logical - 1, 2) &&
+                !api->commit(buffer.get(), std::numeric_limits<size_t>::max(), 2), "invalid commit bounds accepted");
+
+        // Occupy the remaining quota through an ordinary CUDA allocation. A
+        // failed KV extension must preserve data/accounting, then succeed once
+        // that competing allocation is freed. This failure touches one new run.
+        ggml_backend_buffer_ptr blocker(ggml_backend_buft_alloc_buffer(buft, 16*mib - stats().managed_used_bytes));
+        require(blocker && stats().managed_used_bytes == 16*mib, "cannot fill the small physical quota");
+        const auto full = stats();
+        require(!api->commit(buffer.get(), 4*page + 7, 17), "KV extension exceeded the physical quota");
+        require(api->committed(buffer.get()) == twice && stats().managed_used_bytes == full.managed_used_bytes &&
+                stats().denied_allocations > full.denied_allocations, "failed extension leaked accounting");
+        std::vector<uint8_t> recovered(pattern.size());
+        ggml_backend_tensor_get(cross, recovered.data(), 0, recovered.size());
+        require(recovered == pattern, "denied extension corrupted existing bytes");
+        const auto before_cleanup = stats();
+        require(api->clear_existing(buffer.get(), cross_offset, 5*page), "cleanup of mapped bytes plus missing pages failed");
+        require(api->committed(buffer.get()) == twice && stats().managed_used_bytes == before_cleanup.managed_used_bytes &&
+                stats().denied_allocations == before_cleanup.denied_allocations,
+                "restore cleanup allocated missing pages or retried a denied reservation");
+        expect_fill(cross, 0, pattern.size(), 0);
+        require(!api->clear_existing(buffer.get(), logical - 1, 2) && !api->clear_existing(blocker.get(), 0, 1),
+                "invalid/conventional cleanup input accepted");
+        ggml_backend_tensor_set(cross, pattern.data(), 0, pattern.size());
+        blocker.reset();
+        require(api->commit(buffer.get(), 4*page + 7, 17), "KV extension did not recover after pressure was released");
+        require(api->committed(buffer.get()) == 3*page, "retry committed the wrong physical extent");
+
+        // Re-register this single test owner with a larger quota while retaining
+        // the same mapped data/address; retained mappings stay charged.
+        require(set_limit(device, 0, false), "cannot release initial policy owner");
+        policy.active = false;
+        require(set_limit(device, 32*mib, true), "cannot enable the 32 MiB quota with tracked live pages");
+        policy.active = true;
+        require(stats().managed_used_bytes == baseline + 3*page, "policy transition lost mapped accounting");
+
+        constexpr size_t rows = 3, width = 257, host_stride = width + 19;
+        auto * strided = ggml_view_1d(context.get(), flat, int64_t(2*page + width), 6*page + 17);
+        require(ggml_backend_view_init(strided) == GGML_STATUS_SUCCESS, "cannot initialize strided view");
+        std::vector<uint8_t> source(rows*host_stride, 0xd3), actual(rows*host_stride, 0xbd);
+        for (size_t row = 0; row < rows; ++row) {
+            for (size_t column = 0; column < width; ++column) {
+                source[row*host_stride + column] = uint8_t((row*53 + column*17 + 7)%251);
+            }
+        }
+        ggml_backend_tensor_set_2d(strided, source.data(), 0, width, rows, page, host_stride);
+        ggml_backend_tensor_get_2d(strided, actual.data(), 0, width, rows, page, host_stride);
+        require(api->committed(buffer.get()) == 6*page, "2D callback committed gaps between rows");
+        for (size_t row = 0; row < rows; ++row) {
+            for (size_t column = 0; column < host_stride; ++column) {
+                require(actual[row*host_stride + column] == (column < width ? source[row*host_stride + column] : uint8_t(0xbd)),
+                        "2D view copy changed row values or host padding");
+            }
+        }
+        expect_fill(flat, 6*page + 16, 1, 0);
+        expect_fill(flat, 6*page + 17 + width, 1, 0);
+        ggml_backend_tensor_memset(strided, 0xa6, 0, width);
+        expect_fill(strided, 0, width, 0xa6);
+        ggml_backend_tensor_get(cross, recovered.data(), 0, recovered.size());
+        require(recovered == pattern && ggml_backend_buffer_get_base(buffer.get()) == address,
+                "later growth moved VAS or overwrote an earlier view");
+
+        ggml_backend_buffer_clear(buffer.get(), 0x5a);
+        require(api->committed(buffer.get()) == 6*page, "clear eagerly committed the entire reservation");
+        require(!api->clear_existing(buffer.get(), 11*page, page) && api->committed(buffer.get()) == 6*page,
+                "zero-only cleanup changed a nonzero logical lazy fill");
+        expect_fill(cross, 0, pattern.size(), 0x5a);
+        require(api->commit(buffer.get(), 10*page + 3, 257), "future-page commit after clear failed");
+        expect_fill(flat, 10*page + 3, 257, 0x5a);
+
+        // Quantized padding must be zero even when the buffer's current fill
+        // is nonzero. Read it as bytes so no quantized arithmetic is involved.
+        auto * quantized = ggml_new_tensor_1d(context.get(), GGML_TYPE_Q8_0, 32);
+        const size_t data_bytes = ggml_nbytes(quantized);
+        const size_t allocation_bytes = ggml_backend_buft_get_alloc_size(buft, quantized);
+        require(allocation_bytes > data_bytes && allocation_bytes < page - 128, "Q8 padding test shape has no bounded padding");
+        const size_t quant_offset = 4*page + 128;
+        require(ggml_backend_tensor_alloc(buffer.get(), quantized, static_cast<char *>(address) + quant_offset) == GGML_STATUS_SUCCESS,
+                "quantized tensor initialization failed");
+        expect_fill(flat, quant_offset, data_bytes, 0x5a);
+        expect_fill(flat, quant_offset + data_bytes, allocation_bytes - data_bytes, 0);
+
+        ggml_backend_buffer_clear(buffer.get(), 0);
+        expect_fill(cross, 0, pattern.size(), 0);
+        expect_fill(flat, 10*page + 3, 257, 0);
+        // A read callback grows a previously unmapped page and must inherit
+        // the most recent clear, without resurrecting stale GPU memory.
+        expect_fill(flat, 12*page + 33, 257, 0);
+        require(api->committed(buffer.get()) == 8*page && stats().managed_used_bytes == baseline + 8*page &&
+                stats().managed_used_bytes <= 32*mib, "physical growth escaped quota accounting");
+        require(ggml_backend_buffer_get_base(buffer.get()) == address, "clear/growth changed the logical address");
+        buffer.reset();
+        require(stats().managed_used_bytes == baseline, "free did not unmap pages and return managed usage to baseline");
+        std::printf("PASS: CUDA KV VAS reservation, 16/32 MiB quotas, sparse growth, preserved bytes, views/2D, padding, future clears and cleanup (page=%zu)\n", page);
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-dense-embedding.cpp b/tests/test-dense-embedding.cpp
new file mode 100644
index 0000000..deb0204
--- /dev/null
+++ b/tests/test-dense-embedding.cpp
@@ -0,0 +1,183 @@
+#include "llama.h"
+#include "ggml-cpp.h"
+#include "../src/llama-model.h"
+
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+
+static void make_fixture(const std::string & path, bool tied, bool moe) {
+    constexpr int dim = 64, ff = 128, layers = 2, vocab = 259;
+    gguf_context_ptr meta(gguf_init_empty());
+    gguf_set_val_str(meta.get(), "general.architecture", "llama");
+    gguf_set_val_str(meta.get(), "general.name", "dense-embedding-regression");
+    gguf_set_val_u32(meta.get(), "llama.context_length", 256);
+    gguf_set_val_u32(meta.get(), "llama.embedding_length", dim);
+    gguf_set_val_u32(meta.get(), "llama.block_count", layers);
+    gguf_set_val_u32(meta.get(), "llama.feed_forward_length", ff);
+    gguf_set_val_u32(meta.get(), "llama.attention.head_count", 4);
+    gguf_set_val_u32(meta.get(), "llama.attention.head_count_kv", 2);
+    gguf_set_val_u32(meta.get(), "llama.rope.dimension_count", 16);
+    gguf_set_val_f32(meta.get(), "llama.attention.layer_norm_rms_epsilon", 1e-6f);
+    if (moe) {
+        gguf_set_val_u32(meta.get(), "llama.expert_count", 4);
+        gguf_set_val_u32(meta.get(), "llama.expert_used_count", 2);
+    }
+    gguf_set_val_str(meta.get(), "tokenizer.ggml.model", "llama");
+    std::vector<std::string> tokens = {"<unk>", "<s>", "</s>"};
+    for (int i = 0; i < 256; ++i) {
+        char name[16]; std::snprintf(name, sizeof(name), "<0x%02X>", i);
+        tokens.emplace_back(name);
+    }
+    std::vector<const char *> strings;
+    for (const auto & token : tokens) { strings.push_back(token.c_str()); }
+    std::vector<float> scores(vocab, 0);
+    std::vector<int32_t> types(vocab, 6); types[0] = 2; types[1] = types[2] = 3;
+    gguf_set_arr_str(meta.get(), "tokenizer.ggml.tokens", strings.data(), strings.size());
+    gguf_set_arr_data(meta.get(), "tokenizer.ggml.scores", GGUF_TYPE_FLOAT32, scores.data(), scores.size());
+    gguf_set_arr_data(meta.get(), "tokenizer.ggml.token_type", GGUF_TYPE_INT32, types.data(), types.size());
+    gguf_set_val_u32(meta.get(), "tokenizer.ggml.unknown_token_id", 0);
+    gguf_set_val_u32(meta.get(), "tokenizer.ggml.bos_token_id", 1);
+    gguf_set_val_u32(meta.get(), "tokenizer.ggml.eos_token_id", 2);
+    gguf_set_val_bool(meta.get(), "tokenizer.ggml.add_bos_token", true);
+    gguf_set_val_bool(meta.get(), "tokenizer.ggml.add_eos_token", false);
+    ggml_context_ptr tensors(ggml_init({16 * 1024 * 1024, nullptr, false}));
+    require(tensors != nullptr, "cannot allocate fixture tensors");
+    auto tensor = [&](const std::string & name, int x, int y = 1, int z = 1) {
+        auto * t = ggml_new_tensor_3d(tensors.get(), GGML_TYPE_F32, x, y, z);
+        ggml_set_name(t, name.c_str());
+        uint32_t salt = 2166136261u;
+        for (unsigned char c : name) { salt = (salt ^ c) * 16777619u; }
+        auto * data = static_cast<float *>(t->data);
+        for (int64_t i = 0; i < ggml_nelements(t); ++i) {
+            salt = salt * 1664525u + 1013904223u;
+            data[i] = float(int(salt >> 16) - 32768) * (0.02f / 32768);
+            if (name.find("norm.weight") != std::string::npos) { data[i] += 1.0f; }
+        }
+        gguf_add_tensor(meta.get(), t);
+    };
+    tensor("token_embd.weight", dim, vocab);
+    tensor("output_norm.weight", dim);
+    if (!tied) { tensor("output.weight", dim, vocab); }
+    for (int i = 0; i < layers; ++i) {
+        const auto prefix = "blk." + std::to_string(i) + ".";
+        tensor(prefix + "attn_norm.weight", dim);
+        tensor(prefix + "attn_q.weight", dim, dim);
+        tensor(prefix + "attn_k.weight", dim, dim / 2);
+        tensor(prefix + "attn_v.weight", dim, dim / 2);
+        tensor(prefix + "attn_output.weight", dim, dim);
+        tensor(prefix + "ffn_norm.weight", dim);
+        if (moe) {
+            tensor(prefix + "ffn_gate_inp.weight", dim, 4);
+            tensor(prefix + "ffn_gate_exps.weight", dim, ff, 4);
+            tensor(prefix + "ffn_up_exps.weight", dim, ff, 4);
+            tensor(prefix + "ffn_down_exps.weight", ff, dim, 4);
+        } else {
+            tensor(prefix + "ffn_gate.weight", dim, ff);
+            tensor(prefix + "ffn_up.weight", dim, ff);
+            tensor(prefix + "ffn_down.weight", ff, dim);
+        }
+    }
+    require(gguf_write_to_file(meta.get(), path.c_str(), false), "cannot write fixture GGUF");
+}
+
+struct result { std::vector<float> logits; uint64_t model_bytes = 0; };
+
+static result evaluate(const std::string & path, bool strict, bool tied, bool moe, bool override_cpu = false) {
+    auto params = llama_model_default_params();
+    params.n_gpu_layers = 999;
+    params.load_mode = LLAMA_LOAD_MODE_NONE;
+    params.use_extra_bufts = false;
+    params.no_host = true;
+    params.gpu_exclusive = strict;
+    params.gpu_vram_limit_mib = strict ? 64 : 0;
+    const llama_model_tensor_buft_override overrides[] = {
+        {"^token_embd\\.weight$", ggml_backend_dev_buffer_type(ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_CPU))},
+        {nullptr, nullptr}
+    };
+    if (override_cpu) { params.tensor_buft_overrides = overrides; }
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(llama_model_load_from_file(path.c_str(), params), llama_model_free);
+    require(model != nullptr, "cannot load embedding fixture");
+    require((model->hparams.n_expert > 0) == moe, "fixture expert metadata does not match the tested policy");
+    const bool host = ggml_backend_buffer_is_host(model->tok_embd->buffer);
+    require(host == (!strict || moe || override_cpu), "token embedding placement changed unexpectedly");
+    if (strict && !moe && !override_cpu) {
+        require(!ggml_backend_buffer_is_host(model->output->buffer), "output left CUDA");
+        require((model->tok_embd == model->output) == tied, "tied embedding/output was duplicated");
+        require(model->layers.front().wq &&
+                ggml_backend_buft_get_device(ggml_backend_buffer_get_type(model->tok_embd->buffer)) ==
+                ggml_backend_buft_get_device(ggml_backend_buffer_get_type(model->layers.front().wq->buffer)),
+                "embedding is not on the first decoder device");
+    }
+    result output;
+    output.model_bytes = llama_model_size(model.get());
+    if (moe || override_cpu) { return output; } // placement-only guards; do not change their execution policies
+    auto cp = llama_context_default_params();
+    cp.n_ctx = 256; cp.n_batch = 8; cp.n_ubatch = 8; cp.n_seq_max = 1;
+    cp.n_threads = 2; cp.n_threads_batch = 2;
+    std::unique_ptr<llama_context, decltype(&llama_free)> ctx(llama_init_from_model(model.get(), cp), llama_free);
+    require(ctx != nullptr, "cannot initialize embedding fixture context within quota");
+    std::vector<llama_token> tokens = {23, 42, 91, 72};
+    for (int step = 0; step < 4; ++step) {
+        auto batch = llama_batch_get_one(tokens.data(), int32_t(tokens.size()));
+        require(llama_decode(ctx.get(), batch) == 0, "fixture decode failed");
+        const float * values = llama_get_logits_ith(ctx.get(), -1);
+        require(values != nullptr, "missing logits");
+        output.logits.insert(output.logits.end(), values, values + llama_vocab_n_tokens(llama_model_get_vocab(model.get())));
+        tokens = {llama_token(100 + step)};
+    }
+    require(llama_n_ctx(ctx.get()) == 256, "embedding placement changed context capacity");
+    if (strict) {
+        llama_gpu_execution_stats execution{};
+        require(llama_gpu_execution_stats_get(ctx.get(), &execution) && execution.cpu_heavy_ops_submitted == 0 &&
+                execution.gpu_heavy_ops_submitted > 0, "strict embedding test used CPU arithmetic");
+        llama_gpu_memory_stats memory{};
+        require(llama_model_get_gpu_memory_stats(model.get(), &memory) &&
+                memory.limit_bytes == 64 * 1024 * 1024 && memory.managed_used_bytes <= memory.limit_bytes &&
+                memory.managed_peak_bytes <= memory.limit_bytes,
+                "embedding allocation escaped the VRAM quota");
+    }
+    return output;
+}
+
+int main(int argc, char ** argv) {
+    if (argc != 2) { std::fprintf(stderr, "usage: test-dense-embedding fixture-directory\n"); return 2; }
+    try {
+        ggml_backend_load_all();
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) { std::puts("SKIP: CUDA required"); return 77; }
+        llama_backend_init();
+        const std::filesystem::path directory(argv[1]);
+        std::filesystem::create_directories(directory);
+        for (bool tied : {false, true}) {
+            const auto path = (directory / (tied ? "dense-embedding-tied.gguf" : "dense-embedding.gguf")).string();
+            make_fixture(path, tied, false);
+            const auto reference = evaluate(path, false, tied, false);
+            const auto strict = evaluate(path, true, tied, false);
+            require(strict.model_bytes <= reference.model_bytes, "resident embedding increased unique model bytes");
+            require(reference.logits.size() == strict.logits.size(), "logit geometry changed");
+            for (size_t i = 0; i < reference.logits.size(); ++i) {
+                require(std::isfinite(strict.logits[i]) && std::abs(reference.logits[i] - strict.logits[i]) <=
+                        1e-4f * (1 + std::abs(reference.logits[i])), "resident embedding changed logits");
+            }
+            (void) evaluate(path, true, tied, false, true);
+        }
+        const auto moe = (directory / "moe-embedding-placement.gguf").string();
+        make_fixture(moe, false, true);
+        (void) evaluate(moe, true, false, true);
+        llama_backend_free();
+        std::puts("PASS: dense exclusive embeddings stay resident; tied weights share storage; normal, MoE, overrides and quotas preserved");
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
diff --git a/tests/test-kv-growth.cpp b/tests/test-kv-growth.cpp
new file mode 100644
index 0000000..fd014d0
--- /dev/null
+++ b/tests/test-kv-growth.cpp
@@ -0,0 +1,378 @@
+#include "llama.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "ggml-cuda-kv-growth.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+static void require(bool condition, const char * message) {
+    if (!condition) { throw std::runtime_error(message); }
+}
+
+struct environment_guard {
+    std::string key, previous;
+    bool existed;
+
+    environment_guard(const char * name, const char * value) : key(name), existed(std::getenv(name) != nullptr) {
+        if (existed) { previous = std::getenv(name); }
+        set(value);
+    }
+    void set(const char * value) {
+#ifdef _WIN32
+        require(_putenv_s(key.c_str(), value ? value : "") == 0, "cannot set KV growth test environment");
+#else
+        require((value ? setenv(key.c_str(), value, 1) : unsetenv(key.c_str())) == 0,
+                "cannot set KV growth test environment");
+#endif
+    }
+    ~environment_guard() {
+#ifdef _WIN32
+        _putenv_s(key.c_str(), existed ? previous.c_str() : "");
+#else
+        if (existed) { setenv(key.c_str(), previous.c_str(), 1); }
+        else { unsetenv(key.c_str()); }
+#endif
+    }
+};
+
+struct batch_owner {
+    llama_batch batch = llama_batch_init(64, 0, 1);
+    ~batch_owner() { llama_batch_free(batch); }
+};
+
+struct result {
+    uint32_t context = 0;
+    size_t vocab = 0;
+    uint64_t initial_bytes = 0, prefill_bytes = 0, decode_bytes = 0;
+    uint64_t at_256_bytes = 0, restored_bytes = 0;
+    std::vector<float> prefill, decode, shifted;
+};
+
+static uint64_t managed_bytes(const llama_model * model) {
+    llama_gpu_memory_stats stats {};
+    require(llama_model_get_gpu_memory_stats(model, &stats) && stats.enabled && stats.limit_bytes == 0,
+            "strict quota-zero CUDA allocation accounting is unavailable");
+    return stats.managed_used_bytes;
+}
+
+static llama_token fixed_token(size_t position, size_t vocab) {
+    // Feed the same tokens in both modes: a small numerical difference must
+    // not change the subsequent workload through autoregressive sampling.
+    require(vocab > 32, "KV fixture vocabulary is too small");
+    return llama_token(16 + ((position*13 + 7) % (vocab - 32)));
+}
+
+static void decode_fixed(llama_context * ctx, batch_owner & owner, size_t vocab,
+                         uint32_t begin, uint32_t count, std::vector<float> & output, bool collect_logits = true) {
+    auto & batch = owner.batch;
+    require(count > 0 && count <= 64, "invalid KV test batch size");
+    batch.n_tokens = int32_t(count);
+    for (uint32_t i = 0; i < count; ++i) {
+        batch.token[i] = fixed_token(begin + i, vocab);
+        batch.pos[i] = llama_pos(begin + i);
+        batch.n_seq_id[i] = 1;
+        batch.seq_id[i][0] = 0;
+        batch.logits[i] = collect_logits || i+1 == count;
+    }
+    require(llama_decode(ctx, batch) == 0, "KV fixture decode failed");
+    if (!collect_logits) { return; }
+    for (uint32_t i = 0; i < count; ++i) {
+        const float * logits = llama_get_logits_ith(ctx, int32_t(i));
+        require(logits != nullptr, "missing KV fixture logits");
+        output.insert(output.end(), logits, logits + vocab);
+    }
+}
+
+static std::vector<float> continuation(llama_context * ctx, batch_owner & batch, size_t vocab, uint32_t begin = 320) {
+    std::vector<float> output;
+    output.reserve(16*vocab);
+    for (uint32_t i = 0; i < 16; ++i) { decode_fixed(ctx, batch, vocab, begin + i, 1, output); }
+    return output;
+}
+
+static void require_identical(const std::vector<float> & expected, const std::vector<float> & actual,
+                              const char * message) {
+    require(expected.size() == actual.size() &&
+            std::memcmp(expected.data(), actual.data(), expected.size()*sizeof(float)) == 0, message);
+}
+
+static result evaluate(const char * path, ggml_backend_dev_t device, bool growing, uint32_t context) {
+    // The setting must be read per constructor, not cached process-wide. These
+    // two evaluations run sequentially in the same executable, with no model
+    // overlap and otherwise identical parameters and CUDA kernels.
+    environment_guard setting("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", growing ? "256" : "0");
+    auto mp = llama_model_default_params();
+    ggml_backend_dev_t devices[] = { device, nullptr };
+    mp.devices = devices;
+    mp.n_gpu_layers = 999;
+    mp.split_mode = LLAMA_SPLIT_MODE_NONE;
+    mp.main_gpu = 0;
+    mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+    mp.use_extra_bufts = false;
+    mp.no_host = true;
+    mp.gpu_exclusive = true;
+    mp.gpu_diagnostics = false;
+    mp.gpu_vram_limit_mib = 0;
+    std::unique_ptr<llama_model, decltype(&llama_model_free)> model(llama_model_load_from_file(path, mp), llama_model_free);
+    require(model != nullptr, "cannot load dense KV fixture");
+    char architecture[64] {};
+    llama_model_meta_val_str(model.get(), "general.architecture", architecture, sizeof(architecture));
+    require(std::string(architecture) == "llama", "KV integration test requires the dense Llama fixture");
+
+    auto cp = llama_context_default_params();
+    cp.n_ctx = context;
+    cp.n_batch = 64;
+    cp.n_ubatch = 64;
+    cp.n_seq_max = 1;
+    cp.n_rs_seq = 0;
+    cp.n_threads = 2;
+    cp.n_threads_batch = 2;
+    cp.type_k = GGML_TYPE_Q8_0;
+    cp.type_v = GGML_TYPE_Q8_0;
+    cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+    cp.offload_kqv = true;
+    cp.kv_unified = true;
+    std::unique_ptr<llama_context, decltype(&llama_free)> ctx(llama_init_from_model(model.get(), cp), llama_free);
+    require(ctx != nullptr, "cannot create CUDA KV fixture context");
+    require(llama_n_ctx(ctx.get()) == context && llama_n_ctx_seq(ctx.get()) == context,
+            "physical KV commitment changed logical context capacity");
+
+    result out;
+    out.context = llama_n_ctx(ctx.get());
+    out.vocab = llama_vocab_n_tokens(llama_model_get_vocab(model.get()));
+    out.initial_bytes = managed_bytes(model.get());
+    batch_owner batch;
+    out.prefill.reserve(320*out.vocab);
+    for (uint32_t begin = 0; begin < 320; begin += 64) {
+        decode_fixed(ctx.get(), batch, out.vocab, begin, 64, out.prefill);
+        if (begin == 192) { out.at_256_bytes = managed_bytes(model.get()); }
+    }
+    out.prefill_bytes = managed_bytes(model.get());
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 319,
+            "prefill lost positions when crossing the initial 256-token commitment");
+
+    const size_t capacity = llama_state_get_size(ctx.get());
+    require(capacity > 0, "empty state snapshot at 320 tokens");
+    std::vector<uint8_t> state(capacity);
+    const size_t written = llama_state_get_data(ctx.get(), state.data(), state.size());
+    require(written > 0 && written <= state.size(), "cannot save KV state across the growth boundary");
+    state.resize(written);
+
+    out.decode = continuation(ctx.get(), batch, out.vocab);
+    out.decode_bytes = managed_bytes(model.get());
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 335, "decode lost KV positions");
+    require(llama_state_set_data(ctx.get(), state.data(), state.size()) == state.size(), "cannot restore KV state over a longer live history");
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 319, "state restore retained stale tail cells");
+    const auto replay = continuation(ctx.get(), batch, out.vocab);
+    require_identical(out.decode, replay, "restored KV state changed continuation logits bitwise");
+
+    // Clearing must touch committed pages only, then restoration must commit
+    // and copy precisely the saved active rows, never the full virtual range.
+    llama_memory_clear(llama_get_memory(ctx.get()), true);
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == -1, "KV clear retained sequence metadata");
+    require(llama_state_set_data(ctx.get(), state.data(), state.size()) == state.size(), "cannot reload KV state after clearing");
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 319, "clear/reload lost saved positions");
+    const auto after_clear = continuation(ctx.get(), batch, out.vocab);
+    require_identical(out.decode, after_clear, "clear/reload changed continuation logits bitwise");
+
+    require(llama_state_set_data(ctx.get(), state.data(), state.size()) == state.size(), "cannot restore prefix before K shift");
+    require(llama_memory_can_shift(llama_get_memory(ctx.get())), "dense fixture does not support K shifting");
+    llama_memory_seq_add(llama_get_memory(ctx.get()), 0, 0, -1, 1);
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 320, "K shift did not update logical positions");
+    out.shifted = continuation(ctx.get(), batch, out.vocab, 321);
+    require(llama_memory_seq_pos_max(llama_get_memory(ctx.get()), 0) == 336, "K-shift continuation lost positions");
+    out.restored_bytes = managed_bytes(model.get());
+    require(llama_n_ctx(ctx.get()) == context, "KV growth or restoration reduced the context");
+    llama_gpu_execution_stats execution {};
+    require(llama_gpu_execution_stats_get(ctx.get(), &execution) && !execution.cpu_heavy_ops_submitted &&
+            execution.gpu_heavy_ops_submitted > 0, "dense KV test did not demonstrate exclusive CUDA execution");
+    std::printf("KV mode=%s context=%u vocab=%zu state=%zu managed_initial=%llu managed_at256=%llu managed_prefill320=%llu managed_decode336=%llu managed_restored=%llu\n",
+            growing ? "growth256" : "fully_committed", out.context, out.vocab, state.size(),
+            (unsigned long long) out.initial_bytes, (unsigned long long) out.at_256_bytes,
+            (unsigned long long) out.prefill_bytes, (unsigned long long) out.decode_bytes,
+            (unsigned long long) out.restored_bytes);
+    return out;
+}
+
+static float compare_logits(const result & reference, const result & growing,
+                            const std::vector<float> & a, const std::vector<float> & b) {
+    require(reference.vocab == growing.vocab && a.size() == b.size() && a.size()%reference.vocab == 0,
+            "off/on KV output shape differs");
+    float maximum = 0;
+    for (size_t token = 0; token < a.size()/reference.vocab; ++token) {
+        const auto offset = token*reference.vocab;
+        for (size_t v = 0; v < reference.vocab; ++v) {
+            require(std::isfinite(a[offset+v]) && std::isfinite(b[offset+v]), "nonfinite KV integration logits");
+            maximum = std::max(maximum, std::abs(a[offset+v] - b[offset+v]));
+        }
+        const auto top_a = std::max_element(a.begin()+offset, a.begin()+offset+reference.vocab) - a.begin();
+        const auto top_b = std::max_element(b.begin()+offset, b.begin()+offset+reference.vocab) - b.begin();
+        require(top_a == top_b, "initial KV commitment changed greedy top-1");
+    }
+    require(maximum <= 2e-4f, "initial KV commitment changed logits beyond 2e-4");
+    return maximum;
+}
+
+static void quota_denied_restore(const char * path, ggml_backend_dev_t device) {
+    constexpr uint64_t quota_mib = 512;
+    constexpr uint32_t context = 65536;
+    // The tied-wide fixture has 136-byte quantized KV rows. With a 2 MiB
+    // minimum VMM page, 512 rows still fit inside the initially committed page
+    // (~15420 rows/page), so they cannot exercise a denied growth. 32768 rows
+    // span multiple new pages; the independent 65536 context leaves the prefix
+    // and tensor-padding tail separate even in the small-context fallback case.
+    constexpr uint32_t snapshot_tokens = 32768;
+    ggml_backend_dev_t devices[] = { device, nullptr };
+    auto create = [&]() {
+        auto mp = llama_model_default_params();
+        mp.devices = devices;
+        mp.n_gpu_layers = 999;
+        mp.split_mode = LLAMA_SPLIT_MODE_NONE;
+        mp.main_gpu = 0;
+        mp.load_mode = LLAMA_LOAD_MODE_MMAP;
+        mp.use_extra_bufts = false;
+        mp.no_host = true;
+        mp.gpu_exclusive = true;
+        mp.gpu_diagnostics = false;
+        mp.gpu_vram_limit_mib = quota_mib;
+        std::unique_ptr<llama_model, decltype(&llama_model_free)> model(llama_model_load_from_file(path, mp), llama_model_free);
+        require(model != nullptr, "cannot load quota/state fixture");
+        auto cp = llama_context_default_params();
+        cp.n_ctx = context; cp.n_batch = 64; cp.n_ubatch = 64; cp.n_seq_max = 1; cp.n_rs_seq = 0;
+        cp.n_threads = 2; cp.n_threads_batch = 2;
+        cp.type_k = GGML_TYPE_Q8_0; cp.type_v = GGML_TYPE_Q8_0;
+        cp.flash_attn_type = LLAMA_FLASH_ATTN_TYPE_ENABLED;
+        cp.offload_kqv = true; cp.kv_unified = true;
+        std::unique_ptr<llama_context, decltype(&llama_free)> ctx(llama_init_from_model(model.get(), cp), llama_free);
+        require(ctx != nullptr && llama_n_ctx(ctx.get()) == context, "cannot create unchanged-context quota fixture");
+        return std::make_pair(std::move(model), std::move(ctx));
+    };
+
+    std::vector<uint8_t> snapshot;
+    std::vector<float> expected;
+    size_t vocab = 0;
+    {
+        environment_guard setting("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "0");
+        auto session = create();
+        vocab = llama_vocab_n_tokens(llama_model_get_vocab(session.first.get()));
+        batch_owner batch;
+        std::vector<float> prefill;
+        for (uint32_t begin = 0; begin < snapshot_tokens; begin += 64) {
+            // Only the final row is needed for the snapshot/continuation. Do
+            // not accumulate a long prompt's output logits on the host.
+            decode_fixed(session.second.get(), batch, vocab, begin, 64, prefill, false);
+        }
+        snapshot.resize(llama_state_get_size(session.second.get()));
+        const size_t written = llama_state_get_data(session.second.get(), snapshot.data(), snapshot.size());
+        require(written > 0 && written <= snapshot.size(), "cannot save 32768-token quota fixture state");
+        snapshot.resize(written);
+        expected = continuation(session.second.get(), batch, vocab, snapshot_tokens);
+    }
+
+    environment_guard setting("WILDLLAMA_KV_CACHE_INITIAL_TOKENS", "256");
+    auto session = create();
+    auto stats = [&] {
+        llama_gpu_memory_stats memory {};
+        require(llama_model_get_gpu_memory_stats(session.first.get(), &memory) && memory.enabled &&
+                memory.limit_bytes == quota_mib*1024*1024, "quota fixture memory policy is not active");
+        return memory;
+    };
+    const auto before = stats();
+    require(before.managed_used_bytes + 65536 < before.limit_bytes, "fixture exhausted its quota before restore blocker");
+    // Existing CUDA metadata and graph buffers are allocated already. Leave
+    // less than one VMM page available so any required new KV page is denied.
+    const size_t blocker_bytes = size_t(before.limit_bytes - before.managed_used_bytes - 1024);
+    ggml_backend_buffer_ptr blocker(ggml_backend_buft_alloc_buffer(ggml_backend_dev_buffer_type(device), blocker_bytes));
+    require(blocker != nullptr, "cannot allocate restore quota blocker");
+    const auto blocked = stats();
+    require(blocked.managed_used_bytes <= blocked.limit_bytes && blocked.limit_bytes - blocked.managed_used_bytes < 65536,
+            "restore blocker did not leave less than one CUDA VMM page");
+    require(llama_state_set_data(session.second.get(), snapshot.data(), snapshot.size()) == 0,
+            "restore ignored denied KV commitment");
+    require(stats().denied_allocations > blocked.denied_allocations && stats().managed_used_bytes <= blocked.limit_bytes,
+            "restore denial escaped the allocation policy or did not report a denied allocation");
+    blocker.reset();
+    llama_memory_clear(llama_get_memory(session.second.get()), true);
+    require(llama_state_set_data(session.second.get(), snapshot.data(), snapshot.size()) == snapshot.size(),
+            "valid restore did not recover after releasing the quota blocker");
+    require(llama_memory_seq_pos_max(llama_get_memory(session.second.get()), 0) == llama_pos(snapshot_tokens-1),
+            "recovered state restore lost saved positions");
+    batch_owner batch;
+    const auto actual = continuation(session.second.get(), batch, vocab, snapshot_tokens);
+    require_identical(expected, actual, "recovered quota-denied restore changed continuation logits bitwise");
+    std::printf("PASS KV quota_restore quota_mib=%llu context=%u snapshot_tokens=%u initial_tokens=256 continuation=bitwise denied_allocations=%llu\n",
+            (unsigned long long) quota_mib, context, snapshot_tokens, (unsigned long long) stats().denied_allocations);
+}
+
+int main(int argc, char ** argv) {
+    if (argc < 2) {
+        std::fprintf(stderr, "usage: test-kv-growth dense-llama-fixture.gguf [context8192or65536or131072; default65536]\n");
+        return 2;
+    }
+    std::setvbuf(stdout, nullptr, _IONBF, 0);
+    ggml_backend_load_all();
+    llama_backend_init();
+    try {
+        auto * registry = ggml_backend_reg_by_name("CUDA");
+        if (!registry || !ggml_backend_reg_dev_count(registry)) {
+            std::fprintf(stderr, "SKIP: CUDA unavailable\n");
+            llama_backend_free();
+            return 77;
+        }
+        auto * device = ggml_backend_reg_dev_get(registry, 0);
+        const auto * api = static_cast<const ggml_backend_cuda_kv_growth_api *>(
+                ggml_backend_reg_get_proc_address(registry, "ggml_backend_cuda_kv_growth_api"));
+        if (!api || api->version != 1 || !api->granularity || !api->granularity(ggml_backend_dev_buffer_type(device))) {
+            std::fprintf(stderr, "SKIP: CUDA KV growth VMM support unavailable\n");
+            llama_backend_free();
+            return 77;
+        }
+        const size_t page = api->granularity(ggml_backend_dev_buffer_type(device));
+        if (page > 4*1024*1024) {
+            std::fprintf(stderr, "SKIP: tied-wide fixture prefix cannot prove growth with VMM pages above 4 MiB\n");
+            llama_backend_free();
+            return 77;
+        }
+        const auto requested = argc > 2 ? std::stoul(argv[2]) : 65536ul;
+        require(requested == 8192 || requested == 65536 || requested == 131072,
+                "KV integration test context must be 8192, 65536 or 131072");
+        const bool expected_growth = requested >= 65536;
+        std::printf("KV fixture VMM_min_page=%zu requested_context=%lu expected_memory=%s quota_restore_prefix=32768_tokens\n",
+                page, requested, expected_growth ? "strict_saving" : "full_allocation_fallback");
+        const auto reference = evaluate(argv[1], device, false, uint32_t(requested));
+        const auto growing = evaluate(argv[1], device, true, uint32_t(requested));
+        const float prefill_error = compare_logits(reference, growing, reference.prefill, growing.prefill);
+        const float decode_error = compare_logits(reference, growing, reference.decode, growing.decode);
+        const float shift_error = compare_logits(reference, growing, reference.shifted, growing.shifted);
+        if (expected_growth) {
+            require(growing.initial_bytes < reference.initial_bytes, "KV growth allocated the full initial CUDA memory footprint");
+            require(growing.prefill_bytes < reference.prefill_bytes && growing.decode_bytes < reference.decode_bytes &&
+                    growing.restored_bytes < reference.restored_bytes, "KV growth/state restoration lost physical CUDA memory savings");
+        } else {
+            // At 8192 tokens the fixture's logical KV is only 8.5 MiB. Mapping
+            // prefixes plus quantization-padding tails in 2 MiB pages can cost
+            // more; the allocator must fall back to the ordinary full buffer.
+            require(growing.initial_bytes <= reference.initial_bytes && growing.prefill_bytes <= reference.prefill_bytes &&
+                    growing.decode_bytes <= reference.decode_bytes && growing.restored_bytes <= reference.restored_bytes,
+                    "small-context KV fallback used more physical memory than ordinary allocation");
+        }
+        std::printf("PASS KV off/on context=%u tokens=320+16 max_prefill_abs=%.9g max_decode_abs=%.9g max_kshift_abs=%.9g greedy_top1=identical state_replays=bitwise\n",
+                growing.context, prefill_error, decode_error, shift_error);
+        quota_denied_restore(argv[1], device);
+        llama_backend_free();
+        return 0;
+    } catch (const std::exception & error) {
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        llama_backend_free();
+        return 1;
+    }
+}
