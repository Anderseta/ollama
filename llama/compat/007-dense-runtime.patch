--- /dev/null
+++ b/src/llama-kv-growth.h
@@ -0,0 +1,99 @@
+#pragma once
+#include "ggml-cuda-kv-growth.h"
+#include "ggml-alloc.h"
+#include "ggml-backend.h"
+#include "ggml-cpp.h"
+#include "llama-impl.h"
+#include <cerrno>
+#include <cstdlib>
+#include <cstring>
+#include <algorithm>
+#include <stdexcept>
