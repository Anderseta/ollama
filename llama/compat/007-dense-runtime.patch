diff --git a/ggml/src/ggml-cuda/kv-growth.cuh b/ggml/src/ggml-cuda/kv-growth.cuh
new file mode 100644
index 0000000..ab3cceb
--- /dev/null
+++ b/ggml/src/ggml-cuda/kv-growth.cuh
@@ -0,0 +1,105 @@
+#pragma once
+
+// Included after the shared CUDA allocation policy, before device buffers.
+struct ggml_cuda_kv_vmm {
+    int device;
+    size_t capacity, granularity;
+    uintptr_t address = 0;
+    struct mapping { size_t offset, size; bool tracked; };
+    std::vector<mapping> mappings;
+    std::vector<uint8_t> pages;
+    std::mutex mutex;
+    uint8_t fill = 0;
+
+    ggml_cuda_kv_vmm(int device, size_t capacity, size_t granularity) :
+        device(device), capacity(capacity), granularity(granularity), pages(capacity/granularity, 0) {}
+
+    ~ggml_cuda_kv_vmm() {
+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+        if (!address) { return; }
+        ggml_cuda_set_device(device);
+        size_t tracked = 0, untracked = 0;
+        for (const auto & m : mappings) {
+            CU_CHECK(cuMemUnmap(address+m.offset, m.size));
+            if (m.tracked) { tracked += m.size; } else { ++untracked; }
+        }
+        CU_CHECK(cuMemAddressFree(address, capacity));
+        ggml_cuda_memory_release_vmm(ggml_cuda_get_physical_device(device), tracked, untracked);
+#endif
+    }
+
+    bool ensure(size_t offset, size_t size) {
+        if (offset > capacity || size > capacity-offset) { return false; }
+        if (!size) { return true; }
+#if defined(GGML_USE_VMM) && !defined(GGML_USE_HIP) && !defined(GGML_USE_MUSA)
+        std::lock_guard<std::mutex> lock(mutex);
+        const size_t first = offset/granularity, end = (offset+size+granularity-1)/granularity;
+        size_t runs = 0;
+        for (size_t i=first; i<end;) {
+            if (pages[i]) { ++i; continue; }
+            ++runs; while (i<end && !pages[i]) { ++i; }
+        }
+        try { mappings.reserve(mappings.size()+runs); } catch (...) { return false; }
+        ggml_cuda_set_device(device);
+        for (size_t i=first; i<end;) {
+            if (pages[i]) { ++i; continue; }
+            const size_t start = i;
+            while (i<end && !pages[i]) { ++i; }
+            const size_t bytes = (i-start)*granularity;
+            ggml_cuda_memory_reservation reservation(device, bytes);
+            if (!reservation.valid) { return false; }
+            CUmemAllocationProp prop = {};
+            prop.type = CU_MEM_ALLOCATION_TYPE_PINNED;
+            prop.location.type = CU_MEM_LOCATION_TYPE_DEVICE;
+            prop.location.id = ggml_cuda_get_physical_device(device);
+            CUmemGenericAllocationHandle handle = 0;
+            if (cuMemCreate(&handle, bytes, &prop, 0) != CUDA_SUCCESS) { return false; }
+            const CUdeviceptr ptr = address+start*granularity;
+            if (cuMemMap(ptr, bytes, 0, handle, 0) != CUDA_SUCCESS) { cuMemRelease(handle); return false; }
+            CUmemAccessDesc access = {};
+            access.location = prop.location; access.flags = CU_MEM_ACCESS_FLAGS_PROT_READWRITE;
+            if (cuMemSetAccess(ptr, bytes, &access, 1) != CUDA_SUCCESS) {
+                cuMemUnmap(ptr,bytes); cuMemRelease(handle); return false;
+            }
+            const cudaError_t zero = cudaMemsetAsync(reinterpret_cast<void *>(ptr), fill, bytes, cudaStreamPerThread);
+            const cudaError_t synced = cudaStreamSynchronize(cudaStreamPerThread);
+            if (zero != cudaSuccess || synced != cudaSuccess) {
+                cuMemUnmap(ptr,bytes); cuMemRelease(handle); (void)cudaGetLastError(); return false;
+            }
+            CU_CHECK(cuMemRelease(handle)); // the mapping retains the physical allocation
+            reservation.commit();
+            mappings.push_back({start*granularity,bytes,reservation.tracked});
+            std::fill(pages.begin()+start,pages.begin()+i,uint8_t(1));
+        }
+        return true;
+#else
+        return false;
+#endif
+    }
+
+    void clear(uint8_t value) {
+        std::lock_guard<std::mutex> lock(mutex);
+        fill = value;
+        ggml_cuda_set_device(device);
+        for (const auto & m : mappings) {
+            CUDA_CHECK(cudaMemsetAsync(reinterpret_cast<void *>(address+m.offset), value, m.size, cudaStreamPerThread));
+        }
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+    }
+    bool clear_existing(size_t offset,size_t size) {
+        if (offset>capacity || size>capacity-offset) { return false; }
+        std::lock_guard<std::mutex> lock(mutex);
+        if (fill!=0) { return false; }
+        ggml_cuda_set_device(device);
+        for (const auto & m : mappings) {
+            const size_t start=std::max(offset,m.offset), end=std::min(offset+size,m.offset+m.size);
+            if (start<end) { CUDA_CHECK(cudaMemsetAsync(reinterpret_cast<void *>(address+start),0,end-start,cudaStreamPerThread)); }
+        }
+        CUDA_CHECK(cudaStreamSynchronize(cudaStreamPerThread));
+        return true;
+    }
+    size_t committed() {
+        std::lock_guard<std::mutex> lock(mutex);
+        size_t bytes=0; for (const auto & m : mappings) { bytes+=m.size; } return bytes;
+    }
+};
