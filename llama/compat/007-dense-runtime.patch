+
+ggml_cuda_mmvq_reuse_scope::~ggml_cuda_mmvq_reuse_scope() {
+    if (!data) { return; }
+    GGML_ASSERT(mmvq_reuse_active == data);
+    mmvq_reuse_active = data->previous;
+    // ggml_cuda_pool_vmm requires exact reverse allocation order. Temporary
+    // allocations made inside individual operations have already been returned.
+    for (auto it = data->allocations.rbegin(); it != data->allocations.rend(); ++it) { it->storage.reset(); }
+    delete data;
+}
+
+void ggml_cuda_mmvq_reuse_scope::advance(int last_node) {
+    if (!data) { return; }
+    // Return completed intervals as soon as LIFO permits. The final consumer's
+    // kernels precede any reuse on this same stream, including graph capture.
+    while (!data->allocations.empty() && data->allocations.back().last <= last_node) {
+        const auto & allocation = data->allocations.back();
+        data->bytes -= allocation.bytes;
+        data->inputs.at(allocation.input).quantized = nullptr;
+        data->allocations.pop_back();
+    }
+}
+
+static char * mmvq_reuse_input(ggml_backend_cuda_context & ctx, const ggml_tensor * input,
+                               size_t bytes, bool & fresh) {
+    auto * scope = mmvq_reuse_active;
+    if (!scope || scope->context != &ctx || ctx.curr_stream_no != 0) { return nullptr; }
+    const auto found = scope->inputs.find(input);
+    if (found == scope->inputs.end()) { return nullptr; }
+    if (found->second.quantized) {
+        fresh = false;
+        ggml_cuda_dense_trace(ggml_cuda_dense_event::reuse, input);
+        return found->second.quantized;
+    }
+    constexpr size_t budget = 4 * 1024 * 1024;
+    if (bytes > budget - scope->bytes) { return nullptr; }
+    auto allocation = std::make_unique<ggml_cuda_pool_alloc<char>>(ctx.pool(), bytes);
+    char * result = allocation->get();
+    scope->allocations.push_back({input, found->second.last, bytes, std::move(allocation)});
+    scope->bytes += bytes;
+    found->second.quantized = result;
+    ggml_cuda_dense_trace(ggml_cuda_dense_event::quantize, input);
+    return result;
