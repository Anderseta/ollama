+
+inline uint32_t llama_kv_growth_initial() {
+    const char * raw=std::getenv("WILDLLAMA_KV_CACHE_INITIAL_TOKENS");
+    if (!raw || !*raw || !std::strcmp(raw,"0")) { return 0; }
+    char * end=nullptr; errno=0;
+    const unsigned long long value=std::strtoull(raw,&end,10);
+    if (errno || !end || *end || *raw=='-' || value<256 || value>2097152) {
+        throw std::runtime_error("kv_cache_initial_tokens must be 0 or 256..2097152");
+    }
+    return uint32_t(value);
+}
+
+inline const ggml_backend_cuda_kv_growth_api * llama_kv_growth_api(ggml_backend_buffer_type_t buft) {
+    auto * dev=ggml_backend_buft_get_device(buft);
+    if (!dev) { return nullptr; }
+    auto * reg=ggml_backend_dev_backend_reg(dev);
+    const auto * api=static_cast<const ggml_backend_cuda_kv_growth_api *>(
+        ggml_backend_reg_get_proc_address(reg,"ggml_backend_cuda_kv_growth_api"));
+    return api && api->version==1 && api->granularity(buft) ? api : nullptr;
+}
+
+inline ggml_backend_buffer_t llama_kv_growth_alloc(ggml_context * ctx,ggml_backend_buffer_type_t buft,
+        const ggml_backend_cuda_kv_growth_api * api,uint32_t initial) {
+    const size_t total=ggml_backend_alloc_ctx_tensors_from_buft_size(ctx,buft);
+    ggml_backend_buffer_ptr buffer(api->reserve(buft,total));
+    if (!buffer) { throw std::runtime_error("KV growth: cannot reserve CUDA virtual addresses"); }
+    auto allocator=ggml_tallocr_new(buffer.get());
+    for (auto * t=ggml_get_first_tensor(ctx);t;t=ggml_get_next_tensor(ctx,t)) {
+        if (!t->data) {
+            const auto result=t->view_src ? ggml_backend_view_init(t) : ggml_tallocr_alloc(&allocator,t);
+            if (result!=GGML_STATUS_SUCCESS) { throw std::runtime_error("KV growth: tensor layout allocation failed"); }
+        } else if (t->view_src && !t->buffer && ggml_backend_view_init(t)!=GGML_STATUS_SUCCESS) {
+            throw std::runtime_error("KV growth: tensor view initialization failed");
+        }
+    }
+    auto * base=static_cast<uint8_t *>(ggml_backend_buffer_get_base(buffer.get()));
+    for (auto * t=ggml_get_first_tensor(ctx);t;t=ggml_get_next_tensor(ctx,t)) {
+        if (t->view_src) { continue; }
+        if (t->ne[2]!=1 || t->ne[3]!=1 || initial>uint64_t(t->ne[1]) ||
+            !api->commit(buffer.get(),static_cast<uint8_t *>(t->data)-base,t->nb[1]*initial)) {
+            throw std::runtime_error("KV growth: initial physical allocation denied");
+        }
+    }
+    return buffer.release();
+}
+
+inline size_t llama_kv_growth_estimate(ggml_context * ctx,ggml_backend_buffer_type_t buft,
+        const ggml_backend_cuda_kv_growth_api * api,uint32_t initial) {
+    const size_t alignment=ggml_backend_buft_get_alignment(buft),gran=api->granularity(buft);
+    std::vector<std::pair<size_t,size_t>> ranges;
+    size_t offset=0,total=0;
+    auto add=[&](size_t start,size_t size) {
+        if (!size) { return; }
+        if (start>SIZE_MAX-size || start+size>SIZE_MAX-(gran-1)) { throw std::runtime_error("KV growth estimate overflow"); }
+        ranges.emplace_back(start/gran*gran,GGML_PAD(start+size,gran));
+    };
+    for (auto * t=ggml_get_first_tensor(ctx);t;t=ggml_get_next_tensor(ctx,t)) {
+        if (t->view_src) { continue; }
+        const size_t allocated=ggml_backend_buft_get_alloc_size(buft,t), actual=ggml_nbytes(t);
+        add(offset,t->nb[1]*initial);
+        // CUDA initializes quantized tensor tail padding even before use.
+        // Include those scattered pages, not only the initial KV prefixes.
+        if (allocated>actual) { add(offset+actual,allocated-actual); }
+        offset+=GGML_PAD(allocated,alignment);
+    }
+    std::sort(ranges.begin(),ranges.end());
+    size_t previous_end=0;
+    for (const auto & range:ranges) {
+        if (range.second>previous_end) { total+=range.second-std::max(previous_end,range.first); }
+        previous_end=std::max(previous_end,range.second);
+    }
+    return total;
+}
+
+inline void llama_kv_growth_clear(ggml_tensor * tensor,size_t offset,size_t size) {
+    auto * buffer=tensor->buffer;
+    if (buffer) {
+        const auto * api=llama_kv_growth_api(ggml_backend_buffer_get_type(buffer));
+        if (api && api->clear_existing) {
+            const uintptr_t base=reinterpret_cast<uintptr_t>(ggml_backend_buffer_get_base(buffer));
+            const uintptr_t address=reinterpret_cast<uintptr_t>(tensor->data);
+            if (address>=base && address-base<=SIZE_MAX-offset && api->clear_existing(buffer,address-base+offset,size)) { return; }
+        }
+    }
+    llama_clear_tensor_data(tensor,offset,size);
+}
