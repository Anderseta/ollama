+// This points to an execution scope, not a persistent pointer/value cache. A nested
+// backend evaluation restores its caller, and each new capture starts empty.
+static thread_local ggml_cuda_mmvq_reuse_scope::state * mmvq_reuse_active = nullptr;
+
+ggml_cuda_mmvq_reuse_scope::ggml_cuda_mmvq_reuse_scope(
+        ggml_backend_cuda_context & ctx, const ggml_cgraph * graph, bool concurrent) : data(nullptr) {
+    if (!ggml_cuda_dense_opt_enabled() || concurrent || ctx.curr_stream_no != 0) { return; }
+    const auto plans = ggml_cuda_dense_plan_inputs(graph);
+    if (plans.empty()) { return; }
+    auto scope = std::make_unique<state>();
+    scope->context = &ctx;
+    scope->previous = mmvq_reuse_active;
+    for (const auto & plan : plans) { scope->inputs.emplace(plan.input, state::input{nullptr, plan.last}); }
+    data = scope.release();
+    mmvq_reuse_active = data;
