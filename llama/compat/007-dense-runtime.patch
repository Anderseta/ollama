+@pytest.mark.parametrize("thinking", [False, True])
+def test_apply_template_exact_text_token_count(thinking: bool):
+    server.jinja = True
+    server.chat_template_file = '../../../models/templates/Qwen-Qwen3-0.6B.jinja'
+    server.start()
+    body = {
+        "messages": [{"role": "user", "content": "Text with </s> and Unicode: árvore."}],
+        "chat_template_kwargs": {"enable_thinking": thinking},
+    }
+    plain = server.make_request("POST", "/apply-template", data=body)
+    counted = server.make_request("POST", "/apply-template", data={**body, "count_tokens": True})
+    assert plain.status_code == counted.status_code == 200
+    assert "token_count" not in plain.body
+    assert counted.body["prompt"] == plain.body["prompt"]
+    tokenized = server.make_request("POST", "/tokenize", data={
+        "content": counted.body["prompt"], "add_special": True, "parse_special": True,
+    })
+    assert tokenized.status_code == 200
+    assert counted.body["token_count"] == len(tokenized.body["tokens"])
