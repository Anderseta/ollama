--- /dev/null
+++ b/ggml/include/ggml-cuda-kv-growth.h
@@ -0,0 +1,16 @@
+#pragma once
+#include "ggml-backend.h"
+#include <stdint.h>
+
+// Optional CUDA VMM storage. Logical buffer size/address stay fixed; only mapped
+// physical pages consume the existing CUDA allocation quota. Never host-paged.
+struct ggml_backend_cuda_kv_growth_api {
+    uint32_t version;
+    size_t (*granularity)(ggml_backend_buffer_type_t);
+    ggml_backend_buffer_t (*reserve)(ggml_backend_buffer_type_t, size_t);
+    bool (*commit)(ggml_backend_buffer_t, size_t, size_t);
+    size_t (*committed)(ggml_backend_buffer_t);
+    // Zero mapped bytes without allocating missing pages (whose logical value
+    // is already zero). False for conventional storage or nonzero lazy fill.
+    bool (*clear_existing)(ggml_backend_buffer_t, size_t, size_t);
+};
diff --git a/ggml/src/ggml-cuda/dense-reuse.h b/ggml/src/ggml-cuda/dense-reuse.h
new file mode 100644
index 0000000..f94107b
--- /dev/null
+++ b/ggml/src/ggml-cuda/dense-reuse.h
@@ -0,0 +1,104 @@
+#pragma once
+
+#include "ggml.h"
+
+#include <cstdint>
+#include <atomic>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <limits>
+#include <unordered_map>
+#include <vector>
+
+// Independent of the MoE runtime. Set before backend initialization for an ablation.
+inline bool ggml_cuda_dense_opt_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_CUDA_DENSE_OPT");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
+
+enum class ggml_cuda_dense_event { quantize, reuse, norm_silu };
+
+inline void ggml_cuda_dense_trace(ggml_cuda_dense_event event, const ggml_tensor * tensor) {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_CUDA_DENSE_TRACE");
+        return value && std::strcmp(value, "1") == 0;
+    }();
+    if (!enabled) { return; }
+    static std::atomic<unsigned> counts[3]{};
+    const auto index = static_cast<unsigned>(event);
+    if (counts[index].load(std::memory_order_relaxed) >= 4) { return; }
+    const auto count = counts[index].fetch_add(1, std::memory_order_relaxed) + 1;
+    if (count <= 4) {
+        static const char * names[] = {"shared-input-quantize", "shared-input-reuse", "norm-gamma-silu"};
+        std::fprintf(stderr, "cuda_dense: %s count=%u tensor=%s shape=[%lld,%lld,%lld,%lld]\n",
+            names[index], count, tensor->name,
+            (long long) tensor->ne[0], (long long) tensor->ne[1],
+            (long long) tensor->ne[2], (long long) tensor->ne[3]);
+    }
+}
+
+struct ggml_cuda_dense_input_plan {
+    const ggml_tensor * input;
+    int first;
+    int last;
+    unsigned consumers;
+};
+
+inline bool ggml_cuda_dense_no_write(const ggml_tensor * node) {
+    return ggml_is_empty(node) || node->op == GGML_OP_NONE || node->op == GGML_OP_VIEW ||
+           node->op == GGML_OP_RESHAPE || node->op == GGML_OP_TRANSPOSE || node->op == GGML_OP_PERMUTE;
+}
+
+inline bool ggml_cuda_dense_overlap(const ggml_tensor * a, const ggml_tensor * b) {
+    if (!a->data || !b->data) { return true; }
+    const auto x = reinterpret_cast<uintptr_t>(a->data), y = reinterpret_cast<uintptr_t>(b->data);
+    const size_t nx = ggml_nbytes(a), ny = ggml_nbytes(b);
+    if (x > std::numeric_limits<uintptr_t>::max() - nx ||
+        y > std::numeric_limits<uintptr_t>::max() - ny) { return true; }
+    return x < y + ny && y < x + nx;
+}
+
+// Tensor identity is a value version within this graph, unlike an allocator address.
+// Reject intervening writes, including in-place operations, before sharing a value.
+inline std::vector<ggml_cuda_dense_input_plan> ggml_cuda_dense_plan_inputs(const ggml_cgraph * graph) {
+    std::vector<ggml_cuda_dense_input_plan> plans;
+    std::unordered_map<const ggml_tensor *, size_t> inputs;
+    // These public accessors predate const-correct graph views.
+    auto * view = const_cast<ggml_cgraph *>(graph);
+    for (int i = 0; i < ggml_graph_n_nodes(view); ++i) {
+        const auto * node = ggml_graph_node(view, i);
+        if (node->op == GGML_OP_CUSTOM || node->op == GGML_OP_MAP_CUSTOM1 ||
+            node->op == GGML_OP_MAP_CUSTOM2 || node->op == GGML_OP_MAP_CUSTOM3 ||
+            node->op == GGML_OP_OPT_STEP_ADAMW || node->op == GGML_OP_OPT_STEP_SGD) { return {}; }
+        if (node->op != GGML_OP_MUL_MAT || !node->src[0] || !node->src[1]) { continue; }
+        const auto * weight = node->src[0];
+        const auto * input = node->src[1];
+        if (weight->type != GGML_TYPE_Q8_0 || input->type != GGML_TYPE_F32 ||
+            weight->ne[0] != input->ne[0] || weight->ne[2] != 1 || weight->ne[3] != 1 ||
+            input->ne[0] <= 0 || input->ne[1] <= 0 || input->ne[1] > 8 ||
+            input->ne[2] != 1 || input->ne[3] != 1 || !ggml_is_contiguous(input)) { continue; }
+        const auto inserted = inputs.emplace(input, plans.size());
+        if (inserted.second) {
+            plans.push_back({input, i, i, 1});
+        } else {
+            auto & plan = plans[inserted.first->second];
+            plan.last = i;
+            ++plan.consumers;
+        }
+    }
+    std::vector<ggml_cuda_dense_input_plan> safe;
+    for (const auto & plan : plans) {
+        if (plan.consumers < 2) { continue; }
+        bool immutable = true;
+        for (int i = plan.first; immutable && i <= plan.last; ++i) {
+            const auto * node = ggml_graph_node(view, i);
+            immutable = ggml_cuda_dense_no_write(node) || !ggml_cuda_dense_overlap(plan.input, node);
+        }
+        if (immutable) { safe.push_back(plan); }
+    }
+    return safe;
+}
