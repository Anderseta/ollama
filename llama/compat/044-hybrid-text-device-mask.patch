+static size_t mask_ops=0,cuda_mask_ops=0,cuda_attention=0,cpu_attention=0;
+static bool observe(ggml_tensor * t,bool ask,void *) {
+    if(t->op!=GGML_OP_ATTN_MASK && t->op!=GGML_OP_FLASH_ATTN_EXT && t->op!=GGML_OP_SOFT_MAX)return false;
+    if(ask)return true;
+    const bool host=t->buffer && ggml_backend_buffer_is_host(t->buffer);
+    bool cuda=false;
+    if(!host && t->buffer) {
+        const auto device=ggml_backend_buft_get_device(ggml_backend_buffer_get_type(t->buffer));
+        const auto reg=device ? ggml_backend_dev_backend_reg(device) : nullptr;
+        cuda=reg && std::strcmp(ggml_backend_reg_name(reg),"CUDA")==0;
+    }
+    if(t->op==GGML_OP_ATTN_MASK){++mask_ops;if(cuda)++cuda_mask_ops;}
+    else {if(cuda)++cuda_attention;else if(host)++cpu_attention;}
+    return true;
+}
+static llama_context_ptr mask_context(llama_model * model,bool use_compact,bool flash) {
+    compact(use_compact);
+    auto p=llama_context_default_params();
+    p.n_ctx=2048;p.n_batch=512;p.n_ubatch=512;p.n_seq_max=1;p.kv_unified=true;
+    p.n_rs_seq=2;p.n_threads=p.n_threads_batch=1;p.op_offload=gpu;p.offload_kqv=gpu;
+    p.flash_attn_type=flash ? LLAMA_FLASH_ATTN_TYPE_ENABLED : LLAMA_FLASH_ATTN_TYPE_DISABLED;
+    p.cb_eval=observe;
+    llama_context_ptr ctx(llama_init_from_model(model,p));
+    require(bool(ctx),"cannot create hybrid mask context");
+    require(dynamic_cast<llama_memory_hybrid *>(llama_get_memory(ctx.get())),"test model is not hybrid");
+    return ctx;
+}
+static std::vector<float> mask_decode(llama_context * ctx,int n,int start,bool use_compact,bool expect_mask,bool media=false) {
+    compact(use_compact);
+    std::vector<llama_token> tokens(n);std::vector<float> embeddings(size_t(n)*128,0.01f);
+    std::vector<llama_pos> positions(size_t(n)*(media ? 4 : 1));
+    std::vector<int32_t> nseq(n,1);std::vector<llama_seq_id> sid(n,0);
+    std::vector<llama_seq_id *> ids(n);std::vector<int8_t> logits(n,1);
+    for(int i=0;i<n;++i){tokens[i]=3+(i*13+start)%256;positions[i]=start+i;ids[i]=&sid[i];}
+    if(media)for(int j=1;j<4;++j)for(int i=0;i<n;++i)positions[size_t(j)*n+i]=j==3 ? 0 : (start+i)/2;
+    llama_batch batch{};batch.n_tokens=n;batch.token=media ? nullptr : tokens.data();
+    batch.embd=media ? embeddings.data() : nullptr;batch.pos=positions.data();batch.n_seq_id=nseq.data();
+    batch.seq_id=ids.data();batch.logits=logits.data();
+    mask_ops=cuda_mask_ops=cuda_attention=cpu_attention=0;
+    require(llama_decode(ctx,batch)==0,"hybrid mask decode failed");
+    require(expect_mask ? (mask_ops>0 && cuda_mask_ops==mask_ops) : mask_ops==0,"hybrid compact/fallback execution wrong");
+    if(expect_mask)require(cuda_attention>0 && cpu_attention==0,"hybrid compact attention silently used CPU");
+    const auto * values=llama_get_logits(ctx);require(values,"hybrid mask logits missing");
+    const int vocab=llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)));
+    std::printf("HYBRID_MASK n=%d pos=%d media=%d ops=%zu cuda_mask=%zu cuda_attention=%zu cpu_attention=%zu\n",
+        n,start,media,mask_ops,cuda_mask_ops,cuda_attention,cpu_attention);
+    return {values,values+size_t(n)*vocab};
+}
+static void equal_mask(const std::vector<float> & a,const std::vector<float> & b,const char * tag) {
+    require(a.size()==b.size(),"hybrid mask logits changed shape");
+    float maximum=0;
+    for(size_t i=0;i<a.size();++i){require(std::isfinite(a[i])&&std::isfinite(b[i]),"nonfinite hybrid mask logits");maximum=std::max(maximum,std::abs(a[i]-b[i])/(1+std::abs(a[i])));}
+    require(maximum<=1e-5f,"hybrid compact mask changed logits");
+    std::printf("HYBRID_MASK_LOGITS stage=%s elements=%zu max_scaled=%.9g\n",tag,a.size(),maximum);
+}
