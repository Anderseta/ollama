+static void position_proof() {
+    size_t checks=0;
+    for (const int32_t p : {0,1,2,17,1024,INT_MAX}) {
+        require(llama_device_mask_text_query(4,0,p,p,p,0),"aligned M-RoPE text query rejected");
+        require(llama_device_mask_text_query(3,0,p,p,p,31),"three-section query rejected");
+        require(!llama_device_mask_text_query(2,0,p,p,p,0),"unknown position layout admitted");
+        require(!llama_device_mask_text_query(4,1,p,p,p,0),"PLE query admitted");
+        require(!llama_device_mask_text_query(4,0,p,p,p,1),"nonzero fourth position admitted");
+        if(p)require(!llama_device_mask_text_query(4,0,p,0,0,0),"neutral query can mask aligned equal-p cached key");
+        const int32_t changed=p==INT_MAX ? p-1 : p+1;
+        require(!llama_device_mask_text_query(4,0,p,changed,p,0),"spatial x query admitted");
+        require(!llama_device_mask_text_query(4,0,p,p,changed,0),"spatial y query admitted");
+        for(const int32_t k : {0,1,2,17,1024,INT_MAX}) {
+            for(const bool neutral : {false,true}) {
+                const int32_t x=neutral ? 0 : k,y=x;
+                require(llama_device_mask_text_key(0,3,k,x,y),"token-backed text key rejected");
+                const bool host=k<=p && !(k==p && ((y>p)||(y==p && x>p)));
+                const bool device=k<=p;
+                require(host==device,"admitted text proof changes equal-position causal visibility");
+                ++checks;
+            }
+        }
+        require(!llama_device_mask_text_key(0,LLAMA_TOKEN_NULL,p,p,p),"embedding/media key admitted");
+        require(!llama_device_mask_text_key(1,3,p,p,p),"PLE key admitted");
+        require(!llama_device_mask_text_key(0,3,p,changed,p),"spatial cached key admitted");
+    }
+    require(!llama_device_mask_text_query(4,0,-1,-1,-1,0),"negative query admitted");
+    require(!llama_device_mask_text_key(0,3,-1,0,0),"negative key admitted");
+    // Concrete counterexample to using the prefix-retention helper alone.
+    require(llama_prefix_text_cell(4,0,llama_kv_cell_ext{7,7,3},7),"retention control rejected aligned text");
+    require(llama_kv_cell_ext{7,7,3}.is_2d_gt(0,0),"equal-p counterexample invalid");
+    require(!llama_device_mask_text_query(4,0,7,0,0,0),"equal-p neutral query counterexample admitted");
+    std::printf("MROPE_TEXT_PROOF exact_visibility=%zu unsupported_media_spatial_ple_negative PASS\n",checks);
+}
