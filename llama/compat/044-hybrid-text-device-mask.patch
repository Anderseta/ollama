+        for(auto * ctx : {reference.get(),candidate.get()})llama_set_causal_attn(ctx,true);
+        pair(512,0,true,"hybrid-causal-reentry");
+        for(auto * ctx : {reference.get(),candidate.get()}) {
+            auto * mem=dynamic_cast<llama_memory_hybrid *>(llama_get_memory(ctx));
+            auto & cells=const_cast<llama_kv_cells &>(mem->get_mem_attn()->get_cells(0));
+            const auto index=cells.seq_pos_get(0).begin()->second;
+            auto ext=cells.ext_get(index);ext.tok=LLAMA_TOKEN_NULL;cells.ext_set(index,ext);
+        }
+        pair(512,512,false,"hybrid-cached-media-fallback");
+        clear();pair(512,0,true,"hybrid-cache-reset-reentry");
+        for(auto * ctx : {reference.get(),candidate.get()}) {
+            auto * mem=dynamic_cast<llama_memory_hybrid *>(llama_get_memory(ctx));
+            auto & cells=const_cast<llama_kv_cells &>(mem->get_mem_attn()->get_cells(0));
+            const auto index=cells.seq_pos_get(0).begin()->second;
+            auto ext=cells.ext_get(index);ext.x=1;ext.y=0;cells.ext_set(index,ext);
+        }
+        pair(512,512,false,"hybrid-cached-spatial-fallback");
+        clear();pair(512,0,false,"hybrid-media-query-fallback",true);
+        pair(512,512,false,"hybrid-text-after-media-fallback");
+        std::printf("HYBRID_MASK_GRAPH backend=%s flash=%d actual_positive_media_negative PASS\n",gpu ? "CUDA" : "CPU-fallback",flash);
+    }
+    compact(false);
+}
+int main(int argc,char ** argv) {
+    try {
+        std::setvbuf(stdout,nullptr,_IONBF,0);
+        gpu=argc>1 && std::strcmp(argv[1],"--cuda")==0;
+        const std::string dir=argc>(gpu ? 2 : 1) ? argv[gpu ? 2 : 1] : ".";
+        ggml_backend_load_all();
+        if(gpu && !ggml_backend_dev_by_type(GGML_BACKEND_DEVICE_TYPE_GPU))return 77;
+        position_proof();
+        graph_tests(dir);
+        return 0;
+    } catch(const std::exception & e){std::fprintf(stderr,"FAIL: %s\n",e.what());return 1;}
+}
