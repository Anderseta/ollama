+static void llama_sampler_penalties_apply(struct llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_penalties *) smpl->ctx;
+    if (ctx->is_disabled()) {
+        return;
+    }
+    if (ctx->token_count.empty()) {
+        cur_p->sorted = false;
+        return;
+    }
+    if (ctx->n_vocab <= 0 || cur_p->size != (size_t) ctx->n_vocab ||
+            ctx->token_count.size() > cur_p->size - cur_p->size / 4) {
+        llama_sampler_penalties_apply_general(smpl, cur_p);
+        return;
+    }
+
+    // Prove a canonical prefix before updating its sparse history rows.
+    // Reordered or duplicate-ID candidates keep the original loop in the suffix.
+    size_t canonical_end = 0;
+    for (; canonical_end < cur_p->size && cur_p->data[canonical_end].id == (llama_token) canonical_end; ++canonical_end) {}
+    if (canonical_end == 0 || (canonical_end < cur_p->size && ctx->token_count.size() > cur_p->size / 8)) {
+        llama_sampler_penalties_apply_general(smpl, cur_p);
+        return;
+    }
+    for (const auto & entry : ctx->token_count) {
+        if (entry.first < 0 || (size_t) entry.first >= canonical_end) {
+            continue;
+        }
+        auto & candidate = cur_p->data[entry.first];
+        const int count = entry.second;
+        assert(count > 0 && count <= ctx->penalty_last_n);
+        if (candidate.logit <= 0) {
+            candidate.logit *= ctx->penalty_repeat;
+        } else {
+            candidate.logit /= ctx->penalty_repeat;
+        }
+        candidate.logit -= float(count) * ctx->penalty_freq + float(count > 0) * ctx->penalty_present;
+    }
+    if (canonical_end < cur_p->size) {
+        auto suffix = *cur_p;
+        suffix.data += canonical_end;
+        suffix.size -= canonical_end;
+        llama_sampler_penalties_apply_general(smpl, &suffix);
+    }
     cur_p->sorted = false;
 }
 
