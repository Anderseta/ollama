+static bool fail_allocation = false;
+void * operator new(size_t size) {
+    if (fail_allocation) { throw std::bad_alloc(); }
+    if (void * p = std::malloc(size ? size : 1)) { return p; }
+    throw std::bad_alloc();
+}
+void operator delete(void * p) noexcept { std::free(p); }
+void operator delete(void * p, size_t) noexcept { std::free(p); }
+
+static void require(bool value, const char * message) {
+    if (!value) { throw std::runtime_error(message); }
+}
+static float linear(const std::vector<llama_token_data> & q, llama_token token) {
+    for (const auto & item : q) { if (item.id == token) { return item.p; } }
+    return 0.f;
+}
+static bool same_bits(float a, float b) { return std::memcmp(&a, &b, sizeof(float)) == 0; }
+
+int main() {
+    try {
+        std::vector<uint32_t> workspace;
+        std::vector<llama_token_data> q;
+        for (int i = 0; i < 1024; ++i) { q.push_back({(i * 97) % 2048 - 1024, 0.f, float(i) / 1024.f}); }
+        q[1].p = -0.f;
+        q[2].p = std::numeric_limits<float>::quiet_NaN();
+        q[3].p = std::numeric_limits<float>::infinity();
+        q.push_back({q[1].id, 0.f, .7f});
+        q.push_back({q[2].id, 0.f, .8f});
+        const common_sampling_probability_index indexed(q.data(), q.size(), 2048, workspace);
+        require(indexed.indexed(), "large support did not index");
+        for (int id = -2048; id <= 2048; ++id) {
+            require(same_bits(indexed.probability(id), linear(q, id)), "lookup changed probability bits or first duplicate");
+        }
+        for (llama_token id : {std::numeric_limits<llama_token>::min(), std::numeric_limits<llama_token>::max()}) {
+            require(same_bits(indexed.probability(id), linear(q, id)), "extreme token lookup changed");
+        }
+        const auto * storage = workspace.data();
+        const auto capacity = workspace.capacity();
+        const common_sampling_probability_index reused(q.data(), q.size(), 2048, workspace);
+        require(workspace.data() == storage && workspace.capacity() == capacity, "warm lookup allocated workspace");
+        require(!common_sampling_probability_index(q.data(), 20, 2048, workspace).indexed(), "small support unnecessarily indexed");
+        require(!common_sampling_probability_index(q.data(), q.size(), 20, workspace).indexed(), "few queries unnecessarily indexed");
+        // A rejected oversize index must not read the hypothetical input.
+        require(!common_sampling_probability_index(nullptr, common_sampling_probability_index::max_entries + 1, 2048, workspace).indexed(),
+                "oversize support exceeded bounded workspace");
+        std::vector<uint32_t> empty;
+        fail_allocation = true;
+        const common_sampling_probability_index fallback(q.data(), q.size(), 2048, empty);
+        fail_allocation = false;
+        require(!fallback.indexed() && same_bits(fallback.probability(q[1].id), q[1].p), "allocation failure did not retain linear fallback");
+
+        q.clear();
+        constexpr size_t count = 8192;
+        for (size_t i = 0; i < count; ++i) { q.push_back({llama_token((i * 97) % count), 0.f, float(i % 7) / float(8 * count)}); }
+        const common_sampling_probability_index residual_index(q.data(), q.size(), count, workspace);
+        std::vector<llama_token_data> old_residual, new_residual;
+        float old_sum = 0.f, new_sum = 0.f;
+        for (size_t k = 0; k < count; ++k) {
+            const float p = float(k % 11) / float(9 * count);
+            const float a = p - linear(q, llama_token(k));
+            const float b = p - residual_index.probability(llama_token(k));
+            if (a > 0.f) { old_residual.push_back({llama_token(k), 0.f, a}); old_sum += a; }
+            if (b > 0.f) { new_residual.push_back({llama_token(k), 0.f, b}); new_sum += b; }
+        }
+        require(same_bits(old_sum, new_sum) && old_residual.size() == new_residual.size() &&
+                std::memcmp(old_residual.data(), new_residual.data(), old_residual.size() * sizeof(llama_token_data)) == 0,
+                "residual order or arithmetic changed");
+        std::mt19937 old_rng(424242), new_rng(424242);
+        auto sample = [](const std::vector<llama_token_data> & residual, float sum, std::mt19937 & rng) {
+            std::uniform_real_distribution<float> uniform(0.f, 1.f);
+            float u = uniform(rng) * sum;
+            for (const auto & item : residual) { u -= item.p; if (u <= 0.f) { return item.id; } }
+            return residual.back().id;
+        };
+        for (int i = 0; i < 4096; ++i) {
+            require(sample(old_residual, old_sum, old_rng) == sample(new_residual, new_sum, new_rng), "residual token changed");
+        }
+        require(old_rng == new_rng, "residual RNG state changed");
+
+        // Component benchmark includes rebuilding the index each rejection,
+        // with retained storage as on a warm sampler; it is not model tokens/s.
+        volatile float checksum = 0.f;
+        auto measure = [&](bool use_index) {
+            const auto begin = std::chrono::steady_clock::now();
+            for (int repeat = 0; repeat < 3; ++repeat) {
+                if (use_index) {
+                    const common_sampling_probability_index index(q.data(), q.size(), count, workspace);
+                    for (size_t k = 0; k < count; ++k) { checksum += index.probability(llama_token(k)); }
+                } else {
+                    for (size_t k = 0; k < count; ++k) { checksum += linear(q, llama_token(k)); }
+                }
+            }
+            return std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
+        };
+        const auto old_ms = measure(false), new_ms = measure(true);
+        std::printf("PASS: 4097 bit-exact lookups, duplicates/nonfinite/extreme IDs, allocation fallback, bounded warm reuse, 4096 residual draws and RNG\n");
+        std::printf("BENCH: 8192-support x 8192 lookups, 3 repeats including index sort: linear=%.3f ms indexed=%.3f ms workspace=%zu bytes checksum=%f\n",
+                    old_ms, new_ms, workspace.capacity() * sizeof(uint32_t), double(checksum));
+        return 0;
+    } catch (const std::exception & error) {
+        fail_allocation = false;
+        std::fprintf(stderr, "FAIL: %s\n", error.what());
+        return 1;
+    }
+}
