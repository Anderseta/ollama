+#pragma once
+
+#include "llama.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <new>
+#include <numeric>
+#include <vector>
+
+// A rejection residual repeatedly looks up q(token) for each target token.
+// Index only large supports. Sorting indexes (not probabilities) preserves the
+// first duplicate, all float bits and the caller's original arithmetic order.
+class common_sampling_probability_index {
+public:
+    static constexpr size_t max_entries = 262144; // at most 1 MiB of uint32_t indexes
+
+    common_sampling_probability_index(const llama_token_data * data, size_t size, size_t queries,
+                                     std::vector<uint32_t> & workspace) : data(data), size(size) {
+        if (size < 64 || queries < 64 || size > max_entries || queries <= 4096 / size) {
+            return;
+        }
+        try {
+            // Avoid vector's geometric capacity growth beyond the entry limit.
+            if (workspace.capacity() < size) {
+                std::vector<uint32_t> next(size);
+                workspace.swap(next);
+            } else {
+                workspace.resize(size);
+            }
+        } catch (const std::bad_alloc &) {
+            return; // The optimization must not make an otherwise viable sample fail.
+        }
+        std::iota(workspace.begin(), workspace.end(), uint32_t{0});
+        std::sort(workspace.begin(), workspace.end(), [data](uint32_t a, uint32_t b) {
+            return data[a].id < data[b].id || (data[a].id == data[b].id && a < b);
+        });
+        order = workspace.data();
+    }
+
+    float probability(llama_token id) const {
+        if (!order) {
+            for (size_t i = 0; i < size; ++i) {
+                if (data[i].id == id) { return data[i].p; }
+            }
+            return 0.0f;
+        }
+        const auto * found = std::lower_bound(order, order + size, id, [this](uint32_t index, llama_token token) {
+            return data[index].id < token;
+        });
+        return found != order + size && data[*found].id == id ? data[*found].p : 0.0f;
+    }
+
+    bool indexed() const { return order != nullptr; }
+
+private:
+    const llama_token_data * data;
+    const size_t size;
+    const uint32_t * order = nullptr;
+};
