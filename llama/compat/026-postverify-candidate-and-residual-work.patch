+bool llama_sampler_can_defer_candidates(const llama_sampler * sampler) {
+    if (!sampler || !sampler->iface) { return false; }
+    if (sampler->iface == &llama_sampler_chain_i) {
+        const auto * chain = static_cast<const llama_sampler_chain *>(sampler->ctx);
+        return std::all_of(chain->samplers.begin(), chain->samplers.end(), [](const llama_sampler_chain::info & entry) {
+            return llama_sampler_can_defer_candidates(entry.ptr);
+        });
+    }
+    const auto accept = sampler->iface->accept;
+    return !accept || accept == llama_sampler_empty_accept || accept == llama_sampler_dist_accept;
+}
