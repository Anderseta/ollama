+static void observe_accept(llama_sampler * sampler, llama_token token) {
+    auto * observer = static_cast<candidate_observer *>(sampler->ctx);
+    const auto * candidates = common_sampler_get_candidates(observer->sampler, false);
+    require(candidates->selected >= 0 && candidates->selected < int64_t(candidates->size) &&
+            candidates->data[candidates->selected].id == token, "accept callback observed stale candidate state");
+    if (++observer->calls == observer->fail_at) { throw std::runtime_error("expected accept failure"); }
+}
+static void backend_candidate_fallbacks(llama_model * model, common_params_sampling params) {
