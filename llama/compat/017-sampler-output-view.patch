+llama_sampler_output llama_get_sampler_output_ith_synchronized(llama_context * ctx, int32_t i) {
+    llama_sampler_output output {};
+    // Preserve the individual getter order used by common_sampler::set_logits.
+    // Internal getters borrow views/reorder outputs; they do not synchronize,
+    // sample, advance RNG, or modify sampler/grammar/controller state.
+    output.sampled_probs = ctx->get_sampled_probs_ith(i);
+    output.sampled_logits = ctx->get_sampled_logits_ith(i);
+    output.candidates = ctx->get_sampled_candidates_ith(i);
+    if (output.sampled_probs) {
+        output.sampled_probs_count = static_cast<uint32_t>(ctx->get_sampled_probs_count(i));
+    }
+    if (output.sampled_logits) {
+        output.sampled_logits_count = static_cast<uint32_t>(ctx->get_sampled_logits_count(i));
+    }
+    if (!output.sampled_probs && !output.sampled_logits) {
+        output.raw_logits = ctx->get_logits_ith(i);
+    }
+    output.candidates_count = static_cast<uint32_t>(ctx->get_sampled_candidates_count(i));
+    output.sampled_token = ctx->get_sampled_token_ith(i);
+    return output;
+}
