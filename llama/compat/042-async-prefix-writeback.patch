@@ -0,0 +1,165 @@
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstdio>
+#include <future>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+
+static std::mutex gate_mutex;
+static std::condition_variable gate_changed;
+static bool gate_open = true;
+static size_t gate_arrivals = 0;
+static std::atomic<bool> gate_timeout { false };
+static void writeback_gate() {
+    std::unique_lock<std::mutex> lock(gate_mutex);
+    ++gate_arrivals;
+    gate_changed.notify_all();
+    if (!gate_changed.wait_for(lock, std::chrono::seconds(5), [] { return gate_open; })) {
+        gate_timeout = true;
+    }
+}
+#define WILDLLAMA_STATE_WRITEBACK_TEST_GATE writeback_gate
+#include "../tools/server/server-state-writeback.h"
+
+static void require(bool value, const char * message) { if (!value) { throw std::runtime_error(message); } }
+static void close_gate() { std::lock_guard<std::mutex> lock(gate_mutex); gate_open = false; gate_arrivals = 0; }
+static void open_gate() { { std::lock_guard<std::mutex> lock(gate_mutex); gate_open = true; } gate_changed.notify_all(); }
+static void await_writer() {
+    std::unique_lock<std::mutex> lock(gate_mutex);
+    require(gate_changed.wait_for(lock, std::chrono::seconds(3), [] { return gate_arrivals > 0; }), "writer never reached test gate");
+}
+static std::vector<uint8_t> bytes(size_t size, uint8_t seed) {
+    std::vector<uint8_t> result(size);
+    for (size_t i = 0; i < size; ++i) { result[i] = uint8_t(seed + 29*i); }
+    return result;
+}
+static void exact_and_bounded(const std::filesystem::path & directory) {
+    server_state_pager pager;
+    require(pager.configure(directory, 16*1024*1024), "pager configure failed");
+    server_state_writeback writer;
+    writer.set_enabled(false);
+    auto a = bytes(1024*1024+17, 3), b = bytes(7, 8), c = bytes(11, 13), d = bytes(503, 17), e = bytes(509, 19);
+    a.reserve(2*1024*1024);
+    const auto oa=a, ob=b, oc=c, od=d, oe=e;
+    std::vector<std::vector<uint8_t> *> parts { &a,&b,&c,&d,&e };
+    const auto charge = server_state_writeback::charge(parts);
+    require(charge > 2*1024*1024, "vector capacity absent from RAM charge");
+    require(!writer.submit(pager,parts,8*1024*1024) && a==oa, "disabled writer moved input");
+    writer.set_enabled(true);
+    require(!writer.submit(pager,parts,charge-1) && a==oa && b==ob, "RAM admission bypass");
+    require(!writer.submit(pager,{&a,&a},8*1024*1024) && a==oa, "aliased vector moved twice");
+    require(!writer.submit(pager,{nullptr},8*1024*1024), "null part accepted");
+    close_gate();
+    auto pending = writer.submit(pager,parts,charge);
+    require(bool(pending), "complete writeback admission failed");
+    await_writer();
+    require(!pending->ready() && pending->resident_bytes()==charge && pending->payload_bytes()==oa.size()+ob.size()+oc.size()+od.size()+oe.size(),
+            "in-flight bytes released from accounting");
+    require(a.empty() && b.empty() && c.empty() && d.empty() && e.empty(), "vectors copied instead of moved");
+    auto x=bytes(97,21), y=bytes(99,23);
+    const auto ox=x, oy=y;
+    auto second=writer.submit(pager,{&x},4096);
+    require(bool(second), "second bounded request rejected");
+    require(!writer.submit(pager,{&y},4096) && y==oy, "two-request budget bypass");
+    open_gate(); pending->wait(); second->wait();
+    require(pending->succeeded() && pending->resident_bytes()==charge, "ready write prematurely freed charged RAM");
+    server_state_pager::handle saved;
+    require(pending->finish(parts,saved,false) && saved && pending->payload_bytes()==0, "complete disk handle not published");
+    pending.reset();
+    require(server_state_pager::load(saved,parts) && a==oa && b==ob && c==oc && d==od && e==oe,
+            "async target/draft/spec/checkpoint bytes changed");
+    server_state_pager::handle unused;
+    require(second->finish({&x},unused,true) && x==ox && !unused, "hot RAM hit reread or changed original bytes");
+    second.reset();
+    auto last=writer.submit(pager,{&y},4096);
+    require(bool(last), "completed request reservation leaked");
+    require(last->finish({&y},unused,true) && y==oy, "second admission changed bytes");
+    last.reset(); saved.reset();
+    require(pager.used()==0, "owned files/quota leaked");
+    std::puts("PASS: move-only complete components, capacity-aware RAM bound, two requests, hot RAM reuse, quota and owned cleanup");
+}
+static void failures_and_lifetime(const std::filesystem::path & directory) {
+    server_state_pager pager;
+    require(pager.configure(directory,1024), "failure pager configure failed");
+    server_state_writeback writer; writer.set_enabled(true);
+    auto a=bytes(4096,31); const auto original=a;
+    auto failed=writer.submit(pager,{&a},8192);
+    require(bool(failed), "failure test admission missing");
+    failed->wait(); require(!failed->succeeded(), "disk quota bypass");
+    server_state_pager::handle saved;
+    require(!failed->finish({&a},saved,false) && a==original && !saved && pager.used()==0,
+            "failed write discarded original RAM bytes");
+    failed.reset();
+
+    require(pager.configure(directory,1024*1024), "lifetime pager configure failed");
+    close_gate();
+    auto pending=writer.submit(pager,{&a},8192);
+    require(bool(pending), "lifetime admission missing");
+    await_writer();
+    std::promise<void> started; auto started_future=started.get_future();
+    auto disposer=std::async(std::launch::async,[held=std::move(pending), &started]() mutable { started.set_value(); held.reset(); });
+    started_future.wait();
+    require(disposer.wait_for(std::chrono::milliseconds(25))==std::future_status::timeout,
+            "state erasure freed owner while write still read its RAM");
+    open_gate(); disposer.get();
+    require(pager.used()==0, "erased request leaked its written file");
+
+    a=original; close_gate();
+    auto survivor=writer.submit(pager,{&a},8192); require(bool(survivor), "move admission missing"); await_writer();
+    auto destroyer=std::async(std::launch::async,[moved=std::move(writer)]() mutable {
+        server_state_writeback again;
+        again=std::move(moved); // transfer the live worker twice
+    });
+    require(destroyer.wait_for(std::chrono::milliseconds(25))==std::future_status::timeout,
+            "model teardown did not join outstanding writeback");
+    open_gate(); destroyer.get();
+    require(survivor->ready() && survivor->finish({&a},saved,true) && a==original,
+            "worker move/teardown invalidated surviving request");
+    survivor.reset(); require(pager.used()==0,"teardown leaked quota");
+    std::puts("PASS: failed disk admission restores vectors, erasure waits, model teardown drains, live worker move/assignment");
+}
+static void concurrent_pool(const std::filesystem::path & directory) {
+    server_state_pager pager;
+    constexpr uint64_t quota=2*1024*1024;
+    require(pager.configure(directory,quota),"concurrent pool configure failed");
+    std::promise<void> start; auto go=start.get_future().share();
+    std::vector<std::future<bool>> workers;
+    for(int worker=0;worker<4;++worker) {
+        workers.push_back(std::async(std::launch::async,[copy=pager,go,worker,quota]() mutable {
+            go.wait();
+            auto input=bytes(64*1024,uint8_t(61+worker));
+            std::vector<server_state_pager::handle> held;
+            for(int iteration=0;iteration<8;++iteration) {
+                auto saved=copy.store({&input});
+                if(copy.used()>quota) { return false; }
+                if(saved) {
+                    std::vector<uint8_t> output;
+                    if(!server_state_pager::load(saved,{&output}) || input!=output) { return false; }
+                    held.push_back(std::move(saved));
+                }
+                std::this_thread::yield();
+            }
+            return !held.empty();
+        }));
+    }
+    start.set_value();
+    for(auto & result:workers) { require(result.get(),"shared pool concurrent reserve/read/delete failed"); }
+    require(pager.used()==0,"concurrent deletes lost pool byte or entry charge");
+    std::puts("PASS: four shared-pool writers/readers concurrently reserve/delete within one disk quota");
+}
+int main(int argc,char ** argv) {
+    try {
+        require(argc==2,"absolute test directory required");
+        const std::filesystem::path directory(argv[1]);
+        require(directory.is_absolute(),"test directory must be explicit absolute path");
+        exact_and_bounded(directory);
+        failures_and_lifetime(directory);
+        concurrent_pool(directory);
+        require(!gate_timeout,"test gate timed out");
+        std::puts("state writeback: PASS"); return 0;
+    } catch(const std::exception & e) {
+        open_gate(); std::fprintf(stderr,"state writeback: FAIL: %s\n",e.what()); return 1;
+    }
+}
