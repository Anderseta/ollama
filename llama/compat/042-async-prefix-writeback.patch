+bool server_prompt_cache::finish_writeback(server_prompt_cache_state & state, bool keep_ram, bool wait) {
+    if (!state.writeback) { return true; }
+    if (!wait && !state.writeback->ready()) { return false; }
+    if (wait) { state.writeback->wait(); }
+    const bool wrote = state.writeback->succeeded();
+    try {
+        const bool result = state.writeback->finish(state.buffers(), state.backing, keep_ram);
+        state.writeback.reset();
+        state.writeback_failed = !wrote;
+        return result;
+    } catch (...) { return false; }
+}
+
+void server_prompt_cache::collect_writebacks() {
+    if (!pager.enabled() || !writer.is_enabled()) { return; }
+    for (auto & state : states) {
+        // Keep successful prewrites in RAM until pressure actually needs their
+        // bytes. A hot hit must not become an avoidable SSD read.
+        if (state.writeback && state.writeback->ready() && !state.writeback->succeeded()) {
+            finish_writeback(state, false, false);
+        }
+    }
+}
+
+void server_prompt_cache::queue_writebacks() {
+    // Prewrite only near RAM pressure. In-flight vectors stay in size(), and
+    // removing a pending entry waits for its owner before releasing that charge.
+    // No separate RAM allowance or implicit cache directory is introduced.
+    if (!pager.enabled() || !writer.is_enabled() || !limit_size) { return; }
+    size_t current = size();
+    if (current < limit_size - limit_size/4) { return; }
+    for (auto & state : states) {
+        if (!writer.can_submit()) { break; }
+        if (state.backing || state.writeback || state.writeback_failed || state.resident ||
+                state.data.main.empty() || state.prompt.tokens.has_mtmd) { continue; }
+        try {
+            auto buffers = state.buffers();
+            size_t payload = 0;
+            for (auto * buffer : buffers) {
+                if (buffer->size() > SIZE_MAX - payload) { return; }
+                payload += buffer->size();
+            }
+            if (payload > current) { return; }
+            const size_t base = current - payload;
+            const size_t metadata = state.cold_metadata_size();
+            if (base > limit_size || metadata > limit_size - base) { continue; }
+            const size_t previous = state.size();
+            if (previous > current) { return; }
+            auto pending = writer.submit(pager, buffers, limit_size - base - metadata);
+            if (pending) {
+                state.writeback = std::move(pending);
+                // The complete pending charge was bounded by the allowance
+                // above. Workers never change it, so this checked projection
+                // remains within limit_size without rescanning every entry.
+                current = current - previous + state.size();
+            }
+        } catch (...) { return; }
+    }
+}
