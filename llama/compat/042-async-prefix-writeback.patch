+#pragma once
+
+#include "server-state-pager.h"
+
+#include <condition_variable>
+#include <deque>
+#include <mutex>
+#include <thread>
+
+// One optional writer for immutable serialized prefixes, not model weights.
+// Existing vectors move into each request. They remain fully charged to the
+// prompt cache until the inference thread collects or restores that request.
+// The worker never touches prompt metadata, model state or a cache list node.
+class server_state_writeback {
+    struct work;
+    struct control {
+        std::mutex mutex;
+        std::condition_variable changed;
+        std::deque<std::shared_ptr<work>> queue;
+        size_t requests = 0, bytes = 0;
+        bool stopping = false;
+    };
+    struct work {
+        explicit work(server_state_pager source) : pager(std::move(source)) {}
+        server_state_pager pager;
+        std::vector<std::vector<uint8_t>> data;
+        std::vector<const std::vector<uint8_t> *> sources;
+        server_state_pager::handle saved;
+        std::mutex mutex;
+        std::condition_variable changed;
+        // All fields above become immutable to the worker before publication.
+        // data/saved are touched by the inference thread only after done.
+        bool done = true;
+    };
+    std::shared_ptr<control> state;
+    std::thread worker;
+    bool enabled = false;
+    static constexpr size_t maximum_requests = 2;
+    static constexpr size_t maximum_bytes = 32 * 1024 * 1024;
+
+    static void run(const std::shared_ptr<control> & state) noexcept {
+        for (;;) {
+            std::shared_ptr<work> next;
+            {
+                std::unique_lock<std::mutex> lock(state->mutex);
+                state->changed.wait(lock, [&] { return state->stopping || !state->queue.empty(); });
+                if (state->queue.empty()) { return; }
+                next = std::move(state->queue.front());
+                state->queue.pop_front();
+            }
+#ifdef WILDLLAMA_STATE_WRITEBACK_TEST_GATE
+            WILDLLAMA_STATE_WRITEBACK_TEST_GATE();
+#endif
+            auto saved = next->pager.store(next->sources);
+            // The request keeps the owner alive while waiting. Drop the
+            // worker's reference before completion becomes observable, so its
+            // destructor can release every charged byte before the reservation.
+            auto * completed = next.get();
+            next.reset();
+            {
+                std::lock_guard<std::mutex> lock(completed->mutex);
+                completed->saved = std::move(saved);
+                completed->done = true;
+                completed->changed.notify_all();
+            }
+        }
+    }
+    bool start_worker() noexcept {
+        if (worker.joinable()) { return true; }
+        try {
+            auto pending = std::make_shared<control>();
+            worker = std::thread([pending] { run(pending); });
+            state = std::move(pending);
+            return true;
+        } catch (...) { return false; }
+    }
+    void stop() noexcept {
+        if (!worker.joinable()) { return; }
+        {
+            std::lock_guard<std::mutex> lock(state->mutex);
+            state->stopping = true;
+        }
+        state->changed.notify_all();
+        worker.join();
+    }
+public:
+    class request {
+        friend class server_state_writeback;
+        std::shared_ptr<work> job;
+        std::shared_ptr<control> owner;
+        size_t charge = 0;
+        bool reserved = false;
+        request(std::shared_ptr<work> job, std::shared_ptr<control> owner, size_t bytes) :
+            job(std::move(job)), owner(std::move(owner)), charge(bytes) {}
+    public:
+        request(const request &) = delete;
+        request & operator=(const request &) = delete;
+        ~request() {
+            wait();
+            job->saved.reset();
+            std::vector<std::vector<uint8_t>>().swap(job->data);
+            std::vector<const std::vector<uint8_t> *>().swap(job->sources);
+            job.reset();
+            if (reserved) {
+                std::lock_guard<std::mutex> lock(owner->mutex);
+                owner->bytes -= charge;
+                --owner->requests;
+            }
+        }
+        void wait() const noexcept {
+            std::unique_lock<std::mutex> lock(job->mutex);
+            job->changed.wait(lock, [&] { return job->done; });
+        }
+        bool ready() const noexcept {
+            std::lock_guard<std::mutex> lock(job->mutex);
+            return job->done;
+        }
+        bool succeeded() const noexcept {
+            std::lock_guard<std::mutex> lock(job->mutex);
+            return job->done && bool(job->saved);
+        }
+        size_t resident_bytes() const noexcept { return charge; }
+        size_t payload_bytes() const noexcept {
+            size_t result = 0;
+            for (const auto & part : job->data) { result += part.size(); }
+            return result;
+        }
+        // On failure or demand before collection, reuse original RAM vectors.
+        // A completed write becomes visible only with its whole owned handle.
+        bool finish(const std::vector<std::vector<uint8_t> *> & parts,
+                server_state_pager::handle & backing, bool keep_ram) noexcept {
+            if (parts.size() != job->data.size()) { return false; }
+            for (auto * part : parts) { if (!part || !part->empty()) { return false; } }
+            wait();
+            const bool success = bool(job->saved);
+            if (keep_ram || !success) {
+                for (size_t i = 0; i < parts.size(); ++i) { parts[i]->swap(job->data[i]); }
+                job->saved.reset();
+            } else {
+                backing = std::move(job->saved);
+            }
+            std::vector<std::vector<uint8_t>>().swap(job->data);
+            return keep_ram || success;
+        }
+    };
+    using handle = std::unique_ptr<request>;
+
+    server_state_writeback() {
+        const char * value = std::getenv("WILDLLAMA_PREFIX_DISK_ASYNC");
+        enabled = value && std::strcmp(value, "1") == 0;
+    }
+    ~server_state_writeback() { stop(); }
+    server_state_writeback(const server_state_writeback &) = delete;
+    server_state_writeback & operator=(const server_state_writeback &) = delete;
+    server_state_writeback(server_state_writeback && other) noexcept :
+        state(std::move(other.state)), worker(std::move(other.worker)), enabled(other.enabled) {}
+    server_state_writeback & operator=(server_state_writeback && other) noexcept {
+        if (this != &other) {
+            stop();
+            state = std::move(other.state); worker = std::move(other.worker); enabled = other.enabled;
+        }
+        return *this;
+    }
+    bool is_enabled() const noexcept { return enabled; }
+    void set_enabled(bool value) noexcept { enabled = value; }
+    bool can_submit() const noexcept {
+        if (!enabled) { return false; }
+        if (!state) { return true; }
+        std::lock_guard<std::mutex> lock(state->mutex);
+        return !state->stopping && state->requests < maximum_requests && state->bytes < maximum_bytes;
+    }
+    static size_t charge(const std::vector<std::vector<uint8_t> *> & parts) noexcept {
+        if (parts.empty() || parts.size() > 4096) { return SIZE_MAX; }
+        // Include the eventual disk-handle descriptors as well as vector and
+        // request metadata; allocating a worker does not free a RAM-cache byte.
+        size_t total = sizeof(request) + sizeof(work) + sizeof(server_state_pager::entry);
+        constexpr size_t item = sizeof(std::vector<uint8_t>) + sizeof(void *) + sizeof(uint64_t);
+        if (parts.size() > (SIZE_MAX - total) / item) { return SIZE_MAX; }
+        total += parts.size() * item;
+        for (size_t i = 0; i < parts.size(); ++i) {
+            auto * part = parts[i];
+            if (!part || part->capacity() > SIZE_MAX - total) { return SIZE_MAX; }
+            // Moving one vector twice would silently change its second part.
+            for (size_t j = 0; j < i; ++j) { if (parts[j] == part) { return SIZE_MAX; } }
+            total += part->capacity();
+        }
+        return total;
+    }
+    handle submit(const server_state_pager & pager,
+            const std::vector<std::vector<uint8_t> *> & parts, size_t allowed_bytes) noexcept {
+        if (!can_submit() || !pager.enabled()) { return {}; }
+        auto bytes = charge(parts);
+        if (bytes > allowed_bytes || bytes > maximum_bytes) { return {}; }
+        try {
+            auto job = std::make_shared<work>(pager);
+            job->data.resize(parts.size());
+            job->sources.reserve(parts.size());
+            for (const auto & part : job->data) { job->sources.push_back(&part); }
+            const size_t data_extra = job->data.capacity() - parts.size();
+            if (data_extra > (maximum_bytes - bytes) / sizeof(std::vector<uint8_t>)) { return {}; }
+            bytes += data_extra * sizeof(std::vector<uint8_t>);
+            const size_t source_extra = job->sources.capacity() - parts.size();
+            if (source_extra > (maximum_bytes - bytes) / sizeof(void *)) { return {}; }
+            bytes += source_extra * sizeof(void *);
+            if (bytes > allowed_bytes) { return {}; }
+            if (!start_worker()) { return {}; }
+            auto result = handle(new request(job, state, bytes));
+            {
+                std::lock_guard<std::mutex> lock(state->mutex);
+                if (state->stopping || state->requests >= maximum_requests || state->bytes > maximum_bytes - bytes) { return {}; }
+                state->queue.push_back(job); // allocate before moving caller bytes
+                for (size_t i = 0; i < parts.size(); ++i) { job->data[i].swap(*parts[i]); }
+                job->done = false;
+                state->bytes += bytes; ++state->requests;
+                result->reserved = true;
+            }
+            state->changed.notify_one();
+            return result;
+        } catch (...) { return {}; }
+    }
+};
