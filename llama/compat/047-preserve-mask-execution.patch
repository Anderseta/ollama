+    auto * bad_ids=ggml_new_tensor_1d(ctx.get(),GGML_TYPE_I32,4);
+    auto * bad_slots=ggml_new_tensor_1d(ctx.get(),GGML_TYPE_I64,4);
+    auto * mixed_input=ggml_new_tensor_2d(ctx.get(),GGML_TYPE_F32,4,4);
