+    auto * keys=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,4,2,1);
+    auto * queries=ggml_new_tensor_3d(ctx.get(),GGML_TYPE_I32,4,2,1);
+    ggml_set_input(keys);ggml_set_input(queries);
