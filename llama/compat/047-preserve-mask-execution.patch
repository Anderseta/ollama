+static std::vector<float> host_embedding_decode(llama_context * ctx,int n,int start,bool use_compact,bool output_last) {
+    compact(use_compact);
+    auto batch=llama_batch_init(n,0,1);batch.n_tokens=n;
+    for(int i=0;i<n;++i){batch.token[i]=3+(i*13+start)%256;batch.pos[i]=start+i;batch.n_seq_id[i]=1;batch.seq_id[i][0]=0;batch.logits[i]=output_last && i==n-1;}
+    mask_ops=cuda_mask_ops=cuda_attention=cpu_attention=0;
+    require(llama_decode(ctx,batch)==0,"file-loaded hybrid CPU-input decode failed");
+    llama_batch_free(batch);
+    require(mask_ops==cuda_mask_ops,"hybrid mask did not execute on CUDA");
+    if(use_compact && output_last && n>=256)require(mask_ops>0,"file-loaded hybrid compact mask never executed");
+    if(!use_compact)require(mask_ops==0,"disabled file-loaded mask unexpectedly executed");
+    if(!output_last)return {};
+    const auto * out=llama_get_logits_ith(ctx,-1);require(out,"file-loaded hybrid logits missing");
+    return {out,out+llama_vocab_n_tokens(llama_model_get_vocab(llama_get_model(ctx)))};
+}
