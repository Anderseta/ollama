+    auto * side_effect=ggml_cpy(ctx.get(),side_source,side_destination);ggml_build_forward_expand(graph,side_effect);
+    auto * orphan=ggml_new_tensor_1d(ctx.get(),GGML_TYPE_F32,4);ggml_set_input(orphan);ggml_build_forward_order(graph,orphan);
+    require(!(inactive->flags & GGML_TENSOR_FLAG_COMPUTE) && !(mixed->flags & GGML_TENSOR_FLAG_COMPUTE),"unit inactive branches were already active");
+    const std::vector<ggml_tensor *> roots(graph->nodes,graph->nodes+graph->n_nodes);
+    const std::vector<ggml_tensor *> leafs(graph->leafs,graph->leafs+graph->n_leafs);
