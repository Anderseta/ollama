+// ggml_graph_clear resets membership/use counts, not tensor COMPUTE flags.
+// Rebuild every original root in its original order without promoting ordered
+// placeholders or unselected branches to executable work. A newly introduced
+// operation must receive its own COMPUTE flag from its proven active consumer.
+inline void llama_device_mask_rebuild_order(ggml_cgraph * graph,
+        const std::vector<ggml_tensor *> & roots,
+        const std::vector<ggml_tensor *> & leafs, ggml_tensor * promoted) {
+    ggml_graph_clear(graph);
+    // Select branches may deliberately register an otherwise orphan input
+    // leaf. Keep its original allocation contract; the promoted former mask
+    // leaf is now reached as an operation from its existing consumers.
+    for (auto * leaf : leafs) {
+        if (leaf!=promoted) { ggml_build_forward_order(graph,leaf); }
+    }
+    for (auto * root : roots) { ggml_build_forward_order(graph,root); }
+}
