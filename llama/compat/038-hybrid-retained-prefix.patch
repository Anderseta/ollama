+static void transactions() {
+    constexpr size_t mib=1024*1024;
+    require(llama_prefix_recurrent_limit(nullptr)==32*mib,"missing cap default changed");
+    require(llama_prefix_recurrent_limit("0")==0 && llama_prefix_recurrent_limit("1")==mib &&
+        llama_prefix_recurrent_limit("1024")==1024*mib,"valid RNN cap rejected");
+    for(const char * bad:{"-1","1025","invalid","9999999999999999999999999999999"}){
+        require(llama_prefix_recurrent_limit(bad)==32*mib,"invalid RNN cap changed default");
+    }
+    require(llama_prefix_recurrent_admit(16*mib,16*mib,32*mib),"RNN cap exact boundary rejected");
+    require(!llama_prefix_recurrent_admit(16*mib,16*mib+1,32*mib),"RNN aggregate cap exceeded");
+    require(!llama_prefix_recurrent_admit(SIZE_MAX,1,32*mib),"RNN byte quota overflow admitted");
+    for(int fail=0;fail<5;++fail){int attn=0,recr=0,clears=0;
+        const bool result=llama_hybrid_prefix_transaction([&]{++attn;if(fail==1)throw std::runtime_error("attn");return fail!=2;},
+            [&]{++recr;if(fail==3)throw std::runtime_error("recr");return fail!=4;},[&]{clears+=2;});
+        require(result==(fail==0),"composite transaction result changed");
+        require(clears==(fail?2:0),"failure did not clear both halves");
+        require(recr==((fail==1||fail==2)?0:1),"recurrent restore ran after attention failure");
+    }
