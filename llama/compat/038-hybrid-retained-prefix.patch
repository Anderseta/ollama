+// Attention cells remain shared in their existing allocation. Only the compact
+// logical current recurrent state is captured on the host. Snapshot allocation
+// is optional and bounded separately from the existing retained-token quota.
+struct llama_hybrid_prefix_owner {
+    llama_memory_hybrid * memory;
+    size_t limit;
+    size_t bytes = 0;
+};
+
+class hybrid_prefix_writer final : public llama_io_write_i {
+    std::vector<uint8_t> * data;
+    size_t offset = 0;
+    const size_t limit;
+public:
+    explicit hybrid_prefix_writer(size_t limit,std::vector<uint8_t> * data = nullptr) : data(data),limit(limit) {}
+    void reserve(size_t size) {
+        if (size > limit - offset || (data && size > data->size() - offset)) {
+            throw std::length_error("hybrid prefix recurrent-state byte budget exceeded");
+        }
+    }
+    void write(const void * src, size_t size) override {
+        reserve(size);
+        if (data && size) { std::memcpy(data->data()+offset,src,size); }
+        offset += size;
+    }
+    void write_tensor(ggml_tensor * tensor, size_t begin, size_t size) override {
+        reserve(size);
+        if (data && size) { ggml_backend_tensor_get(tensor,data->data()+offset,begin,size); }
+        offset += size;
+    }
+    size_t n_bytes() override { return offset; }
+};
+
+class hybrid_prefix_reader final : public llama_io_read_i {
+    const std::vector<uint8_t> & data;
+    size_t offset = 0;
+public:
+    explicit hybrid_prefix_reader(const std::vector<uint8_t> & data) : data(data) {}
+    void require(size_t size) {
+        if (size > data.size()-offset) { throw std::runtime_error("truncated hybrid prefix recurrent state"); }
+    }
+    void read(void * dst, size_t size) override {
+        require(size);
+        if (size) { std::memcpy(dst,data.data()+offset,size); }
+        offset += size;
+    }
+    void read_tensor(ggml_tensor * tensor, size_t begin, size_t size) override {
+        require(size);
+        if (size) { ggml_backend_tensor_set(tensor,data.data()+offset,begin,size); }
+        offset += size;
+    }
+    size_t n_bytes() override { return offset; }
+};
+
+struct llama_hybrid_prefix_state final : llama_memory_prefix {
+    std::weak_ptr<llama_hybrid_prefix_owner> owner;
+    std::shared_ptr<llama_memory_prefix> attention;
+    std::vector<uint8_t> recurrent;
+    bool charged = false;
+    llama_hybrid_prefix_state(const std::shared_ptr<llama_hybrid_prefix_owner> & owner,
+            std::shared_ptr<llama_memory_prefix> attention, std::vector<uint8_t> recurrent) :
+        owner(owner), attention(std::move(attention)), recurrent(std::move(recurrent)) {}
+    ~llama_hybrid_prefix_state() override {
+        if (charged) {
+            if (auto locked = owner.lock()) { locked->bytes -= recurrent.size(); }
+        }
+    }
+    bool valid() const override { return !owner.expired() && attention && attention->valid() && !recurrent.empty(); }
+    size_t size() const override { return attention->size()+recurrent.size(); }
+    uint32_t n_tokens() const override { return attention->n_tokens(); }
+    bool restore(llama_memory_t memory, llama_seq_id destination) override {
+        auto locked = owner.lock();
+        if (!valid() || !locked || locked->memory != memory || destination < 0 ||
+                size_t(destination) >= locked->memory->get_mem_recr()->rs_idx.size()) { return false; }
+        auto * attn = locked->memory->get_mem_attn();
+        auto * recr = locked->memory->get_mem_recr();
+        return llama_hybrid_prefix_transaction(
+            [&] { return attention->restore(attn,destination); },
+            [&] {
+                hybrid_prefix_reader reader(recurrent);
+                recr->state_read(reader,destination,0);
+                return reader.n_bytes()==recurrent.size() &&
+                    attn->seq_pos_max(destination)==llama_pos(n_tokens()-1) &&
+                    recr->seq_pos_max(destination)==llama_pos(n_tokens()-1);
+            },
+            [&] {
+                // No half-restored state can be used by the next decode.
+                attn->seq_rm(destination,-1,-1);
+                recr->seq_rm(destination,-1,-1);
+            });
+    }
+};
+
+llama_memory_hybrid::~llama_memory_hybrid() {
+    invalidate_prefixes();
+    prefix_owner.reset();
+}
+
+void llama_memory_hybrid::invalidate_prefixes() const { static_cast<llama_memory_i *>(mem_attn.get())->invalidate_prefixes(); }
+
+std::shared_ptr<llama_memory_prefix> llama_memory_hybrid::retain_prefix(llama_seq_id sequence,uint32_t max_tokens) {
+    // Derived layouts can own additional indexer/compression state. They must
+    // explicitly implement a complete composite snapshot before opting in.
+    if (typeid(*this)!=typeid(llama_memory_hybrid) || sequence<0 ||
+            size_t(sequence)>=mem_recr->rs_idx.size()) { return {}; }
+    if (!prefix_owner) {
+        prefix_owner=std::make_shared<llama_hybrid_prefix_owner>(llama_hybrid_prefix_owner{
+            this,llama_prefix_recurrent_limit(std::getenv("WILDLLAMA_PREFIX_RECURRENT_MIB"))});
+    }
+    const auto limit=prefix_owner->limit;
+    if (!limit) { return {}; }
+    auto attention=mem_attn->retain_prefix(sequence,max_tokens);
+    if (!attention || mem_recr->seq_pos_max(sequence)!=llama_pos(attention->n_tokens()-1)) { return {}; }
+    hybrid_prefix_writer measure(limit);
+    try { mem_recr->state_write(measure,sequence,0); }
+    catch (const std::length_error &) { return {}; }
+    const size_t bytes=measure.n_bytes();
+    if (!bytes || bytes>SIZE_MAX-attention->size()) { return {}; }
+    if (!llama_prefix_recurrent_admit(prefix_owner->bytes,bytes,limit)) { return {}; }
+    std::vector<uint8_t> recurrent(bytes);
+    hybrid_prefix_writer writer(limit,&recurrent);
+    mem_recr->state_write(writer,sequence,0);
+    if (writer.n_bytes()!=bytes) { return {}; }
+    auto retained=std::make_shared<llama_hybrid_prefix_state>(prefix_owner,std::move(attention),std::move(recurrent));
+    prefix_owner->bytes+=bytes;
+    retained->charged=true;
+    return retained;
+}
