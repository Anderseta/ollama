+#pragma once
+
+#include <cstddef>
+#include <cstdlib>
+#include <cerrno>
+
+inline size_t llama_prefix_recurrent_limit(const char * value) {
+    constexpr size_t mib=1024*1024, fallback=32*mib;
+    if (!value || !*value) { return fallback; }
+    char * end=nullptr;errno=0;
+    const auto parsed=std::strtoull(value,&end,10);
+    return errno || end==value || !end || *end || parsed>1024 ? fallback : size_t(parsed)*mib;
+}
+
+inline bool llama_prefix_recurrent_admit(size_t retained,size_t requested,size_t limit) {
+    return retained<=limit && requested<=limit-retained;
+}
+
+// Clear both destination memories on either-half failure. The saved handle is
+// immutable and remains usable; callers must recompute after a false result.
+// Clear callbacks must be allocation-free and must clear the full sequence.
+template<typename Attention, typename Recurrent, typename Clear>
+bool llama_hybrid_prefix_transaction(Attention attention, Recurrent recurrent, Clear clear) {
+    try {
+        if (attention() && recurrent()) { return true; }
+    } catch (...) {}
+    clear();
+    return false;
+}
