+#pragma once
+#include "llama-kv-cells.h"
+
+// Text-only M-RoPE admission; the actual cell/ext storage stays shared intact.
+inline bool llama_prefix_text_cell(uint32_t n_pos,uint32_t ple_heads,
+        const llama_kv_cell_ext & ext,llama_pos position) {
+    if (n_pos==1) { return true; }
+    const bool aligned=(ext.x==0 && ext.y==0) || (ext.x==position && ext.y==position);
+    return !ple_heads && ext.tok!=LLAMA_TOKEN_NULL && aligned;
+}
