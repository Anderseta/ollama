diff --git a/tools/server/server-admission.h b/tools/server/server-admission.h
new file mode 100644
--- /dev/null
+++ b/tools/server/server-admission.h
@@ -0,0 +1,187 @@
+#pragma once
+
+#include "server-task.h"
+#include "sampling.h"
+
+#include <algorithm>
+#include <atomic>
+#include <condition_variable>
+#include <deque>
+#include <exception>
+#include <functional>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <thread>
+#include <utility>
+#include <vector>
+
+struct server_admission_work {
+    common_params_sampling sampling;
+    common_sampler_ptr sampler;
+    std::exception_ptr error;
+    std::function<common_sampler *(common_params_sampling &)> make_sampler;
+    std::function<void()> wake;
+    std::weak_ptr<server_task_preparation> owner;
+    std::atomic<bool> ready{false};
+    int id = -1;
+    bool tokens_valid = false;
+    bool valid_model = true;
+    bool waiting = false; // main thread only
+};
+
+struct server_task_preparation {
+    std::shared_ptr<server_admission_work> work;
+};
+
+// One persistent worker prepares CPU samplers without delaying the decode fence.
+struct server_admission {
+private:
+    std::vector<std::weak_ptr<server_admission_work>> pending;
+    std::deque<std::shared_ptr<server_admission_work>> queued;
+    std::mutex mutex;
+    std::condition_variable condition;
+    std::thread worker;
+    bool stopping = false;
+
+    void run() {
+        while (true) {
+            std::shared_ptr<server_admission_work> work;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                condition.wait(lock, [&] { return stopping || !queued.empty(); });
+                if (stopping) { return; }
+                work = std::move(queued.front());
+                queued.pop_front();
+            }
+            if (work->owner.expired()) { continue; }
+            try {
+                work->sampler.reset(work->make_sampler(work->sampling));
+            } catch (...) {
+                work->error = std::current_exception();
+            }
+            // No sampler/config access after publishing; admission can move them.
+            work->ready.store(true, std::memory_order_release);
+            try { work->wake(); } catch (...) { /* the ready result remains available */ }
+        }
+    }
+
+public:
+    ~server_admission() { clear(); }
+
+    static bool eligible(const server_task & task) {
+        if (task.cli || task.id_slot != -1 || task.is_parent() || task.is_child() || task.tokens.has_mtmd) {
+            return false;
+        }
+        if (task.type != SERVER_TASK_TYPE_COMPLETION && task.type != SERVER_TASK_TYPE_INFILL) {
+            return false;
+        }
+        // The optional external grammar engine has a separate threading contract.
+        const auto & grammar = common_grammar_value(task.params.sampling.grammar);
+        return grammar.compare(0, 11, "%llguidance") != 0 && grammar.size() <= 64 * 1024 &&
+            task.params.sampling.generation_prompt.size() <= 64 * 1024;
+    }
+
+    template<typename Validate, typename Prepare, typename Wake>
+    bool prepare(server_task & task, size_t capacity, Validate && validate, Prepare && make_sampler, Wake && wake) {
+        if (!eligible(task) || (task.preparation && task.preparation->work->valid_model)) {
+            return false;
+        }
+        pending.erase(std::remove_if(pending.begin(), pending.end(),
+            [](const auto & p) { return p.expired(); }), pending.end());
+        if (pending.size() >= capacity) {
+            return false;
+        }
+        try {
+            auto prepared = std::make_shared<server_task_preparation>();
+            auto work = std::make_shared<server_admission_work>();
+            prepared->work = work;
+            work->owner = prepared;
+            work->id = task.id;
+            work->sampling = task.params.sampling;
+            work->tokens_valid = validate();
+            work->make_sampler = std::forward<Prepare>(make_sampler);
+            work->wake = std::forward<Wake>(wake);
+            pending.push_back(work);
+            if (work->tokens_valid) {
+                std::lock_guard<std::mutex> lock(mutex);
+                if (!worker.joinable()) { worker = std::thread([this] { run(); }); }
+                queued.push_back(work);
+            } else {
+                work->ready.store(true, std::memory_order_release);
+            }
+            task.preparation = std::move(prepared);
+            condition.notify_one();
+            return true;
+        } catch (...) {
+            return false; // Lookahead bookkeeping must not abort an active decode.
+        }
+    }
+
+    template<typename Resume>
+    void resume_ready(Resume && resume) {
+        for (auto & weak : pending) {
+            if (auto work = weak.lock()) {
+                if (work->waiting && work->ready.load(std::memory_order_acquire)) {
+                    resume(work->id);
+                    work->waiting = false;
+                }
+            }
+        }
+    }
+
+    // Prepared samplers hold vocab pointers. Drop them before unloading the model.
+    void clear() {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stopping = true;
+            queued.clear();
+        }
+        condition.notify_one();
+        if (worker.joinable()) { worker.join(); }
+        for (auto & weak : pending) {
+            if (auto work = weak.lock()) {
+                work->sampler.reset();
+                work->error = nullptr;
+                work->valid_model = false;
+                work->make_sampler = {};
+                work->wake = {};
+            }
+        }
+        pending.clear();
+        stopping = false;
+    }
+};
+
+struct server_decode_metadata {
+    std::vector<uint64_t> prompt_by_slot;
+    std::vector<size_t> prompt_slots;
+    uint64_t n_prompt = 0;
+
+    template<typename Tokens>
+    void prepare(const Tokens & tokens, size_t off, size_t count, size_t n_slots) {
+        if (off > tokens.size() || count > tokens.size() - off) {
+            throw std::out_of_range("decode metadata is outside the batch");
+        }
+        for (size_t slot : prompt_slots) {
+            prompt_by_slot[slot] = 0;
+        }
+        prompt_by_slot.resize(n_slots, 0);
+        prompt_slots.clear();
+        n_prompt = 0;
+        for (size_t i = off; i < off + count; ++i) {
+            const auto & token = tokens[i];
+            if (!token.is_prompt) {
+                continue;
+            }
+            if (token.id_slot < 0 || size_t(token.id_slot) >= n_slots) {
+                throw std::out_of_range("decode metadata has an invalid slot");
+            }
+            if (prompt_by_slot[token.id_slot] == 0) {
+                prompt_slots.push_back(token.id_slot);
+            }
+            ++prompt_by_slot[token.id_slot];
+            ++n_prompt;
+        }
+    }
+};
