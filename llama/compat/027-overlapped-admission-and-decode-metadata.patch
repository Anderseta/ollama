--- /dev/null
+++ b/tests/test-server-admission.cpp
@@ -0,0 +1,291 @@
+#include "../tools/server/server-admission.h"
+#include "../tools/server/server-queue.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <future>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+static void require(bool ok, const char * message) {
+    if (!ok) { throw std::runtime_error(message); }
+}
+
+static server_task task_with_id(int id, server_task_type type = SERVER_TASK_TYPE_COMPLETION) {
+    server_task task(type); task.id = id; return task;
+}
+
+static void wait_ready(const server_task & task) {
+    const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (!task.preparation->work->ready.load(std::memory_order_acquire)) {
+        require(std::chrono::steady_clock::now() < deadline, "sampler job did not finish");
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+}
+
+static void test_capacity_and_invalidation() {
+    server_admission admission;
+    auto a = task_with_id(1), b = task_with_id(2), c = task_with_id(3);
+    std::promise<void> entered, release;
+    auto started = entered.get_future(); auto gate = release.get_future().share();
+    std::atomic<int> calls{0};
+    auto valid = [] { return true; };
+    auto wake = [] {};
+    auto prepare = [&](common_params_sampling & params) -> common_sampler * {
+        ++calls; params.backend_sampling = false; return nullptr;
+    };
+    require(!admission.prepare(a, 0, valid, prepare, wake), "zero capacity must not prepare");
+    a.params.sampling.backend_sampling = true;
+    require(admission.prepare(a, 2, valid, [&, gate](common_params_sampling & params) -> common_sampler * {
+        entered.set_value(); gate.wait(); return prepare(params);
+    }, wake), "prepare first request");
+    require(started.wait_for(std::chrono::seconds(10)) == std::future_status::ready, "worker did not start");
+    require(admission.prepare(b, 2, valid, prepare, wake), "prepare second request");
+    require(!admission.prepare(a, 2, valid, prepare, wake), "a deferred task is prepared once");
+    require(!admission.prepare(c, 2, valid, prepare, wake), "lookahead exceeds parallel capacity");
+    require(a.params.sampling.backend_sampling, "worker mutated queued request config");
+    std::weak_ptr<server_task_preparation> owner = a.preparation;
+    auto moved = std::move(a);
+    require(!owner.expired(), "queue moves must preserve prepared state");
+    moved.preparation.reset();
+    require(owner.expired(), "cancelled request must release its owner ticket");
+    require(!admission.prepare(c, 2, valid, prepare, wake), "cancelled running job must remain in memory budget");
+    release.set_value();
+    wait_ready(b);
+    require(admission.prepare(c, 2, valid, prepare, wake), "completed cancelled capacity is reusable");
+    wait_ready(c);
+    require(calls == 3, "unexpected repeated preparation");
+    admission.clear();
+    require(!b.preparation->work->valid_model && !c.preparation->work->valid_model,
+        "model unload must invalidate all live preparations");
+    require(admission.prepare(b, 2, valid, prepare, wake), "reload must prepare again");
+    wait_ready(b);
+    require(calls == 4, "reload reused old model preparation");
+
+    for (auto type : {SERVER_TASK_TYPE_CANCEL, SERVER_TASK_TYPE_CONTROL, SERVER_TASK_TYPE_TTS,
+            SERVER_TASK_TYPE_TRANSCRIBE_RT, SERVER_TASK_TYPE_EMBEDDING,
+            SERVER_TASK_TYPE_RERANK, SERVER_TASK_TYPE_DECISION}) {
+        require(!server_admission::eligible(task_with_id(9, type)), "unsafe/unprofitable task prepared");
+    }
+    auto excluded = task_with_id(9);
+    excluded.cli = true;
+    require(!server_admission::eligible(excluded), "CLI tokenization is not lookahead-safe");
+    excluded.cli = false; excluded.id_slot = 0;
+    require(!server_admission::eligible(excluded), "explicit slot affinity changed");
+    excluded.id_slot = -1; excluded.tokens.has_mtmd = true;
+    require(!server_admission::eligible(excluded), "media must keep existing path");
+    excluded.tokens.has_mtmd = false;
+    excluded.params.sampling.grammar = common_grammar(COMMON_GRAMMAR_TYPE_USER, "%llguidance test");
+    require(!server_admission::eligible(excluded), "external grammar must keep existing path");
+    excluded.params.sampling.grammar = common_grammar(COMMON_GRAMMAR_TYPE_USER, std::string(65537, 'a'));
+    require(!server_admission::eligible(excluded), "large grammar must keep existing path");
+    excluded.params.sampling.grammar = {}; excluded.id_parent = 1;
+    require(!server_admission::eligible(excluded), "child preparation must keep independent RNG");
+    excluded.id_parent = -1; excluded.child_tasks.emplace_back(SERVER_TASK_TYPE_COMPLETION);
+    require(!server_admission::eligible(excluded), "parent scheduling remains atomic");
+
+    auto invalid = task_with_id(10);
+    require(admission.prepare(invalid, 2, [] { return false; }, prepare, wake), "invalid token result not retained");
+    require(invalid.preparation->work->ready && !invalid.preparation->work->tokens_valid && calls == 4,
+        "invalid prompt must not construct a sampler");
+    admission.clear();
+    auto wake_failure = task_with_id(11);
+    require(admission.prepare(wake_failure, 1, valid, prepare,
+        [] { throw std::runtime_error("fixture wake failure"); }), "wake failure job not prepared");
+    wait_ready(wake_failure);
+    admission.clear(); // a failing notification must not terminate the worker/process
+}
+
+struct counted_tokens {
+    struct token { int32_t id_slot; bool is_prompt; };
+    std::vector<token> values;
+    mutable size_t reads = 0;
+    size_t size() const { return values.size(); }
+    const token & operator[](size_t i) const { ++reads; return values.at(i); }
+};
+
+static void test_decode_metadata() {
+    counted_tokens tokens;
+    for (int i = 0; i < 4096; ++i) { tokens.values.push_back({i % 3, i % 7 != 0}); }
+    server_decode_metadata metadata;
+    metadata.prepare(tokens, 17, 2048, 4);
+    require(tokens.reads == 2048, "metadata must scan each submitted token once");
+    std::vector<uint64_t> reference(4, 0);
+    for (size_t i = 17; i < 17 + 2048; ++i) {
+        const auto & token = tokens.values[i];
+        if (token.is_prompt) { ++reference[token.id_slot]; }
+    }
+    require(metadata.prompt_by_slot == reference, "mixed prompt/generated counts changed");
+    require(metadata.n_prompt == reference[0] + reference[1] + reference[2], "global count changed");
+    require(metadata.prompt_slots.size() == 3, "each prompt slot should be timed once");
+    const auto capacity = metadata.prompt_by_slot.capacity();
+    metadata.prepare(tokens, 0, 1, 4);
+    require(metadata.prompt_slots.empty() && metadata.n_prompt == 0, "stale counts on decode");
+    require(metadata.prompt_by_slot == std::vector<uint64_t>(4, 0), "stale counts after reuse");
+    require(metadata.prompt_by_slot.capacity() == capacity, "fixed slots must reuse storage");
+    bool thrown = false;
+    try { metadata.prepare(tokens, 4095, 2, 4); } catch (const std::out_of_range &) { thrown = true; }
+    require(thrown, "reject invalid sub-batch without unsigned overflow");
+    counted_tokens invalid; invalid.values = {{1, true}, {-1, true}};
+    thrown = false;
+    try { metadata.prepare(invalid, 0, 2, 2); } catch (const std::out_of_range &) { thrown = true; }
+    require(thrown, "reject invalid prompt slot");
+    metadata.prepare(tokens, 1, 2, 3);
+    require(metadata.n_prompt == 2 && metadata.prompt_by_slot == std::vector<uint64_t>({0, 1, 1}),
+        "retry after failure must clear partial metadata");
+    std::puts("metadata: 2048 token reads; previous two post-forward scans required 4096");
+}
+
+static void test_real_queue_overlap() {
+    server_queue queue;
+    server_admission admission;
+    std::promise<void> enqueued, entered, release;
+    auto submitted = enqueued.get_future(), started = entered.get_future();
+    auto gate = release.get_future().share();
+    std::weak_ptr<server_task_preparation> cancelled;
+    std::vector<int> committed;
+    int failures = 0, cancellations = 0, updates = 0;
+    std::atomic<bool> forwarding{false};
+    queue.on_new_task([&](server_task && task, bool yielding) {
+        if (task.type == SERVER_TASK_TYPE_METRICS) { enqueued.set_value(); return true; }
+        if (yielding) {
+            if (server_admission::eligible(task)) {
+                const int id = task.id;
+                admission.prepare(task, 3, [] { return true; },
+                    [&, id, gate](common_params_sampling & params) -> common_sampler * {
+                        if (id == 501) { entered.set_value(); gate.wait(); }
+                        params.backend_sampling = false;
+                        if (id == 503) { throw std::invalid_argument("fixture sampler failure"); }
+                        return nullptr;
+                    }, [&] { queue.wake(); });
+                if (id == 501) { cancelled = task.preparation; }
+            }
+            return false;
+        }
+        require(!forwarding, "slot commit ran before forward completion");
+        if (task.type == SERVER_TASK_TYPE_CANCEL) { ++cancellations; return true; }
+        auto work = task.preparation->work;
+        if (!work->ready.load(std::memory_order_acquire)) {
+            work->waiting = true;
+            queue.defer(std::move(task));
+            return true;
+        }
+        committed.push_back(task.id);
+        require(!work->sampling.backend_sampling, "worker config changes were not published");
+        if (work->error) {
+            try { std::rethrow_exception(work->error); }
+            catch (const std::invalid_argument & e) {
+                require(std::string(e.what()) == "fixture sampler failure", "request error changed");
+                ++failures;
+            }
+        }
+        if (task.id == 503) { queue.terminate(); }
+        return true;
+    });
+    queue.on_update_slots([&] {
+        admission.resume_ready([&](int id) { queue.pop_deferred_task_by_id(id); });
+        if (++updates == 1) {
+            queue.yield_to_queue([&] {
+                forwarding = true;
+                queue.post(task_with_id(501)); queue.post(task_with_id(502)); queue.post(task_with_id(503));
+                queue.post(task_with_id(901, SERVER_TASK_TYPE_METRICS));
+                require(submitted.wait_for(std::chrono::seconds(10)) == std::future_status::ready, "enqueue did not overlap");
+                require(started.wait_for(std::chrono::seconds(10)) == std::future_status::ready, "persistent worker did not start");
+                forwarding = false;
+            });
+            // The slow sampler is still blocked, but the current forward fence returned.
+            require(committed.empty(), "pending sampler was synchronously admitted");
+        } else if (updates == 2) {
+            require(queue.queue_tasks_deferred_size() == 3, "pending preparation was not deferred");
+            auto cancel = task_with_id(700, SERVER_TASK_TYPE_CANCEL); cancel.id_target = 501;
+            queue.post(std::move(cancel));
+            require(cancelled.expired(), "queue cancellation retained owner ticket");
+            release.set_value();
+        }
+    });
+    queue.on_sleeping_state([&](bool sleeping) {
+        require(!sleeping, "deferred preparation must prevent idle sleep, even at timeout zero");
+    });
+    queue.start_loop(0);
+    require(committed == std::vector<int>({502, 503}), "FIFO/cancellation order changed");
+    require(cancellations == 1 && failures == 1, "deferred error or cancellation was lost");
+    admission.clear();
+    std::puts("queue: blocked sampler did not stall forward; FIFO, cancellation, deferred errors and sleep-zero passed");
+}
+
+static void test_unload_wake_join() {
+    server_queue queue;
+    server_admission admission;
+    auto task = task_with_id(1);
+    std::promise<void> entered, release;
+    auto started = entered.get_future(); auto gate = release.get_future().share();
+    require(admission.prepare(task, 1, [] { return true; },
+        [&, gate](common_params_sampling &) -> common_sampler * {
+            entered.set_value(); gate.wait(); return nullptr;
+        }, [&] { queue.wake(); }), "unload preparation not started");
+    require(started.wait_for(std::chrono::seconds(10)) == std::future_status::ready, "unload worker did not start");
+    queue.on_new_task([](server_task &&, bool) { return true; });
+    queue.on_update_slots([] {});
+    queue.on_sleeping_state([&](bool sleeping) {
+        if (sleeping) {
+            release.set_value();
+            admission.clear(); // worker wake must not wait on a mutex held by this callback
+            require(!task.preparation->work->valid_model, "unload retained sampler vocabulary");
+            queue.terminate();
+        }
+    });
+    queue.start_loop(0);
+    std::puts("unload: worker completion/wake joined before model invalidation without queue-lock deadlock");
+}
+
+static void test_sleep_publication_and_resume() {
+    server_queue queue;
+    std::atomic<bool> cache_ready{false};
+    bool resumed = false;
+    int sleeps = 0;
+    std::promise<void> reading, waking;
+    auto read_started = reading.get_future(), wake_started = waking.get_future();
+    std::future<bool> observer;
+    std::future<void> requester;
+    queue.on_new_task([](server_task &&, bool) { return true; });
+    queue.on_update_slots([&] { if (resumed) { queue.terminate(); } });
+    queue.on_sleeping_state([&](bool sleeping) {
+        if (!sleeping) { resumed = true; return; }
+        ++sleeps;
+        observer = std::async(std::launch::async, [&] {
+            reading.set_value();
+            (void) queue.is_sleeping();
+            return cache_ready.load();
+        });
+        requester = std::async(std::launch::async, [&] {
+            waking.set_value();
+            queue.wait_until_no_sleep();
+        });
+        require(read_started.wait_for(std::chrono::seconds(10)) == std::future_status::ready,
+            "sleep observer did not start");
+        require(wake_started.wait_for(std::chrono::seconds(10)) == std::future_status::ready,
+            "wake request did not start");
+        require(observer.wait_for(std::chrono::milliseconds(20)) == std::future_status::timeout,
+            "sleep was published before route caches were ready");
+        require(requester.wait_for(std::chrono::milliseconds(20)) == std::future_status::timeout,
+            "HTTP request continued before model reload");
+        cache_ready = true;
+    });
+    queue.start_loop(0);
+    require(sleeps == 1 && resumed, "wake during unload was lost");
+    require(observer.get(), "observer saw uninitialized sleeping caches");
+    requester.get();
+    std::puts("sleep: cached-state publication serialized; wake during unload preserved");
+}
+
+int main() {
+    try {
+        test_capacity_and_invalidation(); test_decode_metadata();
+        test_real_queue_overlap(); test_unload_wake_join(); test_sleep_publication_and_resume();
+        std::puts("server admission: all checks passed (CPU only, no model)"); return 0;
+    } catch (const std::exception & e) {
+        std::fprintf(stderr, "server admission: %s\n", e.what()); return 1;
+    }
+}
