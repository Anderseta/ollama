+void server_queue::pop_deferred_task_by_id(int id_task) {
+    std::lock_guard<std::mutex> lock(mutex_tasks);
+    auto it = std::find_if(queue_tasks_deferred.begin(), queue_tasks_deferred.end(),
+        [id_task](const server_task & task) { return task.id == id_task; });
+    if (it != queue_tasks_deferred.end()) {
+        queue_tasks.emplace_back(std::move(*it));
+        queue_tasks_deferred.erase(it);
+        time_last_task = ggml_time_ms();
+        condition_tasks.notify_one();
+    }
+}
+
+void server_queue::wake() {
+    req_update.store(true, std::memory_order_release);
+    std::lock_guard<std::mutex> lock(mutex_tasks);
+    condition_tasks.notify_all();
+}
