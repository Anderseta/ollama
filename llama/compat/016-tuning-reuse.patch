 // This points to an execution scope, not a persistent pointer/value cache. A nested
 // backend evaluation restores its caller, and each new capture starts empty.
 static thread_local ggml_cuda_mmvq_reuse_scope::state * mmvq_reuse_active = nullptr;
+
+bool ggml_cuda_mmvq_has_reuse_plan(const ggml_backend_cuda_context & ctx, const ggml_tensor * input) {
+    const auto * scope = mmvq_reuse_active;
+    return scope && scope->context == &ctx && ctx.curr_stream_no == 0 &&
+        scope->inputs.find(input) != scope->inputs.end();
+}
 
